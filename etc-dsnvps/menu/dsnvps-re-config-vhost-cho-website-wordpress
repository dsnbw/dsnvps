sed -i 's/.*all.conf.*/#include \/etc\/nginx\/conf\/all.conf;/g' /etc/nginx/conf.d/$website.conf
sed -i 's/.*supercache.conf.*/#include \/etc\/nginx\/conf\/supercache.conf;/g' /etc/nginx/conf.d/$website.conf
sed -i 's/.*w3total.conf.*/include \/etc\/nginx\/conf\/w3total.conf;/g' /etc/nginx/conf.d/$website.conf
sed -i 's/.*wprocket.conf.*/#include \/etc\/nginx\/conf\/wprocket.conf;/g' /etc/nginx/conf.d/$website.conf
sed -i 's/.*wp-fastest-cache.conf.*/#include \/etc\/nginx\/conf\/wp-fastest-cache.conf;/g' /etc/nginx/conf.d/$website.conf
sed -i 's/.*wp-optimize-cache.conf.*/#include \/etc\/nginx\/conf\/wp-optimize-cache.conf;/g' /etc/nginx/conf.d/$website.conf
END
chmod +x /etc/dsnvps/.tmp/re-config-vhost.sh
#### Backup Vhost I
rm -rf /etc/dsnvps/.tmp/$website.conf_check
cp /etc/nginx/conf.d/$website.conf /etc/dsnvps/.tmp/$website.conf_check
############################# 
/etc/dsnvps/.tmp/re-config-vhost.sh
rm -f /etc/dsnvps/.tmp/re-config-vhost.sh
######Check Nginx Service II
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word
if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` != "oksuccessful" ]; then
rm -rf /etc/nginx/conf.d/$website.conf
mv /etc/dsnvps/.tmp/$website.conf_check /etc/nginx/conf.d/$website.conf
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
echo "-------------------------------------------------------------------------"
echo "Phát hiện lỗi ..."; sleep 3
clear
echo "========================================================================="
echo "Vhost loi voi config moi. DSNVPS không thể thực hiện chức năng này."
exit 0
fi
fi
################################################
##Restart Nginx service
/etc/dsnvps/menu/inc/re-start-nginx-service
##
clear
echo "========================================================================="
echo "Cau hinh Vhost cua $website cho W3 Total Cache thanh cong"
exit 0
###################################
#Huỷ bỏ 
###################################
else
clear
exit 0
fi

