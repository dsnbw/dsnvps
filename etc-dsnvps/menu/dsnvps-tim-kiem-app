# Hàm parse JSON bằng Python hoặc sed
parse_json() {
    local json="$1" key="$2" value
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import json' 2>/dev/null; then
        value=$(echo "$json" | python3 -c "import json, sys; data = json.loads(sys.stdin.read()); print(data.get(\"$key\", \"\"))" 2>/dev/null)
        [ "$value" = "None" ] && value=""
        echo "$value"
    else
        value=$(echo "$json" | sed -n "s/.*\"$key\":\"\\{0,1\\}\\([^\"]*\\)\"\\{0,1\\}.*/\\1/p" | head -1)
        [ "$value" = "null" ] && value=""
        echo "$value"
    fi
}

# Hàm parse JSON cho số bằng Python hoặc sed
parse_json_number() {
    local json="$1" key="$2" value
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import json' 2>/dev/null; then
        value=$(echo "$json" | python3 -c "import json, sys; data = json.loads(sys.stdin.read()); print(data.get(\"$key\", 0) or 0)" 2>/dev/null)
        echo "$value"
    else
        value=$(echo "$json" | sed -n "s/.*\"$key\":\\([0-9]*\\).*/\\1/p" | head -1)
        [ -z "$value" ] || [ "$value" = "null" ] && value="0"
        echo "$value"
    fi
}

