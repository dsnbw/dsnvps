echo "Phát hiện lỗi ..."; sleep 3
clear
echo "========================================================================="
echo "Lỗi Vhost với cấu hình mới. DSNVPS không thể chạy chức năng này !"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
fi
fi

##Restart Nginx service
/etc/dsnvps/menu/inc/re-start-nginx-service
##
clear
