#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
nginx_status=$(systemctl is-active nginx.service)
if [ "$nginx_status" != "active" ]; then
    systemctl start nginx.service
    nginx_status=$(systemctl is-active nginx.service)
    if [ "$nginx_status" != "active" ]; then
        clear
        echo "========================================================================="
        echo "Xin lỗi, Nginx đã dừng. Vui lòng BẬT lại trước khi sử dụng chức năng này!"
        /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
    fi
fi

######################################################################################
rm -rf /etc/dsnvps/.tmp/*hostingaz*
rm -rf /etc/dsnvps/.tmp/check*
mkdir -p /etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist 
sowebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
for website in $sowebsite 
do
if [ -f /etc/nginx/conf.d/$website.conf ]; then
if [ "$(grep deny-script-writeable-folder.conf /etc/nginx/conf.d/$website.conf)" == "include /etc/nginx/conf/deny-script-writeable-folder.conf;" ]; then
touch /etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz/$website
fi
fi
done
rm -rf /etc/dsnvps/.tmp/kland
SOURCE_DIR="/etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz"
OUTPUT_FILE="/etc/dsnvps/.tmp/kland"
> "$OUTPUT_FILE"
for file in "$SOURCE_DIR"/*; do
    # Check if it is a file
    if [ -f "$file" ]; then
        # Extract the file name and append it to the output file
        echo "$(basename "$file")" >> "$OUTPUT_FILE"
    fi
done
###################################################################################
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -l)" -lt "1" ]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website mới vào server !"
        /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/checkallwebsites
vhost_dir="/etc/nginx/conf.d"
home_dir="/home"
output_file="/etc/dsnvps/.tmp/checkallwebsites"

> "$output_file"

for vhost_file in "$vhost_dir"/*.conf; do
    domainc=$(basename "$vhost_file" .conf)

    # Bỏ qua domain dsnvps.demo
    if [[ "$domainc" == "dsnvps.demo" ]]; then
        continue
    fi

    # Kiểm tra nếu thư mục /home/domain tồn tại
    if [[ -d "$home_dir/$domainc" ]]; then
        echo "$domainc" >> "$output_file"
    fi
done

# Kiểm tra nếu file output không có domain nào
if [[ ! -s "$output_file" ]]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website Vào Server !"
        /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
##################################################################
#Thêm (V)
if [ -s "/etc/dsnvps/.tmp/kland" ]; then
ALL_WEBSITES_FILE="/etc/dsnvps/.tmp/checkallwebsites"
KLAND_FILE="/etc/dsnvps/.tmp/kland"
OUTPUT_FILE="/etc/dsnvps/.tmp/checkallwebsites_with_status"
> "$OUTPUT_FILE"
while read -r domain; do
    if grep -q "^$domain$" "$KLAND_FILE"; then
        echo "$domain**" >> "$OUTPUT_FILE"
    else
        echo "$domain" >> "$OUTPUT_FILE"
    fi
done < "$ALL_WEBSITES_FILE"
else
mv /etc/dsnvps/.tmp/checkallwebsites /etc/dsnvps/.tmp/checkallwebsites_with_status
fi
#####################################################################
#####################################################################
########################################################################################################
#Park Domains
######################################################
#lay Danh Sách Website Trên Server####################
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
# Xóa file cũ nếu tồn tại
> "$output_file"
# Duyệt qua tất cả các file .conf trong thư mục cấu hình Nginx
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"

    # Kiểm tra nếu domain có thư mục public_html trong /home và vhost trong /etc/nginx/conf.d/
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        echo "$domain" >> "$output_file"
    fi
done
# Kiểm tra nếu không có domain nào được tìm thấy
if [[ ! -s "$output_file" ]]; then
clear
echo "========================================================================= "
echo "Không tìm thấy website trên server"
echo "-------------------------------------------------------------------------"
echo "Bạn cần Thêm Website Vào Server trước khi chạy chức năng này."
/etc/dsnvps/menu/dsnvps-tao-paidssl-menu
exit
fi
########################################################
klaoxcy_file="/etc/dsnvps/.tmp/klaoxcy"
nginx_conf_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcypark"
# Xóa file kết quả cũ nếu tồn tại
> "$output_file"

if [[ -s "$klaoxcy_file" ]]; then
    while IFS= read -r domain; do
        domain_conf_folder="$nginx_conf_folder/$domain/conf.d"
        if [[ "$domain" != "$mainsite" && -d "$domain_conf_folder" ]]; then
            # Kiểm tra nếu thư mục có file .conf
            if compgen -G "$domain_conf_folder"/*.conf > /dev/null; then
                for vhost in "$domain_conf_folder"/*.conf; do
                    subdomain=$(basename "$vhost" .conf)
                    # Kiểm tra nếu subdomain không phải domain chính
                    if [[ "$subdomain" != "$domain" ]]; then
                        # Kiểm tra độ dài file vhost
                        vhost_length=$(wc -c < "$vhost")
                        if (( vhost_length > 200 )); then
                            # Thêm vào danh sách park domain
                            echo "$subdomain" >> "$output_file"
                            
                            # Kiểm tra nếu vhost có auth_basic_user_file
                            if grep -qx "include /etc/nginx/conf/deny-script-writeable-folder.conf;" "$vhost"; then
                                # Nếu có auth_basic_user_file, thêm ** vào
                                sed -i "/^$subdomain$/s/$/&**/" "$output_file"
                            fi
                        fi
                    fi
                done
            fi
        fi
    done < "$klaoxcy_file"
fi

# Kiểm tra và thông báo kết quả
if [[ -s "$output_file" ]]; then
    cat "$output_file" >> /etc/dsnvps/.tmp/checkallwebsites_with_status
fi
#####################################################################
echo "========================================================================="
echo "Sử dụng chức năng này để ALLOW/DENY chạy script trong writable folder"
echo "-------------------------------------------------------------------------"
echo "Folder:uploads,images,cache,media,logs,tmp - Script: PHP,PL,PY,JSP,SH,CGI "
echo "-------------------------------------------------------------------------"
echo "Edit rules tại: /etc/nginx/conf/deny-script-writeable-folder.conf"
echo "========================================================================="
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checkallwebsites_with_status
echo "Danh sách Website & Park domains trên server: | ** : Config đang BẬT"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${danh_sach_website[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${danh_sach_website[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//')
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

