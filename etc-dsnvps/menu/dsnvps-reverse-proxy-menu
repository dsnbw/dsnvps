#!/bin/bash
. /root/dsnvps.conf
# Anti-debug removed

#################################################################
## Kiểm tra websocket.conf trong nginx.conf
#################################################################
NGINX_CONF="/etc/nginx/nginx.conf"
WEBSOCKET_LINE="include /etc/nginx/conf/websocket.conf;"
ANCHOR="real-ip-cloudflare.conf"
if [ ! -f /etc/nginx/conf/websocket.conf ]; then
    cp -f /etc/dsnvps/menu/inc/conf/websocket.conf /etc/nginx/conf/
fi
if ! grep -qF "websocket.conf" "$NGINX_CONF" 2>/dev/null; then
    cp -f "$NGINX_CONF" "/etc/dsnvps/.tmp/nginx.conf.bak.websocket" 2>/dev/null || true
    if grep -q "$ANCHOR" "$NGINX_CONF" 2>/dev/null; then
        sed -i "/$ANCHOR/a\\
	$WEBSOCKET_LINE" "$NGINX_CONF"
    else
        sed -i "/include \/etc\/nginx\/conf\.d\/\*\.conf;/i\\
	$WEBSOCKET_LINE" "$NGINX_CONF"
    fi
    if ! nginx -t 2>/dev/null; then
        [ -f "/etc/dsnvps/.tmp/nginx.conf.bak.websocket" ] && cp -f "/etc/dsnvps/.tmp/nginx.conf.bak.websocket" "$NGINX_CONF"
    fi
fi

while true; do
/etc/dsnvps/menu/dsnvps-menu-all-function 
    echo "========================================================================="
    echo "                   QUẢN LÝ REVERSE DOMAIN PROXY"
    echo "========================================================================="
    echo "1. Thêm Reverse Proxy Domain"
    echo "2. List Domains"
    echo "3. Xem chi tiết"
    echo "4. Chỉnh sửa (Edit)"
    echo "5. Hướng dẫn sử dụng"
    echo "========================================================================="
    read -p "Nhập lựa chọn [0 -Thoát]: " choice
    choice=$(echo "$choice" | tr -d ' \t\r\n')
    case $choice in
        1) 
            /etc/dsnvps/menu/dsnvps-them-website-reveser-proxy
            ;;
        2) 
            #clear
            /etc/dsnvps/menu/dsnvps-list-reverse-proxy-domain
            ;;
        3) 
           # clear
            /etc/dsnvps/menu/dsnvps-xem-chi-tiet-reverse-domain
            ;;
        4) 
            #clear
            /etc/dsnvps/menu/dsnvps-edit-reverse-proxy-domain
            ;;
        5) 
            clear
            /etc/dsnvps/menu/dsnvps-huong-dan-su-dung-reverse-proxy-thong-bao
            ;;
0) clear; exit 0;;
        *) 
			echo "========================================================================="
            echo "Lựa chọn không hợp lệ."
            sleep 2
			clear && /etc/dsnvps/menu/dsnvps-reverse-proxy-menu
            ;;
    esac
done
