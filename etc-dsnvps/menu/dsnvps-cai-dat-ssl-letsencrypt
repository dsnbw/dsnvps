#!/bin/bash
# Khởi tạo script với Bash, không dùng set -e để hiển thị lỗi chi tiết
# - Mục đích: Cho phép script tiếp tục chạy và báo lỗi rõ ràng khi gặp vấn đề
# - Cách hoạt động: Kiểm tra lỗi thủ công bằng $? thay vì thoát sớm
# - Kết quả: Dễ debug, thông báo lỗi khớp với script gốc

# Nạp file cấu hình DSNVPS
# - Mục đích: Lấy các biến như serverip, priport, mainsite, emailmanage
# - Cách hoạt động: Dùng lệnh `.` để nạp /root/dsnvps.conf
# - Kết quả: Các biến từ file conf sẵn sàng sử dụng
. /root/dsnvps.conf

# Source file check API để có thể sử dụng các function
if [ -f "/etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global" ]; then
    source /etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global
fi

# Khai báo biến hằng số
# - Mục đích: Định nghĩa đường dẫn và file tạm để dùng xuyên suốt
# - Cách hoạt động: Gán giá trị cố định cho thư mục tạm, file danh sách, và Nginx
# - Kết quả: Tăng tính dễ đọc và dễ bảo trì mã
TEMP_DIR="/etc/dsnvps/.tmp"
ACME_TMP="$TEMP_DIR/acme"
mkdir -p "$ACME_TMP"
DOMAIN_LIST="$ACME_TMP/90asx.txt"
COMBINED_LIST="$ACME_TMP/290asx.txt"
NGINX_CONF="/etc/nginx/conf.d"
HOME_DIR="/home"
BACKUP_SSL_DIR="/etc/dsnvps/Backup.Vhost.SSL"

# Tạo thư mục tạm và thiết lập dọn dẹp tự động
# - Mục đích: Đảm bảo thư mục tạm tồn tại và được xóa khi script kết thúc
# - Cách hoạt động: Tạo /etc/dsnvps/.tmp/acme, dùng `trap` để xóa file tạm trong acme
# - Kết quả: Tránh xóa nhầm file log khác trong /etc/dsnvps/.tmp/
trap 'rm -rf "$ACME_TMP"/*' EXIT

# Xác định server IP và port
# - Mục đích: Lấy địa chỉ server để kiểm tra DNS
# - Cách hoạt động: Kiểm tra file domainquanly.conf, dùng $domainquanly hoặc $serverip:$priport
# - Kết quả: Biến serverip_priport chứa IP/port của server
serverip_priport=$([ -f /etc/dsnvps/domainquanly/domainquanly.conf ] && echo "$domainquanly" || echo "${serverip}:${priport}")

# Kiểm tra strace có chạy không
# - Mục đích: Ngăn script chạy nếu strace (công cụ debug) đang hoạt động
# - Cách hoạt động: Dùng `pgrep -x strace`, nếu có thì chờ lâu và thoát
# - Kết quả: Thoát nếu strace chạy, tránh xung đột
if pgrep -x strace >/dev/null; then
    echo "Vui lòng chờ."; sleep 21474836
    exit 1
fi

if ! systemctl is-active --quiet nginx; then
    clear
    echo "========================================================================"
    echo "Dịch vụ Nginx không chạy"
    echo "------------------------------------------------------------------------"
    echo "DSNVPS đang cố gắng khởi động lại..."
    sleep 1
    
    # Thử khởi động lại Nginx
    /etc/dsnvps/menu/inc/start-nginx-service > /dev/null 2>&1
    
    # 2. Kiểm tra lại lần cuối sau khi đã thử khởi động
    if ! systemctl is-active --quiet nginx; then
        clear
        echo "========================================================================"
        echo "LỖI: DSNVPS không thể khởi động dịch vụ Nginx!"
        echo "------------------------------------------------------------------------"
        echo "Thông tin lỗi chi tiết:"
        echo "------------------------------------------------------------------------"
        nginx -t
        echo "------------------------------------------------------------------------"
        echo "Vui lòng xử lý lỗi cấu hình trên trước khi tiếp tục."
        echo "========================================================================"
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    fi
    
    echo "Khởi động Nginx thành công... please wait"
    sleep 2
    clear
    
fi

# --- CODE PHÍA DƯỚI CỦA BẠN BẮT ĐẦU TỪ ĐÂY ---

# Xóa nội dung file tạm
# - Mục đích: Đảm bảo file danh sách domain rỗng trước khi ghi
# - Cách hoạt động: Dùng `: >` để xóa nội dung file
# - Kết quả: File 90asx.txt, 290asx.txt sẵn sàng
: > "$DOMAIN_LIST"
: > "$COMBINED_LIST"

# Thu thập domain thông thường
# - Mục đích: Lấy domain từ file cấu hình Nginx, trừ dsnvps.demo
# - Cách hoạt động: Duyệt /etc/nginx/conf.d/*.conf, kiểm tra /home/$domain/public_html
# - Kết quả: Lưu danh sách domain vào 90asx.txt
for conf in "$NGINX_CONF"/*.conf; do
    [[ -f "$conf" ]] || continue
    domain=$(basename "$conf" .conf)
    [[ -d "$HOME_DIR/$domain/public_html" && "$domain" != "dsnvps.demo" ]] && echo "$domain" >> "$DOMAIN_LIST"
done

# Thu thập subsite và kiểm tra SSL
# - Mục đích: Liệt kê subsite WordPress Multisite, thêm ** nếu có SSL, tránh lặp và trùng sub-domain
# - Cách hoạt động: Tìm domain có wp-config.php, kiểm tra multisite.conf.d, thêm subsite nếu không là sub-domain và chưa có trong klaixx.txt
# - Kết quả: File klaixx.txt chứa subsite hợp lệ, không lặp
: > "$ACME_TMP/klaixx.txt"
for vhost in "$NGINX_CONF"/*.conf; do
    [[ -f "$vhost" ]] || continue
    domain=$(basename "$vhost" .conf)
    domain_home="$HOME_DIR/$domain/public_html"
    if [[ -f "$domain_home/wp-config.php" ]]; then
        multisite_folder="$HOME_DIR/$domain/multisite.conf.d"
        if [[ -d "$multisite_folder" && $(ls -A "$multisite_folder"/*.conf 2>/dev/null) ]]; then
            for subsite_vhost in "$multisite_folder"/*.conf; do
                [[ -f "$subsite_vhost" ]] || continue
                subsite=$(basename "$subsite_vhost" .conf)
                # Chỉ thêm subsite nếu không có Vhost tại /etc/nginx/conf.d/<subsite>.conf và chưa có trong klaixx.txt
                if [[ ! -f "$NGINX_CONF/$subsite.conf" && ! $(grep -Fx "$subsite" "$ACME_TMP/klaixx.txt") ]]; then
                    if grep -q "/etc/nginx/auth-acme/$subsite/$subsite.crt" "$subsite_vhost" && grep -q "https://$subsite\$request_uri;" "$subsite_vhost"; then
                        echo "${subsite}**" >> "$ACME_TMP/klaixx.txt"
                    else
                        echo "$subsite" >> "$ACME_TMP/klaixx.txt"
                    fi
                fi
            done
        fi
    fi
done
# Gộp danh sách domain và subsite
# - Mục đích: Tạo file chứa tất cả domain/subsite để xử lý
# - Cách hoạt động: Nối 90asx.txt và klaixx.txt vào 290asx.txt
# - Kết quả: File 290asx.txt chứa danh sách đầy đủ, không lặp
cat "$DOMAIN_LIST" "$ACME_TMP/klaixx.txt" > "$COMBINED_LIST"

# Kiểm tra nếu không có domain
# - Mục đích: Thoát nếu không tìm thấy website
# - Cách hoạt động: Kiểm tra 290asx.txt rỗng, xóa file tạm, hiển thị thông báo
# - Kết quả: Thoát và gọi menu letsencrypt
if [[ ! -s "$COMBINED_LIST" ]]; then
    rm -rf "$ACME_TMP/90asx.txt" "$ACME_TMP/290asx.txt" "$ACME_TMP/klaixx.txt"
    clear
    echo "========================================================================="
    echo "Hiện tại bạn chưa thêm Website Vào Server !"
    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    exit
fi

# Kiểm tra cấu hình Nginx
# - Mục đích: Đảm bảo Nginx hợp lệ trước khi tiếp tục
# - Cách hoạt động: Chạy `nginx -t`, kiểm tra output có "oksuccessful" không
# - Kết quả: Thoát nếu Nginx lỗi, hiển thị trạng thái
rm -rf "$ACME_TMP/dsnvps.nginx.check*"
nginx -t 2>&1 | grep -v "ModSecurity-nginx" > "$ACME_TMP/dsnvps.nginx.check"
if [[ -f "$ACME_TMP/dsnvps.nginx.check" ]]; then
    awk '{print $NF}' "$ACME_TMP/dsnvps.nginx.check" | tr -d '\n' > "$ACME_TMP/dsnvps.nginx.check.word"
    if [[ $(cat "$ACME_TMP/dsnvps.nginx.check.word") != "oksuccessful" ]]; then
        rm -rf "$ACME_TMP/dsnvps.nginx.check*"
        echo "-------------------------------------------------------------------------"
        echo "Phát hiện lỗi ..."; sleep 3
        clear
        echo "========================================================================="
        echo "Nginx gặp lỗi. DSNVPS không thể chạy chức năng này !"
        echo "-------------------------------------------------------------------------"
        echo "Trạng thái Nginx: "
        echo "-------------------------------------------------------------------------"
        nginx -t
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit
    fi
fi

# Tạo thư mục backup Vhost SSL
# - Mục đích: Đảm bảo thư mục lưu backup Vhost tồn tại
# - Cách hoạt động: Tạo /etc/dsnvps/Backup.Vhost.SSL
# - Kết quả: Thư mục sẵn sàng lưu backup
if [[ ! -d "$BACKUP_SSL_DIR" ]]; then
    mkdir -p "$BACKUP_SSL_DIR"
fi

# Tạo thư mục tạm nếu chưa có
# - Mục đích: Đảm bảo thư mục tạm tồn tại
# - Cách hoạt động: Tạo /etc/dsnvps/.tmp/acme
# - Kết quả: Thư mục tạm sẵn sàng
if [[ ! -d "$ACME_TMP" ]]; then
    mkdir -p "$ACME_TMP"
fi

# Cài acme.sh nếu chưa có
# - Mục đích: Cài công cụ cấp chứng chỉ SSL Let's Encrypt
# - Cách hoạt động: Kiểm tra acme.sh, tải và cài nếu chưa có
# - Kết quả: Thoát và gọi menu nếu cài acme.sh
if [[ ! -f /root/.acme.sh/acme.sh ]]; then
    clear
    echo "========================================================================="
    echo "Cai dat tien ich Acme.Sh "
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."; sleep 3
    curl https://get.acme.sh | sh -s email="$emailmanage"
    if [[ $? -ne 0 ]]; then
        echo "Lỗi khi cài đặt acme.sh"
        exit 1
    fi
    acme.sh --set-default-ca --server letsencrypt
    sleep 3
    clear
    echo "========================================================================="
    echo "Cài đặt acme.sh hoàn thành"
    echo "-------------------------------------------------------------------------"
    echo "Bây giờ bạn có thể sử dụng chức năng cài đặt SSL cho website của mình."
    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    exit
fi

# Xóa file tạm cũ
# - Mục đích: Đảm bảo không có dữ liệu cũ ảnh hưởng
# - Cách hoạt động: Xóa file liên quan đến danh sách website và SSL
# - Kết quả: File tạm được làm mới
rm -rf "$ACME_TMP/checkallwebsites_with_status" "$ACME_TMP/list_domain_SSL" "$ACME_TMP/check_lets"* "$ACME_TMP/thanh_cong_SSL" "$ACME_TMP/dsnvps-websitelist" "$ACME_TMP/checksite-list" "$ACME_TMP/dsnvps-replace"

# Tạo danh sách website trên server
# - Mục đích: Lấy danh sách domain từ Nginx để kiểm tra SSL
# - Cách hoạt động: Liệt kê *.conf, xóa .conf, loại bỏ $mainsite
# - Kết quả: File dsnvps-websitelist chứa danh sách domain
ls "$NGINX_CONF" > "$ACME_TMP/dsnvps-websitelist"
sed -i 's/\.conf//g' "$ACME_TMP/dsnvps-websitelist"
cat > "$ACME_TMP/dsnvps-replace" <<END
sed -i '/$mainsite/d' $ACME_TMP/dsnvps-websitelist
END
chmod +x "$ACME_TMP/dsnvps-replace"
"$ACME_TMP/dsnvps-replace"
if [[ $? -ne 0 ]]; then
    echo "Lỗi khi loại bỏ mainsite khỏi danh sách website"
    exit 1
fi
rm -rf "$ACME_TMP/dsnvps-replace"

# Tạo danh sách domain đã cài SSL
# - Mục đích: Xác định domain nào đã cài SSL để thêm **
# - Cách hoạt động: Kiểm tra file .crt và grep trong cấu hình Nginx
# - Kết quả: File thanh_cong_SSL chứa domain đã cài SSL
sowebsitetrenserver=$(wc -l < "$ACME_TMP/dsnvps-websitelist")
domainlist=$(cat "$ACME_TMP/dsnvps-websitelist")
: > "$ACME_TMP/thanh_cong_SSL"
for domain in $domainlist; do
    if [[ -f "/etc/nginx/auth-acme/$domain/$domain.crt" ]]; then
        grep "/etc/nginx/auth-acme/$domain/$domain.crt" "$NGINX_CONF/$domain.conf" >/dev/null 2>&1
        if [[ $? -eq 0 ]]; then
            echo "$domain" >> "$ACME_TMP/thanh_cong_SSL"
        fi
    fi
done

# Gộp danh sách website với trạng thái SSL
# - Mục đích: Tạo danh sách domain/subsite với ** cho SSL
# - Cách hoạt động: So sánh 290asx.txt với thanh_cong_SSL, thêm **
# - Kết quả: File checkallwebsites_with_status chứa danh sách với **
if [[ -s "$ACME_TMP/thanh_cong_SSL" ]]; then
    : > "$ACME_TMP/checkallwebsites_with_status"
    while read -r domain; do
        if grep -Fxq "$domain" "$ACME_TMP/thanh_cong_SSL"; then
            echo "$domain**" >> "$ACME_TMP/checkallwebsites_with_status"
        else
            echo "$domain" >> "$ACME_TMP/checkallwebsites_with_status"
        fi
    done < "$COMBINED_LIST"
else
    mv "$COMBINED_LIST" "$ACME_TMP/checkallwebsites_with_status"
fi

# Thu thập park domain và kiểm tra SSL
# - Mục đích: Liệt kê park domain, thêm ** nếu có SSL
# - Cách hoạt động: Tìm domain trong Nginx, kiểm tra conf.d/*.conf
# - Kết quả: File klaoxcypark chứa park domain, thêm ** nếu có SSL
: > "$ACME_TMP/klaoxcy"
for vhost in "$NGINX_CONF"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$HOME_DIR/$domain/public_html"
    [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]] && echo "$domain" >> "$ACME_TMP/klaoxcy"
done
if [[ ! -s "$ACME_TMP/klaoxcy" ]]; then
    clear
    echo "========================================================================="
    echo "Không tìm thấy website trên server"
    echo "-------------------------------------------------------------------------"
    echo "Bạn cần thêm Website Vào Server trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi
: > "$ACME_TMP/klaoxcypark"
while IFS= read -r domain; do
    domain_conf_folder="$HOME_DIR/$domain/conf.d"
    if [[ "$domain" != "$mainsite" && -d "$domain_conf_folder" ]]; then
        if compgen -G "$domain_conf_folder"/*.conf >/dev/null; then
            for vhost in "$domain_conf_folder"/*.conf; do
                subdomain=$(basename "$vhost" .conf)
                if [[ "$subdomain" != "$domain" ]]; then
                    vhost_length=$(wc -c < "$vhost")
                    if (( vhost_length > 200 )); then
                        echo "$subdomain" >> "$ACME_TMP/klaoxcypark"
                        grep -q "/etc/nginx/auth-acme/$domain/$domain.crt" "$vhost" && sed -i "/^$subdomain$/s/$/**/" "$ACME_TMP/klaoxcypark"
                    fi
                fi
            done
        fi
    fi
done < "$ACME_TMP/klaoxcy"
[[ -s "$ACME_TMP/klaoxcypark" ]] && cat "$ACME_TMP/klaoxcypark" >> "$ACME_TMP/checkallwebsites_with_status"

# Hiển thị danh sách website
# - Mục đích: Hiển thị domain/subsite/park domain với ** cho SSL
# - Cách hoạt động: Đọc checkallwebsites_with_status, hiển thị 2 cột
# - Kết quả: Menu chọn website khớp output gốc
echo "========================================================================="
echo "Sử dụng chức năng này cài đặt FreeSSL cho Website, Subsite & Park domain"
echo "-------------------------------------------------------------------------"
echo "========================================================================="
echo "Websites, Subsites & Park domains trên server: | ** : Đang dùng FreeSSL"
echo "-------------------------------------------------------------------------"
mapfile -t danh_sach_website < "$ACME_TMP/checkallwebsites_with_status"
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))
for ((i=0; i<half; i++)); do
    left_index=$((i + 1))
    right_index=$((half + i + 1))
    left_db="${danh_sach_website[i]:- }"
    if (( right_index <= total )); then
        right_db="${danh_sach_website[right_index-1]}"
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done

# Chọn website
# - Mục đích: Cho phép người dùng chọn domain để cài SSL
# - Cách hoạt động: Đọc input, kiểm tra hợp lệ, gán website
# - Kết quả: Biến $website chứa domain được chọn
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: "
    read -r selection
    if [[ -z "$selection" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$selection" == "0" ]]; then
        clear; clear
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit
    elif [[ "$selection" =~ ^[0-9]+$ && $selection -ge 1 && $selection -le ${#danh_sach_website[@]} ]]; then
        website=$(echo "${danh_sach_website[selection-1]}" | sed 's/**$//')
        break
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

# Xác định domain redirect
# - Mục đích: Tạo biến website_redirect để kiểm tra DNS/SSL
# - Cách hoạt động: Bỏ www nếu có, thêm www nếu không
# - Kết quả: Biến $website_redirect chứa domain đối lập
if [[ "$website" == www.* ]]; then
    website_redirect="${website#www.}"
else
    website_redirect="www.$website"
fi

# Xóa file tạm Cloudflare
# - Mục đích: Đảm bảo không có dữ liệu Cloudflare cũ
# - Cách hoạt động: Xóa cloudflare.status*
# - Kết quả: File tạm sạch
rm -rf "$ACME_TMP/cloudflare.status*"

# Khởi tạo IP server
# - Mục đích: Lấy IP server để kiểm tra DNS
# - Cách hoạt động: Dùng ip, hostname -I, và dịch vụ check IP
# - Kết quả: Biến $server_ips chứa danh sách IP
command -v ip >/dev/null || apt-get install -y -qq iproute2
command -v host >/dev/null || apt-get install -y -qq bind9-host
server_ips=$(ip -4 addr show | awk '/inet / {print $2}' | cut -d/ -f1 | tr '\n' ' ')
[[ -z "$server_ips" ]] && server_ips=$(hostname -I)
echo "$server_ips" > "$ACME_TMP/akxiao"
sviasp=$(curl -4 -s --max-time 10 https://checkip.amazonaws.com || wget -4 -qO- http://ipecho.net/plain || curl -4 -s --max-time 10 https://ifconfig.me)
echo "$sviasp" >> "$ACME_TMP/akxiao"
server_ips=$(awk '{$1=$1}1' ORS=' ' "$ACME_TMP/akxiao")

# Hàm kiểm tra Cloudflare
# - Mục đích: Kiểm tra domain có dùng Cloudflare không
# - Cách hoạt động: Curl header, tìm "cloudflare"
# - Kết quả: Thoát nếu bật Cloudflare, thông báo OK nếu không
check_cloudflare() {
    local domain=$1
    echo "-------------------------------------------------------------------------"
    echo "=> Check $domain"; sleep 2
    curl -I -s "$domain" > "$ACME_TMP/cloudflare.status.$domain" 2>/dev/null
    if grep -qi cloudflare "$ACME_TMP/cloudflare.status.$domain"; then
        clear
        echo "========================================================================="
        echo "$domain đang BẬT CloudFlare Proxy"
        echo "-------------------------------------------------------------------------"
        echo "Bạn phải tắt CloudFlare trước khi sử dụng chức năng này."
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit
    fi
    echo ""
    echo "===> $domain Không BẬT CloudFlare Proxy. => [ OK ]"
    echo ""
}

# Hàm kiểm tra DNS
# - Mục đích: Kiểm tra domain trỏ về IP server
# - Cách hoạt động: Dùng host lấy IP domain, so sánh với IP server
# - Kết quả: Thoát nếu DNS sai, thông báo OK nếu đúng
check_dns() {
    local domain=$1
    rm -rf "$ACME_TMP/check_letsencrypt*.$domain"
    host -t A "$domain" | grep -o '[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}' > "$ACME_TMP/check_letsencrypt.$domain" 2>/dev/null
    if [[ $(wc -c < "$ACME_TMP/check_letsencrypt.$domain") -lt 5 ]]; then
        clear
        echo "========================================================================="
        echo "Bạn phải trỏ $domain tới địa chỉ IP của server"
        echo "-------------------------------------------------------------------------"
        echo "trước khi thực hiện chức năng này."
        echo "-------------------------------------------------------------------------"
        echo "Kết quả kiểm tra: "
        echo "-------------------------------------------------------------------------"
        host -t A "$domain"
        rm -rf "$ACME_TMP/check_letsencrypt*"
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit
    fi
    website_ips=$(cat "$ACME_TMP/check_letsencrypt.$domain" | tr -s ' ')
    found_match=0
    for web_ip in $website_ips; do
        echo "Kiểm tra: $web_ip"
        if echo " $server_ips " | grep -q " $web_ip "; then
            echo "IP khớp: $web_ip"
            found_match=1
            break
        fi
    done
    if [[ $found_match -eq 0 ]]; then
        clear
        echo "========================================================================="
        echo "Bạn phải trỏ $domain tới địa chỉ IP của server"
        echo "-------------------------------------------------------------------------"
        echo "trước khi thực hiện chức năng này."
        echo "-------------------------------------------------------------------------"
        echo "Kết quả kiểm tra: "
        echo "-------------------------------------------------------------------------"
        host -t A "$domain"
        rm -rf "$ACME_TMP/check_letsencrypt*"
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit
    fi
    echo "=> Check DNS : $domain ==> OK"
    echo "-------------------------------------------------------------------------"
    echo ""
}

