# Function để kiểm tra và xử lý domain/subdomain trong Cloudflare
check_and_handle_domain_in_cloudflare() {
    local website="$1"
    local global_ssl_api_email="$2"
    local global_ssl_api_token="$3"
    
    # Xác định domain chính và zone ID
    local main_domain
    local zone_id
    
    # Xác định domain chính dựa trên số dấu chấm
    # example.com -> example.com
    # www.example.com -> example.com  
    # sub.example.com -> example.com
    # sub.sub.example.com -> example.com
    # aiai.vultr.in -> vultr.in
    local dot_count
    dot_count=$(echo "$website" | grep -o '\.' | wc -l)
    
    if [ "$dot_count" -ge 2 ]; then
        # Có ít nhất 2 dấu chấm (subdomain), lấy 2 phần cuối
        main_domain=$(echo "$website" | awk -F '.' '{print $(NF-1)"."$NF}')
    else
        # Chỉ có 1 dấu chấm (domain chính)
        main_domain="$website"
    fi
    
    zone_id=$(get_zone_id_for_ssl "$main_domain" "$global_ssl_api_email" "$global_ssl_api_token")
    
    # Kiểm tra domain chính có tồn tại trong Cloudflare không
    if [ -z "$zone_id" ]; then
        echo "========================================================================="
        echo "Domain $main_domain không thuộc tài khoản Cloudflare đã cấu hình trên VPS."
        echo "-------------------------------------------------------------------------"
        echo "Bạn có muốn tiếp tục cài đặt SSL cho $website không?"
		echo "-------------------------------------------------------------------------"
        echo "(SSL sẽ được cài đặt mà không sử dụng Cloudflare API)"
        echo "-------------------------------------------------------------------------"
        echo "1. Có, tiếp tục cài đặt SSL"
        echo "0. Không, thoát"
        echo "========================================================================="
        
        while true; do
            read -p "Lựa chọn của bạn: " cf_skip_choice
            case $cf_skip_choice in
                1)
                    echo "==> Tiếp tục cài đặt SSL mà không sử dụng Cloudflare API"
                    return 1
                    ;;
0) clear; exit 0;;
                *)
                    echo "Lựa chọn không hợp lệ. Vui lòng chọn 1 hoặc 0"
                    ;;
            esac
        done
    fi
    
    # Kiểm tra domain/subdomain có tồn tại trong Cloudflare không
    local dns_response
    if [ -n "$global_ssl_api_email" ]; then
        # Global API Key
        dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
             -H "X-Auth-Email: $global_ssl_api_email" \
             -H "X-Auth-Key: $global_ssl_api_token" \
             -H "Content-Type: application/json")
    else
        # API Token
        dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
             -H "Authorization: Bearer $global_ssl_api_token" \
             -H "Content-Type: application/json")
    fi
    
    # Kiểm tra xem có DNS record nào cho domain/subdomain này không
    if echo "$dns_response" | grep -q '"success":true' && echo "$dns_response" | grep -q '"result":\[.*\]' && ! echo "$dns_response" | grep -q '"result":\[\]'; then
        # Domain/subdomain đã tồn tại, kiểm tra IP và Proxy
        local current_ip
        local current_proxied
        current_ip=$(echo "$dns_response" | grep -o '"content":"[^"]*"' | head -1 | sed 's/"content":"//;s/"//')
        current_proxied=$(echo "$dns_response" | grep -o '"proxied":[^,]*' | head -1 | sed 's/"proxied"://;s/"//g')
        
        if [ -n "$current_ip" ]; then
            echo "========================================================================="
            echo "Domain/subdomain đã tồn tại trong Cloudflare"
            echo "-------------------------------------------------------------------------"
            echo "Domain: $website"
            echo "IP hiện tại: $current_ip"
            echo "Cloudflare Proxy: $current_proxied"
            echo "IP VPS: $serverip"
            echo "========================================================================="
            echo "Bạn muốn làm gì với domain này?"
            echo "-------------------------------------------------------------------------"
            echo "1. Giữ nguyên IP hiện tại, giữ nguyên Proxy status → Cài SSL"
            echo "2. Cập nhật IP về VPS, tắt Proxy → Cài SSL"
            echo "3. Cập nhật IP về VPS, bật Proxy → Cài SSL"
            echo "0. Thoát"
            echo "========================================================================="
            
            while true; do
                read -p "Lựa chọn của bạn: " ip_choice
                
                case $ip_choice in
                    1)
                        echo "==> Giữ nguyên cấu hình hiện tại và cài SSL"
                        return 0
                        ;;
                    2)
                        echo "==> Cập nhật IP về VPS, tắt Proxy và cài SSL"
                        update_dns_record "$website" "$zone_id" "$global_ssl_api_email" "$global_ssl_api_token" false
                        return 0
                        ;;
                    3)
                        echo "==> Cập nhật IP về VPS, bật Proxy và cài SSL"
                        update_dns_record "$website" "$zone_id" "$global_ssl_api_email" "$global_ssl_api_token" true
                        return 0
                        ;;
0) clear; exit 0;;
                    *)
                        echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2, 3 hoặc 0"
                        ;;
                esac
            done
        fi
    else
        # Domain/subdomain chưa tồn tại, hỏi có tạo không
        echo "========================================================================="
        echo "Subdomain $website chưa tồn tại trong tài khoản Cloudflare"
        echo "-------------------------------------------------------------------------"
        echo "Domain chính $main_domain tồn tại trong Cloudflare"
        echo "========================================================================="
        echo "Bạn có muốn tạo subdomain $website trong Cloudflare không?"
        echo "-------------------------------------------------------------------------"
        echo "1. Có, tạo subdomain và trỏ về IP VPS - $serverip"
        echo "2. Không, chỉ cài SSL mà không tạo subdomain"
        echo "0. Thoát"
        echo "========================================================================="
        
        while true; do
            read -p "Lựa chọn của bạn: " create_choice
            
            case $create_choice in
                1)
                    echo "========================================================================="
                    echo "Bạn muốn bật Cloudflare Proxy cho subdomain $website không?"
                    echo "-------------------------------------------------------------------------"
                    echo "1. Có, tạo subdomain, trỏ IP và BẬT Proxy"
                    echo "2. Có, tạo subdomain, trỏ IP và TẮT Proxy"
                    echo "0. Quay lại"
                    echo "========================================================================="
                    
                    while true; do
                        read -p "Lựa chọn của bạn: " proxy_choice
                        
                        case $proxy_choice in
                            1)
                                echo "==> Tạo subdomain với Proxy BẬT"
                                create_dns_record "$website" "$zone_id" "$global_ssl_api_email" "$global_ssl_api_token" true
                                return 0
                                ;;
                            2)
                                echo "==> Tạo subdomain với Proxy TẮT"
                                create_dns_record "$website" "$zone_id" "$global_ssl_api_email" "$global_ssl_api_token" false
                                return 0
                                ;;
                            0)
                                break
                                ;;
                            *)
                                echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2 hoặc 0"
                                ;;
                        esac
                    done
                    ;;
                2)
                    echo "==> Chỉ cài SSL mà không tạo subdomain"
                    return 0
                    ;;
0) clear; exit 0;;
                *)
                    echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2 hoặc 0"
                    ;;
            esac
        done
    fi
}

# Function cập nhật DNS record
update_dns_record() {
    local domain="$1"
    local zone_id="$2"
    local api_email="$3"
    local api_token="$4"
    local proxied="$5"
    
    # Lấy record ID
    local record_id
    if [ -n "$api_email" ]; then
        # Global API Key
        record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${domain}" \
             -H "X-Auth-Email: $api_email" \
             -H "X-Auth-Key: $api_token" \
             -H "Content-Type: application/json" | \
             grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//')
    else
        # API Token
        record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${domain}" \
             -H "Authorization: Bearer $api_token" \
             -H "Content-Type: application/json" | \
             grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//')
    fi
    
    if [ -n "$record_id" ]; then
        # Cập nhật DNS record
        local update_response
        if [ -n "$api_email" ]; then
            # Global API Key
            update_response=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id" \
                 -H "X-Auth-Email: $api_email" \
                 -H "X-Auth-Key: $api_token" \
                 -H "Content-Type: application/json" \
                 -d '{"type":"A","name":"'$domain'","content":"'$serverip'","ttl":1,"proxied":'$proxied'}')
        else
            # API Token
            update_response=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id" \
                 -H "Authorization: Bearer $api_token" \
                 -H "Content-Type: application/json" \
                 -d '{"type":"A","name":"'$domain'","content":"'$serverip'","ttl":1,"proxied":'$proxied'}')
        fi
        
        if echo "$update_response" | grep -q '"success":true'; then
            echo "==> Đã cập nhật domain $domain thành công"
            echo "==> IP: $serverip"
            echo "==> Proxy: $proxied"
        else
            echo "==> Không thể cập nhật domain $domain"
        fi
    fi
}

