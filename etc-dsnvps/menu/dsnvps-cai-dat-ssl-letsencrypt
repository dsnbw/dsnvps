# Function kiểm tra tính hợp lệ của Cloudflare API
test_cloudflare_api() {
    local api_email="$1"
    local api_token="$2"
    
    if [ -n "$api_email" ]; then
        # Global API Key - test với endpoint user tokens
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
             -H "X-Auth-Email: $api_email" \
             -H "X-Auth-Key: $api_token" \
             -H "Content-Type: application/json" \
             --max-time 10)
    else
        # API Token - test với endpoint user tokens
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
             -H "Authorization: Bearer $api_token" \
             -H "Content-Type: application/json" \
             --max-time 10)
    fi
    
    # Kiểm tra response có chứa success:true không
    if echo "$response" | grep -q '"success":true'; then
        return 0  # API hợp lệ
    else
        return 1  # API không hợp lệ
    fi
}

# Function cấu hình acme.sh với Cloudflare API
configure_acme_cloudflare() {
    local api_email="$1"
    local api_token="$2"
    
    # File lưu cấu hình hiện tại
    local config_file="/etc/dsnvps/.acme-cloudflare-config"
    
    # Đọc cấu hình hiện tại
    local current_config=""
    if [ -f "$config_file" ]; then
        current_config=$(cat "$config_file")
    fi
    
    # Tạo cấu hình mới
    local new_config=""
    if [ -n "$api_email" ]; then
        new_config="EMAIL:$api_email|KEY:$api_token"
    else
        new_config="TOKEN:$api_token"
    fi
    
    # So sánh cấu hình
    if [ "$current_config" != "$new_config" ]; then
        echo "==> Cập nhật cấu hình acme.sh với Cloudflare API mới"
        
        # Test API trước khi cập nhật
        if test_cloudflare_api "$api_email" "$api_token"; then
            # Xóa cấu hình cũ
            unset CF_Email CF_Key CF_Token
            
            # Set cấu hình mới
            if [ -n "$api_email" ]; then
                export CF_Email="$api_email"
                export CF_Key="$api_token"
            else
                export CF_Token="$api_token"
            fi
            
            # Lưu cấu hình mới
            echo "$new_config" > "$config_file"
            
            echo "==> Đã cập nhật cấu hình acme.sh thành công"
        else
            echo "==> Lỗi: API Cloudflare không hợp lệ, không thể cập nhật acme.sh"
            return 1
        fi
    fi
}

# Hàm cài SSL
# - Mục đích: Cài chứng chỉ SSL cho domain
# - Cách hoạt động: Kiểm tra chứng chỉ tồn tại và thời hạn, cấp mới nếu cần, rồi cài đặt chứng chỉ, backup
# - Kết quả: Cài SSL hoặc thoát nếu lỗi
# Hàm cài SSL
# Hàm cài SSL
# Hàm cài SSL
install_ssl() {
    local domain=$1 vhost_path=$2 public_html=$3 is_subdomain=$4 mainwebsite=$5
    local conf_txt="$ACME_TMP/$domain.conf.txt"
    local ssl_conf="$ACME_TMP/SSL-$website.conf.txt"
    local conf_https="$ACME_TMP/$domain.conf_HTTPS"
    local home_domain="$HOME_DIR/${mainwebsite:-$domain}" # Sử dụng mainwebsite nếu có, nếu không dùng domain
    local cert_file="/root/.acme.sh/${domain}_ecc/$domain.cer"
    local random
    random=$(cat /dev/urandom | tr -dc 'a-z0-9' | head -c 5) # 5 ký tự ngẫu nhiên a-z, 0-9
    local acme_log="/tmp/acme_er_$random.log"

    # Tạo thư mục .well-known cho acme-challenge (cần cho Nginx, ngay cả khi dùng DNS-01)
    if [[ ! -d "$public_html/.well-known/acme-challenge" ]]; then
        mkdir -p "$public_html/.well-known/acme-challenge"
        chown -R nginx:nginx "$public_html/.well-known"
    fi

    # Tạo cấu hình .well-known cho Nginx
    rm -rf "$ACME_TMP/config.ssl.$domain.txt"
    cat > "$ACME_TMP/config.ssl.$domain.txt" <<END
# Config for Free SSL (LetEncrypt) - Do not Delete!
location ~ /.well-known {
    allow all;
    root $public_html;
}
END

    # Thêm .well-known vào file Vhost nếu chưa có
    (cd "$ACME_TMP" || exit 1
    grep "location ~ /.well-known {" "$vhost_path" >/dev/null 2>&1 || sed -i "/block.conf;/r config.ssl.${domain}.txt" "$vhost_path")

    # Khởi động lại Nginx
    /etc/dsnvps/menu/inc/re-start-nginx-service
    mkdir -p /etc/nginx/auth-acme/$domain
    rm -rf "$acme_log"

    if [[ $is_subdomain -eq 1 ]]; then
        # Kiểm tra chứng chỉ cho subdomain
        if /root/.acme.sh/acme.sh --list | grep -w "$domain" >/dev/null; then
            # Kiểm tra thời hạn chứng chỉ
            if [[ -f "$cert_file" ]]; then
                # Lấy ngày hết hạn và so sánh với 29 ngày
                expiry_date=$(openssl x509 -enddate -noout -in "$cert_file" | cut -d= -f2)
                if [[ -z "$expiry_date" ]]; then
                    echo "Lỗi: Không thể lấy ngày hết hạn từ chứng chỉ $cert_file" >> "$acme_log"
                    clear
                    echo "========================================================================="
                    echo "Quá trình kiểm tra chứng chỉ SSL cho $domain gặp lỗi."
                    echo "-------------------------------------------------------------------------"
                    echo "Nguyên nhân: Không thể lấy ngày hết hạn chứng chỉ."
                    echo "-------------------------------------------------------------------------"
                    echo "File log lỗi: $acme_log"
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit
                fi
                expiry_epoch=$(date -d "$expiry_date" +%s 2>/dev/null)
                if [[ $? -ne 0 ]]; then
                    echo "Lỗi: Định dạng ngày hết hạn không hợp lệ: $expiry_date" >> "$acme_log"
                    clear
                    echo "========================================================================="
                    echo "Quá trình kiểm tra chứng chỉ SSL cho $domain gặp lỗi."
                    echo "-------------------------------------------------------------------------"
                    echo "Nguyên nhân: Định dạng ngày hết hạn không hợp lệ."
                    echo "-------------------------------------------------------------------------"
                    echo "File log lỗi: $acme_log"
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit
                fi
                current_epoch=$(date +%s)
                days_left=$(( (expiry_epoch - current_epoch) / 86400 )) # Số ngày còn lại
                if [[ ! "$days_left" =~ ^[0-9]+$ ]]; then
                    echo "Lỗi: Không thể tính số ngày còn lại cho chứng chỉ $domain" >> "$acme_log"
                    clear
                    echo "========================================================================="
                    echo "Quá trình kiểm tra chứng chỉ SSL cho $domain gặp lỗi."
                    echo "-------------------------------------------------------------------------"
                    echo "Nguyên nhân: Không thể tính số ngày còn lại."
                    echo "-------------------------------------------------------------------------"
                    echo "File log lỗi: $acme_log"
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit
                fi
                if [[ $days_left -gt 29 ]]; then
                    echo "========================================================================="
                    echo "Chứng chỉ cho $domain còn hiệu lực ($days_left ngày), bắt đầu cài đặt..."
                    echo "-------------------------------------------------------------------------"
                    # Bỏ qua --issue, chạy --installcert
                    /root/.acme.sh/acme.sh --installcert -d "$domain" \
                        --keypath /etc/nginx/auth-acme/$domain/$domain.key \
                        --capath /etc/nginx/auth-acme/$domain/$domain.ca \
                        --fullchainpath /etc/nginx/auth-acme/$domain/$domain.crt \
                        --reloadcmd "service nginx force-reload" 2>&1 | tee -a "$acme_log"
                    if [[ $? -ne 0 ]]; then
                        clear
                        echo "========================================================================="
                        echo "Quá trình cài đặt chứng chỉ SSL cho $domain gặp lỗi."
                        echo "-------------------------------------------------------------------------"
                        echo "Nguyên nhân có thể:"
                        echo "-------------------------------------------------------------------------"
                        grep -E "ERROR|error|failed" "$acme_log" | head -n 3 || echo "Không tìm thấy chi tiết lỗi cụ thể."
                        echo "-------------------------------------------------------------------------"
                        echo "File log lỗi: $acme_log"
                        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                        exit
                    fi
                    sleep 6
                else
                    # Chứng chỉ sắp hết hạn, cấp mới
                    echo "========================================================================="
                    echo "Chứng chỉ cho $domain sắp hết hạn ($days_left ngày), cấp mới..."
                    echo "-------------------------------------------------------------------------"
                    if [[ -f /etc/dsnvps/ssl-cloudflare-api-global.conf ]]; then
                        # Cấu hình acme.sh với Cloudflare API
                        source /etc/dsnvps/ssl-cloudflare-api-global.conf
                        configure_acme_cloudflare "$global_ssl_api_email" "$global_ssl_api_token"
                        /root/.acme.sh/acme.sh --issue -d "$domain" --dns dns_cf 2>&1 | tee -a "$acme_log"
                    else
                        /root/.acme.sh/acme.sh --issue --nginx -d "$domain" -w "$public_html" 2>&1 | tee -a "$acme_log"
                    fi
                    if [[ $? -ne 0 ]]; then
                        clear
                        echo "========================================================================="
                        echo "Quá trình cấp chứng chỉ SSL cho $domain gặp lỗi."
                        echo "-------------------------------------------------------------------------"
                        echo "Nguyên nhân có thể:"
                        echo "-------------------------------------------------------------------------"
                        grep -E "ERROR|error|failed" "$acme_log" | head -n 3 || echo "Không tìm thấy chi tiết lỗi cụ thể."
                        echo "-------------------------------------------------------------------------"
                        echo "File log lỗi: $acme_log"
                        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                        exit
                    fi
                    sleep 6
                    /root/.acme.sh/acme.sh --installcert -d "$domain" \
                        --keypath /etc/nginx/auth-acme/$domain/$domain.key \
                        --capath /etc/nginx/auth-acme/$domain/$domain.ca \
