#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed


rm -rf /etc/dsnvps/.tmp/checkredis

upredis=$(/bin/systemctl status redis-server.service | grep running | grep -v not | wc -l);

if [ "$upredis" -lt 1 ]; then
redis-cli ping 2> /etc/dsnvps/.tmp/checkredis
else
redis-cli ping > /etc/dsnvps/.tmp/checkredis
fi
redistt=`cat /etc/dsnvps/.tmp/checkredis`
if [ -f /etc/dsnvps/.tmp/checkredis ] && [ "$redistt" = "PONG" ]; then
checkokie=okie
fi




if [ "$checkokie" == "okie" ]; then
echo "========================================================================="
echo "Chức năng này sẽ kiểm tra trạng thái redis trong 30 giây." 
echo "-------------------------------------------------------------------------"
echo "Sau đó sẽ tự động quay trở lại quản lý redis cache menu."
echo "-------------------------------------------------------------------------"
echo "Sau khi nhấn [ enter ], bạn truy cập website đã bật redis và nhìn trạng  "
echo "-------------------------------------------------------------------------"
echo "thái redis cache dưới dòng này "
echo "========================================================================="
read -p "Nhấn [enter] để bắt đầu kiểm tra ..."
timeout 30 redis-cli monitor
clear
echo "========================================================================="
echo "Kiểm tra redis hoàn thành !"
echo "-------------------------------------------------------------------------"
echo "Redis cache đang hoạt động"
/etc/dsnvps/menu/dsnvps-redis-menu
else
echo "========================================================================="
echo "Redis cache đang bị vô hiệu hóa."
echo "-------------------------------------------------------------------------"
echo "Bạn phải bật redis cache trước khi sử dụng chức năng này."
/etc/dsnvps/menu/dsnvps-redis-menu
exit
fi
