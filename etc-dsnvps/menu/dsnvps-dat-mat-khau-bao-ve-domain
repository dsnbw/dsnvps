home_dir="/home"
output_file="/etc/dsnvps/.tmp/checkallwebsites"

> "$output_file"

for vhost_file in "$vhost_dir"/*.conf; do
    domainc=$(basename "$vhost_file" .conf)

    # Bỏ qua domain dsnvps.demo
    if [[ "$domainc" == "dsnvps.demo" ]]; then
        continue
    fi

    # Kiểm tra nếu thư mục /home/domain tồn tại
    if [[ -d "$home_dir/$domainc" ]]; then
        echo "$domainc" >> "$output_file"
    fi
done

# Kiểm tra nếu file output không có domain nào
if [[ ! -s "$output_file" ]]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website Vào Server !"
        /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
##################################################################
#Thêm *
# Thêm ** cho domain chính nếu có bảo vệ mật khẩu
ALL_WEBSITES_FILE="/etc/dsnvps/.tmp/checkallwebsites"
OUTPUT_FILE="/etc/dsnvps/.tmp/checkallwebsites_with_status"
> "$OUTPUT_FILE"

while read -r domain; do
    if [ -f "/etc/nginx/conf.d/$domain.conf" ] && grep -q "auth_basic_user_file" "/etc/nginx/conf.d/$domain.conf"; then
        echo "$domain**" >> "$OUTPUT_FILE"  # Thêm ** nếu domain chính có bảo vệ mật khẩu
    else
        echo "$domain" >> "$OUTPUT_FILE"
    fi
done < "$ALL_WEBSITES_FILE"

########################################################################################################
#Park Domains
######################################################
#lay Danh Sách Website Trên Server####################
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
# Xóa file cũ nếu tồn tại
> "$output_file"
# Duyệt qua tất cả các file .conf trong thư mục cấu hình Nginx
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"

    # Kiểm tra nếu domain có thư mục public_html trong /home và vhost trong /etc/nginx/conf.d/
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        echo "$domain" >> "$output_file"
    fi
done
# Kiểm tra nếu không có domain nào được tìm thấy
if [[ ! -s "$output_file" ]]; then
clear
echo "========================================================================= "
echo "Không tìm thấy website trên server"
echo "-------------------------------------------------------------------------"
echo "Bạn cần thêm Website Vào Server trước khi chạy chức năng này."
/etc/dsnvps/menu/dsnvps-tao-paidssl-menu
exit
fi
