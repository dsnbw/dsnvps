#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
. /etc/dsnvps/pwprotect.default
if [ ! -f /usr/local/bin/htpasswd.py ]; then
cp -r /etc/dsnvps/menu/inc/htpasswd.py /usr/local/bin/htpasswd.py
chmod +x /usr/local/bin/htpasswd.py
fi

######################################################################################
rm -rf /etc/dsnvps/.tmp/*hostingaz*
rm -rf /etc/dsnvps/.tmp/check*
rm -rf /etc/dsnvps/.tmp/checkallwebsites_with_status
rm -rf /etc/dsnvps/.tmp/checkallwebsites
mkdir -p /etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist 
sowebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
for website in $sowebsite 
do
if [ -f /etc/nginx/conf.d/$website.conf ]; then
if [ "$(grep .htpasswd /etc/nginx/conf.d/$website.conf)" == "auth_basic_user_file  /etc/nginx/.htpasswd;" ]; then
touch /etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz/$website
fi
fi
done
rm -rf /etc/dsnvps/.tmp/kland
SOURCE_DIR="/etc/dsnvps/.tmp/sitedangbatsqlinjecthostingaz"
OUTPUT_FILE="/etc/dsnvps/.tmp/kland"
> "$OUTPUT_FILE"
for file in "$SOURCE_DIR"/*; do
    # Check if it is a file
    if [ -f "$file" ]; then
        # Extract the file name and append it to the output file
        echo "$(basename "$file")" >> "$OUTPUT_FILE"
    fi
done
###################################################################################




###Check Nginx service I
UP=$(systemctl status nginx | grep running | grep -v not | wc -l);
if [ "$UP" -ne 1 ]; then
clear
echo "========================================================================"
echo "Dịch vụ Nginx không chạy"
echo "------------------------------------------------------------------------"
echo "DSNVPS đang cố gắng khởi động nó"
echo "------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 5 ; clear
/etc/dsnvps/menu/inc/start-nginx-service
