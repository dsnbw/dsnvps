#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
code=-`date |md5sum |cut -c '1-29'`
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -f /etc/dsnvps/.tmp/dsnvps-replace
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -l)" -lt "1" ]; then
rm -f /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website mới vào server !"; sleep 2
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
rm -f /etc/dsnvps/.tmp/checkallwebsites
numberfiles=$(find /home/$mainsite/private_html/backup/ -name "*.zip*" | wc -l)
if [ "$numberfiles" = "0" ]; then
clear
echo "========================================================================="
echo "Không tồn tại file backup trên server."; sleep 2
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -f /etc/dsnvps/.tmp/dsnvps-replace
listwebsite=$(cat /etc/dsnvps/.tmp/checkallwebsites)
rm -f /etc/dsnvps/.tmp/checkallwebsites
for checkweb in $listwebsite
do
rm -f /etc/dsnvps/.tmp/website_co_backup
if [ -f /home/$mainsite/private_html/backup/$checkweb/*.zip ]; then
find /home/$mainsite/private_html/backup/$checkweb/ -name '*.zip' -type f -exec basename {} \; > /etc/dsnvps/.tmp/website_co_backup
sodong=`cat /etc/dsnvps/.tmp/website_co_backup | wc -l`
if [ "$sodong" -gt 0 ]; then
echo "$checkweb" >> /etc/dsnvps/.tmp/checkwebsite-list
fi
rm -f /etc/dsnvps/.tmp/website_co_backup
fi
done
if [ ! -f /etc/dsnvps/.tmp/checkwebsite-list ]; then
clear
echo "========================================================================="
echo "DSNVPS không tìm thấy backup file của các website trên server !"; sleep 2
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
mapfile -t file_list < /etc/dsnvps/.tmp/checkwebsite-list
echo "========================================================================="
echo "Sử dụng chức năng này để copy backup của website tới root folder"
echo "-------------------------------------------------------------------------"
echo "của domain. Bạn sẽ dễ dàng wget backup để di chuyển sang server khác."
echo "========================================================================="
echo "========================================================================="
echo "Danh sách Website Có Backup Trên Server:"
echo "-------------------------------------------------------------------------"
total=${#file_list[@]}
half=$(( (total + 1) / 2 )) # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1)) # Số thứ tự bên trái
    right_index=$((half + i + 1)) # Số thứ tự bên phải
    left_site="${file_list[i]:- }" # Tên website bên trái
    if (( right_index <= total )); then # Hiển thị nếu bên phải còn giá trị
        right_site="${file_list[right_index-1]}" # Tên website bên phải
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_site" "$right_index." "$right_site"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_site"
    fi
done
# Chọn website
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: "
    read -r choice
    if [[ $choice == "0" ]]; then
        clear
        rm -f /etc/dsnvps/.tmp/checkwebsite-list
        /etc/dsnvps/menu/dsnvps-sao-luu
        exit
    fi
    # Kiểm tra input rỗng
    if [[ -z "$choice" ]]; then
        echo "-------------------------------------------------------------------------"
        echo "Lỗi: Bạn chưa nhập lựa chọn. Vui lòng nhập số từ 1-${#file_list[@]}"
        sleep 2 && tput cuu 4 && tput ed
        continue
    fi
    # Kiểm tra có phải số không và trong khoảng hợp lệ
    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#file_list[@]} )); then
        website=${file_list[choice-1]}
        break # Thoát vòng lặp khi có lựa chọn hợp lệ
    else
        echo "-------------------------------------------------------------------------"
        echo "Lỗi: Lựa chọn không hợp lệ. Vui lòng nhập số từ 1-${#file_list[@]}"
        sleep 2 && tput cuu 4 && tput ed
    fi
done
# Tìm tất cả file backup (có .zip trong tên)
backup_files=()
backup_dir="/home/$mainsite/private_html/backup/$website"
if [ -d "$backup_dir" ]; then
    temp_file="/tmp/backup_files_$$"
    find "$backup_dir" -name "*zip*" -type f > "$temp_file"
    while IFS= read -r file; do
        if [ -n "$file" ]; then
            backup_files+=("$file")
        fi
    done < "$temp_file"
    rm -f "$temp_file"
fi
# Kiểm tra nếu không có file backup
if [ ${#backup_files[@]} -eq 0 ]; then
    clear
    echo "========================================================================="
    echo "Không tìm thấy file backup nào trong thư mục:"
    echo "/home/$mainsite/private_html/backup/$website"
    rm -f /etc/dsnvps/.tmp/checkwebsite-list
    /etc/dsnvps/menu/dsnvps-sao-luu
    exit
fi
# Sắp xếp file theo thời gian tạo (mới nhất trước)
sorted_files=()
for file in "${backup_files[@]}"; do
    timestamp=$(stat -c %Y "$file")
    sorted_files+=("$timestamp:$file")
done
# Sắp xếp theo timestamp giảm dần
IFS=$'\n' sorted_files=($(sort -rn -t: -k1 <<< "${sorted_files[*]}"))
# Tạo danh sách file đã sắp xếp
final_files=()
for item in "${sorted_files[@]}"; do
    file_path="${item#*:}"
    final_files+=("$file_path")
done
# Nếu chỉ có 1 file, sử dụng trực tiếp
if [ ${#final_files[@]} -eq 1 ]; then
    selected_file="${final_files[0]}"
    filename=$(basename "$selected_file")
else
    # Hiển thị danh sách để user chọn
    echo "========================================================================="
    echo "DANH SÁCH FILE BACKUP CỦA: $website"
    echo "========================================================================="
    for i in "${!final_files[@]}"; do
        file_path="${final_files[i]}"
        file_time=$(date -r "$file_path" "+%H:%M %d/%m/%Y")
        if [ $i -eq 0 ]; then
            printf "%2d. Backup tạo lúc: %s (File mới nhất)\n" $((i+1)) "$file_time"
        else
            printf "%2d. Backup tạo lúc: %s\n" $((i+1)) "$file_time"
        fi
    done
    echo ""
    # Chọn file backup
    while true; do
        echo -n "Chọn file backup để copy [0 -Thoát]: "
        read -r backup_choice
        if [[ $backup_choice == "0" ]]; then
            clear
            rm -f /etc/dsnvps/.tmp/checkwebsite-list
            /etc/dsnvps/menu/dsnvps-sao-luu
            exit
        fi
        # Kiểm tra input rỗng
        if [[ -z "$backup_choice" ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Lỗi: Bạn chưa nhập lựa chọn. Vui lòng nhập số từ 1-${#final_files[@]}"
            sleep 2 && tput cuu 4 && tput ed
            continue
        fi
        if [[ $backup_choice =~ ^[0-9]+$ ]] && (( backup_choice >= 1 && backup_choice <= ${#final_files[@]} )); then
            selected_file="${final_files[$((backup_choice-1))]}"
            filename=$(basename "$selected_file")
            break
        else
            echo "-------------------------------------------------------------------------"
            echo "Lỗi: Lựa chọn không hợp lệ. Vui lòng nhập số từ 1-${#final_files[@]}"
            sleep 2 && tput cuu 4 && tput ed
        fi
    done
fi
# Thực hiện copy file backup
if [ -f "/home/$mainsite/private_html/backup/$website/$filename" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Tìm thấy file backup $website trên server"
    echo "-------------------------------------------------------------------------"
    echo "File backup được chọn: $filename"
    echo "-------------------------------------------------------------------------"
    file_time=$(date -r "/home/$mainsite/private_html/backup/$website/$filename" "+%H:%M %d/%m/%Y")
    echo "Thời gian tạo: $file_time"
    echo "-------------------------------------------------------------------------"
    echo "File backup sẽ được copy vào:"
    echo "-------------------------------------------------------------------------"
    echo "/home/$website/public_html/0-DSNVPS/"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ..."
    sleep 8
    # Tạo thư mục nếu chưa có
    if [ ! -d /home/$website/public_html/0-DSNVPS ]; then
        mkdir -p /home/$website/public_html/0-DSNVPS
        echo "" >/home/$website/public_html/0-DSNVPS/index.php
    fi
    # Copy file backup đã chọn
    yes | cp -rf "/home/$mainsite/private_html/backup/$website/$filename" "/home/$website/public_html/0-DSNVPS"
    clear
    echo "========================================================================="
    echo "Copy backup tới folder public_html của $website hoàn tất."
    echo "-------------------------------------------------------------------------"
    echo "File backup: $filename"
    echo "-------------------------------------------------------------------------"
    echo "Thời gian backup: $file_time"
    echo "-------------------------------------------------------------------------"
    echo "Link download file backup:"
    echo "-------------------------------------------------------------------------"
    echo "http://$website/0-DSNVPS/$filename"
    echo "========================================================================="
    rm -f /etc/dsnvps/.tmp/checkwebsite-list
    /etc/dsnvps/menu/dsnvps-sao-luu
else
    clear
    echo "========================================================================="
    echo "Không tìm thấy file backup $filename !"; sleep 2
    rm -f /etc/dsnvps/.tmp/checkwebsite-list
    /etc/dsnvps/menu/dsnvps-sao-luu
    exit
fi
