    FREE_SPACE=$(df -h /home | awk 'NR==2 {print $4}')
else
    FREE_SPACE=$(df -h / | awk 'NR==2 {print $4}')
fi
NUMBER=$(echo "$FREE_SPACE" | sed 's/[^0-9.]//g')
UNIT=$(echo "$FREE_SPACE" | sed 's/[0-9.]//g')
case "$UNIT" in
    "G") FULL_UNIT="GB" ;;
    "T") FULL_UNIT="TB" ;;
    "M") FULL_UNIT="MB" ;;
    "K") FULL_UNIT="KB" ;;
    *) FULL_UNIT="$UNIT" ;;
esac
