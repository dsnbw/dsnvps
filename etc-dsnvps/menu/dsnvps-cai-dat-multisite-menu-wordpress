#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
######Check Nginx Service I
UP=$(systemctl status nginx | grep running | grep -v not | wc -l);
if [ "$UP" -ne 1 ]; then
clear
echo "========================================================================"
echo "Dịch vụ Nginx không chạy"
echo "------------------------------------------------------------------------"
echo "DSNVPS đang cố gắng khởi động nó"
echo "------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 5 ; clear
/etc/dsnvps/menu/inc/start-nginx-service
clear
echo "========================================================================"
echo "Kiểm tra lại dịch vụ Nginx!"
echo "------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 5 ; clear
UP=$(systemctl status nginx | grep running | grep -v not | wc -l);
if [ "$UP" -ne 1 ]; then
clear
echo "========================================================================"
echo "DSNVPS không thể khởi động dịch vụ Nginx"
sleep 4 ;
	clear
	echo "========================================================================="
	echo "Xin lỗi, nginx đã dừng. Vui lòng BẬT lại trước khi sử dụng chức năng này."
	echo "------------------------------------------------------------------------"
	nginx -t
	dsnvps
else
clear
echo "========================================================================="
echo "Nginx started !"
dsnvps
fi
fi
######Check Nginx Service II
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word
if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` != "oksuccessful" ]; then
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
echo "-------------------------------------------------------------------------"
echo "Phát hiện lỗi ..."; sleep 3
clear
clear
echo "========================================================================="
echo "Nginx gặp lỗi. DSNVPS không thể chạy chức năng này !"
echo "-------------------------------------------------------------------------"
echo "Trạng thái Nginx: "
echo "-------------------------------------------------------------------------"
nginx -t
dsnvps
fi
fi

#prompt="Type in your choice: "
prompt="Nhập Lựa chọn của bạn [0 -Thoát]: "
options=( "Sub-Domain" "Sub-directories")
  echo "========================================================================="
echo "Lựa chọn cách cài đặt Wordpress Multisite"
  echo "-------------------------------------------------------------------------"
  echo "Sub-domain: http://username.website.com"
  echo "-------------------------------------------------------------------------"
  echo "Sub-directories: http://website.com/username"
echo "========================================================================="
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) multisitehow="subdomain"; break;;
    2) multisitehow="subdirectories"; break;;
    0) multisitehow="cancle"; break;;
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!";continue;;
    #*) echo "You typed wrong, Please type in the ordinal number on the list";continue;;
    esac  
done
###################################
#subdomain
###################################
if [ "$multisitehow" = "subdomain" ]; then
/etc/dsnvps/menu/dsnvps-setup-wp-multisite-sub-domain-wordpress
###################################
#Super Cache
###################################
elif [ "$multisitehow" = "subdirectories" ]; then
/etc/dsnvps/menu/dsnvps-setup-wp-multisite-sub-folder-wordpress
###################################
else
clear
exit 0
fi
