#!/bin/bash
if [ ! -f /usr/local/bin/htpasswd.py ]; then
cp -r /etc/dsnvps/menu/dsnvps-tao-mat-khau-bao-ve-folder.py /usr/local/bin/htpasswd.py
chmod 755 /usr/local/bin/htpasswd.py
fi
if [ ! -f /etc/dsnvps/pwprotect.default ]; then
echo "" > /etc/dsnvps/pwprotect.default
fi
if [ ! -d /etc/nginx/pwprotect ]; then
mkdir -p /etc/nginx/pwprotect
fi
if [ ! -f /etc/dsnvps/pwprotect.default ]; then
echo "" > /etc/dsnvps/pwprotect.default
fi
echo "========================================================================="
prompt="Lua chon cua ban (0 -Thoat)1: "
options=( "BAT/TAT Mat Khau Truy Cap Folder" "Tao Username Va Mat Khau Mac Dinh" "Huỷ bỏ")
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) luachonacction="taomatkhau"; break;;
    2) luachonacction="taomatkhaumacdinh"; break;;
    3) chonphpversion="cancle"; break;;
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    esac  
done

###################################
if [ "$luachonacction" = "taomatkhau" ]; then
/etc/dsnvps/menu/dsnvps-dat-mat-khau-bao-ve-folder-website
###################################
elif [ "$luachonacction" = "taomatkhaumacdinh" ]; then
/etc/dsnvps/menu/dsnvps-dat-mat-khau-bao-ve-folder-mac-dinh
###################################
else
clear
exit 0
fi
