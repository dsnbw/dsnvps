#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

if [ "$(crontab -l | awk 'NR==1 {print $1}')" == "" ]; then
clear
echo "========================================================================= "
echo "Bạn chưa tạo cronjob trên server!"
/etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
else
echo "========================================================================= "
read -r -p "Bạn muốn xóa hết các crontab đang chạy? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
echo "Chuẩn bị xóa..."
sleep 3
crontab -r
clear
echo "========================================================================= "
echo "DSNVPS hoàn tất xóa các cronjob hiện tại"
/etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
;;
    *)
        echo ""
        ;;
esac
clear 
echo "========================================================================="
echo "Hủy bỏ việc xóa hết cronjob!"
/etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
exit
fi
