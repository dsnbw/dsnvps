#!/bin/bash
rm -rf /etc/dsnvps/.tmp/check_crontab_acme
crontab -l > /etc/dsnvps/.tmp/check_crontab_acme
if [ "$(grep "acme.sh" /etc/dsnvps/.tmp/check_crontab_acme)" == "" ]; then
/root/.acme.sh/acme.sh --installcronjob >/dev/null 2>&1
if [ -f /bin/systemctl ]; then
/bin/systemctl restart crond.service >/dev/null 2>&1
else
systemctl restart crond >/dev/null 2>&1
fi
fi
