#!/bin/bash
#Phần thời gian (Time Specification)
declare -a days=("Chủ nhật" "Hai" "Ba" "Tư" "Năm" "Sáu" "Bảy")
echo "========================================================================="
echo "Ví dụ: 1 lệnh Cronjob:  * */5 * * * /home/check.sh  "
echo "-------------------------------------------------------------------------"
echo "Gồm 2 phần:"
echo "-------------------------------------------------------------------------"
echo "Phần thời gian: * */5 * * *"
echo "-------------------------------------------------------------------------"
echo "Phần lệnh thực thi: /home/check.sh"
echo "-------------------------------------------------------------------------"
echo "Trong chức năng này, chỉ cần nhập lệnh thực thi. Ví dụ: /home/check.sh"
echo "========================================================================="

echo_message() {
    echo "=========================================================================="
    echo "$1"
    echo "=========================================================================="
}

ask_for_time() {
    local description="$1"
    local var_name="$2"
    echo "-------------------------------------------------------------------------"
    while :; do
echo -n "Nhập $description (1-59): "
        read -r input_value
        if [[ -n "$input_value" ]] && [[ "$input_value" =~ ^[0-9]+$ ]] && [ "$input_value" -ge 1 ] && [ "$input_value" -le 59 ]; then
            eval $var_name="'$input_value'"
            return
        else
            tput cuu 1
            tput el
echo "Nhập sai. Nhập từ 1 đến 59 phút."
            sleep 4
            tput cuu 1
            tput el
        fi
    done
}

ask_for_hours() {
    local description="$1"
    local var_name="$2"
    echo "-------------------------------------------------------------------------"
    while :; do
echo -n "Nhập $description (0-23): "
        read -r input_value
        if [[ -n "$input_value" ]] && [[ "$input_value" =~ ^[0-9]+$ ]] && [ "$input_value" -ge 0 ] && [ "$input_value" -le 23 ]; then
            eval $var_name="'$input_value'"
            return
        else
            tput cuu 1
            tput el
echo "Nhập sai. Nhập 0 - 23 tương ứng 0 - 23h."
            sleep 4
            tput cuu 1
            tput el
        fi
    done
}

while :; do
    while :; do
echo -n "Nhập lệnh thực thi: "
        read command_or_script
        if [ -z "$command_or_script" ]; then
            tput cuu 1
            tput el
echo "Lỗi! Bạn chưa nhập lệnh thực thi."
            sleep 3
            tput cuu 1
            tput el
            continue
        fi
        break
    done

    script_path="$command_or_script"
echo_message "Bạn muốn thiết lập cronjob chạy:"
echo "1. N phút 1 lần"
echo "2. N giờ 1 lần"
echo "3. Ngày 1 lần vào giờ Y - phút Z"
echo "4. Tuần 1 lần vào thứ A - giờ Y - phút Z"
echo "5. Tháng 1 lần vào ngày B - giờ Y - phút Z"
echo "=========================================================================="
read -p "Lựa chọn của bạn [0 - Thoát]: " choice

    case $choice in
        1) # Moi bao nhieu phut
            ask_for_time "số phút" minutes
            if [ "$minutes" -eq 1 ]; then
                schedule="* * * * *"
            else
                schedule="*/$minutes * * * *"
            fi
            explain="Cronjob sẽ chạy mỗi $minutes phút một lần."

            ;;
        2) # Moi bao nhieu gio
            ask_for_hours "số giờ" hours
            schedule="0 */$hours * * *"
            explain="Cronjob sẽ chạy mỗi $hours giờ một lần."

            ;;
        3) # Hang ngay
            ask_for_time "phút" minute
            ask_for_hours "giờ" hour
            schedule="$minute $hour * * *"
            explain="Cronjob sẽ chạy hằng ngày vào lúc $hour giờ $minute phút."

            ;;
        4) # Hang tuan
            ask_for_time "phút" minute
            ask_for_hours "giờ" hour
            echo "-------------------------------------------------------------------------"
            echo "0 => CN | 1 => TH2 | 2 => TH3 | 3 => TH4 | 4 => TH5 | 5 => TH6 | 6 => TH7"
            echo "-------------------------------------------------------------------------"
            while :; do
               echo -n "Nhập thứ: "

                read -r day_of_week
                if [[ "$day_of_week" =~ ^[0-6]$ ]]; then
                    break
                else
                    tput cuu 1
                    tput el
                    echo "Nhập sai. Nhập số từ 0 - 6 tương ứng với các ngày trong tuần."

                    sleep 4
                    tput cuu 1
                    tput el
                fi
            done
            schedule="$minute $hour * * $day_of_week"
            explain="Cronjob sẽ chạy hằng tuần vào thứ ${days[$day_of_week]} lúc $hour giờ $minute phút."

            ;;
        5) # Hang thang
            ask_for_time "phút" minute
            ask_for_hours "giờ" hour
            echo "-------------------------------------------------------------------------"
            while :; do
               echo -n "Nhập ngày trong tháng (1-28): "

                read -r day_of_month
                if [[ "$day_of_month" =~ ^[1-9]$|^1[0-9]$|^2[0-8]$ ]]; then
                    break
                else
                    tput cuu 1
                    tput el
                    echo "Nhập sai. Nhập số từ 1 đến 28 tương ứng với ngày trong tháng."

                    sleep 4
                    tput cuu 1
                    tput el
                fi
            done
            schedule="$minute $hour $day_of_month * *"
            explain="Cronjob sẽ chạy hằng tháng vào ngày $day_of_month lúc $hour giờ $minute phút."

            ;;
0) clear; exit 0;;
        *)
            echo "Lựa chọn không hợp lệ. Vui lòng thử lại."

            sleep 3 && tput cuu 2 && tput ed
            continue
            ;;
    esac

    echo "-------------------------------------------------------------------------"
    echo -n "Ghi chú cho cronjob này (tùy chọn): "

    read comment

    cronjob="$schedule $script_path # $comment"
    echo_message "Đây là cronjob bạn muốn thêm:"

    echo "$cronjob"
    echo "-------------------------------------------------------------------------"
    echo "==> $explain"

    echo "========================================================================="
read -p "DSNVPS sẽ thêm cronjob này vào server? (y/N): " confirm

    if [[ "${confirm,,}" != "y" ]]; then
        clear
        echo "========================================================================= "
        echo "Hủy bỏ!"
        /etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
    fi
    sleep 4
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ..."
####################################################################
##Check Ban Pro
####################################################################
if [ ! -f /usr/bin/gxred ]; then
touch /etc/dsnvps/.tmp/ckla
/etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
clear
/etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
fi


###################################################################
###################################################################    
    
    (crontab -l 2>/dev/null; echo "$cronjob") | crontab -

    if crontab -l | grep -q "$script_path"; then
        clear
        echo "========================================================================= "
echo "Thêm Cronjob thành công."
echo "-------------------------------------------------------------------------"
echo "Danh sách Cronjob hiện tại:"
        echo "-------------------------------------------------------------------------"
        awk '{print NR". "$0}' /var/spool/cron/crontabs/root
        /etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
    else
        clear
        echo "========================================================================= "
echo "Thêm cronjob thất bại."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy thử chạy lại."
        /etc/dsnvps/menu/crontab/dsnvps-cronjob-menu
    fi
done
