# Hàm lấy danh sách website hợp lệ
get_valid_sites() {
    local result=()
    for conf in "$VHOST_DIR"/*.conf; do
        site=$(basename "$conf" .conf)
        [[ "$site" == "nginx" ]] && continue
        [[ "$site" == "dsnvps.demo" ]] && continue
        [ -d "/home/$site/public_html" ] && result+=("$site")
    done
    echo "${result[@]}"
}

# Hàm kiểm tra domain có V2Ray
is_v2ray_domain() {
    local site="$1"
    grep -Fx "include /etc/dsnvps/v2ray/*.conf;" "$VHOST_DIR/$site.conf" > /dev/null
}

# Hàm lấy domain V2Ray hiện tại
get_v2ray_domain() {
    for conf in "$VHOST_DIR"/*.conf; do
        site=$(basename "$conf" .conf)
        is_v2ray_domain "$site" && echo "$site" && return
    done
}

# In danh sách website
show_sites() {
    local sites=("$@")
    local total=${#sites[@]}
    local half=$(( (total + 1) / 2 ))

    for ((i = 0; i < half; i++)); do
        lidx=$((i + 1))
        ridx=$((i + half + 1))

        lsite="${sites[i]}"
        rsite="${sites[ridx-1]:-}"

        is_v2ray_domain "$lsite" && lsite="${lsite}**"
        [ -n "$rsite" ] && is_v2ray_domain "$rsite" && rsite="${rsite}**"

        if [ -n "$rsite" ]; then
            printf "%2d. %-25s %2d. %-25s\n" "$lidx" "$lsite" "$ridx" "$rsite"
        else
            printf "%2d. %-25s\n" "$lidx" "$lsite"
        fi
    done
}

# Hàm chèn V2Ray config
insert_v2ray_conf() {
    local site="$1"
    local vhost="$VHOST_DIR/$site.conf"
    cp "$vhost" "$BACKUP_DIR/$site.conf.bak"
    if grep "$BLOCK_CONF" "$vhost" > /dev/null; then
        sed -i "/\/etc\/nginx\/conf\/block.conf/a $V2RAY_CONF" "$vhost"
        if [ $? -eq 0 ]; then
            return 0
        else
            echo "Lỗi khi chèn dòng VLess VPN vào $vhost."
            mv "$BACKUP_DIR/$site.conf.bak" "$VHOST_DIR/$site.conf"
            return 1
        fi
    else
        echo "Không tìm thấy $BLOCK_CONF trong $vhost."
        mv "$BACKUP_DIR/$site.conf.bak" "$VHOST_DIR/$site.conf"
        return 1
    fi
}

# Hàm xóa V2Ray config
remove_v2ray_conf() {
    local site="$1"
    local vhost="$VHOST_DIR/$site.conf"
    cp "$vhost" "$BACKUP_DIR/$site.conf.bak"
    sed -i "/include \/etc\/dsnvps\/v2ray\/\*.conf;/d" "$vhost"
    if [ $? -eq 0 ] && ! grep -Fx "include /etc/dsnvps/v2ray/*.conf;" "$vhost" > /dev/null; then
        return 0
    else
    
        echo "Lỗi khi xóa cấu hình VLess VPN khỏi $vhost."
        mv "$BACKUP_DIR/$site.conf.bak" "$VHOST_DIR/$site.conf"
        return 1
    fi
}

