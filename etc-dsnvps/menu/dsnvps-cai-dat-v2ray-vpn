# Kiểm tra trạng thái chặn quảng cáo hiện tại
if grep -q "94.140.14.14" /usr/local/etc/v2ray/config.json 2>/dev/null; then
    adblock_status="BẬT"
    adblock_action="TẮT"
else
    adblock_status="TẮT"
    adblock_action="BẬT"
fi

echo "========================================================================="
echo "Trạng thái chặn quảng cáo hiện tại: $adblock_status"
echo "========================================================================="
read -p "Bạn có muốn ${adblock_action} chặn quảng cáo không? (y/N): " confirm

if [[ "$confirm" =~ ^[Yy]$ ]]; then
    echo "========================================================================="
    echo "Đang cập nhật cấu hình VLess VPN..."
    
    # Backup cấu hình hiện tại
    cp /usr/local/etc/v2ray/config.json /usr/local/etc/v2ray/config.json.backup
    
    if [ "$adblock_status" = "BẬT" ]; then
        # Tắt chặn quảng cáo - sử dụng DNS thông thường
        cat > /usr/local/etc/v2ray/config.json << EOL
{
  "log": {
    "access": "",
    "error": "/var/log/v2ray/error.log",
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "inbounds": [
    {
      "port": 50619,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$UUID"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/ws/"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {}
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "block"
      }
    ]
  }
}
EOL
    else
        # Bật chặn quảng cáo - sử dụng DNS chặn quảng cáo
        cat > /usr/local/etc/v2ray/config.json << EOL
{
  "log": {
    "access": "",
    "error": "/var/log/v2ray/error.log",
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "94.140.14.14",
      "94.140.15.15",
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "inbounds": [
    {
      "port": 50619,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$UUID"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/ws/"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "settings": {}
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "block"
      }
    ]
  }
}
EOL
    fi
    
    # Kiểm tra cấu hình JSON có hợp lệ không
    if /usr/local/v2ray/v2ray test -config /usr/local/etc/v2ray/config.json >/dev/null 2>&1; then
        # Khởi động lại V2Ray để áp dụng cấu hình mới
        systemctl restart v2ray
        
        if systemctl is-active --quiet v2ray; then
            clear
            echo "========================================================================="
            echo "Đã ${adblock_action} chặn quảng cáo thành công."
            echo "-------------------------------------------------------------------------"
            echo "VLess VPN đã được khởi động lại để áp dụng cấu hình mới."
        else
            clear
            echo "========================================================================="
            echo "Lỗi: VLess VPN không thể khởi động lại sau khi cập nhật cấu hình."
            echo "-------------------------------------------------------------------------"
            echo "Đang khôi phục cấu hình cũ..."
            mv /usr/local/etc/v2ray/config.json.backup /usr/local/etc/v2ray/config.json
            systemctl restart v2ray
            echo "Đã khôi phục cấu hình cũ."
        fi
    else
        clear
        echo "========================================================================="
        echo "Lỗi: Cấu hình VLess VPN không hợp lệ."
        echo "-------------------------------------------------------------------------"
        echo "Đang khôi phục cấu hình cũ..."
        mv /usr/local/etc/v2ray/config.json.backup /usr/local/etc/v2ray/config.json
        echo "Đã khôi phục cấu hình cũ."
    fi
    
    # Xóa file backup
    rm -f /usr/local/etc/v2ray/config.json.backup
    
else
    clear
    echo "========================================================================="
    echo "Đã hủy."
fi

sleep 2
echo "========================================================================="
/etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
;;

