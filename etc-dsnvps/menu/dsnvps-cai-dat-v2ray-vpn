5)
# Kiểm tra V2Ray đã cài đặt
if [ ! -f /usr/local/v2ray/v2ray ]; then
clear
echo "========================================================================="
    echo "VLess VPN chưa được cài đặt."
    sleep 1
    /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
    exit 0
fi

# Kiểm tra V2Ray đang chạy
if ! systemctl is-active --quiet v2ray; then
clear
echo "========================================================================="
    echo "VLess VPN đang TẮT. Vui lòng BẬT VLess VPN trước."
    sleep 1
    /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
    exit 0
fi

# Kiểm tra file UUID
if [ ! -f /etc/dsnvps/v2ray/v2ray.uuid.txt ]; then
clear
echo "========================================================================="
    echo "Không tìm thấy file cấu hình VLess VPN."
    sleep 1
    /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
    exit 0
fi

# Cài ngầm qrencode nếu chưa có
if ! command -v qrencode >/dev/null 2>&1; then
    apt-get install -y -qq qrencode >/dev/null 2>&1
    if ! command -v qrencode >/dev/null 2>&1; then
    clear
echo "========================================================================="
        echo "Không thể cài đặt qrencode."
        sleep 1
        /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
        exit 0
    fi
fi

# Kiểm tra domain có cấu hình V2Ray
v2ray_domain=""
for conf in /etc/nginx/conf.d/*.conf; do
    if grep -Fx "include /etc/dsnvps/v2ray/*.conf;" "$conf" >/dev/null; then
        v2ray_domain=$(basename "$conf" .conf)
        break
    fi
done

if [ -z "$v2ray_domain" ]; then
clear
echo "========================================================================="
    echo "Chưa cấu hình VLess VPN cho domain. Trước khi chạy chức năng này  "
    echo "---------------------------------------------------------------------"
    echo "bạn cần chạy chức năng [ Thiết Lập Domain VLess VPN ]. "
    sleep 1
    /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
    exit 0
fi

# Lấy UUID gốc (không mã hóa base64)
UUID=$(cat /etc/dsnvps/v2ray/v2ray.uuid.txt)

# Tạo link VLess đúng format với WebSocket
VLESS_LINK="vless://${UUID}@${v2ray_domain}:443?type=ws&security=tls&path=%2Fws%2F&host=${v2ray_domain}&sni=${v2ray_domain}#${v2ray_domain}"
sleep 2
clear
echo "========================================================================="
echo "QR Code:"
qrencode -l L -s 1 -t ansiutf8 "$VLESS_LINK"
echo "========================================================================="
read -p "Nhấn Enter để tiếp tục..." enter

clear
echo "========================================================================="
echo "VLess Link: $VLESS_LINK"
echo "========================================================================="
echo "Thông tin kết nối:"
echo "- Server: $v2ray_domain"
echo "- Port: 443"
echo "- UUID: $UUID"
echo "- Network: WebSocket (ws)"
echo "- Security: TLS"
echo "- Path: /ws/"
echo "- Host: $v2ray_domain"
echo "- SNI: $v2ray_domain"
echo "========================================================================="

# Quay lại menu
sleep 0.3
/etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn
;;  
