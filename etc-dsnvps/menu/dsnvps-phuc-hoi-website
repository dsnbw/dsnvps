#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -l)" -lt "1" ]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website mới vào server !"
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
rm -rf /etc/dsnvps/.tmp/checkallwebsites
nhapwebsite ()
{
echo -n "Nhập tên website [ENTER]: " 
read website
}

vhost_dir="/etc/nginx/conf.d"
home_dir="/home"
output_file="/etc/dsnvps/.tmp/checkallwebsites"

> "$output_file"

for vhost_file in "$vhost_dir"/*.conf; do
    domainc=$(basename "$vhost_file" .conf)

    # Bỏ qua domain dsnvps.demo
    if [[ "$domainc" == "dsnvps.demo" ]]; then
        continue
    fi

    # Kiểm tra nếu thư mục /home/domain tồn tại
    if [[ -d "$home_dir/$domainc" ]]; then
        echo "$domainc" >> "$output_file"
    fi
done

# Kiểm tra nếu file output không có domain nào
if [[ ! -s "$output_file" ]]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website Vào Server !"
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
echo "========================================================================="
echo "Sử dụng chức năng này để phục hồi website từ file backup."
echo "=========================================================================" 
echo "Hướng dẫn sử dụng: http://go.dsnvps/phoiweb"
echo "=========================================================================" 
echo "Nhập số tương ứng với Website bạn muốn phục hồi dữ liệu code."
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checkallwebsites
echo "========================================================================="
echo "Danh sách các website trên server:"
echo "-------------------------------------------------------------------------"
################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${danh_sach_website[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${danh_sach_website[right_index-1]}"      # Tên database bên phải
        printf "%-4s %-30s %-4s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-4s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-sao-luu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=${danh_sach_website[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

####################################################################
##Check Ban Pro
####################################################################
if [ ! -f /usr/bin/gxred ]; then
touch /etc/dsnvps/.tmp/ckla
/etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
clear
/etc/dsnvps/menu/dsnvps-sao-luu
fi

###################################################################
###################################################################
mkdir -p /home/$mainsite/private_html/backup/$website

# Tìm tất cả file backup (có .zip trong tên)
backup_files=()
backup_dir="/home/$mainsite/private_html/backup/$website"
if [ -d "$backup_dir" ]; then
    temp_file="/tmp/backup_files_$$"
    find "$backup_dir" -name "*zip*" -type f > "$temp_file"
    while IFS= read -r file; do
        if [ -n "$file" ]; then
            backup_files+=("$file")
        fi
    done < "$temp_file"
    rm -f "$temp_file"
fi

# Kiểm tra nếu không có file backup
if [ ${#backup_files[@]} -eq 0 ]; then
    echo "========================================================================="
    echo "Không tìm thấy file backup của $website trên server !"
    echo "-------------------------------------------------------------------------"
    echo "Hãy upload file backup .zip của bạn vào folder:"
    echo "-------------------------------------------------------------------------"
    echo "/home/$mainsite/private_html/backup/$website"
    echo "-------------------------------------------------------------------------"
    echo "và chạy lại chức năng này."
    echo "========================================================================="
    read -p "Nhấn [Enter] để tiếp tục ..."
    clear
    /etc/dsnvps/menu/dsnvps-sao-luu
    exit
fi

# Sắp xếp file theo thời gian tạo (mới nhất trước)
sorted_files=()
for file in "${backup_files[@]}"; do
    timestamp=$(stat -c %Y "$file")
    sorted_files+=("$timestamp:$file")
done

# Sắp xếp theo timestamp giảm dần
IFS=$'\n' sorted_files=($(sort -rn -t: -k1 <<< "${sorted_files[*]}"))

# Tạo danh sách file đã sắp xếp
final_files=()
for item in "${sorted_files[@]}"; do
    file_path="${item#*:}"
    final_files+=("$file_path")
done

# Nếu chỉ có 1 file, sử dụng trực tiếp
if [ ${#final_files[@]} -eq 1 ]; then
    filename=$(basename "${final_files[0]}")
else
    # Hiển thị danh sách để user chọn
    echo "========================================================================="
    echo "DANH SÁCH FILE BACKUP CỦA: $website"
    echo "========================================================================="
    
    for i in "${!final_files[@]}"; do
        file_path="${final_files[i]}"
        file_time=$(date -r "$file_path" "+%H:%M %d/%m/%Y")
        
        if [ $i -eq 0 ]; then
            printf " %d. Backup tạo lúc: %s (File mới nhất)\n" $((i+1)) "$file_time"
        else
            printf " %d. Backup tạo lúc: %s\n" $((i+1)) "$file_time"
        fi
    done
    echo ""
    
    # Cho user chọn file backup
    while true; do
        echo -n "Nhập số tương ứng với file backup muốn phục hồi [0 -Thoát]: "
        read -r backup_choice
        
        if [[ -z "$backup_choice" ]]; then
            echo "Vui lòng nhập một số hợp lệ."
            continue
        elif [[ "$backup_choice" == "0" ]]; then
            clear
            /etc/dsnvps/menu/dsnvps-sao-luu
            exit
        elif [[ "$backup_choice" =~ ^[0-9]+$ ]] && (( backup_choice >= 1 && backup_choice <= ${#final_files[@]} )); then
            selected_file="${final_files[$((backup_choice-1))]}"
            filename=$(basename "$selected_file")
            break
        else
            echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
        fi
    done
fi

websiteTO=`echo $website | tr '[a-z]' '[A-Z]'`
echo "========================================================================="
echo "Phát hiện file backup của $website:"
echo "-------------------------------------------------------------------------"
echo "File name: $filename "
echo "-------------------------------------------------------------------------"
echo "File backup được tạo vào: $(date -r /home/$mainsite/private_html/backup/$website/$filename +%H:%M/%F)"
echo "========================================================================="
echo "LỰA CHỌN CÁCH PHỤC HỒI $websiteTO"
echo "========================================================================="
prompt="Nhập vào lựa chọn của bạn [0 -Thoát]: "
options=("Giữ Nguyên Dữ Liệu Hiện Tại Và Ghi Đè Dữ Liệu Từ File Backup" "Xóa Hoàn Toàn Dữ Liệu Hiện Tại Và Phục Hồi Backup")
PS3="$prompt"
select opt in "${options[@]}"; do 
case "$REPLY" in
1) luachon="restore1"; break;;
2) luachon="restore2"; break;;
0) clear; exit 0;;  
*) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!";continue;;
esac   
done
if [ "$luachon" = "restore2" ]; then
echo "========================================================================="
echo "Trong quá trình phục hồi website, KHÔNG ĐƯỢC tắt màn hình SSH!"
echo "========================================================================="
echo "DSNVPS sẽ xóa toàn bộ dữ liệu website hiện tại (Code, images, files...)"
echo "-------------------------------------------------------------------------"
echo "Và thay thế bằng dữ liệu từ file backup. Quá trình này không thể quay lại."
echo "-------------------------------------------------------------------------"
echo "Vì vậy, bạn phải cân nhắc trước khi quyết định phục hồi."
echo "-------------------------------------------------------------------------"
echo "Nhấn [Enter] để phục hồi. Nhấn phím bất kỳ khác để hủy bỏ."
echo "========================================================================="
read -s -n1 -r -p "Nhấn [Enter] để tiếp tục ..." key
if [[ ! $key = "" ]]; then
clear
echo "========================================================================="
echo "Huỷ bỏ phuc hoi $website"
/etc/dsnvps/menu/dsnvps-sao-luu
fi
echo ""
echo "Vui lòng chờ..."
sleep 2
mv /home/$website/public_html /home/$website/public_html_backup
mkdir /home/$website/public_html
cd /home/$mainsite/private_html/backup/$website
unzip $filename -d /home/$website/public_html
cd	
chown -R nginx:nginx /home/$website/public_html
if [ -f /home/$website/public_html/index.php ]; then 
rm -rf /home/$website/public_html_backup 
#########  Restart Nginx ###############
/etc/dsnvps/menu/inc/re-start-nginx-service
#################################


####### Restart PHP-FPM ###############
/etc/dsnvps/menu/inc/re-start-php-fpm-service
##############################
( echo "flushall" ) | redis-cli

clear
echo "========================================================================="
echo "Bạn đã phục hồi xong $website"
/etc/dsnvps/menu/dsnvps-sao-luu
else
rm -rf /home/$website/public_html
mv /home/$website/public_html_backup /home/$website/public_html
clear
echo "========================================================================="
echo "Có điều gì đó không ổn với file backup của bạn"
echo "-------------------------------------------------------------------------"
echo "Phục hồi website thất bại."
/etc/dsnvps/menu/dsnvps-sao-luu
fi
fi

if [ "$luachon" = "restore1" ]; then
echo "========================================================================="
echo "Trong quá trình phục hồi website, KHÔNG ĐƯỢC tắt màn hình SSH!"
echo "========================================================================="
echo "DSNVPS sẽ thay thế các file hiện tại của website (Code, images, files...)"
echo "-------------------------------------------------------------------------"
echo "Bằng dữ liệu từ file backup. Quá trình này không thể quay lại!"
echo "-------------------------------------------------------------------------"
echo "Vì vậy, bạn phải cân nhắc trước khi quyết định phục hồi."
echo "-------------------------------------------------------------------------"
echo "Nhấn [Enter] để phục hồi. Nhấn phím bất kỳ khác để hủy bỏ."
echo "========================================================================="
read -n1 -r -p "Nhấn [Enter] để tiếp tục ..." key
if [[ ! $key = "" ]]; then
clear
echo "========================================================================="
echo "Huỷ bỏ phục hồi $website"
/etc/dsnvps/menu/dsnvps-sao-luu
fi
echo ""
echo "Vui lòng chờ..."
sleep 2
rm -rf /etc/dsnvps/.tmp/websiterestore
mkdir -p /etc/dsnvps/.tmp/websiterestore
cd /home/$mainsite/private_html/backup/$website
unzip -o $filename -d /etc/dsnvps/.tmp/websiterestore
cd
if [ ! -f /etc/dsnvps/.tmp/websiterestore/index.php ]; then
rm -rf /etc/dsnvps/.tmp/websiterestore
clear
echo "========================================================================="
echo "Có điều gì đó không ổn với file backup của bạn"
echo "-------------------------------------------------------------------------"
echo "Phục hồi website thất bại."
/etc/dsnvps/menu/dsnvps-sao-luu
else
#yes | cp -rf /etc/dsnvps/.tmp/websiterestore/*.* /home/$website/public_html
yes | cp -rf /etc/dsnvps/.tmp/websiterestore/* /home/$website/public_html
rm -rf /etc/dsnvps/.tmp/websiterestore
chown -R nginx:nginx /home/$website/public_html
#########  Restart Nginx ###############
/etc/dsnvps/menu/inc/re-start-nginx-service
#################################


####### Restart PHP-FPM ###############
/etc/dsnvps/menu/inc/re-start-php-fpm-service
##############################
	( echo "flushall" ) | redis-cli
clear
echo "========================================================================="
echo "Bạn đã phục hồi xong $website"
/etc/dsnvps/menu/dsnvps-sao-luu
fi 
fi
fi
