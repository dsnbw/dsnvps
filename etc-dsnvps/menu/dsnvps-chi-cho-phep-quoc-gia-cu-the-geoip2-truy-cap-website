    line=""
    while IFS= read -n1 char; do
        if [ ${#line} -ge $((max_length - 1)) ]; then
            echo "$line"
      echo "-------------------------------------------------------------------------"
            line="$char"
        else
            line="${line}$char"
        fi
    done <<< "$text"
    echo "$line"
    sleep 2
    ########################################################################################################################
      clear
      echo "========================================================================="
    echo "Hoàn tất cấu hình cho phép truy cập cho $source_domain"; sleep 3
    echo "-------------------------------------------------------------------------"
    ######################################################################################################################
    text="Các nước được phép truy cập: $all_countries"

    max_length=72
    line=""
    while IFS= read -n1 char; do
        if [ ${#line} -ge $((max_length - 1)) ]; then
            echo "$line"
      echo "-------------------------------------------------------------------------"
            line="$char"
        else
            line="${line}$char"
        fi
    done <<< "$text"
    echo "$line"
    ########################################################################################################################
       /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
      exit
else
    # Cấu hình nginx có lỗi - chỉ xóa các file mới tạo ra
    echo "========================================================================="
    echo "Cấu hình thất bại. Xóa các file mới tạo ra..."
    
    # Xóa các file mới tạo ra (chỉ những file vừa tạo trong lần này)
    if [[ -f "$new_files_tracker" ]]; then
        while IFS= read -r new_file; do
            if [[ -f "$new_file" ]]; then
                rm -f "$new_file"
                echo "Đã xóa: $new_file"
            fi
        done < "$new_files_tracker"
    fi
    
    # Xóa file tracker
    rm -f "$new_files_tracker" "$new_files_tracker.allowlist_before"
    
    systemctl reload nginx
    clear
    echo "========================================================================="
    echo "Cấu hình cho phép truy cập thất bại !"
    echo "-------------------------------------------------------------------------"
    cat /etc/dsnvps/.tmp/a0paMLZa
    rm -f /etc/dsnvps/.tmp/a0paMLZa
    /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
fi
