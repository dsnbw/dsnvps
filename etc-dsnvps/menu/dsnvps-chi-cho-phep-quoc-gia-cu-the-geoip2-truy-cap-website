#!/bin/bash
. /root/dsnvps.conf
check_nginx() {
    if ! systemctl is-active --quiet nginx; then
        clear
        echo "========================================================================"
        echo "Dịch vụ Nginx không chạy"
        echo "------------------------------------------------------------------------"
        echo "DSNVPS đang cố gắng khởi động nó..."
        sleep 3
        systemctl start nginx
        sleep 2

        if ! systemctl is-active --quiet nginx; then
            clear
            echo "========================================================================"
            echo "DSNVPS không thể khởi động dịch vụ Nginx"
            echo "------------------------------------------------------------------------"
            echo "Trạng thái Nginx:"
            nginx -t
            echo "------------------------------------------------------------------------"
            echo "Vui lòng bật lại Nginx trước khi sử dụng chức năng này!"
            echo "------------------------------------------------------------------------"
            /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
            exit 1
        fi
    fi
}

validate_nginx() {
    TMP_FILE="/etc/dsnvps/.tmp/dsnvps.nginx.check"
    mkdir -p /etc/dsnvps/.tmp
    nginx -t 2> "$TMP_FILE"

    # Nếu có lỗi trong config
    if ! grep -q "syntax is ok" "$TMP_FILE" || ! grep -q "test is successful" "$TMP_FILE"; then
        echo "-------------------------------------------------------------------------"
        echo "Phát hiện lỗi trong cấu hình Nginx!"
        sleep 2
        clear
        echo "========================================================================="
        echo "Nginx gặp lỗi. DSNVPS không thể chạy chức năng này!"
        echo "-------------------------------------------------------------------------"
        echo "Trạng thái Nginx:"
        nginx -t
        echo "-------------------------------------------------------------------------"
        /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
        rm -f "$TMP_FILE"
        exit 1
    fi

    rm -f "$TMP_FILE"
}

