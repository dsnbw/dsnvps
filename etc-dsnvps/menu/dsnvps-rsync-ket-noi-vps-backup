#!/bin/bash 
. /root/dsnvps.conf

if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Anti-debug removed

if [ -f /etc/dsnvps/vps_backup_rsync.info ]; then
    if [ ! "$(grep "thanhcong" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}')" == "" ]; then
        clear
        echo "========================================================================="
        echo "Bạn đã hoàn thành cấu hình kết nối server hiện tại với VPS backup"
        echo "-------------------------------------------------------------------------"
        echo "VPS Backup có địa chỉ IP: $(grep "ipaddress" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}')"
        /etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
        exit
    fi
fi

echo "========================================================================="
echo "Sử dụng chức năng này để Kết Nối server hiện tại với VPS Backup"
echo "-------------------------------------------------------------------------"
echo "Sau khi kết nối thành công, sử dụng chức năng [Cấu Hình Thời Gian Đồng Bộ]"
echo "-------------------------------------------------------------------------"
echo "để thiết lập thời gian đồng bộ dữ liệu giữa server hiện tại và VPS backup"
echo "-------------------------------------------------------------------------"
echo "Thông tin VPS Backup cần nhập: IP và Mật khẩu tài khoản Root và SSH Port"
echo "========================================================================="
while true; do
    echo -n "Nhập IP VPS Backup [0 -Thoát]: "
    read ipvpsbackup

    # Thoát nếu nhập 0
    if [ "$ipvpsbackup" = "0" ]; then
        clear
        /etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
        exit
    fi

    # Kiểm tra định dạng IP
    if [[ ! "$ipvpsbackup" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "========================================================================="
        echo "$ipvpsbackup không phải là IP hợp lệ!"
        echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập lại."
        sleep 4  
        tput cuu 5 
        tput ed
        continue
    fi

    # Kiểm tra IP có ping được không
    echo "-------------------------------------------------------------------------"
    echo "Check IP $ipvpsbackup";sleep 5        
    if ! ping -c 1 -W 2 "$ipvpsbackup" > /dev/null 2>&1; then
        echo "========================================================================="
        echo "$ipvpsbackup không phản hồi."
        echo "-------------------------------------------------------------------------"
        echo "IP này có thể không tồn tại hoặc không truy cập được! Vui lòng nhập lại."
        sleep 6  
        tput cuu 7 
        tput ed
        continue
    fi
    echo "-------------------------------------------------------------------------"
    echo "Check => OK"; sleep 4;tput cuu 4;  tput ed   
    break
done


