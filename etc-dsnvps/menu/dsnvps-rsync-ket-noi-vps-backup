if [ -f ~/.ssh/known_hosts ]; then
    grep -q "$ipvpsbackup" ~/.ssh/known_hosts && sed -i "/$ipvpsbackup/d" ~/.ssh/known_hosts
fi
if [ ! -f ~/.ssh/id_rsa.pub ]; then
    echo "-------------------------------------------------------------------------"
    echo "Chưa có SSH key, DSNVPS sẽ tạo SSH key ..."; sleep 2
    ssh-keygen -t rsa -b 4096 -N "" -f ~/.ssh/id_rsa <<< y #>/dev/null 2>&1
    echo "SSH key đã được tạo thành công!"
fi
echo "-------------------------------------------------------------------------"
echo "Kết nối tới $ipvpsbackup..."; sleep 3
sshpass -p "$passrootbackupvps" scp -P $sshport ~/.ssh/id_rsa.pub root@$ipvpsbackup:/root/temp_key
sshpass -p "$passrootbackupvps" ssh -p $sshport root@$ipvpsbackup "
    mkdir -p ~/.ssh &&
    touch ~/.ssh/authorized_keys &&
    cat /root/temp_key >> ~/.ssh/authorized_keys &&
    chmod 700 ~/.ssh &&
    chmod 600 ~/.ssh/authorized_keys &&
    rm -f /root/temp_key"
#sshpass -p '$passrootbackupvps' ssh-copy-id -p $sshport -i ~/.ssh/id_rsa.pub root@$ipvpsbackup #>/dev/null 2>&1
#echo "buoc 2"
checkconnect=$(ssh -p $sshport -o BatchMode=yes -o ConnectTimeout=9 root@$ipvpsbackup echo connected 2>&1)
if [[ ! $checkconnect == connected ]] ; then
    #clear
    echo "========================================================================="
echo "Kết nối thất bại"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng kiểm tra lại thông tin VPS Backup"
    /etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
    exit
fi

cat > "/etc/dsnvps/vps_backup_rsync.info" <<END
ipaddress = $ipvpsbackup
sshport = $sshport
ketnoistatus = thanhcong
END

clear
echo "========================================================================="
echo "Kết nối tới VPS backup $ipvpsbackup thành công !"
echo "-------------------------------------------------------------------------"
echo "Bây giờ bạn có thể cấu hình thời gian đồng bộ cho Server."
/etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
exit
