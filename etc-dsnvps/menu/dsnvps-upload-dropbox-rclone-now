#!/bin/bash
. /root/dsnvps.conf

# Xác định serverip_priport
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Kiểm tra strace
# Anti-debug removed

# Kiểm tra dung lượng thư mục backup
dungluong=$(du -sh /home/$mainsite/private_html/backup 2>/dev/null | awk '{print $1}')
if [ -z "$dungluong" ] || [ "$dungluong" == "0" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Trên server không tồn tại các file backup."
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy sao lưu Website & Database trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra rclone
if ! command -v rclone >/dev/null 2>&1; then
    clear
    echo "========================================================================="
    echo "Bạn hãy cài đặt Rclone trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra cấu hình Rclone
if [ ! -f /root/.config/rclone/rclone.conf ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Chức năng sao lưu Cloud (Dropbox) chưa được cấu hình."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra file cấu hình Dropbox
if [ ! -f /etc/dsnvps/backup.dropbox.conf ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Bạn phải hoàn thành [Cấu Hình Tự Động Sao Lưu] "
    echo "-------------------------------------------------------------------------"
    echo "trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra cấu hình Dropbox
rm -rf /etc/dsnvps/.tmp/checkrclonedropbox
awk '/^\[dropbox\]/ {print}' /root/.config/rclone/rclone.conf > /etc/dsnvps/.tmp/checkrclonedropbox
checkb=$(wc -l < /etc/dsnvps/.tmp/checkrclonedropbox)

if [ "$checkb" -lt 1 ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Bạn hãy kết nối VPS với Dropbox trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

if [ "$checkb" -gt 1 ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Hiện tại DSNVPS chỉ hỗ trợ backup VPS với 1 config Dropbox"
    echo "-------------------------------------------------------------------------"
    echo "Hãy chạy chức năng [ Xóa Tất Cả Cấu Hình ], và thực hiện config lại."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Lấy tên remote từ cấu hình Rclone
rm -rf /etc/dsnvps/.tmp/chckshxn0
grep -B 1 "type = dropbox" /root/.config/rclone/rclone.conf | awk 'NR==1' | sed 's/\[//' | sed 's/\]//' > /etc/dsnvps/.tmp/chckshxn0
uservue=$(cat /etc/dsnvps/.tmp/chckshxn0)
if [ -z "$uservue" ]; then
    clear
    echo "========================================================================="
    echo "DSNVPS không thể thực hiện chức năng này."
    echo "-------------------------------------------------------------------------"
    echo "Bạn vui lòng kiểm tra lại."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra file thực thi upload
upload_script="/etc/dsnvps/menu/backup-dropbox-rclone-run-now"
if [ ! -f "$upload_script" ]; then
    clear
    echo "========================================================================="
    echo "Không tìm thấy file thực thi: $upload_script"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại cấu hình DSNVPS."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi

# Kiểm tra kết nối tới Dropbox
echo "-------------------------------------------------------------------------"
echo "Kiểm tra kết nối tới Dropbox"; sleep 2
REMOTE_NAME="dropbox"
if ! rclone about "$REMOTE_NAME": &>/dev/null; then
    clear
    echo "========================================================================="
    echo "Kết nối tới Dropbox thất bại !"
    echo "-------------------------------------------------------------------------"
    echo "Bạn hãy thử lại hoặc [Xóa Tất Cả Cấu Hình] để kết nối Dropbox lại."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi
sleep 3 && tput cuu 2 && tput ed

# Hỏi người dùng về việc upload
echo "========================================================================="
echo "Dùng chức năng này để upload backup files lên Dropbox ngay và luôn."
echo "========================================================================="
read -r -p "Bạn muốn upload backup files lên Dropbox ngay bây giờ? [y/N] " response
if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "-------------------------------------------------------------------------"
    echo "OK, Vui lòng chờ ..."; sleep 3
    echo "-------------------------------------------------------------------------"
    echo "Uploading ..."; sleep 3
    
    # Thực hiện upload và kiểm tra kết quả
    "$upload_script"
    
    echo "-------------------------------------------------------------------------"
    echo "Upload thành công!"; sleep 3
    clear
    echo "========================================================================="
    echo "Tất cả các file backup đã được upload lên tài khoản Dropbox!"
    echo "-------------------------------------------------------------------------"
    echo "Tên folder: $serverip"
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
else
    clear
    echo "========================================================================="
    echo "Hủy bỏ."
    /etc/dsnvps/menu/dsnvps-rclone-dropbox-menu
    exit
fi