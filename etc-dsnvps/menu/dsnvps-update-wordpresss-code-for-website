#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
#########################################
echo -n "Please wait"
dots="."
while true; do
    echo -n "$dots"  # Hiển thị các dấu chấm
    sleep 2          # Chờ 1 giây
    dots="$dots."    # Thêm dấu chấm
    # Bạn có thể điều kiện để dừng vòng lặp khi lệnh thực thi xong, ví dụ:
    if [ ${#dots} -gt 3 ]; then  # Dừng sau khi thêm 3 dấu chấm
        break
    fi
done
echo  # Để xuống dòng sau khi hoàn thành
########################################
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/wordpresslist
cd /etc/nginx/conf.d
ls > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
cd
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/wordpresslist
file1="/etc/dsnvps/.tmp/dsnvps-websitelist"
while read -r wpsite
    do
if [ -f /home/$wpsite/public_html/wp-config.php ]; then
echo "$wpsite" >> /etc/dsnvps/.tmp/wordpresslist
fi
 done < "$file1"
 if [ ! -f /etc/dsnvps/.tmp/wordpresslist ]; then
clear
echo "========================================================================="
 echo "DSNVPS không tìm thấy website chạy Wordpress Code trên Server."
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
 exit
 fi

api_url="https://api.wordpress.org/core/version-check/1.7/"
latest_version=$(curl -s "$api_url" | jq -r '.offers[0].version')

 #####################################################################
wordpress_list="/etc/dsnvps/.tmp/wordpresslist"
temp_file="/etc/dsnvps/.tmp/wordpresslist_temp"
> "$temp_file"

if [[ -s "$wordpress_list" ]]; then
    while IFS= read -r domain; do
        domain=$(echo "$domain" | xargs)
        root_path="/home/$domain/public_html"

        if [[ -f "$root_path/wp-config.php" ]]; then
            version=$(wp core version --path="$root_path" --allow-root 2>/dev/null)

            if [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo "$domain*$version" >> "$temp_file"
            else
                echo "$domain" >> "$temp_file"
            fi
        else
            echo "$domain" >> "$temp_file"
        fi
    done < "$wordpress_list"
mv "$temp_file" "$wordpress_list"
fi
tput cuu1  # Di chuyển con trỏ lên một dòng
tput el    # Xóa dòng hiện tại
##############################################################################
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/wordpresslist
echo "========================================================================="
echo "WordPress websites + Phiên bản WP đang dùng: | Phiên bản mới nhất: $latest_version"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${danh_sach_website[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${danh_sach_website[right_index-1]}"      # Tên database bên phải
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
website=${danh_sach_website[lua_chon-1]}
website=${website%%\**}
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

# Cac doan ma xac nhan phia duoi se tiep tuc chay

echo "-------------------------------------------------------------------------"; sleep 2
echo "$website đang sử dụng wordpress code trên hệ thống"; sleep 2
echo "-------------------------------------------------------------------------"; sleep 2
echo "DSNVPS đang kiểm tra Wordpress version"; sleep 2
echo "-------------------------------------------------------------------------"; sleep 2
sleep 3
date |md5sum |cut -c '1-8' > /etc/dsnvps/.tmp/abcd
random=$(cat /etc/dsnvps/.tmp/abcd)
tendatabase=`cat /home/$website/public_html/wp-config.php | grep DB_NAME | cut -d \' -f 4`
echo "`date '+%d%m'`" > /etc/dsnvps/.tmp/datetime
tenmo=$(cat /etc/dsnvps/.tmp/datetime)
chown -R nginx:nginx /home/$website/public_html
cd /home/$website/public_html/
wp core check-update --allow-root > /etc/dsnvps/.tmp/abcdxaax
dsnvpscheckversion=$(wp core check-update --allow-root | tail -n1 | awk 'NR==1 {print $1}')

if [ ! -s /etc/dsnvps/.tmp/abcdxaax ]; then
clear
cd
echo "========================================================================="
rm -rf /etc/dsnvps/.tmp/abcdxaax
echo "DSNVPS không thể kết nối tới database của $website"
echo "-------------------------------------------------------------------------"
echo "Chức năng này không thể thực hiện được."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy kiểm tra lại cấu hình Wordpress."

/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
exit
fi

if grep -q "latest" /etc/dsnvps/.tmp/abcdxaax; then
clear
cd
echo "========================================================================="
rm -rf /etc/dsnvps/.tmp/abcdxaax
echo "Website $website dang su dung phien ban wordpress moi nhat"
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
else
if [ ! -d /home/$website/public_html/0-DSNVPS ]; then
mkdir -p /home/$website/public_html/0-DSNVPS
fi
rm -rf /etc/dsnvps/.tmp/abcdxaax
clear
echo "========================================================================="
echo "Phiên bản wordpress hiện tại của $website: $(wp core version --allow-root)"
echo "-------------------------------------------------------------------------"
echo "Phiên bản wordpress mới nhất: $dsnvpscheckversion"
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ update wordpress code của $website lên $dsnvpscheckversion"
echo "-------------------------------------------------------------------------"
echo "Trước khi update, DSNVPS sẽ sao lưu database"
echo "-------------------------------------------------------------------------"
echo "Link file backup database: "
echo "-------------------------------------------------------------------------"
echo "http://$website/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz"

echo "-------------------------------------------------------------------------"
read -p "Nhấn [Enter] để tiếp tục ..."
#enginecheck=`grep "default_storage_engine =" /etc/my.cnf | grep MyISAM`
#if [ -z "$enginecheck" ]; then
#mysqldump -u root -p$mariadbpass $tendatabase --single-transaction | gzip -6 > /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz
#else
#mysqldump -u root -p$mariadbpass $tendatabase --lock-tables=false | gzip -6 > /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz
#fi
wp db export --allow-root /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql
tar -vczf /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql
/etc/dsnvps/menu/dsnvps-enable-tat-ca-cac-ham-php-php.ini
wp core update --allow-root
wp core update-db --allow-root
/etc/dsnvps/menu/dsnvps-re-config-cac-ham-php-disable-php.ini
cd
chown -R nginx:nginx /home/$website/public_html

/etc/dsnvps/menu/inc/re-start-php-fpm-service 

cd /home/$website/public_html
dsnvpscheckversion=$(wp core check-update --allow-root | tail -n1 | awk 'NR==1 {print $1}')
rm -rf /etc/dsnvps/.tmp/abcdxaaxc
wp core check-update --allow-root > /etc/dsnvps/.tmp/abcdxaaxc
clear
echo "========================================================================="
if grep -q "latest" /etc/dsnvps/.tmp/abcdxaaxc; then
rm -rf /etc/dsnvps/.tmp/abcdxaaxc
echo "Update Wordpress code của $website thành công"
else
rm -rf /etc/dsnvps/.tmp/abcdxaaxc
echo "Update wordpress code thất bại"

fi
cd
if [ -f /home/$website/public_html/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz ]; then
echo "-------------------------------------------------------------------------"
echo "Backup database $tendatabase thành công"
echo "-------------------------------------------------------------------------"
echo "Link file backup database:"
echo "-------------------------------------------------------------------------"
echo "http://$website/0-DSNVPS/$tendatabase-$random-$tenmo.sql.gz"
else
echo "-------------------------------------------------------------------------"
echo "Backup database thất bại"

fi
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
fi
