#!/bin/bash 
. /root/dsnvps.conf

# Kiểm tra dịch vụ MySQL/MariaDB có chạy không
if ! systemctl is-active mariadb >/dev/null 2>&1 && ! systemctl is-active mysql >/dev/null 2>&1; then
    clear
    echo "========================================================================="
    echo "Lỗi: MySQL/MariaDB không chạy. Vui lòng kiểm tra lại dịch vụ!"
    dsnvps
    exit 1
fi

echo "========================================================================="
echo "Sử dụng chức năng này để thay mật khẩu tài khoản user root của MySQL"
echo "-------------------------------------------------------------------------"
read -r -p "Bạn muốn thay mật khẩu user root? [y/N] " response
case $response in
    [yY][eE][sS]|[yY])
    sleep 3;tput cuu 4; tput ed
            echo "========================================================================="
            echo "Nhập mật khẩu mới cho user root của MySQL"
            echo "-------------------------------------------------------------------------"
            echo "Mật khẩu phải từ 16 đến 32 ký tự, chỉ dùng số, chữ cái và dấu gạch dưới."
            echo "-------------------------------------------------------------------------" 
        while true; do
            echo -n "Nhập mật khẩu mới [0 -Thoát]: " 
            read PASS1
            
                        # Kiểm tra nếu nhập 0 thì thoát
            if [ "$PASS1" = "0" ]; then
                clear
                echo "========================================================================="
                echo "Bạn đã hủy thay đổi mật khẩu user root của MySQL!"
                dsnvps
                exit 0
            fi

            # Kiểm tra mật khẩu rỗng
            if [ -z "$PASS1" ]; then
            echo "========================================================================="
                echo "Bạn chưa nhập mật khẩu, vui lòng nhập lại!"
                sleep 3;tput cuu 3; tput ed
                continue
            fi

            # Kiểm tra độ dài mật khẩu
            if [ ${#PASS1} -lt 16 ]; then
            echo "========================================================================="
                echo "Mật khẩu phải có ít nhất 16 ký tự, vui lòng nhập lại!"
                sleep 3;tput cuu 3; tput ed
                continue
            fi
            if [ ${#PASS1} -gt 32 ]; then
            echo "========================================================================="
                echo "Mật khẩu không được dài quá 32 ký tự, vui lòng nhập lại!"
                sleep 3;tput cuu 3; tput ed
                continue
            fi

            # Kiểm tra trùng mật khẩu cũ
            if [ "$PASS1" = "$mariadbpass" ]; then
            echo "========================================================================="
                echo "Password mới bạn nhập giống password cũ, vui lòng nhập lại!"
                sleep 3;tput cuu 3; tput ed
                continue
            fi

            # Kiểm tra định dạng mật khẩu
            checkpass="^[a-zA-Z0-9_][-a-zA-Z0-9_]{0,61}[a-zA-Z0-9_]$"
            if [[ ! "$PASS1" =~ $checkpass ]]; then
            echo "========================================================================="
                echo "Bạn chỉ được dùng số, chữ cái và dấu gạch dưới, vui lòng nhập lại!"
               sleep 3;tput cuu 3; tput ed
                continue
            fi 

            # Nhập lại mật khẩu
            echo "-------------------------------------------------------------------------"
            echo -n "Nhập lại password [ENTER]: " 
            read PASS2
            if [ "$PASS1" != "$PASS2" ]; then
            echo "========================================================================="
                echo "Mật khẩu nhập lại không khớp, vui lòng thử lại!"
                sleep 3;tput cuu 5; tput ed
                continue
            fi

            # Nếu tất cả hợp lệ, thoát vòng lặp
            break
        done


echo "-------------------------------------------------------------------------"
read -p "Nhập OK để xác nhận: " input

if [[ "$input" == "OK" ]]; then
echo "========================================================================="
    echo "Xác nhận chính xác."; sleep 2
else
clear
echo "========================================================================="
echo "Xác nhận không chính xác."
echo "----------------------------------------------------------------------"
echo "Bạn cần nhập chữ 'OK' để xác nhận đổi mật khẩu."; sleep 2
dsnvps
fi

        # Thử đổi mật khẩu và kiểm tra lỗi
        if ! mysqladmin -u root -p"$mariadbpass" password "$PASS1" 2>/dev/null; then
            clear
            echo "========================================================================="
            echo "Đổi mật khẩu user root của MySQL thất bại!"
            echo "-------------------------------------------------------------------------"
            echo "Có thể mật khẩu cũ không đúng hoặc MySQL gặp lỗi. Vui lòng kiểm tra lại!"
            dsnvps
            exit 1
        fi

        # Cập nhật file cấu hình
# Thay thế trực tiếp dòng mariadbpass trong /root/dsnvps.conf
        sed -i "s/mariadbpass=\".*\"/mariadbpass=\"$PASS1\"/" /root/dsnvps.conf


        # Cập nhật .my.cnf
        rm -f /root/.my.cnf
        cat > "/root/.my.cnf" <<END
[client]
user=root
password=$PASS1
END
        chmod 600 /root/.my.cnf

        echo "-------------------------------------------------------------------------"
        echo "Vui lòng chờ..."
        sleep 2
        clear
        echo "========================================================================="
        echo "Thay đổi mật khẩu cho user root của MySQL thành công!"
        echo "-------------------------------------------------------------------------"
        dsnvps
        ;;
    *)
        clear
        echo "========================================================================="
        echo "Bạn đã hủy thay đổi mật khẩu user root của MySQL!"
        dsnvps
        ;;
esac
