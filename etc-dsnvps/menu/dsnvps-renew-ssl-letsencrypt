#!/bin/bash

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if ! systemctl is-active --quiet nginx; then
    clear
    echo "========================================================================"
    echo "Dịch vụ Nginx không chạy"
    echo "------------------------------------------------------------------------"
    echo "DSNVPS đang cố gắng khởi động lại..."
    sleep 1
    
    # Thử khởi động lại Nginx
    /etc/dsnvps/menu/inc/start-nginx-service > /dev/null 2>&1
    
    # 2. Kiểm tra lại lần cuối sau khi đã thử khởi động
    if ! systemctl is-active --quiet nginx; then
        clear
        echo "========================================================================"
        echo "LỖI: DSNVPS không thể khởi động dịch vụ Nginx!"
        echo "------------------------------------------------------------------------"
        echo "Thông tin lỗi chi tiết:"
        echo "------------------------------------------------------------------------"
        nginx -t
        echo "------------------------------------------------------------------------"
        echo "Vui lòng xử lý lỗi cấu hình trên trước khi tiếp tục."
        echo "========================================================================"
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    fi
    
    echo "Khởi động Nginx thành công... please wait"
    sleep 2
    clear
    
fi

###### Check Nginx Service II
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
rm -rf /etc/dsnvps/.tmp/klaixx.txt
rm -rf /etc/dsnvps/.tmp/alizb
if ! systemctl is-active --quiet nginx; then
    clear
    echo "========================================================================"
    echo "Dịch vụ Nginx không chạy"
    echo "------------------------------------------------------------------------"
    echo "DSNVPS đang cố gắng khởi động lại..."
    sleep 1
    
    # Thử khởi động lại Nginx
    /etc/dsnvps/menu/inc/start-nginx-service > /dev/null 2>&1
    
    # 2. Kiểm tra lại lần cuối sau khi đã thử khởi động
    if ! systemctl is-active --quiet nginx; then
        clear
        echo "========================================================================"
        echo "LỖI: DSNVPS không thể khởi động dịch vụ Nginx!"
        echo "------------------------------------------------------------------------"
        echo "Thông tin lỗi chi tiết:"
        echo "------------------------------------------------------------------------"
        nginx -t
        echo "------------------------------------------------------------------------"
        echo "Vui lòng xử lý lỗi cấu hình trên trước khi tiếp tục."
        echo "========================================================================"
        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    fi
    
    echo "Khởi động Nginx thành công... please wait"
    sleep 2
    clear
    
fi


if [ ! -d /etc/dsnvps/.tmp ]; then
    mkdir -p /etc/dsnvps/.tmp
fi
rm -rf /etc/dsnvps/.tmp/list_domain_SSL
rm -rf /etc/dsnvps/.tmp/check_lets*
rm -rf /etc/dsnvps/.tmp/thanh_cong_SSL
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/checksite-list
rm -rf /etc/dsnvps/.tmp/dsnvps-replace

ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist

cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checksite-list

sowebsitetrenserver=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist | wc -l)
domainlist=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/checksite-list
rm -rf /etc/dsnvps/.tmp/checksite-listSSL
rm -rf /etc/dsnvps/.tmp/thanh_cong_SSL

for domain in $domainlist; do
    if [ -f /etc/nginx/auth-acme/$domain/$domain.crt ]; then
        if [ "$(grep "/etc/nginx/auth-acme/$domain/$domain.crt" /etc/nginx/conf.d/$domain.conf)" != "" ]; then
            echo "$domain" >> /etc/dsnvps/.tmp/thanh_cong_SSL
        fi
    fi
done

# Nếu không có website nào sử dụng SSL miễn phí
if [ ! -f /etc/dsnvps/.tmp/thanh_cong_SSL ]; then
    clear
    echo "========================================================================="
echo "Hiện tại không có website nào cài đặt Free SSL"
    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
    exit 1
fi

###################################################################################################
########################################################################
#check Subsite
#########################################################################
rm -rf /etc/dsnvps/.tmp/klaixx.txt
klaixx_file="/etc/dsnvps/.tmp/klaixx.txt"
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
# Xóa file cũ nếu tồn tại
> "$klaixx_file"
# Duyệt qua tất cả các file .conf trong thư mục cấu hình Nginx
for vhost in "$nginx_conf_folder"/*.conf; do
    # Lấy tên miền từ file vhost
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"

    # Kiểm tra nếu domain chạy WordPress (tồn tại wp-config.php)
    if [[ -f "$domain_home/wp-config.php" ]]; then
        multisite_folder="$home_folder/$domain/multisite.conf.d"

        # Nếu thư mục multisite.conf.d tồn tại và có file vhost
        if [[ -d "$multisite_folder" && $(ls -A "$multisite_folder"/*.conf 2>/dev/null) ]]; then
            for subsite_vhost in "$multisite_folder"/*.conf; do
                subsite=$(basename "$subsite_vhost" .conf)
                echo "$subsite" >> "$klaixx_file"
            done
        fi
    fi
done
# Kiểm tra kết quả
if [[ -s "$klaixx_file" ]]; then
# Đường dẫn tệp chứa danh sách sub-domain
input_file="/etc/dsnvps/.tmp/klaixx.txt"
output_file="/etc/dsnvps/.tmp/alizb"

# Đọc từng dòng từ tệp input
while IFS= read -r sub_domain; do
    # Tìm domain chính từ sub-domain
    domain=$(echo "$sub_domain" | awk -F. '{print $(NF-1)"."$NF}')
    
    # Đường dẫn đến vhost của sub-domain
    vhost_path="/home/$domain/multisite.conf.d/$sub_domain.conf"
    
    # Kiểm tra nếu tệp vhost tồn tại
    if [[ -f "$vhost_path" ]]; then
        # Kiểm tra nội dung file vhost
        if grep -q "/etc/nginx/auth-acme/$sub_domain/$sub_domain.crt" "$vhost_path" && \
           grep -q "https://$sub_domain\$request_uri;" "$vhost_path"; then
            # Sub-domain đang dùng SSL, thêm vào tệp output
            echo "$sub_domain" >> "$output_file"
        fi
    fi
done < "$input_file"

if [[ -s "$output_file" ]]; then
cat "$output_file" >> /etc/dsnvps/.tmp/thanh_cong_SSL
fi
fi

########################################################################################################
#Park Domains
######################################################
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
> "$output_file"

# Lấy danh sách domain chính từ file .conf
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"

    # Kiểm tra nếu domain có thư mục public_html và không phải domain chính
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        echo "$domain" >> "$output_file"
    fi
done

if [[ ! -s "$output_file" ]]; then
    exit 1
fi

klaoxcy_file="/etc/dsnvps/.tmp/klaoxcy"
output_file="/etc/dsnvps/.tmp/klaoxcypark"
> "$output_file"

# Đọc danh sách domain chính để kiểm tra park domain
while IFS= read -r mainsite; do
    domain_conf_folder="$home_folder/$mainsite/conf.d"

    # Kiểm tra nếu thư mục conf.d tồn tại và có file .conf
    if [[ -d "$domain_conf_folder" ]] && compgen -G "$domain_conf_folder/*.conf" > /dev/null; then
        for vhost in "$domain_conf_folder"/*.conf; do
            subdomain=$(basename "$vhost" .conf)
            # Kiểm tra nếu subdomain khác domain chính và chứa SSL
            if [[ "$subdomain" != "$mainsite" ]] && grep -q "/etc/nginx/auth-acme/$subdomain/$subdomain.crt" "$vhost"; then
                echo "$subdomain" >> "$output_file"
            fi
        done
    fi
done < "$klaoxcy_file"

# Chỉ xuất danh sách park domain có SSL
if [[ -s "$output_file" ]]; then
    cat "$output_file" >> /etc/dsnvps/.tmp/thanh_cong_SSL
fi
###############################################################
#####################################################################


###############################################################################################

# Hiển thị danh sách các website sử dụng SSL miễn phí
echo "========================================================================="
echo "Sử dụng chức năng này để gia hạn thủ công chứng chỉ SSL Miễn Phí."
echo "-------------------------------------------------------------------------"
echo "Tất cả chứng chỉ miễn phí đều tự động gia hạn 30 ngày trước khi hết hạn."
echo "-------------------------------------------------------------------------"
echo "Nếu chứng chỉ gia hạn không thành công, bạn mới cần chạy chức năng này."
echo "========================================================================="
echo "Danh sách Website, Subsite dùng Free SSL:"
echo "-------------------------------------------------------------------------"

# Đọc danh sách các website đã thành công
mapfile -t file_list < /etc/dsnvps/.tmp/thanh_cong_SSL

# Hiển thị danh sách các website
###############################################################
total=${#file_list[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${file_list[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${file_list[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

# Vòng lặp cho việc chọn website
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng website [0 -Thoát]:  "
    read -r choice

    # Nếu chọn 0 thì thoát về menu
    if [[ $choice == "0" ]]; then
        clear
    /etc/dsnvps/menu/dsnvps-letsencrypt-menu # Quay lại menu chính
        exit 0  # Thoát script một cách an toàn
    fi

    # Kiểm tra lựa chọn hợp lệ (số trong danh sách website)
    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#file_list[@]} )); then
        website=${file_list[choice-1]}  # Gán giá trị cho biến website
        break  # Thoát vòng lặp khi có lựa chọn hợp lệ
    else
        echo "Bạn nhập sai, vui lòng nhập lại."
    fi
done
        echo "------------------------------------------------------------------------"
        echo "Vui lòng chờ ..."; sleep 3

    curTime=$(date +%s)
    thoigiangiahangiay=`cat /root/.acme.sh/${website}_ecc/$website.conf | grep Le_NextRenewTime= | sed 's/[^0-9]*//g'`
    hieuthoigianconlai=$(calc $thoigiangiahangiay-$curTime)
    thoigiannengiahan=$(calc $hieuthoigianconlai/60/60/24)
    thoigianconlai=$(calc $thoigiannengiahan+30)

    if [ "$thoigianconlai" -lt 30 ]; then
        echo "------------------------------------------------------------------------"
echo "Chứng chỉ SSL cho $website còn thời hạn: $thoigianconlai ngày"
echo "------------------------------------------------------------------------"
echo "DSNVPS sẽ tiến hành gia hạn chứng chỉ này."
        echo "------------------------------------------------------------------------"
        echo "Vui lòng chờ ..."; sleep 3
        /root/.acme.sh/acme.sh --renew -d $website --force
        curTime2=$(date +%s)
        thoigiangiahangiay2=`cat /root/.acme.sh/${website}_ecc/$website.conf | grep Le_NextRenewTime= | sed 's/[^0-9]*//g'`
        hieuthoigianconlai2=$(calc $thoigiangiahangiay2-$curTime)
        thoigiannengiahan2=$(calc $hieuthoigianconlai2/60/60/24)
        thoigianconlai2=$(calc $thoigiannengiahan2+30)
        clear
        echo "========================================================================="
echo "Hoàn thành gia hạn chứng chỉ SSL cho $website."

echo "========================================================================="
echo "$website đã được gia hạn SSL, thời gian còn lại: $thoigianconlai2 ngày."
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
exit 1

else
clear
echo "========================================================================="
echo "Thời hạn chứng chỉ SSL của $website còn hơn 30 ngày."
echo "-------------------------------------------------------------------------"
echo "Bạn chưa cần gia hạn."
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
exit 0
fi
