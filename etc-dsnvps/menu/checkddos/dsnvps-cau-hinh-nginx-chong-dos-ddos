  if [[ "$line" =~ ^\#?(include\ /etc/nginx/modsec-crs/rules/(REQUEST|RESPONSE)-([0-9]+)-.*\.conf) ]]; then
    rule_number="${BASH_REMATCH[3]}"
    
    # Kiểm tra xem rule_number có phải là một rule hợp lệ không
    if [[ " ${valid_rules[@]} " =~ " $rule_number " ]]; then
