#####################################
toggle_all_rules() {
  local action=$1
  local rule_file="/etc/nginx/modsec/modsecurity_rules.conf"

  if [[ "$action" == "disable" ]]; then
    # Disable tất cả các rule: thêm dấu # vào đầu dòng nếu chưa có
    sed -i 's/^[[:space:]]*\([^#]\)/#\1/' "$rule_file"
  fi
}

enable_selected_rules() {
  local selected_rules=("$@") # Danh sách các rule cần enable
  local rule_file="/etc/nginx/modsec/modsecurity_rules.conf"

  # Enable từng rule trong danh sách: bỏ dấu # nếu có
  for rule in "${selected_rules[@]}"; do
    sed -i "/REQUEST-${rule}/s/^[[:space:]]*#//" "$rule_file"
    sed -i "/RESPONSE-${rule}/s/^[[:space:]]*#//" "$rule_file"  # Thêm dòng này để xử lý các rule RESPONSE
  done
}

update_rules() {
  local selected_rules=("$@") # Lấy danh sách các rule từ người dùng

  # Disable tất cả các rule trước rồi enable các rule được chọn
  toggle_all_rules "disable"
  enable_selected_rules "${selected_rules[@]}"
}

