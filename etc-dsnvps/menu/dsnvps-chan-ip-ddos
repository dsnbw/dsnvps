#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ -f /etc/csf/csf.conf ]; then
test_csf=$(csf -v | awk 'NR==1 {print $NF}')
if [ "$test_csf" == "enable" ]; then
clear
echo "========================================================================="
echo "CSF Firewall đang tắt"
echo "-------------------------------------------------------------------------"
echo "Hãy bật CSF Firewall lên để chạy chức năng này."
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
exit
fi
fi

rm -rf /etc/dsnvps/.tmp/checkchanipcsf*

if [ -f /etc/csf/csf.conf ]; then
echo "========================================================================="
test_csf=$(csf -v | awk 'NR==1 {print $NF}')
if [ "$test_csf" == "enable" ]; then
echo "Chức năng này sẽ bật CSF Firewall nếu bạn đang tắt nó."
echo "-------------------------------------------------------------------------" 
fi
echo "Sử dụng chức năng này để block (chặn) IP truy cập Server."
echo "-------------------------------------------------------------------------"
echo "Sau khi IP bị Block, IP sẽ không thể truy cập các Website trên Server"
echo "-------------------------------------------------------------------------"
echo "Cũng như truy cập SSH... vào Server"
echo "-------------------------------------------------------------------------"
echo -n "Nhập IP bạn muốn Block: "
read ipchan
if [ "$test_csf" == "enable" ]; then
csf -e
fi
if [ "$ipchan" = "" ]; then
clear
echo "========================================================================="
echo "Bạn nhập sai, vui lòng nhập chính xác."
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
exit
fi

csf -d $ipchan > /etc/dsnvps/.tmp/checkchanipcsf

grep "is not a valid" /etc/dsnvps/.tmp/checkchanipcsf > /etc/dsnvps/.tmp/checkchanipcsf1
grep "already" /etc/dsnvps/.tmp/checkchanipcsf > /etc/dsnvps/.tmp/checkchanipcsf2
grep "in the allow" /etc/dsnvps/.tmp/checkchanipcsf > /etc/dsnvps/.tmp/checkchanipcsf3

if [ -f /etc/dsnvps/.tmp/checkchanipcsf1 ]; then
if [ "$(wc -c < /etc/dsnvps/.tmp/checkchanipcsf1)" -gt 1 ]; then
rm -rf /etc/dsnvps/.tmp/checkchanipcsf*
clear
echo "========================================================================="
echo "IP (Dải IP) không hợp lệ"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy nhập lại !"
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
fi
fi

if [ -f /etc/dsnvps/.tmp/checkchanipcsf2 ]; then
if [ "$(wc -c < /etc/dsnvps/.tmp/checkchanipcsf2)" -gt 1 ]; then
rm -rf /etc/dsnvps/.tmp/checkchanipcsf*
clear
echo "========================================================================="
echo "IP (Dải IP) đã bị chặn từ trước!"
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
fi
fi

if [ -f /etc/dsnvps/.tmp/checkchanipcsf3 ]; then
if [ "$(wc -c < /etc/dsnvps/.tmp/checkchanipcsf3)" -gt 1 ]; then
rm -rf /etc/dsnvps/.tmp/checkchanipcsf*
echo "-------------------------------------------------------------------------"
echo "$ipchan hiện đang được thêm vào Whitelist."
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ remove IP (IP range) này ra khỏi Whitelist trước khi block nó"
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."; sleep 6
csf -ar $ipchan
csf -d $ipchan
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
clear
echo "========================================================================="
echo "IP : $ipchan Đã được block thành công. "
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
fi
fi


/etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
clear
echo "========================================================================="
echo "IP (IP Range): $ipchan Đã được block thành công. "
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
else
echo "========================================================================= "
echo "Chức năng này cần CSF Firewall để hoạt động"
echo "-------------------------------------------------------------------------"
echo "CSF Firewall chưa được cài đặt trên server! "
echo "-------------------------------------------------------------------------"
read -r -p "Bạn có muốn cài đặt CSF Firewall [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-cai-dat-csf-csf
clear
echo "========================================================================= "
echo "Cài đặt và cấu hình thành công CSF Firewall."
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
;;
esac
clear
echo "========================================================================= "
echo "Hủy bỏ ! "
/etc/dsnvps/menu/dsnvps-kiem-tra-ddos
exit
fi
