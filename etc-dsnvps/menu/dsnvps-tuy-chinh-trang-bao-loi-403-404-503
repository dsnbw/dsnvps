#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
# Xóa các file tạm thời
rm -rf /etc/dsnvps/.tmp/klaoxcy /etc/dsnvps/.tmp/klaoxcypark

# Đường dẫn cấu hình
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
park_output_file="/etc/dsnvps/.tmp/klaoxcypark"

# Đảm bảo các file đầu ra rỗng
> "$output_file"
> "$park_output_file"

# Duyệt qua tất cả các domain chính
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"

    # Kiểm tra nếu domain có thư mục public_html và vhost tồn tại
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        # Kiểm tra cấu hình lỗi cho domain chính
        if [ -f "$home_folder/$domain/error.conf.d/$domain.conf" ]; then
            echo "$domain**" >> "$output_file"
        else
            echo "$domain" >> "$output_file"
        fi

        # Kiểm tra park domain
        domain_conf_folder="$home_folder/$domain/conf.d"
        if [ -d "$domain_conf_folder" ]; then
            for park_vhost in "$domain_conf_folder"/*.conf; do
                if [ -f "$park_vhost" ]; then
                    park_domain=$(basename "$park_vhost" .conf)
                    park_size=$(wc -c < "$park_vhost")
                    if (( park_size > 400 )); then
                        if [ -f "$home_folder/$domain/error.conf.d/$park_domain/$park_domain.conf" ]; then
                            echo "$park_domain**" >> "$output_file"
                            echo "$park_domain**" >> "$park_output_file"
                        else
                            echo "$park_domain" >> "$output_file"
                            echo "$park_domain" >> "$park_output_file"
                        fi
                    fi
                fi
            done
        fi
    fi
done

# Kiểm tra nếu không có domain hoặc park domain nào được tìm thấy
if [[ ! -s "$output_file" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS đang kiểm tra ......"; sleep 2
    clear
    echo "========================================================================= "
    echo "Không tìm thấy website trên server"
    echo "-------------------------------------------------------------------------"
    echo "Bạn cần thêm Website Vào Server trước khi chạy chức năng này."; sleep 2
    /etc/dsnvps/menu/dsnvps-tien-ich
    exit
fi

echo "========================================================================= "
echo "Sử dụng chức năng này BẬT/TẮT tùy chỉnh trang báo lỗi 401, 403, 404,"
echo "-------------------------------------------------------------------------"
echo " 502... cho website, thay cho các trang thông báo lỗi mặc định của Nginx."
echo "-------------------------------------------------------------------------"
echo "Hướng dẫn sử dụng: http://go.dsnvps/4944"
echo "========================================================================= "
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/klaoxcy
echo "Danh sách website & Park domains trên server:  | ** : Config đang BẬT"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${danh_sach_website[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${danh_sach_website[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
                sleep 3 && tput cuu 4 && tput ed
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
dsnvps
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//')
        break  # Thoat vong lap neu lua chon hop le
    else
    echo "-------------------------------------------------------------------------"
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
        sleep 3 && tput cuu 4 && tput ed
    fi
done

if [[ -s "/etc/dsnvps/.tmp/klaoxcypark" ]] ; then
sed -i 's/\*\*$//' /etc/dsnvps/.tmp/klaoxcypark
fi

##### Kiem tra park domain truoc:


if [[ -s "/etc/dsnvps/.tmp/klaoxcypark" ]] && grep -Fxq "$website" /etc/dsnvps/.tmp/klaoxcypark; then   # Park Domains
    home_folder="/home"
    for domain in "$home_folder"/*; do
        domain_name=$(basename "$domain")
        park_vhost="$domain/conf.d/$website.conf"
        if [[ -f "$park_vhost" ]]; then
            echo "$domain_name" > /etc/dsnvps/.tmp/kl0zx
            break
        fi
    done
    mainwebsite=$(cat /etc/dsnvps/.tmp/kl0zx)
    if [ ! -d /home/$mainwebsite/errorpage_html ]; then
    yes | cp -rf /etc/dsnvps/menu/inc/errorpage_html /home/$mainwebsite > /dev/null 2>&1
fi

    mkdir -p "/home/$mainwebsite/error.conf.d"

###################################################################################

    if [ -f "/home/$mainwebsite/error.conf.d/$website/$website.conf" ]; then
echo "========================================================================="
echo "Website được chọn: $website"
echo "========================================================================="
echo "Tùy chỉnh trang thông báo cho $website đang BẬT"
echo "========================================================================="
read -p "Bạn có muốn TẮT nó? (y/n): " confirm
        if [[ "$(echo "${confirm}" | tr '[:upper:]' '[:lower:]')" == "y" ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng chờ ..."; sleep 2
            rm -rf "/home/$mainwebsite/error.conf.d/$website/$website.conf"
            sed -i '/error\.conf\.d/d' /home/$mainwebsite/conf.d/$website.conf
            systemctl reload nginx 
            clear
            echo "========================================================================="        
 echo "Đã TẮT tùy chỉnh thông báo lỗi cho $website."
            /etc/dsnvps/menu/dsnvps-tien-ich
            exit
        else
    clear
        echo "========================================================================="
        echo "Huỷ bỏ !"
            /etc/dsnvps/menu/dsnvps-tien-ich
            exit 0
        fi
    else
       echo "========================================================================="
echo "Website được chọn: $website"
echo "========================================================================="
echo "Sau khi BẬT, bạn có thể chỉnh sửa trang thông báo lỗi trong:"
echo "-------------------------------------------------------------------------"
echo "/home/$mainwebsite/errorpage_html"
echo "========================================================================="
echo "Tùy chỉnh trang thông báo cho $website đang TẮT"
echo "========================================================================="
read -p "Bạn có muốn BẬT nó? (y/n): " confirm
        if [[ "$(echo "${confirm}" | tr '[:upper:]' '[:lower:]')" == "y" ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng chờ ..."; sleep 2
            mkdir -p "/home/$mainwebsite/error.conf.d"
            mkdir -p /home/$mainwebsite/error.conf.d/$website
            cat > "/home/$mainwebsite/error.conf.d/$website/$website.conf" <<EOF
# Error Page
error_page 401 /errorpage_html/401.html;
error_page 403 /errorpage_html/403.html;
error_page 404 /errorpage_html/404.html;
error_page 405 /errorpage_html/405.html;
error_page 502 /errorpage_html/502.html;
error_page 503 /errorpage_html/503.html;
error_page 504 /errorpage_html/504.html;
location ^~ /errorpage_html/ {
   internal;
    root /home/$mainwebsite;
    access_log              off;
}
EOF


if [ -f "/home/$mainwebsite/conf.d/$website.conf" ]; then
    if ! grep -q "error\.conf\.d/$website" "/home/$mainwebsite/conf.d/$website.conf"; then
        sed -i '/staticfiles\.conf/a include /home/'"$mainwebsite"'/error.conf.d/'"$website"'/*.conf;' "/home/$mainwebsite/conf.d/$website.conf"
    fi
fi
            systemctl reload nginx #|| { echo "Không thể reload nginx"; exit 1; }
            clear
            echo "========================================================================="        
echo "Đã BẬT tùy chỉnh thông báo lỗi cho $website."
echo "-------------------------------------------------------------------------"
echo "Chỉnh sửa thông báo lỗi của $website trong:"

            echo "-------------------------------------------------------------------------"
            echo "/home/$mainwebsite/errorpage_html"; sleep 2
/etc/dsnvps/menu/dsnvps-tien-ich
        else
    clear
        echo "========================================================================="
        echo "Huỷ bỏ !"
            /etc/dsnvps/menu/dsnvps-tien-ich
            exit 0
        fi
    fi
fi
###################################################
# Domain binh thuong
##########################################
###########################################################

if [ -f "/etc/nginx/conf.d/$website.conf" ]; then
    if ! grep -q "error\.conf\.d/" "/etc/nginx/conf.d/$website.conf"; then
        sed -i '/staticfiles/a include /home/'"$website"'/error.conf.d/*.conf;' "/etc/nginx/conf.d/$website.conf"
    fi
fi
     
if [ ! -d /home/$website/errorpage_html ]; then
    yes | cp -rf /etc/dsnvps/menu/inc/errorpage_html /home/$website > /dev/null 2>&1
fi


if [ ! -d /home/$website/error.conf.d ]; then
    mkdir -p /home/$website/error.conf.d
fi

#echo "###################################################################################"

if [ -f "/home/$website/error.conf.d/$website.conf" ]; then
      echo "========================================================================="
echo "Website được chọn: $website"
echo "========================================================================="
echo "Tùy chỉnh trang thông báo cho $website đang BẬT"
echo "========================================================================="
read -p "Bạn có muốn TẮT nó không? (y/n): " confirm

    if [[ "$(echo "${confirm}" | tr '[:upper:]' '[:lower:]')" == "y" ]]; then
        echo "-------------------------------------------------------------------------"
        echo "Vui lòng chờ ..."; sleep 2
        rm -f /home/$website/error.conf.d/$website.conf
        sed -i '/error\.conf\.d\/\*\.conf;/d' /etc/nginx/conf.d/$website.conf
        systemctl reload nginx
        clear
echo "========================================================================="
echo "Đã TẮT tùy chỉnh thông báo lỗi cho $website."; sleep 2

        /etc/dsnvps/menu/dsnvps-tien-ich
        exit
    else
     clear
        echo "========================================================================="
        echo "Huỷ bỏ !"
        /etc/dsnvps/menu/dsnvps-tien-ich
        exit 0
    fi
else
      echo "========================================================================="
echo "Website được chọn: $website"
echo "========================================================================="
echo "Sau khi BẬT, bạn có thể chỉnh sửa trang thông báo lỗi trong:"
echo "-------------------------------------------------------------------------"
echo "/home/$website/errorpage_html"
echo "========================================================================="
echo "Tùy chỉnh thông báo cho $website đang TẮT"
echo "========================================================================="
read -p "Bạn có muốn BẬT nó không? (y/n): " confirm

    if [[ "$(echo "${confirm}" | tr '[:upper:]' '[:lower:]')" == "y" ]]; then
        echo "-------------------------------------------------------------------------"
        echo "Vui lòng chờ ..."; sleep 2
        cat > "/home/$website/error.conf.d/$website.conf" <<EOF
# Error Page
error_page 401 /errorpage_html/401.html;
error_page 403 /errorpage_html/403.html;
error_page 404 /errorpage_html/404.html;
error_page 405 /errorpage_html/405.html;
error_page 502 /errorpage_html/502.html;
error_page 503 /errorpage_html/503.html;
error_page 504 /errorpage_html/504.html;
location ^~ /errorpage_html/ {
    internal;
    root /home/$website;
    access_log              off;
}
EOF
        systemctl reload nginx 
 echo "========================================================================="
echo "Đã BẬT tùy chỉnh thông báo lỗi cho $website."
echo "-------------------------------------------------------------------------"
echo "Chỉnh sửa thông báo lỗi của $website trong:"
echo "-------------------------------------------------------------------------"
echo "/home/$website/errorpage_html"; sleep 5
clear
echo "========================================================================="
echo "Đã BẬT tùy chỉnh thông báo lỗi cho $website."
echo "-------------------------------------------------------------------------"
echo "Chỉnh sửa thông báo lỗi của $website trong:"

        echo "-------------------------------------------------------------------------"
        echo "/home/$website/errorpage_html"
                dsnvps
    else
    clear
        echo "========================================================================="
        echo "Huỷ bỏ !"
        /etc/dsnvps/menu/dsnvps-tien-ich
        exit 0
    fi
fi
