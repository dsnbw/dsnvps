#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ -f /etc/csf/csf.conf ]; then
test_csf=$(csf -v | awk 'NR==1 {print $NF}')
if [ "$test_csf" == "enable" ]; then
clear
echo "========================================================================="
echo "CSF Firewall đang tắt"
echo "-------------------------------------------------------------------------"
echo "Hãy bật CSF Firewall lên để chạy chức năng này."
echo "-------------------------------------------------------------------------"
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-menu
exit
fi
fi


if [ -f /etc/csf/csf.conf ]; then
if [ "$(cat /etc/csf/csf.deny | awk 'NR==1 {print $1}')" == "" ]; then
clear
echo "========================================================================="
echo "Hiện tại CSF Firewall chưa block IP nào."
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-menu
exit
fi
fi
if [ -f /etc/csf/csf.conf ]; then
echo "========================================================================="
test_csf=$(csf -v | awk 'NR==1 {print $NF}')
if [ "$test_csf" == "enable" ]; then
echo "Chức năng này sẽ bật CSF Firewall nếu bạn đang tắt nó."
echo "-------------------------------------------------------------------------" 
fi
if [ "$test_csf" == "enable" ]; then
csf -e
fi


rm -r -f /home/$mainsite/private_html/csf-block.txt
rm -rf /etc/dsnvps/.tmp/csf-block.txt
cp /etc/csf/csf.deny /home/$mainsite/private_html/csf-block.txt
cp /etc/csf/csf.deny /etc/dsnvps/.tmp/csf-block.txt
chmod -R 644 /home/$mainsite/private_html/csf-block.txt
date=$(date +"%Y-%m-%d %H:%M:%S")
sed -i "1s|^| List IP was blocked by CSF FireWall - Created by DSNVPS on ${date}\n\n|" /home/$mainsite/private_html/csf-block.txt
clear
/etc/dsnvps/menu/dsnvps-menu-all-function   
printf "=========================================================================\n"
printf "                  Danh Sách IP Block Bởi CSF Firewall \n"
printf "=========================================================================\n"
cat /etc/csf/csf.deny
echo "========================================================================= "
echo "Link xem trên trình duyệt:"
echo "-------------------------------------------------------------------------"
echo "http://$serverip_priport/csf-block.txt"
echo "========================================================================= "
read -p "Nhấn [Enter] để quay trở lại DSNVPS menu ..."
clear
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-menu




else
echo "========================================================================= "
echo "Chức năng này cần CSF Firewall để hoạt động"
echo "-------------------------------------------------------------------------"
echo "CSF Firewall chưa được cài đặt trên server! "
echo "-------------------------------------------------------------------------"
read -r -p "Bạn có muốn cài đặt CSF Firewall [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-cai-dat-csf-csf
clear
echo "========================================================================= "
echo "Cài đặt và cấu hình thành công CSF Firewall"
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-menu
;;
esac
clear
echo "========================================================================= "
echo "Bạn hủy bỏ cài đặt CSF Firewall ! "
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-menu
exit
fi
