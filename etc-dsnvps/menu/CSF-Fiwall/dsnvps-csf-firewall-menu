    4) /etc/dsnvps/menu/CSF-Fiwall/dsnvps-bo-chan-tat-ca-ip;;
    5) /etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-allow;;
    6) /etc/dsnvps/menu/CSF-Fiwall/dsnvps-remove-ip-khoi-csf-allow;;
    7) /etc/dsnvps/menu/CSF-Fiwall/dsnvps-csf-firewall-block-country;;
