#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed



if [ -f /etc/csf/csf.conf ]; then
show_phan_tren_menu()
{

/etc/dsnvps/menu/dsnvps-menu-all-function  
printf "=========================================================================\n"
echo "                            Quản Lý CSF Firewall                                "
printf "=========================================================================\n"


if [ ! -f "/etc/csf/csf.conf" ]; then
    echo "                          CSF Firewall: Chưa cài đặt"
else
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
    csf -v > /etc/dsnvps/.tmp/dsnvpscheckcscfstatus
    if [ "$(grep disabled /etc/dsnvps/.tmp/dsnvpscheckcscfstatus)" = "" ]; then
echo "    CSF Firewall: installed | Status: Running | Version: $(csf -v | grep -o 'v[0-9]\+\.[0-9]\+' | sed 's/^v//' | xargs)"
    else
echo "                  CSF Firewall: Đã cài đặt nhưng đang Tắt"
    fi
fi


if [ -f "/etc/csf/csf.conf" ]; then
if [ ! -f /etc/csf/csf.deny ]; then
cat > "/etc/csf/csf.deny" <<END
END
fi
fi

if [ -f /etc/csf/csf.deny ]; then
if [ "$(cat /etc/csf/csf.deny | awk 'NR==2 {print $2}')" == "Copyright" ]; then
rm -rf /etc/csf/csf.deny
cat > "/etc/csf/csf.deny" <<END
END
fi
fi

printf "=========================================================================\n"
echo "========================================================================="
}
while true; do
clear
show_phan_tren_menu
printf "%-34s %s\n" " 1) Block (Chặn) IP" "8) Bỏ Chặn Tất Cả Quốc Gia"
