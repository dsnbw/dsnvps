#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
rm -rf /etc/dsnvps/.tmp/check.parkdomain*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word

if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` == "server_names_hash_bucket_sizeoksuccessful" ]; then
rm -rf etc/nginx/conf.d/dsnvpscheck.del.conf
clear
echo "========================================================================="
echo "Ban da Thêm rat nhieu domain vao VPS."
echo "-------------------------------------------------------------------------"
echo "Ban vui long su dung dich vu toi uu va fix loi VPS de tiep tuc add domain"
echo "-------------------------------------------------------------------------"
echo "Link: http://dsnvps/dich-vu"
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
fi

if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` != "oksuccessful" ]; then 
echo "-------------------------------------------------------------------------" 
echo "Phát hiện lỗi .... " ; sleep 3
clear
echo "========================================================================="
echo "Dịch vụ Nginx đang bị lỗi. DSNVPS không thể thực hiện chức năng này."
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
echo "-------------------------------------------------------------------------"
echo "Trạng thái Nginx:"
echo "-------------------------------------------------------------------------"
nginx -t
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
exit
fi
fi

rm -rf /usr/local/testnginx
mkdir -p /usr/local/testnginx
website=`cat /etc/dsnvps/.tmp/websitenhap.test`
website=`echo $website | tr '[A-Z]' '[a-z]'`
#################################################################
## Check WWW or NON_WWW Domain                                 ##
if [ $(echo "$website" | cut -c 1-4) == "www." ]; then
website_redirect=$(echo "$website" | sed 's/....//')
else
website_redirect=www.$website
fi
#################################################################
	cat > "/etc/nginx/conf.d/dsnvpscheck.del.conf" <<END
server {
	    server_name $website $website_redirect;
	    rewrite ^(.*) http://dsnvpscheck.del\$1 permanent;
    	}
server {
	    listen   80;

    	access_log off;
    	error_log off;
		root /usr/local/testnginx;
#include /etc/nginx/conf/ddos2.conf;
	index index.php index.html index.htm;
    	server_name dsnvpscheck.del;
#include /etc/nginx/conf/all.conf;
    }
END
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word
if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` != "oksuccessful" ]; then 
echo "-------------------------------------------------------------------------"
echo "DSNVPS đang kiểm tra ..."; sleep 4 
tput cuu1  # Di chuyển con trỏ lên một dòng
tput el    # Xóa dòng hiện tại
echo "Phát hiện lỗi .... " ; sleep 4
clear
rm -rf /usr/local/testnginx
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
rm -rf /etc/nginx/conf.d/dsnvpscheck.del.conf
rm -rf /etc/dsnvps/.tmp/websitenhap.test

rm -rf /etc/dsnvps/.tmp/check.parkdomain* 
#################################################################
## Check WWW or NON_WWW Domain                                 ##
if [ $(echo "$website" | cut -c 1-4) == "www." ]; then
website=$(echo "$website" | sed 's/....//')
fi
#################################################################
find /etc/nginx/conf.d/ -name "*.conf" > /etc/dsnvps/.tmp/check.parkdomain.list
vhostcheck=$(cat /etc/dsnvps/.tmp/check.parkdomain.list)
for vhost in $vhostcheck 
do
grep $website $vhost > /etc/dsnvps/.tmp/check.parkdomain
if [ `ls -l /etc/dsnvps/.tmp/check.parkdomain | awk '{print $5}'` -gt 10 ] && [ `ls -l /etc/dsnvps/.tmp/check.parkdomain | awk '{print $5}'` -lt 300 ] ; then
echo "$vhost" >> /etc/dsnvps/.tmp/check.parkdomain.ketqua
fi
done
echo "========================================================================="
echo "Domain $website bạn muốn thêm vào có vấn đề !"
echo "-------------------------------------------------------------------------"
echo "Domain này đã tồn tại trên VPS dưới dạng PARK hoặc REDIRECT domain"
echo "-------------------------------------------------------------------------"
echo "hoặc Reverse Domain hoặc Wordpress Multisite. Bạn hãy thêm domain khác."
sleep 3
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
else
rm -rf /usr/local/testnginx
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
rm -rf /etc/nginx/conf.d/dsnvpscheck.del.conf
rm -rf /etc/dsnvps/.tmp/websitenhap.test
fi
fi
rm -rf /usr/local/testnginx
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
rm -rf /etc/nginx/conf.d/dsnvpscheck.del.conf
rm -rf /etc/dsnvps/.tmp/websitenhap.test
