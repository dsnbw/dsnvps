#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/wordpresslist
cd /etc/nginx/conf.d
ls > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
cd
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/wordpresslist
file1="/etc/dsnvps/.tmp/dsnvps-websitelist"
while read -r wpsite
    do
if [ -f /home/$wpsite/public_html/wp-config.php ]; then
echo "$wpsite" >> /etc/dsnvps/.tmp/wordpresslist
fi
 done < "$file1"
 if [ ! -f /etc/dsnvps/.tmp/wordpresslist ]; then
clear
echo "========================================================================="
 echo "DSNVPS không tìm thấy website chạy Wordpress Code trên Server."
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
 exit
 fi

echo "========================================================================="
echo "Sử dụng chức năng này để fix lỗi [Missed Schedule] cho WP Website" 
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ cài đặt plugin: [Missed Scheduled Posts Publisher] "
echo "-------------------------------------------------------------------------"
echo "Plugin này sẽ tự động republish những post bị lỗi Missed Schedule nhưng "
echo "-------------------------------------------------------------------------"
echo "gần như không tiêu tốn tài nguyên server."
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/wordpresslist
echo "========================================================================="
echo "Danh sách các website trên server:"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${danh_sach_website[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${danh_sach_website[right_index-1]}"      # Tên database bên phải
        printf "%-4s %-30s %-4s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-4s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=${danh_sach_website[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

if [ -d /home/$website/public_html/wp-content/plugins/missed-scheduled-posts-publisher ]; then
clear
echo "========================================================================="
echo "Bạn đã cài đặt plugin missed-scheduled-posts-publisher!"
echo "-------------------------------------------------------------------------"
echo "Hãy active nếu bạn đang TẮT nó."
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
exit
fi

echo "========================================================================="
read -r -p "Bạn muốn fix lỗi Missed Schedule cho $website ?  [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ..."    		
    sleep 2
cd /home/$website/public_html
/etc/dsnvps/menu/dsnvps-enable-tat-ca-cac-ham-php-php.ini
wp plugin install missed-scheduled-posts-publisher --activate --allow-root
#wp plugin activate wp-missed-schedule --allow-root
/etc/dsnvps/menu/dsnvps-re-config-cac-ham-php-disable-php.ini
cd

/etc/dsnvps/menu/inc/re-start-php-fpm-service 

clear
echo "========================================================================="
if [ -d /home/$website/public_html/wp-content/plugins/missed-scheduled-posts-publisher ]; then
echo "Fix lỗi Missed Schedule cho $website thành công !"
else
echo "Fix lỗi Missed Schedule chưa hoàn thành !"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại!"
fi
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
        ;;
    *)
       clear
    echo "========================================================================="
   echo "Hủy bỏ!"
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
        ;;
esac
exit

