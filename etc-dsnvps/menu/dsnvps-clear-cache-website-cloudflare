#!/bin/bash
. /root/dsnvps.conf

# Functions từ dsnvps-ssl-cloudflare-check-api-global
validate_ssl_api_token() {
    local email="$1"
    local api_key="$2"
    
    if [ -z "$api_key" ]; then
        return 1
    fi
    
    if [ -n "$email" ]; then
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user" \
             -H "X-Auth-Email: $email" \
             -H "X-Auth-Key: $api_key" \
             -H "Content-Type: application/json")
    else
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
             -H "Authorization: Bearer $api_key" \
             -H "Content-Type: application/json")
    fi
    
    if echo "$response" | grep -q '"success":true'; then
        return 0
    else
        return 1
    fi
}

get_zone_id_for_ssl() {
    local domain="$1"
    local email="$2"
    local api_key="$3"
    local main_domain
    
    if [ -z "$domain" ] || [ -z "$api_key" ]; then
        return 1
    fi
    
    local main_domain="$domain"
    if [[ "$domain" == www.* ]]; then
        main_domain="${domain#www.}"
    fi
    
    if is_subdomain_accurate "$domain"; then
        main_domain=$(get_main_domain "$domain")
    fi
    
    if [ -n "$email" ]; then
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${main_domain}" \
             -H "X-Auth-Email: $email" \
             -H "X-Auth-Key: $api_key" \
             -H "Content-Type: application/json")
    else
        local response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${main_domain}" \
             -H "Authorization: Bearer $api_key" \
             -H "Content-Type: application/json")
    fi
    
    local zone_id=$(echo "$response" | grep -o '"id":"[^"]*"' | head -n 1 | sed 's/"id":"//' | sed 's/"//')
    
    if [ -n "$zone_id" ]; then
        echo "$zone_id"
        return 0
    else
        return 1
    fi
}

get_main_domain() {
    local subdomain="$1"
    
    echo "$subdomain" | sed 's/^[^.]*\.//'
}

find_public_suffix() {
    local domain="$1"
    local psl_file="/etc/dsnvps/public_suffix_list.dat"
    
    if [ ! -f "$psl_file" ]; then
        return 1
    fi
    
    local longest_suffix=""
    local domain_lower=$(echo "$domain" | tr '[:upper:]' '[:lower:]')
    
    while IFS= read -r line; do
        if [[ "$line" =~ ^[[:space:]]*$ ]] || [[ "$line" =~ ^// ]]; then
            continue
        fi
        
        if [[ "$line" =~ ^\* ]] || [[ "$line" =~ ^! ]]; then
            continue
        fi
        
        if [[ "$domain_lower" =~ \.$line$ ]] || [[ "$domain_lower" == "$line" ]]; then
            if [ ${#line} -gt ${#longest_suffix} ]; then
                longest_suffix="$line"
            fi
        fi
    done < "$psl_file"
    
    if [ -n "$longest_suffix" ]; then
        echo "$longest_suffix"
        return 0
    fi
    
    return 1
}

is_subdomain_accurate() {
    local domain="$1"
    
    if [[ ! "$domain" =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]]; then
        return 1
    fi
    
    if [ -f "/etc/dsnvps/public_suffix_list.dat" ]; then
        local suffix=$(find_public_suffix "$domain")
        
        if [ -n "$suffix" ]; then
            local domain_part=$(echo "$domain" | sed "s/\.$suffix$//")
            local dot_count=$(echo "$domain_part" | tr -cd '.' | wc -c)
            
            if [[ "$domain_part" == "www" ]] || [[ "$domain_part" =~ ^www\. ]]; then
                return 1
            fi
            
            return $((dot_count >= 1 ? 0 : 1))
        fi
    fi
    
    local domain_lower=$(echo "$domain" | tr '[:upper:]' '[:lower:]')
    
    local complex_tlds=(
        "co.uk" "com.au" "gov.uk" "org.uk" "net.au" "com.vn" "com.br"
        "co.jp" "co.kr" "com.cn" "com.tw" "com.hk" "com.sg"
        "co.za" "co.in" "com.mx" "com.ar" "com.pe" "com.cl"
    )
    
    for tld in "${complex_tlds[@]}"; do
        if [[ "$domain_lower" =~ \.$tld$ ]]; then
            local domain_part=$(echo "$domain" | sed "s/\.$tld$//")
            local dot_count=$(echo "$domain_part" | tr -cd '.' | wc -c)
            
            if [[ "$domain_part" == "www" ]] || [[ "$domain_part" =~ ^www\. ]]; then
                return 1
            fi
            
            return $((dot_count >= 1 ? 0 : 1))
        fi
    done
    
    local dot_count=$(echo "$domain" | tr -cd '.' | wc -c)
    
    if [[ "$domain" == www.* ]]; then
        return 1
    fi
    
    return $((dot_count >= 2 ? 0 : 1))
}

if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Kiểm tra file API Cloudflare
if [ ! -f /etc/dsnvps/ssl-cloudflare-api-global.conf ]; then
    echo "========================================================================="
    echo "DSNVPS chưa được cấu hình Cloudflare API."
    echo "-------------------------------------------------------------------------"
    echo "Bạn cần cấu hình Cloudflare API trước khi sử dụng chức năng này."
    echo "-------------------------------------------------------------------------"
    echo "Hãy vào chức năng [ Cài Đặt CloudFlare SSL (15 Năm) ] để cấu hình"
    echo "-------------------------------------------------------------------------"
