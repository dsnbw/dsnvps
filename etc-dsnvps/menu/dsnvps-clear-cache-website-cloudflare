fi

# Source file API
source /etc/dsnvps/ssl-cloudflare-api-global.conf

# Kiểm tra API có hợp lệ không
if [ -z "$global_ssl_api_token" ]; then
    echo "========================================================================="
    echo "Cloudflare API Token không được cấu hình."
    echo "-------------------------------------------------------------------------"
    echo "Hãy vào chức năng [ Cài Đặt CloudFlare SSL (15 Năm) ] để cấu hình"
    echo "========================================================================="
    sleep 2
    dsnvps
    exit
fi

# Validate API
if [ -n "$global_ssl_api_email" ]; then
    # Global API Key
    if ! validate_ssl_api_token "$global_ssl_api_email" "$global_ssl_api_token"; then
        echo "========================================================================="
        echo "Cloudflare Global API Key không hợp lệ."
        echo "-------------------------------------------------------------------------"
        echo "Hãy vào chức năng [ Cài Đặt CloudFlare SSL (15 Năm) ] để cấu hình"
        echo "========================================================================="
        sleep 2
        dsnvps
        exit
    fi
else
    # API Token
    if ! validate_ssl_api_token "" "$global_ssl_api_token"; then
        echo "========================================================================="
        echo "Cloudflare API Token không hợp lệ."
        echo "-------------------------------------------------------------------------"
        echo "Hãy vào chức năng [ Cài Đặt CloudFlare SSL (15 Năm) ] để cấu hình"
        echo "========================================================================="
        sleep 2
        dsnvps
        exit
    fi
fi

# Tạo thư mục tmp nếu chưa có
if [ ! -d /etc/dsnvps/.tmp ]; then
    mkdir -p /etc/dsnvps/.tmp
fi

# Xóa file cũ nếu tồn tại
rm -rf /etc/dsnvps/.tmp/klaoxcy
rm -rf /etc/dsnvps/.tmp/klaoxcypark

######################################################
#lay Danh Sách Website Trên Server####################
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
# Xóa file cũ nếu tồn tại
true > "$output_file"
# Duyệt qua tất cả các file .conf trong thư mục cấu hình Nginx
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"
    # Kiểm tra nếu domain có thư mục public_html trong /home và vhost trong /etc/nginx/conf.d/
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        echo "$domain" >> "$output_file"
    fi
done
# Kiểm tra nếu không có domain nào được tìm thấy
if [[ ! -s "$output_file" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS đang kiểm tra ......"; sleep 2
    clear
    echo "========================================================================= "
    echo "Không tìm thấy website trên server"
    echo "-------------------------------------------------------------------------"
    echo "Bạn cần thêm Website vào Server trước khi chạy chức năng này."; sleep 2
    dsnvps
    exit
fi
########################################################
klaoxcy_file="/etc/dsnvps/.tmp/klaoxcy"
nginx_conf_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcypark"
# Xóa file kết quả cũ nếu tồn tại
true > "$output_file"
if [[ -s "$klaoxcy_file" ]]; then
    while IFS= read -r domain; do
        domain_conf_folder="$nginx_conf_folder/$domain/conf.d"
        if [[ "$domain" != "$mainsite" && -d "$domain_conf_folder" ]]; then
            # Kiểm tra nếu thư mục có file .conf
            if compgen -G "$domain_conf_folder"/*.conf > /dev/null; then
                for vhost in "$domain_conf_folder"/*.conf; do
                    subdomain=$(basename "$vhost" .conf)
                    # Kiểm tra nếu subdomain không phải domain chính
                    if [[ "$subdomain" != "$domain" ]]; then
                        # Kiểm tra độ dài file vhost
                        vhost_length=$(wc -c < "$vhost")
                        if (( vhost_length > 200 )); then
                            echo "$subdomain**" >> "$output_file"
                        fi
                    fi
                done
            fi
        fi
    done < "$klaoxcy_file"
fi
# Kiểm tra và thông báo kết quả
if [[ -s "$output_file" ]]; then
    cat /etc/dsnvps/.tmp/klaoxcypark >> /etc/dsnvps/.tmp/klaoxcy
fi
if [[ ! -z "$domainquanly" ]]; then
    # Thêm (DQL) domainquanly vào file /etc/dsnvps/.tmp/klaoxcy
    echo "$domainquanly (QL)" >> /etc/dsnvps/.tmp/klaoxcy
fi

# Function để clear cache Cloudflare
clear_cloudflare_cache() {
    local domain="$1"
    local email="$2"
    local api_token="$3"
    
    # Xác định domain chính để clear cache
    local main_domain="$domain"
    
    # Xử lý www domain
    if [[ "$domain" == www.* ]]; then
        main_domain="${domain#www.}"
    fi
    
    # Xử lý subdomain
    if is_subdomain_accurate "$domain"; then
        main_domain=$(get_main_domain "$domain")
    fi
    
    # Lấy zone ID cho domain chính
    local zone_id=$(get_zone_id_for_ssl "$main_domain" "$email" "$api_token")
    
    if [ -z "$zone_id" ]; then
    sleep 3
    clear
        echo "========================================================================="
        echo "Domain '$domain' không thuộc tài khoản Cloudflare của bạn."
        echo "-------------------------------------------------------------------------"
        echo "DSNVPS không thể thực hiện chức năng này."
        echo "========================================================================="
        return 1
    fi
    
    echo "Đang xóa cache cho domain: $main_domain"; sleep 2
    tput cuu 1 && tput ed
    
    # Thực hiện purge cache
    local response=""
    if [ -n "$email" ]; then
        # Global API Key
        response=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/$zone_id/purge_cache" \
             -H "X-Auth-Email: $email" \
             -H "X-Auth-Key: $api_token" \
             -H "Content-Type: application/json" \
             -d '{"purge_everything":true}')
    else
        # API Token
        response=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/$zone_id/purge_cache" \
             -H "Authorization: Bearer $api_token" \
             -H "Content-Type: application/json" \
             -d '{"purge_everything":true}')
    fi
    
    # Kiểm tra kết quả
    local success_value=$(echo "$response" | jq -r '.success' 2>/dev/null)
    
    if [ "$success_value" = "true" ]; then
        echo "=> $main_domain => Xóa cache thành công."; sleep 2
        return 0
    else
        
        echo "========================================================================="
        echo "Không thể xóa cache cho domain: $main_domain"
        echo "-------------------------------------------------------------------------"
        echo "Chi tiết lỗi:"
        
        # Kiểm tra loại lỗi cụ thể
        if echo "$response" | grep -q "Authentication error"; then
            echo "API Token không có quyền truy cập vào zone '$main_domain'"
            echo "-------------------------------------------------------------------------"
            echo "Để sửa lỗi này:"
            echo "1. Vào Cloudflare Dashboard → My Profile → API Tokens"
            echo "2. Chỉnh sửa API Token hiện tại"
            echo "3. Thêm quyền 'Zone:Read' và 'Cache Purge:Edit' cho zone '$main_domain'"
            echo "4. Hoặc sử dụng Global API Key thay vì API Token"
        elif echo "$response" | grep -q "Invalid zone"; then
            echo "Zone '$main_domain' không tồn tại trong tài khoản Cloudflare của bạn"
        else
            # Hiển thị lỗi từ API
            echo "$response" | jq -r '.errors[0].message' 2>/dev/null || echo "$response"
        fi
        
        echo "========================================================================="
        sleep2
        return 1
    fi
}

# Main loop
/etc/dsnvps/menu/dsnvps-menu-all-function  
while true; do
    echo "========================================================================="
    echo "CLEAR CACHE CLOUDFLARE CHO DOMAIN"
    echo "========================================================================="
    echo "Sử dụng chức năng này để xóa cache Cloudflare, giúp website tải nội dung "
    echo "-------------------------------------------------------------------------"
    echo "mới nhất ngay lập tức. "
    echo "-------------------------------------------------------------------------"
    echo "Khi cập nhật file (css, js, image, video...) nhưng website vẫn hiển   "
    echo "-------------------------------------------------------------------------"
    echo "thị nội dung cũ, hãy dùng chức năng này."
    echo "========================================================================="
    echo "========================================================================="
    mapfile -t danh_sach_website < /etc/dsnvps/.tmp/klaoxcy
    echo "Danh sách các website & Park domains trên server:  | ** : Park Domains"
    echo "-------------------------------------------------------------------------"
    ###############################################################
    total=${#danh_sach_website[@]}
    half=$(( (total + 1) / 2 ))  
    for ((i = 0; i < half; i++)); do
        left_index=$((i + 1))                         
        right_index=$((half + i + 1))                
        left_db="${danh_sach_website[i]:- }"                    
        if (( right_index <= total )); then           
            right_db="${danh_sach_website[right_index-1]}"      
            printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
        else
            printf "%-1s %-30s\n" "$left_index." "$left_db"
        fi
    done
    ###############################################################
    echo "========================================================================="
    
    while true; do
        echo -n "Nhập số tương ứng với domain muốn clear cache [0 -Thoát]: " 
        read -r lua_chon
        
        # Kiểm tra nếu không nhập gì hoặc nhập không hợp lệ
        if [[ -z "$lua_chon" ]]; then
            echo "Vui lòng nhập một số hợp lệ."
            continue
        elif [[ "$lua_chon" == "0" ]]; then
            clear
            dsnvps
            exit
        elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
            website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//' | sed 's/ (QL)$//')
            break  # Thoát vòng lặp nếu lựa chọn hợp lệ
        else
            echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
        fi
    done
    
    echo "========================================================================="
    echo "Bạn chọn: $website"; sleep 2
    tput cuu 1 && tput ed
    
    # Kiểm tra và thông báo nếu là subdomain
    if is_subdomain_accurate "$website"; then
        main_domain=$(get_main_domain "$website")

        echo "=> Bạn đã chọn subdomain: $website"
        echo "-------------------------------------------------------------------------"
        echo "Đây là subdomain của domain: $main_domain"
        echo "-------------------------------------------------------------------------"
        echo "Khi xóa cache cho subdomain này, Cloudflare sẽ xóa cache của:"
        echo "-------------------------------------------------------------------------"
        echo "-> Toàn bộ subdomain thuộc $main_domain"
        echo "-> Domain $main_domain"
        echo "-------------------------------------------------------------------------"
        echo "Bạn có muốn tiếp tục không?"
        echo "========================================================================="
        
        while true; do
            echo -n "Lựa chọn của bạn ? [y/n]: "
            read -r confirm
            case $confirm in
                [Yy]|[Yy][Ee][Ss])
        #            echo "-------------------------------------------------------------------------"  
       #             echo "Tiếp tục xóa cache..."; sleep 1
                    break
                    ;;
                [Nn]|[Nn][Oo])
                    echo "Hủy."; sleep 2
                    tput cuu 14 && tput ed
                    clear
                    continue 2  # Quay lại menu chọn domain
                    ;;
                *)
                    echo "Vui lòng nhập y (yes) hoặc n (no)"
                    ;;
            esac
        done
    fi
    
    # Thực hiện clear cache
    if clear_cloudflare_cache "$website" "$global_ssl_api_email" "$global_ssl_api_token"; then
    sleep 2 && tput cuu 14 && tput ed
    clear
        echo "========================================================================="
        echo -e "\033[31m==> Hoàn thành xóa cache cho website!\033[0m"
        
        # Thông báo chi tiết về domain đã clear cache
        if is_subdomain_accurate "$website"; then
            main_domain=$(get_main_domain "$website")
            echo "=> Đã xóa cache cho domain chính: $main_domain"
            echo "-------------------------------------------------------------------------"
            echo "-> Bao gồm tất cả subdomain thuộc $main_domain"
        else
            echo "=> Đã xóa cache cho domain: $website"
        fi
        
        echo "-------------------------------------------------------------------------"
        echo "Bạn có thể chọn domain khác để tiếp tục."
        echo "========================================================================="
        sleep 3
        tput cuu 6 && tput ed
    else
        echo "========================================================================="
        echo "Không thể xóa cache cho domain: $website"
        echo "-------------------------------------------------------------------------"
        echo "Bạn có thể chọn domain khác để thử lại."
        echo "========================================================================="
        sleep 5
        tput cuu 6 && tput ed
    fi
done
