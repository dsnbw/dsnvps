# Folder paths
ddns_folder="/etc/dsnvps/ddns-cloudflare"
nginx_folder="/etc/nginx/conf.d"
tmp_folder="/etc/dsnvps/.tmp"
kalis_file="$tmp_folder/kalis"
kalis2_file="$tmp_folder/kalis2"
kalislo_file="$tmp_folder/kalislo"

# Function to extract maindomain from subdomain
get_maindomain() {
    local domain=$1
    echo "$domain" | awk -F. '{if (NF>2) print $(NF-1)"."$NF; else print $0}'
}

# Check and delete files in /etc/dsnvps/ddns-cloudflare that are not present in /etc/nginx/conf.d
if [ "$(ls -A $ddns_folder)" ]; then
    # If the ddns-cloudflare folder is not empty
    for file in "$ddns_folder"/*.conf; do
        domain_name=$(basename "$file" .conf)
        maindomain=$(get_maindomain "$domain_name")
        multisite_dir="/home/$maindomain/multisite.conf.d"

        # Check conditions for deletion
        if [ ! -f "$nginx_folder/$domain_name.conf" ] && \
           { [ ! -d "$multisite_dir" ] || [ -z "$(ls -A $multisite_dir/*.conf 2>/dev/null)" ]; }; then
            # echo "Deleting file: $file because it's not in $nginx_folder and no conf file in $multisite_dir"
            rm -f "$file"
        fi
    done
else
    clear
    printf "=========================================================================\n"
    echo "Chưa thiết lập DDNS Cloudflare cho website trên server."
    /etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
    exit 0
fi



