#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -d /home/$mainsite/private_html/server-log ]; then
mkdir -p /home/$mainsite/private_html/server-log
fi
random=`date |md5sum |cut -c '1-8'`
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 2
echo "-------------------------------------------------------------------------"
rm -rf /etc/dsnvps/.tmp/folderlog
if [ -f /var/log/nginx/error.log  ]; then
mkdir -p /etc/dsnvps/.tmp/folderlog
	rm -rf /home/$mainsite/private_html/server-log/nginx*
	\cp -uf /var/log/nginx/error.log  /etc/dsnvps/.tmp/folderlog/
	cd /etc/dsnvps/.tmp/folderlog
	zip -r nginx.log-$random.zip * 
	cp /etc/dsnvps/.tmp/folderlog/nginx.log-$random.zip /home/$mainsite/private_html/server-log
	cd
	rm -rf /etc/dsnvps/.tmp/folderlog
	chown -R nginx:nginx /home/$mainsite/private_html/server-log/*
	
		rm -rf /etc/dsnvps/.tmp/dsnvps-checklogzise
	find /var/log/nginx/ -name "*nginx*" > /etc/dsnvps/.tmp/dsnvps-checklogzise
    logsize=$(du -ch $(cat /etc/dsnvps/.tmp/dsnvps-checklogzise) | tail -1 | cut -f 1)
	if [ "$logsize" = "0" ]; then
	rm -rf /etc/dsnvps/.tmp/dsnvps-checklogzise
	clear
	echo "========================================================================= "
echo "Không có dữ liệu trong Log file"
	/etc/dsnvps/menu/downloadlog/dsnvps-eroor-menu
	exit
	fi
	
clear
echo "========================================================================= "
echo "Link tải Nginx Log:"
echo "-------------------------------------------------------------------------"
echo "http://$serverip_priport/server-log/nginx.log-$random.zip "
	/etc/dsnvps/menu/downloadlog/dsnvps-eroor-menu
else
clear
echo "========================================================================= "
echo "File log không tồn tại hoặc bạn đã tắt chức năng ghi log."
/etc/dsnvps/menu/downloadlog/dsnvps-eroor-menu
fi 
