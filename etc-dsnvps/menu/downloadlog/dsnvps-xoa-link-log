#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ...."
sleep 2
if [ "$(ls -1 /home/$mainsite/private_html/server-log | wc -l)" == "0" ]; then
clear
echo "========================================================================= "
echo "Không thể tìm thấy liên kết tải cho tệp log."
/etc/dsnvps/menu/downloadlog/dsnvps-eroor-menu
fi
rm -rf /home/$mainsite/private_html/server-log/*.*
clear
echo "========================================================================= "
echo "Xóa tất cả liên kết tải LOG thành công"
/etc/dsnvps/menu/downloadlog/dsnvps-eroor-menu


