#!/bin/bash
. /root/dsnvps.conf
CONFIG_FILE="$1"
LOG_FILE="/etc/dsnvps/log-login-ssh.txt"
TELEGRAM_CONFIG_FILE="/etc/dsnvps/telegram.conf"
LAST_TELEGRAM_TIME_FILE="/etc/dsnvps/last_login_telegram_time.txt"

# **THÊM LOCK FILE ĐỂ TRÁNH RACE CONDITION**
LOCK_FILE="/tmp/dsnvps_telegram_login.lock"
LOCK_TIMEOUT=10

# Kiểm tra và tạo lock file
if [ -f "$LOCK_FILE" ]; then
    # Kiểm tra xem lock file có quá cũ không (tránh deadlock)
    if [ $(($(date +%s) - $(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0))) -gt $LOCK_TIMEOUT ]; then
        rm -f "$LOCK_FILE"
    else
        exit 0  # Đã có tiến trình khác đang xử lý
    fi
fi

# Tạo lock file
touch "$LOCK_FILE"
trap 'rm -f "$LOCK_FILE"' EXIT

# Kiểm tra phiên bản Pro
is_pro_version=false
if [ -f /usr/bin/gxred ]; then
   is_pro_version=true
fi

# Kiểm tra file cấu hình Telegram
SEND_TELEGRAM=false
if [[ -f "$TELEGRAM_CONFIG_FILE" ]]; then
    source "$TELEGRAM_CONFIG_FILE"
    SEND_TELEGRAM=true
fi

# Thời gian hiện tại
CURRENT_TIME=$(date "+%Y-%m-%d %H:%M:%S")
CURRENT_TIMESTAMP=$(date +%s)

# **CẢI TIẾN KIỂM TRA SESSION DUY NHẤT**
# Tạo session identifier bao gồm PID và TTY để unique hơn
SESSION_ID=""
if [ -n "$SSH_CONNECTION" ]; then
    # Bao gồm SSH_CONNECTION + PID + TTY để unique hơn
    SESSION_ID=$(echo "${SSH_CONNECTION}_$$_${SSH_TTY}" | md5sum | cut -d' ' -f1)
elif [ -n "$SSH_CLIENT" ]; then
    SESSION_ID=$(echo "${SSH_CLIENT}_$$_${SSH_TTY}" | md5sum | cut -d' ' -f1)
else
    SESSION_ID="local_$$_$(date +%s%N)"  # Thêm nanoseconds cho local sessions
fi

SESSION_FILE="/tmp/dsnvps_session_${SESSION_ID}"
if [ -f "$SESSION_FILE" ]; then
    echo "[$CURRENT_TIME] Session ${SESSION_ID:0:8} đã được xử lý - thoát" >> "$LOG_FILE"
    exit 0  # Session này đã được xử lý rồi
fi
touch "$SESSION_FILE"
# Tự động xóa session file sau 3 phút (giảm từ 5 phút)
(sleep 180; rm -f "$SESSION_FILE") &

# **DETECT SFTP - BỎ QUA THÔNG BÁO CHO SFTP UPLOAD**
IS_SFTP=false

# Cách 1: Kiểm tra SSH_ORIGINAL_COMMAND có chứa sftp không
if [[ -n "$SSH_ORIGINAL_COMMAND" && "$SSH_ORIGINAL_COMMAND" == *"sftp"* ]]; then
    IS_SFTP=true
fi

# Cách 2: Kiểm tra process tree có sftp-server không
if [[ "$IS_SFTP" == false ]]; then
    if ps aux | grep -i sftp-server | grep -v grep >/dev/null 2>&1; then
        IS_SFTP=true
    fi
fi

# Cách 3: Kiểm tra parent process có phải sftp không
if [[ "$IS_SFTP" == false ]]; then
    if ps -o pid,ppid,comm -p $PPID 2>/dev/null | grep -i sftp >/dev/null 2>&1; then
        IS_SFTP=true
    fi
fi

# Nếu là SFTP thì bỏ qua, không gửi thông báo
if [[ "$IS_SFTP" == true ]]; then
    echo "[$CURRENT_TIME] Phát hiện SFTP upload - bỏ qua thông báo Telegram" >> "$LOG_FILE"
    exit 0
fi

# Lấy địa chỉ IP đăng nhập từ lệnh `who`
LOGIN_IP=$(who | awk '{print $5}' | grep -E '([0-9]{1,3}\.){3}[0-9]{1,3}' | sed 's/[()]//g' | tail -n 1)

if [[ -z "$LOGIN_IP" ]]; then
    # **THÊM FALLBACK ĐỂ LẤY IP TỪ SSH_CONNECTION**
    if [ -n "$SSH_CONNECTION" ]; then
        LOGIN_IP=$(echo $SSH_CONNECTION | awk '{print $1}')
    elif [ -n "$SSH_CLIENT" ]; then
        LOGIN_IP=$(echo $SSH_CLIENT | awk '{print $1}')
    else
        LOGIN_IP="unknown"
    fi
fi

if [[ "$LOGIN_IP" == "unknown" ]]; then
    echo "[$CURRENT_TIME] Không tìm thấy địa chỉ IP đăng nhập!" >> "$LOG_FILE"
    exit 1
fi

# Ghi log vào file (sự kiện cũ ở trên, mới ở dưới)
echo "[$CURRENT_TIME] Phát hiện login SSH từ IP: $LOGIN_IP (Session: ${SESSION_ID:0:8})" >> "$LOG_FILE"

# Xóa log nếu file lớn hơn 300 KB
if [[ -f "$LOG_FILE" && $(stat -c%s "$LOG_FILE") -gt 307200 ]]; then
    > "$LOG_FILE"
fi

# Nếu là phiên bản Pro và có cấu hình Telegram, gửi thông báo login
if [[ "$is_pro_version" == true && "$SEND_TELEGRAM" == true ]]; then
    SHOULD_SEND=true

    # **LOGIC GIỚI HẠN CHỈ TRONG CÙNG SESSION - KHÔNG CHẶN LOGIN MỚI**
    # Chỉ kiểm tra thời gian global để tránh spam quá nhanh (30 giây)
    if [[ -f "$LAST_TELEGRAM_TIME_FILE" ]]; then
        LAST_TIMESTAMP=$(cat "$LAST_TELEGRAM_TIME_FILE")
        TIME_DIFF=$((CURRENT_TIMESTAMP - LAST_TIMESTAMP))
        # Giảm xuống 30 giây - chỉ chặn spam quá nhanh, không chặn login mới
        if [[ $TIME_DIFF -lt 30 ]]; then
            SHOULD_SEND=false
        fi
    fi

    # **XÓA LOGIC KIỂM TRA IP+USER** - Vì nó chặn login mới từ cùng IP
    # Mỗi kết nối SSH mới (dù cùng IP) đều phải thông báo

    if [[ "$SHOULD_SEND" == true ]]; then
        # **THÊM TELEGRAM LOCK ĐỂ TRÁNH GỬI DUPLICATE**
        TELEGRAM_LOCK="/tmp/dsnvps_telegram_sending.lock"
        if [ -f "$TELEGRAM_LOCK" ]; then
            exit 0
        fi
        
        touch "$TELEGRAM_LOCK"
        trap 'rm -f "$TELEGRAM_LOCK"' EXIT
        
        MESSAGE="$serverip: Phát hiện đăng nhập SSH bằng tài khoản: $(whoami) từ IP: $LOGIN_IP. Thời gian: $CURRENT_TIME. Nhật ký Login: DSNVPS menu => Auto Check Login/Nginx/MySQL/PHP => Xem Log SSH Login."
        
        # **THÊM RETRY LOGIC CHO TELEGRAM**
        TELEGRAM_SUCCESS=false
        for i in {1..3}; do
            if curl -s -X POST "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" \
               -d chat_id="$CHAT_ID" \
               -d text="$MESSAGE" \
               -d parse_mode="HTML" \
               --connect-timeout 10 \
               --max-time 30; then
                TELEGRAM_SUCCESS=true
                break
            fi
            sleep 2
        done
        
        if [[ "$TELEGRAM_SUCCESS" == true ]]; then
            # Chỉ lưu timestamp khi telegram gửi thành công
            echo "$CURRENT_TIMESTAMP" > "$LAST_TELEGRAM_TIME_FILE"
        fi
        
        rm -f "$TELEGRAM_LOCK"
    fi
fi