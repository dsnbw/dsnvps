        echo "Bạn chỉ được dùng chữ cái, số và dấu gạch dưới để đặt Username."
        sleep 3;tput cuu 3; tput ed
        continue
    fi
    break
done
    echo "-------------------------------------------------------------------------"
while true; do
    echo -n "Nhập mật khẩu: "
    read matkhau
    if [ "$matkhau" = "" ]; then
        echo "========================================================================="
        echo "Bạn chưa nhập mật khẩu, vui lòng nhập lại!"
        sleep 3;tput cuu 3; tput ed
        continue
    fi
    checkpass="^[a-zA-Z0-9_][-a-zA-Z0-9_]{0,61}[a-zA-Z0-9_]$"
    if [[ ! "$matkhau" =~ $checkpass ]]; then
        echo "========================================================================="
        echo "Bạn chỉ được dùng chữ cái, số và dấu gạch dưới để đặt mật khẩu."
        sleep 3;tput cuu 3; tput ed
        continue
    fi
    if [[ ${#matkhau} -lt 6 ]]; then
        echo "========================================================================="
        echo "Mật khẩu tối thiểu phải có 6 ký tự."
        sleep 3;tput cuu 3; tput ed
        continue
    fi
    break
done


echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ...."
sleep 2
if [ ! -d /etc/nginx/pwprotect/$website ]; then
mkdir -p /etc/nginx/pwprotect/$website
fi
rm -rf /etc/nginx/pwprotect/$website/.htpasswd_wp_login
htpasswd.py -c -b /etc/nginx/pwprotect/$website/.htpasswd_wp_login $username $matkhau
if [ ! -f /etc/nginx/pwprotect/$website/.htpasswd_wp_login ]; then
/etc/dsnvps/menu/inc/htpasswd.py -c -b /etc/nginx/pwprotect/$website/.htpasswd_wp_login $username $matkhau
fi
if [ ! -f /etc/nginx/pwprotect/$website/.htpasswd_wp_login  ]; then
htpasswd -b -c /etc/nginx/pwprotect/$website/.htpasswd_wp_login  $username $matkhau
fi
chmod -R 644 /etc/nginx/pwprotect/$website/.htpasswd_wp_login

cat > "/etc/nginx/pwprotect/$website/wp_login.conf" <<END
    location ~ ^/(wp-login\\.php) {
		include /etc/nginx/fastcgi_params;
		fastcgi_pass 127.0.0.1:9000;
		fastcgi_param SCRIPT_FILENAME /home/$website/public_html\$fastcgi_script_name;
		auth_basic "Authorization Required";
		auth_basic_user_file  /etc/nginx/pwprotect/$website/.htpasswd_wp_login;
	}
END
	
##############################################################
config_file="/etc/nginx/conf.d/$website.conf"
if ! grep -q "wp_login.conf" "$config_file"; then
    line_number=$(grep -n '/etc/nginx/conf/ddos2.conf' "$config_file" | cut -d: -f1 | tail -n 1)
    if [ -n "$line_number" ]; then
        sed -i "$((line_number+1))i\\
include /etc/nginx/pwprotect/$website/wp_login.conf;" "$config_file"
    fi
fi

#########  Restart Nginx ###############
/etc/dsnvps/menu/inc/re-start-nginx-service
#################################


clear
echo "========================================================================="
echo "Đặt mật khẩu bảo vệ wp-login.php của $website thành công"
echo "-------------------------------------------------------------------------"
echo "Thông tin truy cập: "
echo "-------------------------------------------------------------------------"
echo "Username: $username | Password: $matkhau"; sleep 2
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu

exit
fi
