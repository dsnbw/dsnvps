#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
if pgrep -x "strace" > /dev/null; then
    echo "DSNVPS cannot perform this function."
    clear
    dsnvps
    exit
fi
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/dsnvps/ddns-cloudflare | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -c)" -lt "2" ]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Bạn chưa cài đặt DDNS Cloudflare cho domain nào !"
/etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
exit
fi
echo "========================================================================="
echo "Sử dụng chức năng này XÓA cài đặt DDNS Cloudflare cho website trên server"
echo "=========================================================================" 
echo "=========================================================================" 
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checkallwebsites
echo "Danh sách các website thiết lập DDNS Cloudflare:"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${danh_sach_website[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${danh_sach_website[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
    	echo "-------------------------------------------------------------------------"; sleep 2
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=${danh_sach_website[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done
echo "========================================================================="
echo "DSNVPS sẽ XÓA cài đặt DDNS Cloudflare cho $website"
echo "========================================================================="
read -r -p "Bạn đồng ý xóa thiết lập DDNS cho website? [y/N] " response

	if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
	echo "-------------------------------------------------------------------------"; sleep 2
	echo "Vui lòng chờ ...";sleep 2
	rm -rf /etc/dsnvps/ddns-cloudflare/$website.conf
	clear
	clear
	echo "========================================================================="
echo "Đã xóa cài đặt DDNS Cloudflare cho $website."

/etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
	exit
		else
		clear
	echo "========================================================================="
        echo "Hủy bỏ."; sleep 2
/etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
	exit
	fi
#fi
