#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

# Clear previous check files
rm -rf /etc/dsnvps/.tmp/check*

vhost_dir="/etc/nginx/conf.d"
home_dir="/home"
output_file="/etc/dsnvps/.tmp/checkallwebsites"

# Clear the output file
> "$output_file"

# Loop through all vhost files to check for existing websites
for vhost_file in "$vhost_dir"/*.conf; do
    domainc=$(basename "$vhost_file" .conf)

    # Skip dsnvps.demo domain
    if [[ "$domainc" == "dsnvps.demo" ]]; then
        continue
    fi

    # Check if /home/$domainc/public_html directory exists
    if [[ -d "$home_dir/$domainc/public_html" ]]; then
        echo "$domainc" >> "$output_file"
    fi
done
# Check if no websites are found
if [[ ! -s "$output_file" ]]; then
    clear
    echo "========================================================================="
    echo "Hiện tại bạn chưa thêm Website mới vào server !"
    /etc/dsnvps/menu/dsnvps-ftpserver-menu
    exit
fi

# Check if FTP server is installed
if [ ! -f /etc/pure-ftpd/pure-ftpd.conf ]; then
    clear
    echo "========================================================================= "
    echo "FTP Server chưa được cài đặt "
    echo "-------------------------------------------------------------------------"
    echo "Bạn phải cài đặt chức năng Setup FTP server trước"
    /etc/dsnvps/menu/dsnvps-ftpserver-menu
    exit
fi

# List of websites
listwebsite=$(cat "$output_file")

# Check and clean up errors in FTP account info
for checkweb in $listwebsite; do
    if [ "$(pure-pw list | grep home/$checkweb)" == "" ] && [ "$(grep home/$checkweb /etc/dsnvps/FTP-Account.info)" != "" ]; then
        sed -i "/home\/$checkweb/d" /etc/dsnvps/FTP-Account.info
    fi
    # Check if the website has an FTP account
    if [ "$(pure-pw list | grep "/home/$checkweb/")" != "" ]; then
        echo "$checkweb" >> /etc/dsnvps/.tmp/checkwebsite-list
    fi
done

# Append ** to websites with FTP accounts
# Khai báo OUTPUT_FILE trước cả hai nhánh if-else
OUTPUT_FILE="/etc/dsnvps/.tmp/checkallwebsites_with_status"

if [ -s "/etc/dsnvps/.tmp/checkwebsite-list" ]; then
    ALL_WEBSITES_FILE="$output_file"
    KLAND_FILE="/etc/dsnvps/.tmp/checkwebsite-list"
    > "$OUTPUT_FILE"
    while read -r domain; do
        if grep -q "^$domain$" "$KLAND_FILE"; then
            echo "$domain**" >> "$OUTPUT_FILE"
        else
            echo "$domain" >> "$OUTPUT_FILE"
        fi
    done < "$ALL_WEBSITES_FILE"
else
    mv "$output_file" "$OUTPUT_FILE"
fi
#####################################################################
echo "========================================================================="
echo "Sử dụng chức năng này để tạo FTP user cho website."
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checkallwebsites_with_status
echo "========================================================================="
echo "Danh sách các website trên server: | ** : Đã tạo FTP Account"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${danh_sach_website[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${danh_sach_website[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
    echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-ftpserver-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//')
        break  # Thoat vong lap neu lua chon hop le
    else
     echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
    fi
done

if [ ! -f /etc/pure-ftpd/pureftpd.passwd ]; then
touch /etc/pure-ftpd/pureftpd.passwd
fi

if [ -f /etc/dsnvps/FTP-Account.info ]; then
if [ "$(pure-pw list | grep home/$website)" == "" ] && [ "$(grep home/$website /etc/dsnvps/FTP-Account.info)" != "" ]; then
rm -rf /etc/dsnvps/.tmp/removeerrorftp
cat > "/etc/dsnvps/.tmp/removeerrorftp" <<END
sed -i '/home\/$website/d' /etc/dsnvps/FTP-Account.info
END
sh /etc/dsnvps/.tmp/removeerrorftp
rm -rf /etc/dsnvps/.tmp/removeerrorftp
fi
fi

if [ "$(pure-pw list | grep /home/$website/)" != "" ]; then
clear
echo "========================================================================="
echo "Bạn đã tạo tài khoản FTP cho $website" 
echo "-------------------------------------------------------------------------"
echo "Thông tin tài khoản FTP:"
echo "-------------------------------------------------------------------------"
echo "Host: $serverip | Port: 21"
echo "-------------------------------------------------------------------------"
echo "User: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}') | Password: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $10}')"
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi


echo "-------------------------------------------------------------------------"
echo "Tìm thấy $website trên hệ thống"; sleep 2
echo "-------------------------------------------------------------------------"
echo "$website chưa tạo tài khoản FTP"; sleep 2
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ tạo tài khoản FTP cho $website ngay bây giờ"; sleep 2

####################################################################
##Check Ban Pro
####################################################################
###################################################################
###################################################################

echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ..."; sleep 6


echo "$website" > /etc/dsnvps/.tmp/dsnvpsftp.txt
sed -i '  s/\./_/g' /etc/dsnvps/.tmp/dsnvpsftp.txt
sed -i 's/\-/_/g' /etc/dsnvps/.tmp/dsnvpsftp.txt
username=`cat /etc/dsnvps/.tmp/dsnvpsftp.txt | sed "s/\_//" | sed "s/\_//" | sed "s/\_//" | sed "s/\_//" | cut -c1-30`
password=`date |md5sum |cut -c '3-32'`
#useradd -m -d /home/$website -g nginx -p $password $username
#usermod -aG nginx $username
#chmod g+rxw /home/$website
( echo ${password} ; echo ${password} ) | pure-pw useradd $username -u nginx -g nginx -d /home/${website}/public_html -m 
pure-pw mkdb
rm -rf /etc/dsnvps/.tmp/ftpdsnvps.temp;
pure-pw mkdb
if [ ! -f /etc/dsnvps/FTP-Account.info ]; then
echo "=========================================================================" > /etc/dsnvps/FTP-Account.info
echo "Please Do Not Delete This File " >> /etc/dsnvps/FTP-Account.info
echo "-------------------------------------------------------------------------" >> /etc/dsnvps/FTP-Account.info
echo "If you delete this file, DSNVPS will not run !" >> /etc/dsnvps/FTP-Account.info
echo "-------------------------------------------------------------------------" >> /etc/dsnvps/FTP-Account.info
echo "All FTP User for all domain on VPS list below:" >> /etc/dsnvps/FTP-Account.info
echo "=========================================================================" >> /etc/dsnvps/FTP-Account.info
echo "" >> /etc/dsnvps/FTP-Account.info
fi
################
echo "FTP Account for $website | Username: $username | Password: $password | dd /home/$website/public_html " >> /etc/dsnvps/FTP-Account.info
#Khoi Dong lai Csf Firewall
if [ -f /etc/csf/csf.conf ]; then
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
fi
######
clear
echo "=========================================================================" 
echo "Tạo tài khoản FTP cho $website thành công"
echo "-------------------------------------------------------------------------"
echo "Thông tin login:"
echo "-------------------------------------------------------------------------"
echo "Host: $serverip | Port: 21"
echo "-------------------------------------------------------------------------"
echo "User: $username | Password: $password"; sleep 3 
/etc/dsnvps/menu/dsnvps-ftpserver-menu
