#!/usr/bin/env bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
if pgrep -x "strace" > /dev/null; then
    echo "DSNVPS cannot perform this function."
    clear
    dsnvps
    exit 1
fi

if [ ! -f /bin/dsnvps ]; then
exit
fi
if [ ! -f /root/dsnvps.conf ]; then
exit
fi

### Xác định đường dẫn của script (thư mục chứa script)
parent_path="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

### Kiểm tra và lấy đường dẫn file config.conf từ đối số dòng lệnh
if [[ -z "$1" ]]; then
  echo "Error! !"
 # echo "Error! You must specify the configuration file path!"
  #echo "Usage: ddns.sh <path_to_config_file>"
  exit 1
else
  CONFIG_FILE="$1"  # Nếu có đối số, sử dụng đường dẫn này
fi

### Kiểm tra xem file config.conf có tồn tại không
if ! [ -f "$CONFIG_FILE" ]; then
  echo "Error! Configuration file $CONFIG_FILE does not exist!"
  exit 1
fi

### Nguồn file cấu hình
if ! source "$CONFIG_FILE"; then
  echo 'Error! Invalid syntax in configuration file!'
  exit 1
fi

### Logic ưu tiên API: SSL API -> Domain API -> Error
final_api_token=""
final_api_email=""
api_source=""

# 1. Kiểm tra SSL API trước (ưu tiên cao nhất)
ssl_api_file="/etc/dsnvps/ssl-cloudflare-api-global.conf"
if [ -f "$ssl_api_file" ]; then
  source "$ssl_api_file"
  if [ -n "${global_ssl_api_token:-}" ]; then
    # Kiểm tra SSL API có hợp lệ không
    if [ -n "${global_ssl_api_email:-}" ]; then
      # Global API Key
      verify_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user" \
           -H "X-Auth-Email: $global_ssl_api_email" \
           -H "X-Auth-Key: $global_ssl_api_token" \
           -H "Content-Type: application/json")
    else
      # API Token
      verify_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
           -H "Authorization: Bearer $global_ssl_api_token" \
           -H "Content-Type: application/json")
    fi
    
    if echo "$verify_response" | grep -q '"success":true'; then
      final_api_token="$global_ssl_api_token"
      final_api_email="${global_ssl_api_email:-}"
      api_source="SSL API"
    fi
  fi
fi

# 2. Nếu không có API Global, dùng API riêng của domain
if [ -z "$final_api_token" ] && [ -n "${cloudflare_zone_api_token:-}" ]; then
  # Kiểm tra API riêng có hợp lệ không
  verify_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
       -H "Authorization: Bearer $cloudflare_zone_api_token" \
       -H "Content-Type:application/json")
  if echo "$verify_response" | grep -q '"success":true'; then
    final_api_token="$cloudflare_zone_api_token"
    final_api_email=""
    api_source="Domain API"
  fi
fi

# 3. Nếu không có API nào hợp lệ, báo lỗi
if [ -z "$final_api_token" ]; then
  echo "Error! No valid API token found."
  echo "- SSL API: $([ -f "$ssl_api_file" ] && echo "exists but invalid" || echo "not configured")"
  echo "- Domain API: $([ -n "${cloudflare_zone_api_token:-}" ] && echo "exists but invalid" || echo "not found")"
  echo "Please configure a valid API Global or add valid token to config file."
  exit 1
fi

# Sử dụng API token đã được verify
cloudflare_zone_api_token="$final_api_token"

### Lấy tên miền từ tên file cấu hình (đổi tên file cấu hình thành dns_record)
dns_record=$(basename "$CONFIG_FILE" .conf)

### Check validity of "ttl" parameter
if [ "${ttl}" -lt 120 ] || [ "${ttl}" -gt 7200 ] && [ "${ttl}" -ne 1 ]; then
  echo "Error! ttl out of range (120-7200) or not set to 1"
  exit
fi

### Check validity of "proxied" parameter
if [ "${proxied}" != "false" ] && [ "${proxied}" != "true" ]; then
  echo 'Error! Incorrect "proxied" parameter, choose "true" or "false"'
  exit 0
fi

### Remove check for "what_ip", directly use external IP

### Valid IPv4 Regex
REIP='^((25[0-5]|(2[0-4]|1[0-9]|[1-9]|)[0-9])\.){3}(25[0-5]|(2[0-4]|1[0-9]|[1-9]|)[0-9])$'

### Get external ip from https://checkip.amazonaws.com
ip=$(curl -4 -s -X GET https://checkip.amazonaws.com --max-time 10)
if [ -z "$ip" ]; then
  echo "Error! Can't get external ip from https://checkip.amazonaws.com"
  exit 0
fi
if ! [[ "$ip" =~ $REIP ]]; then
  echo "Error! IP Address returned was invalid!"
  exit 0
fi
echo "==> The Server IP is: $ip"

### Build coma separated array from dns_record parameter to update multiple A records
IFS=',' read -d '' -ra dns_records <<<"$dns_record,"
unset 'dns_records[${#dns_records[@]}-1]'
declare dns_records

for record in "${dns_records[@]}"; do
  ### Get IP address of DNS record from 1.1.1.1 DNS server when proxied is "false"
  if [ "${proxied}" == "false" ]; then
    ### Check if "nslookup" command is present
    if which nslookup >/dev/null; then
      dns_record_ip=$(nslookup ${record} 1.1.1.1 | awk '/Address/ { print $2 }' | sed -n '2p')
    else
      ### if no "nslookup" command use "host" command
      dns_record_ip=$(host -t A ${record} 1.1.1.1 | awk '/has address/ { print $4 }' | sed -n '1p')
    fi

    if [ -z "$dns_record_ip" ]; then
      echo "Error! Can't resolve the ${record} via 1.1.1.1 DNS server"
      exit 0
    fi
    is_proxed="${proxied}"
  fi

  ### Get the dns record id and current proxy status from Cloudflare API when proxied is "true"
  if [ "${proxied}" == "true" ]; then
    if [ -n "$final_api_email" ]; then
      # Global API Key
      dns_record_info=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records?type=A&name=$record" \
        -H "X-Auth-Email: $final_api_email" \
        -H "X-Auth-Key: $cloudflare_zone_api_token" \
        -H "Content-Type: application/json")
    else
      # API Token
      dns_record_info=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records?type=A&name=$record" \
        -H "Authorization: Bearer $cloudflare_zone_api_token" \
        -H "Content-Type: application/json")
    fi
    
    if [[ ${dns_record_info} == *"\"success\":false"* ]]; then
      echo ${dns_record_info}
      echo "Error! Can't get dns record info from Cloudflare API"
      exit 0
    fi
    is_proxed=$(echo ${dns_record_info} | grep -o '"proxied":[^,]*' | grep -o '[^:]*$')
    dns_record_ip=$(echo ${dns_record_info} | grep -o '"content":"[^"]*' | cut -d'"' -f 4)
  fi

  ### Check if ip or proxy have changed
  if [ ${dns_record_ip} == ${ip} ] && [ ${is_proxed} == ${proxied} ]; then
    echo "==> DNS record IP of ${record} is ${dns_record_ip}, no changes needed."
    continue
  fi

  echo "==> DNS record of ${record} is: ${dns_record_ip}.... Updating..."

  ### Get the dns record information from Cloudflare API
  if [ -n "$final_api_email" ]; then
    # Global API Key
    cloudflare_record_info=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records?type=A&name=$record" \
      -H "X-Auth-Email: $final_api_email" \
      -H "X-Auth-Key: $cloudflare_zone_api_token" \
      -H "Content-Type: application/json")
  else
    # API Token
    cloudflare_record_info=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records?type=A&name=$record" \
      -H "Authorization: Bearer $cloudflare_zone_api_token" \
      -H "Content-Type: application/json")
  fi
  
  if [[ ${cloudflare_record_info} == *"\"success\":false"* ]]; then
    echo ${cloudflare_record_info}
    echo "Error! Can't get ${record} record information from Cloudflare API"
    exit 0
  fi

  ### Get the dns record id from response
  cloudflare_dns_record_id=$(echo ${cloudflare_record_info} | grep -o '"id":"[^"]*' | cut -d'"' -f4)

  ### Push new dns record information to Cloudflare API
  if [ -n "$final_api_email" ]; then
    # Global API Key
    update_dns_record=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records/$cloudflare_dns_record_id" \
      -H "X-Auth-Email: $final_api_email" \
      -H "X-Auth-Key: $cloudflare_zone_api_token" \
      -H "Content-Type: application/json" \
      --data "{\"type\":\"A\",\"name\":\"$record\",\"content\":\"$ip\",\"ttl\":$ttl,\"proxied\":$proxied}")
  else
    # API Token
    update_dns_record=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zoneid/dns_records/$cloudflare_dns_record_id" \
      -H "Authorization: Bearer $cloudflare_zone_api_token" \
      -H "Content-Type: application/json" \
      --data "{\"type\":\"A\",\"name\":\"$record\",\"content\":\"$ip\",\"ttl\":$ttl,\"proxied\":$proxied}")
  fi
  
  if [[ ${update_dns_record} == *"\"success\":false"* ]]; then
    echo ${update_dns_record}
    echo "Error! Update failed"
    exit 0
  fi

  echo "==> Success!"
  echo "==> $record DNS Record updated to: $ip, ttl: $ttl, proxied: $proxied"
done
