#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
kiemtradomain3="^([[:alnum:]]([[:alnum:]\-]{0,61}[[:alnum:]])?\.)+[[:alpha:]]{2,14}$";
website=`cat /etc/dsnvps/.tmp/subdomainwp.txt`
websiteOK=`cat /etc/dsnvps/.tmp/subdomainwpOK.txt`
mail1=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 6)
mail2=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 6)
rm -rf /etc/dsnvps/.tmp/listsubsites*
#cd /home/$website/public_html
#wp site list --allow-root | sed '1d' | sed '1d' > /etc/dsnvps/.tmp/listsubsites
#sed '$d' /etc/dsnvps/.tmp/listsubsites >/dev/null 2>&1
#if [ ! -s /etc/dsnvps/.tmp/listsubsites ]; then
#rm -rf /etc/dsnvps/.tmp/listsubsites
#clear
#echo "========================================================================="
#echo "$website da cai dat thanh cong Wordpress Multisite."
#echo "-------------------------------------------------------------------------"
#echo "Hien tai $website chua tao SUB nao trong WP-ADMIN."
#echo "-------------------------------------------------------------------------"
#echo "Bạn phải tao Sub trong WP-ADMIN truoc khi tao Vhost cho Sub do !"
#echo "-------------------------------------------------------------------------"
#echo "How to do: Wp-admin ==> My Sites ==> Network admin ==> Sites ==> Add New "
#dsnvps
#fi
#cd
websiteTO=`echo $website | tr '[A-Z]' '[a-z]'`
echo "========================================================================="
echo "$websiteTO đã cài đặt WordPress Multisite: Sub-directory"
echo "========================================================================="
PS3="$prompt"
while true; do
    printf "%-35s %s\n" "1) Thêm Subsite" " 3) Xem danh sách Subsite"
    printf "%-35s  %s\n" "2) Xóa Subsite"  ""
done

    echo "========================================================================="
    read -p "Lựa chọn của bạn [0 -Thoát]: " choice

    case $choice in
    1) luachon="Taothem_sub"; break;;
    2)  luachon="xoasub_site"; break;;
    3) luachon="xemdanhsach"; break;;
0) clear; exit 0;;
       *)
   echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!";continue;;

    #*) echo "You typed wrong, Please type in the ordinal number on the list";continue;;
    esac  
done
###################################
#Xem danh sach
###################################
if [ "$luachon" = "xemdanhsach" ]; then
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."; sleep 2
rm -rf /etc/dsnvps/.tmp/listsubsites*
cd /home/$website/public_html
wp site list --allow-root > /etc/dsnvps/.tmp/listsubsites
cd
#sed '$d' /etc/dsnvps/.tmp/listsubsites >/dev/null 2>&1
if [ $(wc -c < /etc/dsnvps/.tmp/listsubsites) -gt 3 ]; then
grep -oP "https?://$website/[^/]+(?=/)" /etc/dsnvps/.tmp/listsubsites > /etc/dsnvps/.tmp/listsubsites2
if [ ! -s /etc/dsnvps/.tmp/listsubsites2 ]; then
clear
echo "========================================================================="
echo "Bạn chưa tạo Subsite cho $website"; sleep 2
dsnvps
exit
fi
clear
echo "========================================================================="
echo "Danh sách Subsites của $website:"
echo "-------------------------------------------------------------------------"
cat /etc/dsnvps/.tmp/listsubsites2 | pr -2 -t
dsnvps
exit
else
clear
echo "========================================================================="
echo "Bạn chưa tạo Subsite cho $website"; sleep 2
dsnvps
exit
fi
###################################
#Tao Sub-site
###################################
elif [ "$luachon" = "Taothem_sub" ]; then
echo "========================================================================="
echo "Tao Thêm Subsite cho $website. "
echo "========================================================================="
echo "Ban hay nhap Subsite. Vi du muon tao dsnvps/abc thi nhap abc."
echo "-------------------------------------------------------------------------"
echo "DSNVPS khong chap nhan ten Sub dang: abc.bcd hay abd.ddff.wewe"
echo "========================================================================="
echo -n "Nhap ten Sub: " 
read subdomain
if [ "$subdomain" = "" ]; then
clear
echo "========================================================================="
echo "Bạn nhập sai, vui lòng nhập lại "; sleep 2
dsnvps
exit
fi
cd /home/$website/public_html
if wp site list --field=domain | grep -q "$subdomain"; then
cd
clear
echo "========================================================================="
echo "$subdomain đã tồn tại trên hệ thống."
echo "-------------------------------------------------------------------------"
echo "Vui lòng chọn sub khac. "
dsnvps
exit
fi
cd
#if [[ ! "$subdomain" =~ ^[a-zA-Z0-9-]+\.[a-zA-Z0-9-]+$ ]]; then
#clear
#echo "========================================================================="
#echo "Ban nhap sai dinh dang."
#echo "-------------------------------------------------------------------------"
#echo "DSNVPS khong chap nhan ten sub dang abc.cbdc"; sleep 2
#dsnvps
#exit
#fi

if [[ ! "$subdomain" =~ ^[a-zA-Z0-9]+(-[a-zA-Z0-9]+)*$ ]]; then
clear
echo "========================================================================="
echo "Sub-domain chỉ được phép chứa chữ cái, số và dấu gạch ngang (-)."
echo "-------------------------------------------------------------------------"
echo "Vui lòng chọn sub khac. "
dsnvps
exit
fi
cd /home/$website/public_html
if wp user get "$subdomain" --field=user_login --allow-root > /dev/null 2>&1; then
cd
clear
echo "========================================================================="
echo "Tài khoản username $subdomain đã tồn tại trong hệ thống."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy chọn Subsite khác."
dsnvps
exit
fi
cd
################### Den tai khoan admin
echo "-------------------------------------------------------------------------"
echo -n "Nhập tài khoản admin cho Subsite [ENTER]: " 
read adminwp
if [ "$adminwp" = "" ]; then
clear
echo "========================================================================="
echo "Bạn phải nhập tài khoản admin cho sub-site."; sleep 2
dsnvps
exit
fi
cd /home/$website/public_html
if wp user get "$adminwp" --field=user_login --allow-root > /dev/null 2>&1; then
cd
clear
echo "========================================================================="
echo "Tài khoản $adminwp đã tồn tại trong hệ thống."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy chọn username khác."
dsnvps
exit
fi
cd
if [[ "$adminwp" == "$subdomain" ]]; then
clear
echo "========================================================================="
echo "Tài khoản admin không được trùng tên với subsite"
dsnvps
exit
fi

if [[ ! ${#adminwp} -ge 5 ]]; then
clear
echo "========================================================================="
echo "User admin tối thiểu phải có 5 ký tự "
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại !"
dsnvps
exit
fi 
checkuseradmin="^[a-zA-Z0-9_][-a-zA-Z0-9_]{0,61}[a-zA-Z0-9_]$";
if [[ ! "$adminwp" =~ $checkuseradmin ]]; then
clear
echo "========================================================================="
echo "Bạn chỉ được sử dụng chữ cái và số cho user admin"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại  !"
dsnvps
exit
fi 
echo "-------------------------------------------------------------------------"
echo "Mật khẩu cho $adminwp tối thiểu phải có 8 kí tự"
echo "-------------------------------------------------------------------------"
echo -n "Nhập mật khẩu cho user $adminwp [ENTER]: " 
read passwp
if [[ ! ${#passwp} -ge 8 ]]; then
clear
echo "========================================================================="
echo "Mật khẩu cho $adminwp tối thiểu phải có 8 kí tự "
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại !"
dsnvps
exit
fi 
##################################
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
#################################################
####### Restart Nginx
/etc/dsnvps/menu/inc/re-start-nginx-service
if [[ $(grep -i "https" <<<"$website") ]]; then
    protocol="https"
else
    protocol="http"
fi
cd /home/$website/public_html
wp site create --slug=$subdomain --title="$subdomain" --email=$mail1@$website --allow-root >/dev/null 2>&1
sleep 2
wp user create $adminwp $mail2@$website --role=administrator --user_pass=$passwp --url="$protocol://$website/$subdomain" --allow-root >/dev/null 2>&1
cd
#################################################
####### Restart Nginx
/etc/dsnvps/menu/inc/re-start-nginx-service
#############
clear
echo "========================================================================="
echo "Tạo Sub-Site $subdomain thành công!"
echo "-------------------------------------------------------------------------"
echo "Link: http://$website/$subdomain"
echo "-------------------------------------------------------------------------"
echo "Thông tin admin:"
echo "-------------------------------------------------------------------------"
echo "User: $adminwp | Password: $passwp"
echo "-------------------------------------------------------------------------"
echo "Thông tin lưu tại: /home/$website/multisite-info.txt"
#########################
if [ -f /home/$website/multisite-info.txt ]; then
grep -q "DSNVPS_note" /home/$website/multisite-info.txt || sed -i '1i DSNVPS_note: Please only read and do not edit anything in this file; otherwise, DSNVPS will not function correctly' /home/$website/multisite-info.txt
else
echo "DSNVPS_note: Please only read and do not edit anything in this file; otherwise, DSNVPS will not function correctly" > /home/$website/multisite-info.txt
fi
echo "$subdomain | Admin: $adminwp | Password: $passwp " >> /home/$website/multisite-info.txt
sleep 4
dsnvps
###################################
elif [ "$luachon" = "xoasub_site" ]; then
rm -rf /etc/dsnvps/.tmp/listsubsites*
cd /home/$website/public_html
wp site list --allow-root > /etc/dsnvps/.tmp/listsubsites
cd
#sed '$d' /etc/dsnvps/.tmp/listsubsites >/dev/null 2>&1
if [ ! -s /etc/dsnvps/.tmp/listsubsites ]; then
clear
echo "========================================================================="
echo "Bạn chưa tạo Sub-Site cho $website"; sleep 2
dsnvps
exit
fi
grep -oP "http://$website/\K[a-zA-Z0-9_-]+(?=/)" /etc/dsnvps/.tmp/listsubsites > /etc/dsnvps/.tmp/listsubsites2
mapfile -t danh_sach_subsite < /etc/dsnvps/.tmp/listsubsites2
echo "========================================================================="
echo "Danh sách sub-site của $website:"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_subsite[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${danh_sach_subsite[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${danh_sach_subsite[right_index-1]}"      
        printf "%-1s %-40s %-1s %-40s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-40s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
echo -n "Nhập số tương ứng với sub-site [0 -Thoát]: "
    read -r lua_chonz
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chonz" ]]; then
                   echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chonz" == "0" ]]; then
        clear
 dsnvps
        break
    elif [[ "$lua_chonz" =~ ^[0-9]+$ ]] && (( lua_chonz >= 1 && lua_chonz <= ${#danh_sach_subsite[@]} )); then
        subsite_canxoa=${danh_sach_subsite[lua_chonz-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
               echo "-------------------------------------------------------------------------"
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done
    echo "========================================================================="
read -p "Bạn chắc chắn muốn xóa $subsite_canxoa? (y/N):" choice
 	if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
           echo "-------------------------------------------------------------------------"
#lay gia tri ten sub vi du: abd.ddcdc.com thi lay abd thoi.
 subdomaincanz=$(echo "$subsite_canxoa" | sed 's/\..*//')
echo "Vui lòng chờ ...";sleep 2
           echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ xóa $subsite_canxoa ..."; sleep 2
cd /home/$website/public_html
wp site delete $subdomaincanz --allow-root --yes >/dev/null 2>&1
cd
#rm -rf /home/$website/multisite.conf.d/$subsite_canxoa.conf
sed -i "/${subdomaincanz}\b/d" /home/$website/multisite-info.txt
### Xoa DDNS config
if [ -f /ect/dsnvps/ddns-cloudflare/$subsite_canxoa.conf
rm -rf /ect/dsnvps/ddns-cloudflare/$subsite_canxoa.conf
fi
####### Restart Nginx
/etc/dsnvps/menu/inc/re-start-nginx-service
clear
echo "========================================================================="
echo "Sub-site $subsite_canxoa đã được xóa thành công."
echo "-------------------------------------------------------------------------"
echo "Nếu có lỗi, hãy xóa Subsite trong WP-ADMIN của $website"; sleep 3

    dsnvps
    exit
fi
else
    echo "========================================================================="
    echo "Hủy bỏ!"			
dsnvps
exit
fi
else
clear
exit 0
fi



