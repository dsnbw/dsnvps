# Lấy port WebUI từ config
if [ -f /etc/rslsync-dsnvps/sync.conf ]; then

    rslsyncwebui_port=$(grep -oP '"listen"\s*:\s*"0.0.0.0:\K[0-9]+' /etc/rslsync-dsnvps/sync.conf)
    rslsync_port=$(grep -oP '"listening_port"\s*:\s*\K[0-9]+' /etc/rslsync-dsnvps/sync.conf)
    ssh_port=$(grep -i '^Port ' /etc/ssh/sshd_config | awk '{print $2}' | head -n1)
    [ -z "$ssh_port" ] && ssh_port=22

    # Hàm thêm port nếu chưa có
    add_port_if_missing() {
        local port="$1"
        local var="$2"
        grep -qE "${var}.*\b${port}\b" /etc/csf/csf.conf || \
        sed -i "s/\(${var} = \".*\)\"/\1,${port}\"/" /etc/csf/csf.conf
    }

    # Mở port cho Resilio Sync (webui và sync port)
    for var in TCP_IN TCP_OUT UDP_IN UDP_OUT; do
        [ "$rslsync_port" != "0" ] && add_port_if_missing "$rslsync_port" "$var"
        add_port_if_missing "$rslsyncwebui_port" "$var"
    done

    # Mở port SSH (để rsync qua SSH)
    for var in TCP_IN TCP_OUT; do
        add_port_if_missing "$ssh_port" "$var"
    done

    # Khởi động lại CSF/LFD nếu có script
    [ -x /etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd ] && \
        /etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
fi
