#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
echo "========================================================================="
echo "Dùng chức năng này để xóa cấu hình của [Sao Lưu Backup Tới Telegram] "
echo "========================================================================="
read -r -p "Bạn chắc chắn muốn xóa tất cả cấu hình này? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."; sleep 2
    rm -rf /etc/cron.d/dsnvps.telegram.backup.cron
    rm -rf /etc/dsnvps/backup.telegram.conf
    rm -rf /etc/dsnvps/telegram_group.conf
    rm -rf /etc/dsnvps/telegram.session
    clear
    echo "========================================================================="
    echo "Hoàn tất xóa tất cả cấu hình hiện tại."
    /etc/dsnvps/menu/dsnvps-telegram-menu
    exit
else
    clear
    echo "========================================================================="
    echo "Hủy bỏ !"
    /etc/dsnvps/menu/dsnvps-telegram-menu
    exit
fi
