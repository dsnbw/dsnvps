	echo "File backup được đổi tên thành DSNVPS-DATABASE.sql.gz.$randomwp"
	/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
	fi
else
	clear
	echo "========================================================================="
echo "CÁCH PHỤC HỒI"
echo "========================================================================="
echo "Chức năng này chỉ phục hồi được database có định dạng .sql.gz"
