clear
echo "========================================================================="
echo "$website không phải wordpress blog !"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy làm lại."
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
exit
fi
tendatabase=`cat /home/$website/public_html/wp-config.php | grep DB_NAME | cut -d \' -f 4`
randomwp=`date |md5sum |cut -c '1-18'`
date -r /var/lib/mysql/$tendatabase +%H%M%S> /etc/dsnvps/.tmp/dsnvps1
echo "-------------------------------------------------------------------------"
echo "Tìm thấy $website trên hệ thống"
echo "-------------------------------------------------------------------------"
echo "$website sử dụng wordpress code"
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
echo "-------------------------------------------------------------------------"

if [ -f /home/$website/public_html/DSNVPS-DATABASE.sql.gz ]; then
echo "Tìm thấy file backup DSNVPS-DATABASE.sql.gz"
echo "-------------------------------------------------------------------------"
echo "Chuẩn bị phục hồi .... "
echo "-------------------------------------------------------------------------"
sleep 2
gunzip < /home/$website/public_html/DSNVPS-DATABASE.sql.gz | mysql -u root -p$mariadbpass -f $tendatabase
date -r /var/lib/mysql/$dataname +%H%M%S> /etc/dsnvps/.tmp/dsnvps2
check1=`cat /etc/dsnvps/.tmp/dsnvps1`
check2=`cat /etc/dsnvps/.tmp/dsnvps2`

if [ "$check1" == "$check2" ]; then
	rm -rf /etc/dsnvps/.tmp/dsnvps1
	rm -rf /etc/dsnvps/.tmp/dsnvps2
	clear
	echo "========================================================================="
	echo "Phục hồi database $tendataname thất bại "
	echo "-------------------------------------------------------------------------"
	echo "Hãy kiểm tra file backup và làm lại !"
	/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
	else	
	rm -rf /etc/dsnvps/.tmp/dsnvps1
	rm -rf /etc/dsnvps/.tmp/dsnvps2
	clear
	echo "========================================================================="
	echo "Phuc hoi database $tendatabase thành công !"
	mv /home/$website/public_html/DSNVPS-DATABASE.sql.gz /home/$website/public_html/DSNVPS-DATABASE.sql.gz.$randomwp
