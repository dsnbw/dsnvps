#!/bin/bash

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
serverversion=`/root/.acme.sh/acme.sh --version | awk 'NR==2' | sed 's/v//'`
echo "========================================================================="
echo "Check Update Version ..."; sleep 3
rm -rf /etc/dsnvps/.tmp/checkupdate_acme.sh
mkdir -p /etc/dsnvps/.tmp/checkupdate_acme.sh
cd /etc/dsnvps/.tmp/checkupdate_acme.sh
wget -q https://raw.githubusercontent.com/Neilpang/acme.sh/master/acme.sh -O /etc/dsnvps/.tmp/checkupdate_acme.sh/acme.sh
#wget -q https://raw.githubusercontent.com/Neilpang/acme.sh/master/acme.sh
#unzip -q master
airversion=$(grep VER= /etc/dsnvps/.tmp/checkupdate_acme.sh/acme.sh | sed 's/VER=//')
rm -rf /etc/dsnvps/.tmp/checkupdate_acme.sh
cd

if [ "$serverversion" = "$airversion" ]; then
clear
echo "========================================================================="
echo "Ban dang su dung phien ban moi nhat acme.sh ."
echo "-------------------------------------------------------------------------"
echo "Version: $serverversion"
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi
clear
echo "========================================================================="
/root/.acme.sh/acme.sh --upgrade
version=`/root/.acme.sh/acme.sh --version | awk 'NR==2' | sed 's/v//'`
echo "-------------------------------------------------------------------------"
echo "Lastest Version: $version"
rm -rf /etc/dsnvps/.tmp/check_crontab_acme
crontab -l > /etc/dsnvps/.tmp/check_crontab_acme
if [ ! "$(grep "/root/.acme.sh" /etc/dsnvps/.tmp/check_crontab_acme)" = "" ]; then
/root/.acme.sh/acme.sh --uninstallcronjob
fi
rm -rf /etc/dsnvps/.tmp/check_crontab_acme
sleep 3
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
