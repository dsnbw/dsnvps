check_wpcli_version() {

    # Kiểm tra xem wp-cli đã được cài đặt chưa, nếu chưa cài đặt thì cài đặt
    if [ ! -f /usr/local/bin/wp ] && [ ! -f /bin/wp ]; then
        echo "WP-CLI chưa được cài đặt, đang cài đặt..."
        curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
        chmod +x wp-cli.phar
        sudo mv wp-cli.phar /usr/local/bin/wp
    fi

    # Kiểm tra file wpcli.version, nếu không có thì tạo mới
    if [ ! -f /etc/dsnvps/wpcli.version ]; then
        touch -a -m -t 201601180130.09 /etc/dsnvps/wpcli.version
    fi

    # Kiểm tra kết nối internet
    if ping -q -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
        fileTime3=$(date -r /etc/dsnvps/wpcli.version +%d)
        curTime3=$(date +%d)
        
        # Nếu ngày của wpcli.version khác ngày hiện tại, tiến hành kiểm tra bản cập nhật
        if [ "$fileTime3" != "$curTime3" ]; then
            wp --version --allow-root > /etc/dsnvps/wpcli.version
            wp cli check-update --allow-root > /etc/dsnvps/.tmp/ailsod
            
            # Nếu có bản cập nhật, thực hiện cập nhật WP-CLI
            if ! grep -q "latest" /etc/dsnvps/.tmp/ailsod; then
                echo "========================================================================="
                echo "Có cập nhật cho WP-CLI! Đang cập nhật WP-CLI..."
                echo "-------------------------------------------------------------------------"
                echo "Vui lòng chờ ..."
                sleep 4
                /etc/dsnvps/menu/dsnvps-enable-tat-ca-cac-ham-php-php.ini
                echo y | wp cli update --allow-root
                wp --version --allow-root > /etc/dsnvps/wpcli.version
                /etc/dsnvps/menu/dsnvps-re-config-cac-ham-php-disable-php.ini
            fi
        fi
    fi

    # Quay lại menu WordPress Blog Tools
    menu_wordpress_blog_tools
}


