#Kiem tra va cai lai wp-cli neu can thiet #########
# Hàm kiểm tra kết nối internet
check_internet() {
    ping -q -c 1 -W 1 8.8.8.8 >/dev/null 2>&1
    return $?  # Trả về 0 nếu có kết nối, 1 nếu không có kết nối
}

# Hàm kiểm tra và cài đặt WP-CLI
install_wpcli() {
    attempt=0
    max_attempts=2

    # Kiểm tra xem wp-cli đã cài chưa và có chạy được không
    if [ -f /usr/local/bin/wp ] || [ -f /bin/wp ]; then
        wp --info > /dev/null 2>&1
        if [ $? -eq 0 ]; then
            return 0  # Nếu wp-cli đã có và chạy được, thoát luôn
        fi
    fi

    # Nếu không có wp-cli hoặc không chạy được, cài đặt
    while [ $attempt -lt $max_attempts ]; do
        # Kiểm tra kết nối internet trước khi tải WP-CLI
        if ! check_internet; then
clear
echo "========================================================================="
echo "Không có kết nối mạng, không thể tải WP-CLI."
dsnvps
            exit 1
        fi

        # Tải về wp-cli.phar
        curl -s -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
        if [ $? -eq 0 ]; then
            chmod +x wp-cli.phar
            sudo mv wp-cli.phar /usr/local/bin/wp
            wp --info > /dev/null 2>&1
            if [ $? -eq 0 ]; then
               # echo "WP-CLI cài đặt thành công!"
                return 0
            fi
        fi

        # Tăng số lần thử
        attempt=$((attempt+1))
    done

    # Nếu tải lỗi hai lần, thoát
    clear
echo "========================================================================="
echo "Cài đặt WP-CLI thất bại sau 2 lần thử."
dsnvps
    #echo "Cài đặt WP-CLI thất bại sau 2 lần thử."
    exit 1
}

# Gọi hàm kiểm tra và cài đặt WP-CLI
install_wpcli
