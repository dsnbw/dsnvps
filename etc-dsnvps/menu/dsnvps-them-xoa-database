message="Tổng dung lượng Database: $databasesize | Tổng dung lượng Backup: $backupdatabasesize"; printf "%$(( (73 - ${#message}) / 2 ))s%s\n" "" "$message"
printf "=========================================================================\n"
if [ -f /etc/cron.d/auto.backup.all.databases.cron ] && [ -f /etc/dsnvps/auto.backup.all.databases.conf ]; then
autobackupdata="BẬT"
thoigianmode=`cat /etc/cron.d/auto.backup.all.databases.cron | awk 'NR==2 {print $3}'`
