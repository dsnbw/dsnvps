#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ -f /etc/dsnvps/auto.backup.all.databases.telegram.conf ]; then
thongbao="BẬT    "
else
thongbao="TẮT    "
fi
if [ ! -f /usr/local/bin/htpasswd.py ]; then
cp -r /etc/dsnvps/menu/dsnvps-tao-mat-khau-bao-ve-folder.py /usr/local/bin/htpasswd.py
chmod 755 /usr/local/bin/htpasswd.py
fi
if [ ! -f /etc/dsnvps/pwprotect.default ]; then
echo "" > /etc/dsnvps/pwprotect.default
fi
if [ ! -f /etc/cron.d/dsnvps.db.cron ]; then
touch /etc/cron.d/dsnvps.db.cron
fi
if [ ! -d /home/$mainsite/private_html/backup ]; then
mkdir -p /home/$mainsite/private_html/backup
fi
if [ -f /var/lib/mysql/dsnvpsCheckDB/db.opt ]; then
rm -rf /var/lib/mysql/dsnvpsCheckDB
fi

if [ -f /root/DBinfo.txt ]; then
checkloifilename=`grep "Databasae:" /root/DBinfo.txt`
if [ ! -z "$checkloifilename" ]; then
sed -ri "s|Databasae:|Data\ name:|" /root/DBinfo.txt
fi
checkloifilename2=`grep "Databasa:" /root/DBinfo.txt`
if [ ! -z "$checkloifilename2" ]; then
sed -ri "s|Databasa:|Data\ name:|" /root/DBinfo.txt
fi
fi
find /home/$mainsite/private_html/backup/ -name "*.tar.gz*" > /etc/dsnvps/.tmp/dsnvps_check_backup_database_size
find /home/$mainsite/private_html/backup/ -name "*.sql.gz*" >> /etc/dsnvps/.tmp/dsnvps_check_backup_database_size

############################
# Khởi tạo giá trị mặc định
backupdatabasesize="0 KB"

# Kiểm tra số lượng file và tính dung lượng nếu có dữ liệu
if [ -f /etc/dsnvps/.tmp/dsnvps_check_backup_database_size ]; then
    numberfiles=$(cat /etc/dsnvps/.tmp/dsnvps_check_backup_database_size | wc -l)
    if [ "$numberfiles" -ne 0 ]; then
        # Tính tổng dung lượng bằng KB
        TOTAL_SIZE_KB=$(du -c --block-size=1K $(cat /etc/dsnvps/.tmp/dsnvps_check_backup_database_size) | tail -1 | cut -f 1)
        # Gán giá trị với đơn vị đầy đủ
        if [ "$TOTAL_SIZE_KB" -eq 0 ]; then
            backupdatabasesize="0 KB"
        elif [ "$TOTAL_SIZE_KB" -lt 1024 ]; then
            backupdatabasesize="$TOTAL_SIZE_KB KB"
        else
            backupdatabasesize=$(echo "scale=0; $TOTAL_SIZE_KB / 1024" | bc)
            backupdatabasesize="$backupdatabasesize MB"
        fi
    fi
fi
###########################################
ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/dsnvps_check_db
listdbnumber=`cat /etc/dsnvps/.tmp/dsnvps_check_db`
rm -rf /etc/dsnvps/.tmp/dsnvps_listdbf
for database in $listdbnumber
do
echo "/var/lib/mysql/$database" >> /etc/dsnvps/.tmp/dsnvps_listdbf
done
if [ -s /etc/dsnvps/.tmp/dsnvps_listdbf ]; then
    # Tính dung lượng
    TOTAL_SIZE_KB=$(du -c --block-size=1K $(cat /etc/dsnvps/.tmp/dsnvps_listdbf) | tail -1 | cut -f 1)
    if [ "$TOTAL_SIZE_KB" -eq 0 ]; then
        databasesize="0 KB"
    elif [ "$TOTAL_SIZE_KB" -lt 1024 ]; then
        databasesize="$TOTAL_SIZE_KB KB"
    else
        databasesize=$(echo "scale=0; $TOTAL_SIZE_KB / 1024" | bc)
        databasesize="$databasesize MB"
    fi
else
    databasesize="0 KB"
fi
#############################
if [ -f /etc/cron.d/auto.backup.all.databases.cron ] && [ -f /etc/dsnvps/auto.backup.all.databases.conf ]; then
autobackupdata=BẬT

thoigianmode=`cat /etc/cron.d/auto.backup.all.databases.cron | awk 'NR==2 {print $3,$4,$5}'`
if [ "$thoigianmode" == "* * *" ]; then
thoigianbackup=`echo "Lịch sao lưu: hàng ngày"`
else
thoigianbackup=`echo "Lịch sao Lưu: hàng tuần"`
fi

rm -rf /etc/dsnvps/.tmp/zasxcetbvcx
cat > "/etc/dsnvps/.tmp/zasxcetbvcx" <<END
#!/bin/bash
. /etc/dsnvps/auto.backup.all.databases.conf
echo "\$songayxoa" > /etc/dsnvps/.tmp/zadertycvb
rm -rf /etc/dsnvps/.tmp/zasxcetbvcx
END
sh /etc/dsnvps/.tmp/zasxcetbvcx
ngayluutru=`cat /etc/dsnvps/.tmp/zadertycvb`
ngaytuxoa=`echo "| Lưu trữ file: ${ngayluutru} ngày"`
else
autobackupdata=`echo "TẮT (không an toàn - Khuyến nghị: BẬT)"`
thoigianbackup=""
fi
rm -rf /etc/dsnvps/.tmp/*dsnvps*
show_phan_tren_menu()
{
/etc/dsnvps/menu/dsnvps-menu-all-function  
printf "=========================================================================\n"
