    5) /etc/dsnvps/menu/dsnvps-phuc-hoi-database-chon-dinh-dang;;
    6) /etc/dsnvps/menu/dsnvps-befor-sao-luu-phuc-hoi-tat-ca-database-menu;; 
    7) /etc/dsnvps/menu/dsnvps-link-database-sao-luu;;
    8) /etc/dsnvps/menu/dsnvps-copy-backup-database-to-root-folder;;
    9) /etc/dsnvps/menu/dsnvps-xoa-toan-bo-backup-database;;
    #10) /etc/dsnvps/menu/dsnvps-xem-thong-tin-username-password-database;;
    #11) /etc/dsnvps/menu/dsnvps-hien-mat-khau-root-mysql;;
    #12) /etc/dsnvps/menu/dsnvps-change-root-mysql-password;;
    #14) /etc/dsnvps/menu/dsnvps-re-config-database-cau-hinh-lai-mysql;;
    #11) /etc/dsnvps/menu/tienich/befor-auto-start-mysql;;
    #15) clear; exit 0;;
0) clear; exit 0;;
        *)
           # clear
            echo "========================================================================="
            echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!"; sleep 2.8
            #echo "You typed wrong, Please type in the ordinal number on the list."; sleep 2.3 
            #show_phan_tren_menu
 ####### ########## XOA 4 DONG PHIA TREN ################
 sleep 2
 tput cuu 12   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<12; i++)); do
