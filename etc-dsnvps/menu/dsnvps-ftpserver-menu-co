#!/bin/bash
if [ ! -f /etc/pure-ftpd/pureftpd.passwd ]; then
touch /etc/pure-ftpd/pureftpd.passwd
fi
show_phan_tren_menu()
{
/etc/dsnvps/menu/dsnvps-menu-all-function  
printf "=========================================================================\n"
printf "                    Quản Lý Tài Khoản FTP Cho Website \n"
printf "=========================================================================\n"
echo "========================================================================="
}
while true; do
clear
show_phan_tren_menu

printf "%-31s %s\n" "1) Tạo Tài Khoản FTP Cho Website |" "4) Cài Đặt Quota HDD & Số Lượng File |"
printf "%-31s %s\n" "2) Vô Hiệu Hóa Tài Khoản FTP     |""--------------------------------------|"
printf "%-35s %s\n" "3) Thay Mật Khẩu Tài Khoản FTP   |" "5) Xem Thông Tin FTP Của Website     |"
echo "========================================================================="
    # Lua chon cua nguoi dung
    read -p "Lựa chọn của bạn [0 -Thoát]: " choice

    case $choice in 
    
        1) /etc/dsnvps/menu/dsnvps-tao-ftp-user-cho-domain;;
		2) /etc/dsnvps/menu/dsnvps-xoa-ftp-user;;
		3) /etc/dsnvps/menu/dsnvps-thay-mat-khau-user-ftp;;
		4) /etc/dsnvps/menu/dsnvps-cai-dat-gioi-han-dung-luong-ftp-account;;
		5) /etc/dsnvps/menu/dsnvps-view-userftp-password;;
        #6) /etc/dsnvps/menu/dsnvps-remove-ftp-server;;
0) clear; exit 0;;
        *)
        echo "========================================================================="
        echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!"; sleep 3
        #echo "You typed wrong, Please type in the ordinal number on the list."; 3
        tput cuu 7; for ((i=0; i<7; i++)); do tput el; tput cud1; done; tput cuu 7;; esac; done


