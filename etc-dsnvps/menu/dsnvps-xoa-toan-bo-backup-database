#!/bin/bash

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/checkalldatabase
ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/checkalldatabase
if [ "$(cat /etc/dsnvps/.tmp/checkalldatabase | wc -l)" -lt "1" ]; then
rm -rf /etc/dsnvps/.tmp/checkalldatabase
clear
echo "========================================================================="
echo "Hiện tại bạn chưa tạo database trên server !"
/etc/dsnvps/menu/dsnvps-them-xoa-database
exit
fi
rm -rf /etc/dsnvps/.tmp/checkalldatabase
find /home/$mainsite/private_html/backup/ -name "*.tar.gz*" > /etc/dsnvps/.tmp/dsnvps_check_backup_database_size
find /home/$mainsite/private_html/backup/ -name "*.sql.gz*" >> /etc/dsnvps/.tmp/dsnvps_check_backup_database_size
numberfiles=$(cat /etc/dsnvps/.tmp/dsnvps_check_backup_database_size | wc -l)
if [ "$numberfiles" == "0" ]; then
rm -rf /etc/dsnvps/.tmp/dsnvps*
clear
echo "========================================================================="
echo "Không tìm thấy file backup của database trên server!"
/etc/dsnvps/menu/dsnvps-them-xoa-database
exit
fi
rm -rf /etc/dsnvps/.tmp/dsnvps*

if [ ! -d /home/$mainsite/private_html ]; then
clear
echo "========================================================================="
echo "Bạn không thể dùng chức năng này."
/etc/dsnvps/menu/dsnvps-them-xoa-database
exit
fi
echo "========================================================================="
echo "Sử dụng chức năng này để xóa tất cả các file sao lưu database trên server"
echo "-------------------------------------------------------------------------"
read -r -p "Bạn chắc chắn muốn xóa các file này? [y/N] " response

case $response in
    [yY][eE][sS]|[yY]) 
cd /home/$mainsite/private_html/backup/
find . -name "*.tar.gz" > /etc/dsnvps/.tmp/deletebackupdb
find . -name "*.tar.gz.*" >> /etc/dsnvps/.tmp/deletebackupdb
find . -name "*.sql.gz" >> /etc/dsnvps/.tmp/deletebackupdb
find . -name "*.sql.gz.*" >> /etc/dsnvps/.tmp/deletebackupdb
checksize=$(du -sb /etc/dsnvps/.tmp/deletebackupdb | awk 'NR==1 {print $1}')
	if [ "$checksize" = "0" ]; then
	echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 2
	clear
	echo "========================================================================= "
	echo "Không tìm thấy sao lưu của các database trên server"
/etc/dsnvps/menu/dsnvps-them-xoa-database
	exit
	fi
listfolder=$(cat /etc/dsnvps/.tmp/deletebackupdb)
for pathfolder in $listfolder
do
export dsnvps=$pathfolder
export sim=${dsnvps%/*}
rm -rf "${sim}"
done
cd
rm -rf /etc/dsnvps/.tmp/deletebackupdb
rm -rf /home/$mainsite/private_html/Listbackupall*
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 2
clear
echo "========================================================================= "
echo "Xóa tất cả các bản sao lưu database trên server thành công"
/etc/dsnvps/menu/dsnvps-them-xoa-database
;;
    *)
        echo ""
        ;;
esac
clear
echo "========================================================================="
echo "Huỷ bỏ"
/etc/dsnvps/menu/dsnvps-them-xoa-database
