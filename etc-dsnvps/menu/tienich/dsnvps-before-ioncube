#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

	if [ "`systemctl is-active php-fpm.service`" == "active" ]; then
/etc/dsnvps/menu/tienich/dsnvps-ioncube-cai-dat-remove
	else
systemctl start php-fpm.service
	if [ "`systemctl is-active php-fpm.service`" == "active" ]; then
/etc/dsnvps/menu/tienich/dsnvps-ioncube-cai-dat-remove
		else
clear
echo "========================================================================="
echo "PHP-FPM không thể khởi động"
echo "-------------------------------------------------------------------------"
echo "Bạn không thể cài đặt hay gỡ bỏ Ioncube Loader."
/etc/dsnvps/menu/dsnvps-config-php.ini-menu
		fi
fi

