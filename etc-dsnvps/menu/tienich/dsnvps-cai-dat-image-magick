#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed


if [ "$(/bin/systemctl status  php-fpm.service | awk 'NR==3 {print $2}')" == "inactive" ]; then
clear
echo "========================================================================="
echo "PHP-FPM đang dừng!"
echo "-------------------------------------------------------------------------"
echo "Bạn không thể Cài đặt/Gỡ bỏ Imagick"
/etc/dsnvps/menu/dsnvps-tien-ich
exit
fi
if [ "$(/bin/systemctl status  php-fpm.service | awk 'NR==3 {print $2}')" == "failed" ]; then
clear
echo "========================================================================="
echo "PHP-FPM đang dừng!"
echo "-------------------------------------------------------------------------"
echo "Bạn không thể Cài đặt/Gỡ bỏ Imagick"
/etc/dsnvps/menu/dsnvps-tien-ich
exit
fi

echo "========================================================================="
read -r -p "Bạn muốn cài đặt / cài lại Imagick? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
echo "Ok ! Vui lòng chờ ...."
sleep 2
clear
rm -rf /etc/php.d/imagick.ini 
pecl uninstall imagick
#############################
yes "" | pecl install imagick
php_version=$(php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;")
if [ "$php_version" == "5.4" ]; then
duongdanimagick=$(find / -name 'imagick.so' | grep php/modules/imagick.so)
echo "extension=$duongdanimagick" >> /etc/php.d/imagick.ini
else
echo "extension=imagick.so" > /etc/php.d/imagick.ini
fi
wget -q http://dsnvps/script/dsnvps/check-imagick.php.zip -O /home/$mainsite/private_html/check-imagick.php

/etc/dsnvps/menu/inc/re-start-php-fpm-service 

clear
echo "========================================================================="
echo "Bạn đã hoàn tất cài đặt hoặc cài đặt lại IMAGICK"
echo "-------------------------------------------------------------------------"
echo "Kiểm tra trạng thái cài đặt Imagick:"
echo "-------------------------------------------------------------------------"
echo "http://$serverip_priport/check-imagick.php"
/etc/dsnvps/menu/dsnvps-tien-ich
 ;;
    *)
    clear
    echo "========================================================================="
echo "Hủy bỏ !"
/etc/dsnvps/menu/dsnvps-tien-ich
        ;;
esac
clear
echo "========================================================================="
echo "Hủy bỏ !"
/etc/dsnvps/menu/dsnvps-tien-ich
exit
fi
