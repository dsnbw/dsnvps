#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

echo "========================================================================= "
echo "Sử dụng chức năng này để thay đổi port Quản Lý (Phpmyadmin port) khi truy"
echo "-------------------------------------------------------------------------"
echo "cập phpmyadmin bằng http://$serverip"
echo "-------------------------------------------------------------------------"
read -r -p "Bạn muốn thay đổi port Quản Lý? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
echo "-------------------------------------------------------------------------"
echo -n "Nhập port Quản Lý hiện tại của bạn [ENTER]: "
read portbimat

if [[ ! ${portbimat} =~ ^[0-9]+$ ]] ;then 
clear
echo "========================================================================="
echo "Port bạn nhập: ${portbimat} không phải là số tự nhiên."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy làm lại!"
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
exit
fi


if [ "$(grep "listen   ${portbimat}" /etc/nginx/conf.d/$mainsite.conf)" == "" ]; then
clear
echo "========================================================================= "
echo "Port Quản Lý bạn nhập không chính xác"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy làm lại!" 
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
exit
fi
echo "-------------------------------------------------------------------------"
echo -n "Nhập port Quản Lý mới bạn muốn thay cho port $portbimat [ENTER]:"
read portbimatmoi

if [[ ! ${portbimatmoi} =~ ^[0-9]+$ ]] ;then 
clear
echo "========================================================================="
echo "Port bạn nhập: ${portbimatmoi} không phải là số tự nhiên."
echo "-------------------------------------------------------------------------"
echo "Bạn hãy làm lại!" 
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
exit
fi

if [ "$portbimat" = "$portbimatmoi" ]; then
clear
echo "========================================================================="
echo "Port mới bạn muốn thay trùng với port Quản Lý cũ!"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy làm lại"
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
exit
fi 


cat > "/etc/dsnvps/.tmp/changeport-run" <<END
sed -i 's/listen   $portbimat;/listen   $portbimatmoi;/g' /etc/nginx/conf.d/$mainsite.conf
sed -i 's/priport="$portbimat"/priport="$portbimatmoi"/g' /root/dsnvps.conf
if [ -f /etc/csf/csf.conf ]; then
sed -i 's/.*TCP_IN\ =\ "20,21,22,25,53,80,110,143,443,465,587,993.*/TCP_IN\ =\ "20,21,22,25,53,80,110,143,443,465,587,993,995,6379,11211,30000:50000,$portbimatmoi"/g' /etc/csf/csf.conf
sed -i 's/.*TCP_OUT\ =\ "20,21,22,25,53,80,110,113,443,587,11211.*/TCP_OUT\ =\ "20,21,22,25,53,80,110,113,443,587,11211,993,995,6379,465,587,3306,3307,8080,$portbimatmoi"/g' /etc/csf/csf.conf
fi
END

chmod +x /etc/dsnvps/.tmp/changeport-run
/etc/dsnvps/.tmp/changeport-run

rm -rf /etc/dsnvps/.tmp/changeport-run


echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ....";sleep 2
iptables -I INPUT -p tcp --dport $portbimat -j DROP
iptables -I INPUT -p tcp --dport $portbimatmoi -j ACCEPT
if command -v nft >/dev/null 2>&1; then nft list ruleset > /etc/nftables.conf 2>/dev/null || true; else service iptables save 2>/dev/null || true; fi
#########  Restart Nginx ###############
/etc/dsnvps/menu/inc/re-start-nginx-service
#################################
if [ -f /etc/csf/csf.conf ]; then
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
fi
clear
echo "========================================================================="
echo "Thay đổi port Quản Lý cho Server thành công!"
echo "-------------------------------------------------------------------------"
echo "Từ bây giờ port Quản Lý đã được thay bằng: $portbimatmoi "
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu
;;
esac
clear
echo "========================================================================="
echo "Hủy bỏ!"
/etc/dsnvps/menu/dsnvps-phpmyadmin-menu

