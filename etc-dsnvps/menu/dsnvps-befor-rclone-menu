#!/bin/bash
. /root/dsnvps.conf
##############
# Phien ban RCLONE cai dat:######################
VERSION="1.69.1"

if ! command -v rclone &>/dev/null || [ "$(rclone --version | head -n 1 | awk '{print $2}' | tr -d 'v' 2>/dev/null)" != "$VERSION" ]; then
    unzip_tools_list=('unzip' '7z' 'busybox')
    echo "========================================================================="
    echo "Cấu hình lần đầu! Vui lòng đợi ..."

    TMP_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t 'rclone-install.XXXXXXXXXX') || exit 1
    cd "$TMP_DIR" &>/dev/null || exit 1

    for tool in "${unzip_tools_list[@]}"; do
        if command -v "$tool" &>/dev/null; then
            UNZIP_TOOL="$tool"
            break
        fi
    done

    [ -z "$UNZIP_TOOL" ] && exit 4

    OS=$(uname)
    case "$OS" in
        Linux) OS='linux' ;;
        FreeBSD) OS='freebsd' ;;
        NetBSD) OS='netbsd' ;;
        OpenBSD) OS='openbsd' ;;
        Darwin) OS='osx' ;;
        *) exit 2 ;;
    esac

    ARCH=$(uname -m)
    case "$ARCH" in
        x86_64|amd64) ARCH='amd64' ;;
        i?86|x86) ARCH='386' ;;
        aarch64|arm64) ARCH='arm64' ;;
        armv7*) ARCH='arm-v7' ;;
        armv6*) ARCH='arm-v6' ;;
        arm*) ARCH='arm' ;;
        *) exit 2 ;;
    esac

    DOWNLOAD_LINK="https://downloads.rclone.org/v${VERSION}/rclone-v${VERSION}-${OS}-${ARCH}.zip"
    RCLONE_ZIP="rclone-v${VERSION}-${OS}-${ARCH}.zip"

    curl -OfsS "$DOWNLOAD_LINK" &>/dev/null || exit 3

    UNZIP_DIR="rclone_unzip"
    mkdir -p "$UNZIP_DIR" &>/dev/null || exit 1

    case "$UNZIP_TOOL" in
        'unzip') unzip -a "$RCLONE_ZIP" -d "$UNZIP_DIR" &>/dev/null || exit 5 ;;
        '7z') 7z x "$RCLONE_ZIP" "-o$UNZIP_DIR" &>/dev/null || exit 5 ;;
        'busybox') busybox unzip "$RCLONE_ZIP" -d "$UNZIP_DIR" &>/dev/null || exit 5 ;;
    esac

    cd "$UNZIP_DIR/rclone-v${VERSION}-${OS}-${ARCH}" &>/dev/null || exit 1

    case "$OS" in
        'linux'|'freebsd'|'openbsd'|'netbsd')
            sudo cp rclone /usr/bin/rclone.new &>/dev/null || exit 6
            sudo chmod 755 /usr/bin/rclone.new &>/dev/null
            sudo chown root:root /usr/bin/rclone.new &>/dev/null
            sudo mv /usr/bin/rclone.new /usr/bin/rclone &>/dev/null
            ;;
        'osx')
            sudo mkdir -p /usr/local/bin &>/dev/null
            sudo cp rclone /usr/local/bin/rclone.new &>/dev/null || exit 6
            sudo mv /usr/local/bin/rclone.new /usr/local/bin/rclone &>/dev/null
            sudo chmod a+x /usr/local/bin/rclone &>/dev/null
            ;;
    esac

    cd / &>/dev/null
    rm -rf "$TMP_DIR" &>/dev/null
fi
/etc/dsnvps/menu/dsnvps-sao-luu-vps-toi-cloud-tele-menu
