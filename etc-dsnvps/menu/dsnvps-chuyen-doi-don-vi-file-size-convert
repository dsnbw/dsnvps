elif [ "$donvicanchuyen" = "Gigabyte" ]; then
echo -n "Nhập FileSize (Không bao gồm GB): "
read nhapso
nhapso=`echo $nhapso | tr '[A-Z]' '[a-z]'`
if [ "$nhapso" = "" ]; then
