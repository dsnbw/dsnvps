#!/bin/bash
. /root/dsnvps.conf

# Tạo thư mục nếu chưa tồn tại
if [ ! -d /etc/dsnvps ]; then
    mkdir -p /etc/dsnvps
fi

# Kiểm tra và cài đặt jq nếu chưa có
if ! command -v jq >/dev/null 2>&1; then
    echo "========================================================================="
    echo "Đang cài đặt jq để xử lý JSON..."
    echo "========================================================================="
    if command -v dnf >/dev/null 2>&1; then
        apt-get install -y -qq jq >/dev/null 2>&1
    elif command -v yum >/dev/null 2>&1; then
        apt-get install -y -qq jq >/dev/null 2>&1
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get update >/dev/null 2>&1 && apt-get install -y jq >/dev/null 2>&1
    fi
fi

#clear
echo "========================================================================="
echo "CẤU HÌNH CLOUDFLARE API"
echo "========================================================================="
echo "API Global hoặc API Token được dùng để hỗ trợ cài đặt Let's Encrypt SSL "
echo "-------------------------------------------------------------------------"
echo "đơn giản hơn và nhanh hơn."
echo "========================================================================="
echo "========================================================================="

# Kiểm tra xem đã có API Global chưa
if [ -f /etc/dsnvps/ssl-cloudflare-api-global.conf ]; then
    source /etc/dsnvps/ssl-cloudflare-api-global.conf
    if [ -n "$global_ssl_api_email" ]; then
        echo "==> DSNVPS đã cấu hình Cloudflare API Global (SSL)"
        echo "-------------------------------------------------------------------------"
        echo "Loại: Global API Key"
        echo "Email: $global_ssl_api_email"
        echo "API Key: ${global_ssl_api_token:0:10}..."
    else
        echo "==> DSNVPS đã cấu hình Cloudflare API Token (SSL)"
        echo "-------------------------------------------------------------------------"
        echo "Loại: API Token"
        echo "API Token: ${global_ssl_api_token:0:10}..."
    fi
    echo "========================================================================="
    echo "==> Bạn có muốn cấu hình lại không?"
    echo "-------------------------------------------------------------------------"
    if [ -n "$global_ssl_api_email" ]; then
        echo "1. Cấu hình lại Cloudflare API Global"
        echo "2. Xóa Cloudflare API Global"
    else
        echo "1. Cấu hình lại Cloudflare API Token"
        echo "2. Xóa Cloudflare API Token"
    fi
    echo "========================================================================="
    
    while true; do
        read -p "Lựa chọn của bạn [0 -Thoát]: " choice
        
        case $choice in
            1)
                echo "========================================================================="
                echo "Cấu hình lại Cloudflare API Global"
                echo "========================================================================="
                # Xóa config cũ và tiếp tục với phần nhập mới
                rm -f /etc/dsnvps/ssl-cloudflare-api-global.conf
                break
                ;;
            2)
                echo "========================================================================="
                if [ -n "$global_ssl_api_email" ]; then
                    echo "Xóa Cloudflare API Global"
                    echo "========================================================================="
                    echo "Bạn có chắc chắn muốn xóa cấu hình API Global không?"
                else
                    echo "Xóa Cloudflare API Token"
                    echo "========================================================================="
                    echo "Bạn có chắc chắn muốn xóa cấu hình API Token không?"
                fi
                echo "-------------------------------------------------------------------------"
                read -p "Nhập 'y/Y' để xác nhận xóa [0 -Thoát]: " confirm
                
                if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                    rm -f /etc/dsnvps/ssl-cloudflare-api-global.conf
                    echo "========================================================================="
                    if [ -n "$global_ssl_api_email" ]; then
                    clear
                    echo "========================================================================="
                        echo "Đã xóa cấu hình API Global thành công!"
                        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    else
                    clear
                    echo "========================================================================="
                        echo "Đã xóa cấu hình API Token thành công!"
                        /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    fi
                    echo "========================================================================="
                    sleep 3
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                elif [ "$confirm" = "0" ]; then
                    clear
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                else
                    echo "========================================================================="
                    echo "Hủy xóa API Global"
                    echo "========================================================================="
                    sleep 3
                    tput cuu 6 && tput ed
                fi
                ;;
0) clear; exit 0;;
            *)
                echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2 hoặc 0"
                ;;
        esac
    done
fi

# Nhập thông tin API Global mới
echo "========================================================================="
echo "Chọn loại API:"
echo "-------------------------------------------------------------------------"
echo "1. Global API Key (Email + Key)"
echo "2. API Token (Nên dùng)"
echo "========================================================================="

while true; do
    read -p "Lựa chọn của bạn [0 -Thoát]: " api_type
    
    case $api_type in
        1)
            echo "========================================================================="
            echo "CẤU HÌNH SỬ DỤNG GLOBAL API KEY"
            echo "========================================================================="
            echo "-------------------------------------------------------------------------"
            echo "Và lấy API Keys - Global API Key ở dưới cùng của trang đó."
            echo "========================================================================="
            while true; do
                echo -n "Nhập Email Cloudflare [0 -Thoát]: "
                read -r apiemail
                
                if [ "$apiemail" = "0" ]; then
                    clear
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                fi
                
                if [ -z "$apiemail" ]; then
                    echo "========================================================================="
                    echo "Bạn nhập sai, vui lòng nhập lại!"
                    sleep 2
                    continue
                fi
                break
            done
            
            while true; do
                echo "-------------------------------------------------------------------------"
                echo -n "Nhập Global API Key [0 -Thoát]: "
                read -r apitoken
                
                if [ "$apitoken" = "0" ]; then
                    clear
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                fi
                
                if [ -z "$apitoken" ]; then
                    echo "========================================================================="
                    echo "Bạn nhập sai, vui lòng nhập lại!"
                    sleep 2
                    continue
                fi
                break
            done
            break
            ;;
        2)
            echo "========================================================================="
            echo "CẤU HÌNH SỬ DỤNG API TOKEN"
            echo "========================================================================="
            echo "-------------------------------------------------------------------------"
            echo "Và tạo API Token với các quyền sau:"
            echo "-------------------------------------------------------------------------"
            echo "Permissions:"
            echo "-----------"
            echo "Zone - Zone - Read"
            echo "Zone - Zone - Edit"
            echo "Zone - Zone Setting - Edit"
            echo "Zone - SSL and Certificate - Edit"
            echo "Zone - SSL and Certificate - Read "
            echo "Zone - DNS - Edit" 
            echo "Zone - Cache Pure - Pure"
            echo "-------------------------------------------------------------------------"
             echo "Zone Resources:"
            echo "----------------"   
            echo "Include: All zones"
            echo "========================================================================="         
            while true; do
                echo -n "Nhập API Token [0 -Thoát]: "
                read -r apitoken
                
                if [ "$apitoken" = "0" ]; then
                    clear
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                fi
                
                if [ -z "$apitoken" ]; then
                    echo "========================================================================="
                    echo "Bạn nhập sai, vui lòng nhập lại!"
                    sleep 2
                    continue
                fi
                break
            done
            apiemail=""  # Không cần email với API Token
            break
            ;;
0) clear; exit 0;;
        *)
            echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2 hoặc 0"
            ;;
    esac
done

# Kiểm tra API với vòng lặp cho phép nhập lại
while true; do
    echo "========================================================================="
    if [ -n "$apiemail" ]; then
        echo "DSNVPS đang kiểm tra Global API Key ..."
    else
        echo "DSNVPS đang kiểm tra API Token ..."
    fi
    sleep 4

    # Kiểm tra API dựa trên loại
    if [ -n "$apiemail" ]; then
        # Global API Key
        user_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user" \
             -H "X-Auth-Email: $apiemail" \
             -H "X-Auth-Key: $apitoken" \
             -H "Content-Type: application/json")
        zone_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones" \
             -H "X-Auth-Email: $apiemail" \
             -H "X-Auth-Key: $apitoken" \
             -H "Content-Type: application/json")
    else
        # API Token
        user_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
             -H "Authorization: Bearer $apitoken" \
             -H "Content-Type: application/json")
        zone_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones" \
             -H "Authorization: Bearer $apitoken" \
             -H "Content-Type: application/json")
    fi

    if echo "$user_response" | grep -q '"success":true'; then
        
        if echo "$zone_response" | grep -q '"success":true'; then
            echo "========================================================================="
            if [ -n "$apiemail" ]; then
                echo "Global API Key chính xác."
            else
                echo "API Token chính xác."
            fi
            echo "-------------------------------------------------------------------------"
            echo "Đang lưu cấu hình API Global SSL ..."
            sleep 3
            
            # Lưu thông tin vào file cấu hình
            if [ -n "$apiemail" ]; then
                echo "global_ssl_api_email=\"$apiemail\"" > /etc/dsnvps/ssl-cloudflare-api-global.conf
            else
                echo "global_ssl_api_email=\"\"" > /etc/dsnvps/ssl-cloudflare-api-global.conf
            fi
            echo "global_ssl_api_token=\"$apitoken\"" >> /etc/dsnvps/ssl-cloudflare-api-global.conf
            chmod 600 /etc/dsnvps/ssl-cloudflare-api-global.conf
            
            clear
            echo "========================================================================="
            echo "Cấu hình API Global SSL thành công!"
            echo "-------------------------------------------------------------------------"
            if [ -n "$apiemail" ]; then
                echo "Loại: Global API Key"
                echo "-------------------------------------------------------------------------"
                echo "Email: $apiemail"
                echo "-------------------------------------------------------------------------"
                echo "API Key: ${apitoken:0:10}..."
            else
                echo "Loại: API Token"
                echo "-------------------------------------------------------------------------"
                echo "API Token: ${apitoken:0:10}..."
            fi
            echo "-------------------------------------------------------------------------"
            echo "Từ bây giờ, khi cài đặt SSL cho domain/subdomain, DSNVPS sẽ tự động tạo"
            echo "-------------------------------------------------------------------------"
            echo "chứng chỉ SSL cho domain/subdomain."
            echo "========================================================================="
            
            # Hiển thị danh sách domain có thể quản lý với API này
            echo "Danh sách domain có thể quản lý SSL với Cloudflare API Global này:"
            echo "-------------------------------------------------------------------------"
            
            # Lấy danh sách zones từ Cloudflare
            if echo "$zone_response" | grep -q '"result":\[.*\]' && ! echo "$zone_response" | grep -q '"result":\[\]'; then
                # Kiểm tra xem có jq không
                if command -v jq >/dev/null 2>&1; then
                    echo "$zone_response" | jq -r '.result[] | .name' 2>/dev/null | while read domain; do
                        if [ -n "$domain" ] && [ "$domain" != "null" ]; then
                            echo "- $domain"
                        fi
                    done
                else
                    # Fallback nếu không có jq
                    echo "$zone_response" | grep -o '"name":"[^"]*"' | sed 's/"name":"//;s/"//' | grep -v "Account" | grep -v "Free Website" | while read domain; do
                        if [ -n "$domain" ] && [ "$domain" != "null" ]; then
                            echo "- $domain"
                        fi
                    done
                fi
            else
                echo "Không có domain nào trong tài khoản Cloudflare này."
            fi
            
            echo "========================================================================="
            echo "Nhấn Enter để quay về menu chính..."
            read
            clear
            /etc/dsnvps/menu/dsnvps-letsencrypt-menu
            exit 0
        else
            echo "========================================================================="
            if [ -n "$apiemail" ]; then
                echo "Global API Key không có quyền truy cập zones hoặc không có domain nào"
            else
                echo "API Token không có quyền truy cập zones hoặc không có domain nào"
            fi
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng kiểm tra lại quyền hạn của API."
            echo "========================================================================="
            sleep 4
            /etc/dsnvps/menu/dsnvps-letsencrypt-menu
            exit 0
        fi
    else
        echo "========================================================================="
        if [ -n "$apiemail" ]; then
            echo "Bạn nhập sai Email hoặc Global API Key"
        else
            echo "API Token không hợp lệ hoặc đã hết hạn"
        fi
        echo "-------------------------------------------------------------------------"
        echo "Bạn có muốn nhập lại không?"
        echo "-------------------------------------------------------------------------"
        echo "1. Nhập lại API"
        echo "2. Quay về menu chính"
        echo "========================================================================="
        
        while true; do
            read -p "Lựa chọn của bạn [0 -Thoát]: " retry_choice
            
            case $retry_choice in
                1)
                    echo "========================================================================="
                    if [ -n "$apiemail" ]; then
                        echo "CẤU HÌNH LẠI GLOBAL API KEY"
            echo "========================================================================="
            echo "-------------------------------------------------------------------------"
            echo "Và lấy API Keys - Global API Key ở dưới cùng của trang đó."
            echo "========================================================================="
                        while true; do
                            echo -n "Nhập Email Cloudflare [0 -Thoát]: "
                            read -r apiemail
                            
                            if [ "$apiemail" = "0" ]; then
                                clear
                                /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                                exit 0
                            fi
                            
                            if [ -z "$apiemail" ]; then
                                echo "========================================================================="
                                echo "Bạn nhập sai, vui lòng nhập lại!"
                                sleep 2
                                continue
                            fi
                            break
                        done
                        
                        while true; do
                            echo "-------------------------------------------------------------------------"
                            echo -n "Nhập Global API Key [0 -Thoát]: "
                            read -r apitoken
                            
                            if [ "$apitoken" = "0" ]; then
                                clear
                                /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                                exit 0
                            fi
                            
                            if [ -z "$apitoken" ]; then
                                echo "========================================================================="
                                echo "Bạn nhập sai, vui lòng nhập lại!"
                                sleep 2
                                continue
                            fi
                            break
                        done
                    else
                        echo "CẤU HÌNH LẠI API TOKEN"
                        echo "========================================================================="
            echo "-------------------------------------------------------------------------"
            echo "Và tạo API Token với các quyền sau:"
            echo "-------------------------------------------------------------------------"
            echo "Permissions:"
            echo "-----------"
            echo "Zone - Zone - Read"
            echo "Zone - Zone - Edit"
            echo "Zone - Zone Setting - Edit"
            echo "Zone - SSL and Certificate - Edit"
            echo "Zone - SSL and Certificate - Read "
            echo "Zone - DNS - Edit" 
            echo "Zone - Cache Pure - Pure"
            echo "-------------------------------------------------------------------------"
             echo "Zone Resources:"
            echo "----------------"   
            echo "Include: All zones"
            echo "========================================================================="  
                        
                        while true; do
                            echo -n "Nhập API Token [0 -Thoát]: "
                            read -r apitoken
                            
                            if [ "$apitoken" = "0" ]; then
                                clear
                                /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                                exit 0
                            fi
                            
                            if [ -z "$apitoken" ]; then
                                echo "========================================================================="
                                echo "Bạn nhập sai, vui lòng nhập lại!"
                                sleep 2
                                continue
                            fi
                            break
                        done
                    fi
                    break
                    ;;
                2)
                    clear
                    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
                    exit 0
                    ;;
0) clear; exit 0;;
                *)
                    echo "Lựa chọn không hợp lệ. Vui lòng chọn 1, 2 hoặc 0"
                    ;;
            esac
        done
    fi
done
