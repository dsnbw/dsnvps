#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
checktruenumber='^[0-9]+$'
if [ ! -f /etc/dsnvps/minfreedisc.info ]; then
echo "1000" > /etc/dsnvps/minfreedisc.info
fi
minfreedisc=`cat /etc/dsnvps/minfreedisc.info`
if [[ ! $minfreedisc =~ $checktruenumber ]] ; then
echo "1000" > /etc/dsnvps/minfreedisc.info
fi 

kiemtraemail3="^(([-a-zA-Z0-9\!#\$%\&\'*+/=?^_\`{\|}~])+\.)*[-a-zA-Z0-9\!#\$%\&\'*+/=?^_\`{\|}~]+@\w((-|\w)*\w)*\.(\w((-|\w)*\w)*\.)*\w{2,24}$";
if [ ! -f /root/.bash_profile ]; then
clear
echo "========================================================================="
echo "Can not find file /root/.bash_profile"
echo "-------------------------------------------------------------------------"
echo "DSNVPS can not run this function on this server"
echo "-------------------------------------------------------------------------"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi

prompt="Nhập Lựa chọn của bạn [0 -Thoát]: "
options=( "Bat/Tat Thong Bao Login SSH vào Server Qua Email" "Thay Doi Email Nhan Thong Bao")
printf "=========================================================================\n"
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) cauhinh="battatemail"; break;;
    2) cauhinh="thaydoiemail"; break;;
    0) cauhinh="cancel"; break;;
    *) echo "Bạn nhập sai! Vui lòng chọn số trong danh sách.";continue;;
    esac  
done
###################################

###################################
if [ "$cauhinh" = "battatemail" ]; then

if [ "$(grep timelogindsnvpscheck /root/.bash_profile)" == "" ]; then
echo "========================================================================="
echo "Su dung chuc nang nay de BAT/TAT chuc nang gui thong bao qua email"
echo "-------------------------------------------------------------------------"
echo "moi khi co dang nhap SSH vào Server."
echo "-------------------------------------------------------------------------"
echo -n "Nhap dia chi email [ENTER]: " 
read dsnvpsemail
if [ "$dsnvpsemail" = "" ]; then
clear
echo "========================================================================="
echo "Bạn nhập sai, vui lòng nhập lại!"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi

if [[ ! "$dsnvpsemail" =~ $kiemtraemail3 ]]; then
clear
echo "========================================================================="
echo "$dsnvpsemail co le khong dung dinh dang email!"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại  !"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 4
rm -rf /etc/dsnvps/.tmp/checkautorundsnvps
if [ ! "$(grep "/bin/dsnvps" /root/.bash_profile)" == "" ]; then
echo "1" > /etc/dsnvps/.tmp/checkautorundsnvps
 sed -i '/\/bin\/dsnvps/d' /root/.bash_profile
fi
    cat >> "/root/.bash_profile" <<END
IPdsnvpscheck="\$(echo \$SSH_CONNECTION | cut -d " " -f 1)"
timelogindsnvpscheck=\$(date +"%e %b %Y, %a %r")
echo 'Someone has IP address '\$IPdsnvpscheck' login to $serverip on '\$timelogindsnvpscheck'.' | mail -s 'eMail Notifications From DSNVPS On $serverip' ${dsnvpsemail}
END
#echo 'Someone has IP address '\$IPdsnvpscheck' login to $serverip on '\$timelogindsnvpscheck'.' | mail -s 'eMail Notifications From DSNVPS On $serverip' ${dsnvpsemail}

if [ -f /etc/dsnvps/.tmp/checkautorundsnvps ]; then
echo "/bin/dsnvps" >> /root/.bash_profile
rm -rf /etc/dsnvps/.tmp/checkautorundsnvps
fi

clear
clear
echo "========================================================================="
echo "Hoan thanh cau hinh gui email thong bao khi co dang nhap SSH vào Server"
echo "-------------------------------------------------------------------------"
echo "eMail nhan thong bao: $dsnvpsemail"
echo "-------------------------------------------------------------------------"
echo "Neu khong thay email trong thu muc Inbox. Ban hay check thu muc SPAM "
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
fi

if [ ! "$(grep timelogindsnvpscheck /root/.bash_profile)" == "" ]; then
echo "========================================================================="
echo "Su dung chuc nang nay de BAT/TAT chuc nang gui thong bao qua email"
echo "-------------------------------------------------------------------------"
echo "moi khi co dang nhap SSH vào Server."
echo "-------------------------------------------------------------------------"
echo "Hien tai eMail nhan thong bao: $(grep "mail -s" /root/.bash_profile  | awk 'NR==1 {print $NF}')"
echo "-------------------------------------------------------------------------"
read -r -p "Ban muon TAT email thong bao login ? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ... "
    sleep 3
sed -i '/dsnvpscheck/d' /root/.bash_profile
clear
echo "========================================================================="
echo "TAT chuc nang gui email thong bao login thanh cong! "
 /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
    ;;
*)
clear
echo "========================================================================="
echo "Huỷ bỏ "
 /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
  exit
;;
esac
fi

###################################

###################################
elif [ "$cauhinh" = "thaydoiemail" ]; then

if [ "$(grep timelogindsnvpscheck /root/.bash_profile)" == "" ]; then
clear
echo "========================================================================="
echo "Ban chua cau hinh gui email thong bao khi co dang nhap SSH vào Server"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
emailhientai=$(grep "mail -s" /root/.bash_profile | awk 'NR==1 {print $NF}')
echo "========================================================================="
echo "Su dung chuc nang nay de thay doi email nhan thong bao login ssh"
echo "-------------------------------------------------------------------------"
echo "Hien tai eMail nhan thong bao: $emailhientai"
echo "-------------------------------------------------------------------------"
echo -n "Nhap dia chi email moi [ENTER]: " 
read dsnvpsemailmoi
if [ "$dsnvpsemailmoi" = "" ]; then
clear
echo "========================================================================="
echo "Bạn nhập sai, vui lòng nhập lại!"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
if [[ ! "$dsnvpsemailmoi" =~ $kiemtraemail3 ]]; then
clear
echo "========================================================================="
echo "$dsnvpsemailmoi co le khong dung dinh dang email!"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng thử lại  !"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
exit
fi
echo "-------------------------------------------------------------------------"
read -r -p "Ban muon thay email nhan thong bao login ? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ... "
    sleep 3
sed -i "s/${emailhientai}/${dsnvpsemailmoi}/g" /root/.bash_profile
clear
echo "========================================================================="
echo "Thay dia chi email nhan thong bao login thanh cong! "
    echo "-------------------------------------------------------------------------"
    echo "Dia chi eMail moi la: ${dsnvpsemailmoi}"
    echo "-------------------------------------------------------------------------"
echo "Neu khong thay email trong thu muc Inbox. Ban hay check thu muc SPAM "
 /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
    ;;
*)
clear
echo "========================================================================="
echo "Huỷ bỏ "
 /etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
  exit
;;
esac
###################################
else
clear
exit 0
fi
