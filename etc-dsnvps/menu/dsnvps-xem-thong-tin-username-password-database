#!/bin/bash

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Anti-debug removed

rm -rf /etc/dsnvps/.tmp/checkalldatabase
ls -l /var/lib/mysql | grep "^d" | awk '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/checkalldatabase

if [ "$(cat /etc/dsnvps/.tmp/checkalldatabase | wc -l)" -lt "1" ]; then
    rm -rf /etc/dsnvps/.tmp/checkalldatabase
    clear
    echo "========================================================================="
    echo "Hiện tại bạn chưa tạo database trên server !"
    dsnvps
    exit
fi

rm -rf /etc/dsnvps/.tmp/checkalldatabase

if [ ! -f /root/DBinfo.txt ]; then
    clear
    echo "========================================================================="
    echo "Không tìm thấy /root/DBinfo.txt trên server"
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS không thể thực hiện chức năng này."
    dsnvps
    exit
fi

echo "========================================================================="
echo "Sử dụng chức năng này để xem thông tin của Database."
rm -rf /etc/dsnvps/.tmp/check*

ls -l /var/lib/mysql | grep "^d" | awk '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/checkalldatabase
echo "========================================================================="
mapfile -t file_list < /etc/dsnvps/.tmp/checkalldatabase

echo "Danh sách database trên server:"
echo "-------------------------------------------------------------------------"
total=${#file_list[@]}
half=$(( (total + 1) / 2 ))
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))
    right_index=$((half + i + 1))
    left_db="${file_list[i]:- }"
    if (( right_index <= total )); then
        right_db="${file_list[right_index-1]}"
        printf "%-1s %-25s %-1s %-25s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-25s\n" "$left_index." "$left_db"
    fi
done

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với Database bạn muốn xem thông tin [0 -Thoát]: "
    read -r choice

    if [[ $choice == "0" ]]; then
        clear
        dsnvps
        break
    fi

    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#file_list[@]} )); then
        databasename=${file_list[choice-1]}
    else
        echo "Lựa chọn không hợp lệ."; continue
    fi

    echo "-------------------------------------------------------------------------"
    echo "Tìm thấy database $databasename trên server" ; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS đang tìm thông tin."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."; sleep 2

    # Xử lý xóa block trùng trong DBinfo.txt
    grep -n "Data name: ${databasename}" /root/DBinfo.txt | cut -d':' -f1 > /tmp/line_numbers.txt
    total_lines=$(wc -l < /root/DBinfo.txt)

    tac /tmp/line_numbers.txt | tail -n +2 | while read line; do
        start=$((line - 2))
        [ $start -lt 1 ] && start=1
        end=$((line + 2))
        [ $end -gt $total_lines ] && end=$total_lines
        sed -i "${start},${end}d" /root/DBinfo.txt
    done
    rm -f /tmp/line_numbers.txt

    # Trích xuất thông tin username/password
    rm -f /etc/dsnvps/.tmp/datanamecheck
    awk -v db="Data name: ${databasename}" '
        $0 ~ db {
            getline user_line
            getline pass_line
            print user_line
            print pass_line
            exit
        }
    ' /root/DBinfo.txt > /etc/dsnvps/.tmp/datanamecheck

    databaseuser=$(awk -F': *' 'NR==1 {print $2}' /etc/dsnvps/.tmp/datanamecheck)
    databasepass=$(awk -F': *' 'NR==2 {print $2}' /etc/dsnvps/.tmp/datanamecheck)
    sizedb=$(du -sh /var/lib/mysql/$databasename 2>/dev/null | awk '{print $1}')
    [ -z "$sizedb" ] && sizedb="0KB"

    clear
    echo "========================================================================="
    echo "Thông tin database $databasename:"
    echo "========================================================================="
    echo "Tên Database: $databasename"
    echo "-------------------------------------------------------------------------"
    echo "Username: $databaseuser"
    echo "-------------------------------------------------------------------------"
    echo "Password: $databasepass"
    echo "-------------------------------------------------------------------------"
    echo "Dung lượng hiện tại: $sizedb"
    sleep 1
    dsnvps
done