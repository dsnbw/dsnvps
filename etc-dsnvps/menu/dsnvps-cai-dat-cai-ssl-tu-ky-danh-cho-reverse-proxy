#!/bin/bash
. /root/dsnvps.conf

# Source file check API để có thể sử dụng các function
if [ -f "/etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global" ]; then
    source /etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global
fi
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Kiểm tra cấu hình nginx
if ! nginx -t >/dev/null 2>&1; then
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi cấu hình Nginx..."; sleep 2
    clear
    echo "========================================================================="
    echo "Nginx gặp lỗi. DSNVPS không thể chạy chức năng này !"
    echo "-------------------------------------------------------------------------"
    echo "Chi tiết lỗi Nginx:"
    echo "-------------------------------------------------------------------------"
    nginx -t
    echo "========================================================================="
    echo "Vui lòng sửa lỗi cấu hình Nginx trước khi tiếp tục."
    echo "========================================================================="
  /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit 1
fi

# Anti-debug removed
if [ ! -d /etc/nginx/paidssl ]; then
    mkdir -p /etc/nginx/paidssl
fi
if [ ! -d /home/$mainsite/private_html/paidssl ]; then
    mkdir -p /home/$mainsite/private_html/paidssl
fi
rm -rf /etc/dsnvps/.tmp/klaoxcy
rm -rf /etc/dsnvps/.tmp/klaoxcypark
rm -rf /etc/dsnvps/.tmp/kl0zx
rm -rf /etc/dsnvps/.tmp/$website.conf_HTTPS
######################################################
#lay Danh Sách Website Trên Server####################
nginx_conf_folder="/etc/nginx/conf.d"
home_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcy"
# Xóa file cũ nếu tồn tại
true > "$output_file"
# Duyệt qua tất cả các file .conf trong thư mục cấu hình Nginx
for vhost in "$nginx_conf_folder"/*.conf; do
    domain=$(basename "$vhost" .conf)
    domain_home="$home_folder/$domain/public_html"
    # Kiểm tra nếu domain có thư mục public_html trong /home và vhost trong /etc/nginx/conf.d/
    if [[ -d "$domain_home" && -f "$vhost" && "$domain" != "$mainsite" ]]; then
        echo "$domain" >> "$output_file"
    fi
done
# Thu thập subsite WordPress Multisite
# - Mục đích: Liệt kê subsite WordPress Multisite, thêm ** nếu có SSL Cloudflare
# - Cách hoạt động: Tìm domain có wp-config.php, kiểm tra multisite.conf.d, thêm subsite nếu không là sub-domain và chưa có trong klaixx.txt
# - Kết quả: File klaixx.txt chứa subsite hợp lệ, không lặp
klaixx_file="/etc/dsnvps/.tmp/klaixx.txt"
true > "$klaixx_file"
for vhost in /etc/nginx/conf.d/*.conf; do
    [[ -f "$vhost" ]] || continue
    domain=$(basename "$vhost" .conf)
    domain_home="/home/$domain/public_html"
    if [[ -f "$domain_home/wp-config.php" ]]; then
        multisite_folder="/home/$domain/multisite.conf.d"
        if [[ -d "$multisite_folder" && $(ls -A "$multisite_folder"/*.conf 2>/dev/null) ]]; then
            for subsite_vhost in "$multisite_folder"/*.conf; do
                [[ -f "$subsite_vhost" ]] || continue
                subsite=$(basename "$subsite_vhost" .conf)
                # Chỉ thêm subsite nếu không có Vhost tại /etc/nginx/conf.d/<subsite>.conf và chưa có trong klaixx.txt
                if [[ ! -f "/etc/nginx/conf.d/$subsite.conf" && ! $(grep -Fx "$subsite" "$klaixx_file" 2>/dev/null) ]]; then
                    if [[ -f "/etc/nginx/paidssl/$subsite/$subsite.crt" ]] && grep -q "/etc/nginx/paidssl/$subsite/$subsite.crt" "$subsite_vhost"; then
                        echo "${subsite}**" >> "$klaixx_file"
                    else
                        echo "$subsite" >> "$klaixx_file"
                    fi
                fi
            done
        fi
    fi
done
# Gộp subsite vào danh sách chính
if [[ -s "$klaixx_file" ]]; then
    cat "$klaixx_file" >> "$output_file"
fi
# Kiểm tra nếu không có domain nào được tìm thấy
if [[ ! -s "$output_file" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS đang kiểm tra ......"; sleep 2
    clear
    echo "========================================================================= "
    echo "Không tìm thấy website trên server"
    echo "-------------------------------------------------------------------------"
    echo "Bạn cần thêm Website vào Server trước khi chạy chức năng này."; sleep 2
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi
clear
########################################################
# Đoạn giải thích và xác nhận khi bắt đầu chức năng
echo "========================================================================="
echo "            CÀI ĐẶT SSL TỰ KÝ CHO BACKEND DOMAIN"
echo "========================================================================="
echo -e "Chức năng này dùng để cài đặt SSL tự ký (Self-signed) cho \e[1;32mBackend Domain\e[0m"
echo -e "trên VPS chính, giúp tạo kết nối mã hóa và tránh lỗi \e[1;31mRedirect Loop\e[0m"
echo -e "khi kết nối với \e[1;34mReverse Proxy Domain\e[0m ở VPS phụ."
echo "-------------------------------------------------------------------------"
echo -e "\e[1;33mNGUYÊN LÝ HOẠT ĐỘNG:\e[0m Để kết nối 1 domain ở 2 VPS với nhau, Domain đó"
echo "phải được thêm vào cả 2 VPS cùng một lúc với vai trò khác nhau:"
echo ""
echo -e "1. \e[1;32mTại VPS Chính (Backend Domain):\e[0m Thêm domain như bình thường và sử dụng "
echo "   chức năng này để cài SSL tự ký. Đây là nơi chứa mã nguồn & database."
echo ""
echo -e "2. \e[1;34mTại VPS Reverse Proxy:\e[0m Domain được thêm vào VPS bằng chức năng:"
echo -e "   \e[1;31m\"Thêm Website Reverse Proxy\"\e[0m. Sau đó cài SSL như domain thường."
echo ""
echo -e "\e[1;36mVai trò:\e[0m \e[1;34mReverse Proxy Domain\e[0m là \"điểm tiếp nhận\" nhận request từ khách,"
echo -e "sau đó chuyển tiếp truy cập về \e[1;32mBackend Domain\e[0m trên VPS Chính."
echo "-------------------------------------------------------------------------"
echo -e "\e[1;35mKHUYẾN NGHỊ:\e[0m Nên dùng \e[1;31mSSL Cloudflare (15 Năm)\e[0m cho Reverse Proxy Domain"
echo "để ẩn hoàn toàn IP Phụ và an toàn hơn cho VPS Chính."
echo "-------------------------------------------------------------------------"
echo -e "\e[1;31mLưu ý:\e[0m Chứng chỉ tự ký này chỉ dùng để kết nối nội bộ giữa 2 VPS."
echo "Trình duyệt sẽ báo \"Không an toàn\" nếu bạn truy cập trực tiếp IP Backend."
echo "========================================================================="
echo "Thời hạn chứng chỉ tự ký: 20 năm."
echo "-------------------------------------------------------------------------"
echo "Trong quá trình cài đặt, bạn nên nhập địa chỉ IP của Reverse Proxy VPS,"
echo "Nếu không cấu hình hiển thị IP thật, tất cả người dùng truy cập website"
echo "sẽ bị ghi nhận là cùng một IP của Reverse Proxy."
echo "-------------------------------------------------------------------------"
echo "Nếu trên VPS có cả domain Reverse Proxy thì sẽ không hiển thị ở list này."
echo "-------------------------------------------------------------------------"
read -p "Tôi đã hiểu và xác nhận cài đặt SSL tự ký cho domain? [y/N]: " confirm
confirm=$(echo "$confirm" | tr '[:upper:]' '[:lower:]')
if [[ "$confirm" != "y" && "$confirm" != "yes" ]]; then
    clear
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi
########################################################
klaoxcy_file="/etc/dsnvps/.tmp/klaoxcy"
nginx_conf_folder="/home"
output_file="/etc/dsnvps/.tmp/klaoxcypark"
# Xóa file kết quả cũ nếu tồn tại
true > "$output_file"
if [[ -s "$klaoxcy_file" ]]; then
    while IFS= read -r domain; do
        domain_conf_folder="$nginx_conf_folder/$domain/conf.d"
        if [[ "$domain" != "$mainsite" && -d "$domain_conf_folder" ]]; then
            # Kiểm tra nếu thư mục có file .conf
            if compgen -G "$domain_conf_folder"/*.conf > /dev/null; then
                for vhost in "$domain_conf_folder"/*.conf; do
                    subdomain=$(basename "$vhost" .conf)
                    # Kiểm tra nếu subdomain không phải domain chính
                    if [[ "$subdomain" != "$domain" ]]; then
                        # Kiểm tra độ dài file vhost
                        vhost_length=$(wc -c < "$vhost")
                        if (( vhost_length > 200 )); then
                            echo "$subdomain**" >> "$output_file"
                        fi
                    fi
                done
            fi
        fi
    done < "$klaoxcy_file"
fi
# Kiểm tra và thông báo kết quả
if [[ -s "$output_file" ]]; then
    cat /etc/dsnvps/.tmp/klaoxcypark >> /etc/dsnvps/.tmp/klaoxcy
fi
if [[ ! -z "$domainquanly" ]]; then
    # Thêm (DQL) domainquanly vào file /etc/dsnvps/.tmp/klaoxcy
    echo "$domainquanly (QL)" >> /etc/dsnvps/.tmp/klaoxcy
fi
#################################################################
# Loại bỏ domain Reverse Proxy và domain đã cài SSL khỏi danh sách
#################################################################
# Lấy danh sách Reverse Proxy (cùng logic với dsnvps-list-reverse-domain)
if [ -f /etc/dsnvps/menu/dsnvps-reverse-proxy-common ]; then
    . /etc/dsnvps/menu/dsnvps-reverse-proxy-common
    get_reverse_proxy_domains_list 2>/dev/null || true
fi
if [ ! -s /etc/dsnvps/.tmp/reverse_proxy_domains_list ]; then
    true > /etc/dsnvps/.tmp/reverse_proxy_domains_list
    for vhost in /etc/nginx/conf.d/*.conf; do
        [ -f "$vhost" ] || continue
        domain=$(basename "$vhost" .conf)
        [ -d "/home/$domain/proxy_html" ] && echo "$domain" >> /etc/dsnvps/.tmp/reverse_proxy_domains_list
    done
fi
# Hàm: domain đã cài SSL nếu vhost có ssl_certificate (Let's Encrypt, paidssl, custom path đều được)
domain_already_has_ssl() {
    local dom="$1"
    local vhost
    if [ -f "/etc/nginx/conf.d/$dom.conf" ]; then
        grep -qE "ssl_certificate\s+" "/etc/nginx/conf.d/$dom.conf" 2>/dev/null && return 0
    fi
    if [ -n "$domainquanly" ] && [ "$domainquanly" = "$dom" ] && [ -f "/etc/dsnvps/domainquanly/domainquanly.conf" ]; then
        grep -qE "ssl_certificate\s+" "/etc/dsnvps/domainquanly/domainquanly.conf" 2>/dev/null && return 0
    fi
    for vhost in $(find /home -maxdepth 4 -name "$dom.conf" \( -path "*/conf.d/*" -o -path "*/multisite.conf.d/*" \) 2>/dev/null); do
        [ -f "$vhost" ] && grep -qE "ssl_certificate\s+" "$vhost" 2>/dev/null && return 0
    done
    return 1
}
# Lọc klaoxcy: bỏ domain Reverse Proxy và domain đã có SSL (bất kỳ nguồn: Let's Encrypt, paidssl, custom)
true > /etc/dsnvps/.tmp/klaoxcy.filtered
while IFS= read -r line; do
    [ -z "$line" ] && continue
    domain_clean=$(echo "$line" | sed 's/\*\*$//' | sed 's/ (QL)$//')
    # Bỏ qua nếu là Reverse Proxy
    grep -Fxq "$domain_clean" /etc/dsnvps/.tmp/reverse_proxy_domains_list 2>/dev/null && continue
    # Bỏ qua nếu vhost đã có ssl_certificate (Let's Encrypt, paid SSL, custom path đều được)
    domain_already_has_ssl "$domain_clean" && continue
    echo "$line" >> /etc/dsnvps/.tmp/klaoxcy.filtered
done < /etc/dsnvps/.tmp/klaoxcy
mv -f /etc/dsnvps/.tmp/klaoxcy.filtered /etc/dsnvps/.tmp/klaoxcy
# Kiểm tra nếu không còn domain nào sau khi lọc
if [[ ! -s /etc/dsnvps/.tmp/klaoxcy ]]; then
    clear
    echo "========================================================================="
    echo "Không có domain nào có thể cài SSL tự ký."
    echo "-------------------------------------------------------------------------"
    echo "Domain Reverse Proxy và domain đã cài SSL đã được loại bỏ khỏi danh sách."
    echo "========================================================================="
    read -p "Nhấn [Enter] để quay lại menu..." dummy
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi
echo "========================================================================= "
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/klaoxcy
echo "Danh sách các website & Park domains trên server:  | ** : Park Domains"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                
    left_db="${danh_sach_website[i]:- }"                    
    if (( right_index <= total )); then           
        right_db="${danh_sach_website[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
        /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//' | sed 's/ (QL)$//')
        echo "========================================================================="
        read -p "Xác nhận cài SSL tự ký cho domain $website? [y/N]: " xac_nhan
        xac_nhan=$(echo "$xac_nhan" | tr '[:upper:]' '[:lower:]')
        if [[ "$xac_nhan" == "y" || "$xac_nhan" == "yes" ]]; then
            break  # Xac nhan dung, thoat vong lap
        else
            echo "==> Không xác nhận. Vui lòng chọn lại domain."
            echo "-------------------------------------------------------------------------"
            for ((i = 0; i < half; i++)); do
                left_index=$((i + 1))
                right_index=$((half + i + 1))
                left_db="${danh_sach_website[i]:- }"
                if (( right_index <= total )); then
                    right_db="${danh_sach_website[right_index-1]}"
                    printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
                else
                    printf "%-1s %-30s\n" "$left_index." "$left_db"
                fi
            done
            continue
        fi
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

#################################################################
## Hỏi có muốn thiết lập IP thật của người dùng không
#################################################################
REVERSE_PROXY_IP=""
echo "========================================================================="
echo "Nếu không cấu hình hiển thị IP thật, tất cả người dùng truy cập website"
echo "-------------------------------------------------------------------------"
echo "sẽ bị ghi nhận là cùng một IP của Reverse Proxy."
echo "-------------------------------------------------------------------------"
echo "Chức năng này cần địa chỉ IP của Reverse Proxy VPS để cấu hình."
echo "========================================================================="
read -p "Bạn muốn thiết lập website thấy được IP thật của người dùng? [y/N]: " xac_nhan_realip
xac_nhan_realip=$(echo "$xac_nhan_realip" | tr '[:upper:]' '[:lower:]')
if [[ "$xac_nhan_realip" == "y" || "$xac_nhan_realip" == "yes" ]]; then
    while true; do
        echo "========================================================================="
        read -p "Nhập IP của Reverse Proxy VPS [0 -Bỏ qua]: " REVERSE_PROXY_IP
        REVERSE_PROXY_IP=$(echo "$REVERSE_PROXY_IP" | tr -d ' ')
        if [ "$REVERSE_PROXY_IP" = "0" ]; then
            REVERSE_PROXY_IP=""
            break
        fi
        if [[ -n "$REVERSE_PROXY_IP" ]]; then
            # Kiểm tra IP hợp lệ (dạng 1.2.3.4 hoặc IPv6)
            if [[ "$REVERSE_PROXY_IP" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || [[ "$REVERSE_PROXY_IP" == *:* ]]; then
                echo "-------------------------------------------------------------------------"
                echo "IP Reverse Proxy: $REVERSE_PROXY_IP"
                echo "========================================================================="
                read -p "Xác nhận IP đã chính xác? [y/N]: " xac_nhan_ip
                xac_nhan_ip=$(echo "$xac_nhan_ip" | tr '[:upper:]' '[:lower:]')
                if [[ "$xac_nhan_ip" == "y" || "$xac_nhan_ip" == "yes" ]]; then
                    break
                else
				echo "-------------------------------------------------------------------------"
                    echo "==> Vui lòng nhập lại."
                fi
            else
			echo "-------------------------------------------------------------------------"
                echo "Địa chỉ IP không hợp lệ. Vui lòng nhập IP (vd: 192.168.1.1)"
            fi
        else
		echo "-------------------------------------------------------------------------"
            echo "Bạn chưa nhập IP. Vui lòng nhập IP (vd: 199.268.1.1)"
        fi
    done
fi

# Function để nhập chứng chỉ thủ công
manual_certificate_input() {
echo "========================================================================="
echo "Vui lòng Copy-Paste nội dung Origin Certificate từ Cloudflare Origin SSL."
echo "-------------------------------------------------------------------------"
echo "1. Dán toàn bộ nội dung CRT bắt đầu từ: -----BEGIN CERTIFICATE-----"
echo "-------------------------------------------------------------------------"
echo "2. Dán xong => 3. Nhấn Enter để tiếp tục."
echo "========================================================================="
read -rp "Paste chứng chỉ Origin SSL [0 -Thoát]: " first_line

# Tạo file tạm trong /tmp để lưu nội dung CRT
TEMP_CRT_FILE="/tmp/$website.crt"
true > "$TEMP_CRT_FILE"

# Nếu người dùng nhập 0 ngay từ đầu thì thoát
if [ "$first_line" = "0" ]; then
    clear
    echo "========================================================================="
    echo "Bạn đã chọn thoát."
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra nếu dòng đầu tiên không phải là certificate hợp lệ
if [[ "$first_line" != "-----BEGIN CERTIFICATE-----" ]]; then
    clear
    echo "========================================================================="
    echo "Nội dung không phải là Origin Certificate hợp lệ!"
    echo "-------------------------------------------------------------------------"
    echo "Certificate phải bắt đầu bằng: -----BEGIN CERTIFICATE-----"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Ghi dòng đầu tiên vào nội dung chứng chỉ
CRT_CONTENT="$first_line\n"

# Đọc tiếp nội dung chứng chỉ
while IFS= read -r line; do
    # Nếu dòng trống thì kết thúc nhập
    if [ -z "$line" ]; then
        break
    fi
    CRT_CONTENT+="$line\n"
done

# Kiểm tra nếu không có nội dung nào được nhập
if [ -z "$CRT_CONTENT" ]; then
    clear
    echo "========================================================================="
    echo "Không có nội dung Origin Certificate nào được nhập."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Loại bỏ ký tự xuống dòng Windows (\r) và dòng trống thừa
CRT_CONTENT=$(echo -e "$CRT_CONTENT" | tr -d '\r' | sed '/^$/d')

# Ghi nội dung CRT vào file tạm
echo -e "$CRT_CONTENT" > "$TEMP_CRT_FILE"

# Loại bỏ khoảng trắng ở đầu và cuối mỗi dòng
sed -i 's/^[[:space:]]*//;s/[[:space:]]*$//' "$TEMP_CRT_FILE"

# Kiểm tra xem file CRT có rỗng hay không
if [ ! -s "$TEMP_CRT_FILE" ]; then
    clear
    echo "========================================================================="
    echo "Nội dung chứng chỉ SSL rỗng hoặc không hợp lệ."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Nhập private key
echo "========================================================================="
echo "Vui lòng Copy-Paste nội dung Private Key từ Cloudflare Origin SSL."
echo "-------------------------------------------------------------------------"
echo "1. Dán toàn bộ nội dung key bắt đầu từ: -----BEGIN PRIVATE KEY----- "
echo "-------------------------------------------------------------------------"
echo "2. Dán xong => 3. Nhấn Enter để tiếp tục."
echo "========================================================================="
read -rp "Paste Private Key [0 -Thoát]: " first_line_key

# Tạo file tạm trong /tmp để lưu nội dung key
TEMP_KEY_FILE="/tmp/$website.key"
true > "$TEMP_KEY_FILE"

# Nếu người dùng nhập 0 ngay từ đầu thì thoát
if [ "$first_line_key" = "0" ]; then
    clear
    echo "========================================================================="
    echo "Bạn đã chọn thoát."
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra nếu dòng đầu tiên không phải là private key hợp lệ
if [[ "$first_line_key" != "-----BEGIN PRIVATE KEY-----" ]]; then
    clear
    echo "========================================================================="
    echo "Nội dung không phải là Private Key hợp lệ!"
    echo "-------------------------------------------------------------------------"
    echo "Private Key phải bắt đầu bằng: -----BEGIN PRIVATE KEY-----"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Ghi dòng đầu tiên vào nội dung key
KEY_CONTENT="$first_line_key\n"

# Đọc tiếp nội dung key
while IFS= read -r line; do
    # Nếu dòng trống thì kết thúc nhập
    if [ -z "$line" ]; then
        break
    fi
    KEY_CONTENT+="$line\n"
done

# Kiểm tra nếu không có nội dung nào được nhập
if [ -z "$KEY_CONTENT" ]; then
    clear
    echo "========================================================================="
    echo "Không có nội dung private key nào được nhập."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Loại bỏ ký tự xuống dòng Windows (\r) và dòng trống thừa
KEY_CONTENT=$(echo -e "$KEY_CONTENT" | tr -d '\r' | sed '/^$/d')

# Ghi nội dung key vào file tạm
echo -e "$KEY_CONTENT" > "$TEMP_KEY_FILE"

# Loại bỏ khoảng trắng ở đầu và cuối mỗi dòng
sed -i 's/^[[:space:]]*//;s/[[:space:]]*$//' "$TEMP_KEY_FILE"

# Kiểm tra xem file key có rỗng hay không
if [ ! -s "$TEMP_KEY_FILE" ]; then
    clear
    echo "========================================================================="
    echo "Nội dung private key rỗng hoặc không hợp lệ."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng thử lại."
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

echo "-------------------------------------------------------------------------"
echo "Đã nhận nội dung Origin Certificate và Private Key. Đang kiểm tra..."; sleep 8

# Kiểm tra file certificate

# Kiểm tra chứng chỉ hợp lệ
CERT_ERROR=$(openssl x509 -in "$TEMP_CRT_FILE" -noout 2>&1)
if [ $? -ne 0 ]; then
    echo "========================================================================="
    echo "Chứng chỉ Origin Certificate bạn cung cấp cho $website không hợp lệ."
    echo "-------------------------------------------------------------------------"
    echo "Chi tiết lỗi: $CERT_ERROR"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra private key hợp lệ
KEY_CHECK_ERROR=$(openssl pkey -in "$TEMP_KEY_FILE" -noout -check 2>&1)
if [ $? -ne 0 ]; then
    echo "========================================================================="
    echo "Private Key bạn cung cấp cho $website không hợp lệ."
    echo "-------------------------------------------------------------------------"
    echo "Chi tiết lỗi: $KEY_CHECK_ERROR"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra xem public key từ chứng chỉ và key có khớp không
PUBLIC_CRT_MD5=$(openssl x509 -pubkey -noout -in "$TEMP_CRT_FILE" | openssl md5 | awk '{print $2}')
PUBLIC_KEY_MD5=$(openssl pkey -pubout -in "$TEMP_KEY_FILE" | openssl md5 | awk '{print $2}')

if [ "$PUBLIC_CRT_MD5" != "$PUBLIC_KEY_MD5" ]; then
    clear
    echo "========================================================================="
    echo "Chứng chỉ và khóa riêng không khớp, có thể chứng chỉ thuộc domain khác."
    echo "-------------------------------------------------------------------------"
    echo "Chi tiết public md5: CRT: $PUBLIC_CRT_MD5, Key: $PUBLIC_KEY_MD5"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại Origin Certificate và Private Key!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra thời gian hiệu lực
CURRENT_DATE=$(date +%s)
EXPIRY_DATE=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -enddate | cut -d= -f2)
EXPIRY_EPOCH=$(date -d "$EXPIRY_DATE" +%s 2>/dev/null)

    if ! openssl x509 -in "$TEMP_CRT_FILE" -noout -dates 2>/dev/null | grep -q "notAfter" || [ -z "$EXPIRY_EPOCH" ]; then
    clear
    echo "========================================================================="
    echo "Không thể xác định ngày hết hạn của chứng chỉ."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

if [ "$CURRENT_DATE" -ge "$EXPIRY_EPOCH" ]; then
    clear
    echo "========================================================================="
    echo "Chứng chỉ Origin Certificate SSL đã hết hạn."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng lấy chứng chỉ mới từ Cloudflare!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Kiểm tra chứng chỉ có phải của Cloudflare hay không
ISSUER=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -issuer | grep -io "Cloud[Ff]lare, Inc\.")
if [ -z "$ISSUER" ]; then
    clear
    echo "========================================================================="
    echo "Chứng chỉ không phải do Cloudflare cấp."
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng sử dụng chứng chỉ Origin từ Cloudflare!"
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Lấy Common Name (CN) và danh sách SAN từ chứng chỉ
#echo "🔍 Đang parse certificate..."

# Parse CN
CN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -subject 2>/dev/null | grep -o "CN=[^,]*" | sed 's/CN=//')
if [ -z "$CN" ]; then
    CN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -subject 2>/dev/null | grep -o "CN = [^,]*" | sed 's/CN = //')
fi

# Parse SAN - sử dụng cách đơn giản hơn
SAN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -A10 "Subject Alternative Name" | grep "DNS:" | sed 's/DNS://g' | tr ',' '\n' | grep -v "^$" | tr -d ' ' | tr '\n' ' ')
if [ -z "$SAN" ]; then
    SAN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -A10 "Subject Alternative Name" | grep "DNS: " | sed 's/DNS: //g' | tr ',' '\n' | grep -v "^$" | tr -d ' ' | tr '\n' ' ')
fi

# Bỏ qua phần xử lý SAN cũ vì nó làm hỏng SAN đã parse đúng

# Nếu vẫn không parse được, thử cách khác
if [ -z "$CN" ] && [ -z "$SAN" ]; then
    # Thử lấy tất cả DNS names từ certificate (không sử dụng)
    # ALL_DNS=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -E "DNS:|Subject:" | sed 's/DNS://g' | sed 's/Subject:.*CN=//g' | tr ',' '\n' | grep -v "^$" | tr -d ' ')
    
    # Lấy CN từ subject
    CN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -subject 2>/dev/null | sed 's/.*CN=\([^,]*\).*/\1/')
    
    # Lấy SAN từ text - sửa lại để parse đúng wildcard
    SAN=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -A10 "Subject Alternative Name" | grep "DNS:" | sed 's/DNS://g' | tr ',' '\n' | grep -v "^$" | tr -d ' ')
    
    # Nếu vẫn không có wildcard, thử cách khác
    if ! echo "$SAN" | grep -q "\*"; then
        SAN_WILDCARD=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -A10 "Subject Alternative Name" | grep -o "\*\.[^, ]*" | tr -d ' ')
        if [ -n "$SAN_WILDCARD" ]; then
            SAN="$SAN $SAN_WILDCARD"
        fi
    fi
fi

# Thêm cách parse SAN mạnh mẽ hơn để xử lý các trường hợp đặc biệt
SAN_ROBUST=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -text 2>/dev/null | grep -A20 "Subject Alternative Name" | grep -oE "DNS:[^,]*" | sed 's/DNS://g' | tr ',' '\n' | grep -v "^$" | tr -d ' ' | tr '\n' ' ')

# Thử cách parse SAN khác nữa - sử dụng openssl x509 -noout -ext subjectAltName
SAN_EXT=$(openssl x509 -in "$TEMP_CRT_FILE" -noout -ext subjectAltName 2>/dev/null | grep -oE "DNS:[^,]*" | sed 's/DNS://g' | tr ',' '\n' | grep -v "^$" | tr -d ' ' | tr '\n' ' ')

# Sử dụng SAN tốt nhất
if [ -n "$SAN_EXT" ]; then
    SAN="$SAN_EXT"
elif [ -n "$SAN_ROBUST" ]; then
    SAN="$SAN_ROBUST"
fi

# Hiển thị thông tin certificate
echo "-------------------------------------------------------------------------"
echo "Thông tin certificate"
echo "Website: $website"
echo "CN (Common Name): $CN"
echo "SAN (Subject Alternative Names): $SAN"
echo "-------------------------------------------------------------------------"

echo "-------------------------------------------------------------------------"

# Kiểm tra xem domain có khớp với CN, SAN, hoặc thuộc wildcard
is_valid_domain=false

# Kiểm tra khớp chính xác với CN
if [ "$website" == "$CN" ]; then
    echo "==> Khớp với CN: $CN"
    is_valid_domain=true
fi

# Kiểm tra khớp chính xác với SAN
if echo "$SAN" | grep -qw "$website"; then
    echo "==> Khớp với SAN: $website"
    is_valid_domain=true
fi

# Kiểm tra wildcard - nếu subdomain thuộc *.domain.com thì bỏ qua check
echo "Bắt đầu kiểm tra wildcard..."

# Kiểm tra wildcard certificate đơn giản
if echo "$CN $SAN" | grep -q "\*\."; then
    echo "==> Tìm thấy wildcard certificate"
    
    # Lấy domain chính từ CN hoặc SAN wildcard
    wildcard_domain=""
    
    # Kiểm tra CN wildcard trước
    if [[ "$CN" == "*."* ]]; then
        wildcard_domain="${CN#*.}"
    fi
    
    # Nếu CN không có wildcard, kiểm tra SAN
    if [ -z "$wildcard_domain" ]; then
        read -ra SAN_ARRAY <<< "$SAN"
        for entry in "${SAN_ARRAY[@]}"; do
            if [[ "$entry" == "*."* ]]; then
                wildcard_domain="${entry#*.}"
                break
            fi
        done
    fi
    
    # Kiểm tra website có thuộc wildcard domain không
    if [ -n "$wildcard_domain" ]; then
        if [[ "$website" == "$wildcard_domain" ]] || [[ "$website" == *."$wildcard_domain" ]]; then
            echo "==> Website $website thuộc wildcard *.${wildcard_domain}"
            is_valid_domain=true
        else
            echo "==> Website $website KHÔNG thuộc wildcard *.${wildcard_domain}"
        fi
    fi
else
    echo "==> Không tìm thấy wildcard certificate"
fi


if [ "$is_valid_domain" = true ]; then
    echo "-------------------------------------------------------------------------"
    echo "Chứng chỉ SSL hợp lệ."
else
    echo "========================================================================="
    echo "Chứng chỉ SSL không khớp với domain $website."
    echo "========================================================================="
    echo "Vui lòng kiểm tra lại certificate!"
    echo "========================================================================="
    echo "Nhấn [Enter] để thoát..."
    read -r
    rm -f "$TEMP_KEY_FILE"
    rm -f "$TEMP_CRT_FILE"
    /etc/dsnvps/menu/dsnvps-tao-paidssl-menu
    exit
fi

# Nếu chứng chỉ hợp lệ, sao chép vào đường dẫn yêu cầu
mkdir -p "/etc/nginx/paidssl/$website"
cp -r "$TEMP_KEY_FILE" "/etc/nginx/paidssl/$website/$website.key"
cp -r "$TEMP_CRT_FILE" "/etc/nginx/paidssl/$website/$website.crt"
# Xóa file tạm
rm -f "$TEMP_KEY_FILE"
rm -f "$TEMP_CRT_FILE"
echo "-------------------------------------------------------------------------"
echo "Đã kiểm tra xong..."
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ cài đặt SSL cho Website !"; sleep 8
}

# Function để gọi manual_certificate_input
call_manual_certificate_input() {
    manual_certificate_input
}

# Function để kiểm tra và xử lý domain/subdomain trong Cloudflare
check_and_handle_domain_in_cloudflare() {
    local website="$1"
    local global_ssl_api_email="$2"
    local global_ssl_api_token="$3"
    
    
    # Xác định domain chính và zone ID
    # Nếu domain bắt đầu với www, tìm zone cho non-www version
    # Nếu domain không bắt đầu với www, tìm zone cho chính nó
    local main_domain
    local zone_id
    
    
    if [[ "$website" == www.* ]]; then
        main_domain="${website#www.}"
        zone_id=$(get_zone_id_for_ssl "$main_domain" "$global_ssl_api_email" "$global_ssl_api_token")
    else
        main_domain="$website"
        zone_id=$(get_zone_id_for_ssl "$website" "$global_ssl_api_email" "$global_ssl_api_token")
    fi
    
    
    # Kiểm tra domain chính có tồn tại trong Cloudflare không
    if [ -z "$zone_id" ]; then
        return 0
    fi
    
    # Kiểm tra domain/subdomain có tồn tại trong Cloudflare không bằng cách kiểm tra DNS record
    if [ -n "$global_ssl_api_email" ]; then
        # Global API Key
        local dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
             -H "X-Auth-Email: $global_ssl_api_email" \
             -H "X-Auth-Key: $global_ssl_api_token" \
             -H "Content-Type: application/json")
    else
        # API Token
        local dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
             -H "Authorization: Bearer $global_ssl_api_token" \
             -H "Content-Type: application/json")
    fi
    
    
    # Kiểm tra xem có DNS record nào cho domain/subdomain này không
    if echo "$dns_response" | grep -q '"success":true' && echo "$dns_response" | grep -q '"result":\[.*\]' && ! echo "$dns_response" | grep -q '"result":\[\]'; then
        # Kiểm tra IP hiện tại của domain/subdomain
        local current_ip=$(echo "$dns_response" | grep -o '"content":"[^"]*"' | head -1 | sed 's/"content":"//;s/"//')
        
        if [ -n "$current_ip" ]; then
            # Kiểm tra cả domain chính và domain còn lại của domain cấp 1
            local need_update=false
            local other_domain_current_ip=""
            local other_domain=""
            local current_proxied=""
            local other_domain_proxied=""
            
            # Kiểm tra Cloudflare Proxy status của domain chính
            current_proxied=$(echo "$dns_response" | grep -o '"proxied":[^,]*' | head -1 | sed 's/"proxied"://;s/"//g')
            
            # Xác định domain cần kiểm tra thêm cho domain cấp 1
            if [ -f "/etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global" ]; then
                source /etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global
                if should_create_www_subdomain "$website" "$global_ssl_api_email" "$global_ssl_api_token"; then
                    if [[ "$website" == www.* ]]; then
                        # Nếu domain là www.example.com → kiểm tra example.com
                        other_domain="${website#www.}"
                    else
                        # Nếu domain là example.com → kiểm tra www.example.com
                        other_domain="www.$website"
                    fi
                    
                    # Lấy IP và Proxy status của domain còn lại
                if [ -n "$global_ssl_api_email" ]; then
                    # Global API Key
                        local other_dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${other_domain}" \
                         -H "X-Auth-Email: $global_ssl_api_email" \
                         -H "X-Auth-Key: $global_ssl_api_token" \
                         -H "Content-Type: application/json")
                else
                    # API Token
                        local other_dns_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${other_domain}" \
                         -H "Authorization: Bearer $global_ssl_api_token" \
                         -H "Content-Type: application/json")
                fi
                
                    if echo "$other_dns_response" | grep -q '"success":true' && echo "$other_dns_response" | grep -q '"result":\[.*\]' && ! echo "$other_dns_response" | grep -q '"result":\[\]'; then
                        other_domain_current_ip=$(echo "$other_dns_response" | grep -o '"content":"[^"]*"' | head -1 | sed 's/"content":"//;s/"//')
                        other_domain_proxied=$(echo "$other_dns_response" | grep -o '"proxied":[^,]*' | head -1 | sed 's/"proxied"://;s/"//g')
                    fi
                fi
            fi
            
            # Kiểm tra xem có cần cập nhật không
            # Nếu IP khác VPS IP → cần cập nhật
            if [ "$current_ip" != "$serverip" ]; then
                need_update=true
            fi
            
            # Nếu Cloudflare Proxy chưa bật → cần cập nhật
            if [ "$current_proxied" != "true" ]; then
                need_update=true
            fi
            
            # Nếu domain còn lại có IP khác VPS IP → cần cập nhật
            if [ -n "$other_domain_current_ip" ] && [ "$other_domain_current_ip" != "$serverip" ]; then
                need_update=true
            fi
            
            # Nếu domain còn lại chưa bật Cloudflare Proxy → cần cập nhật
            if [ -n "$other_domain_proxied" ] && [ "$other_domain_proxied" != "true" ]; then
                need_update=true
            fi
            
            # Hiển thị kết quả kiểm tra
            
            if [ "$need_update" = true ]; then
                echo "========================================================================="
                echo "==> CẢNH BÁO: Domain/subdomain cần cập nhật IP hoặc Cloudflare Proxy"
                echo "-------------------------------------------------------------------------"
                echo "Domain $website:"
                echo "  IP hiện tại: $current_ip"
                echo "  Cloudflare Proxy: $current_proxied"
                if [ -n "$other_domain" ]; then
                    echo "Domain $other_domain:"
                    if [ -n "$other_domain_current_ip" ]; then
                        echo "  IP hiện tại: $other_domain_current_ip"
                    else
                        echo "  IP hiện tại: Không tìm thấy DNS record"
                    fi
                    if [ -n "$other_domain_proxied" ]; then
                        echo "  Cloudflare Proxy: $other_domain_proxied"
                    else
                        echo "  Cloudflare Proxy: Không tìm thấy DNS record"
                    fi
                fi
                echo "IP VPS: $serverip"
                echo "========================================================================="
                echo "Bạn có muốn cập nhật domain/subdomain về IP VPS và bật Cloudflare Proxy không?"
                echo "-------------------------------------------------------------------------"
                echo "1. Có, cập nhật IP VPS và bật Proxy và Cài SSL"
                echo "2. Không, giữ nguyên cấu hình hiện tại - Chỉ cài SSL"
                echo "========================================================================="
                
                while true; do
                    read -p "Lựa chọn của bạn [0 -Thoát]: " ip_choice
                    
                    case $ip_choice in
                        1)
                            echo "========================================================================="
                            echo "ĐANG CẬP NHẬT DOMAIN/SUBDOMAIN TRONG CLOUDFLARE"
                            echo "========================================================================="
                            echo "Đang cập nhật domain/subdomain $website..."
                            
                            # Lấy record ID
                            if [ -n "$global_ssl_api_email" ]; then
                                # Global API Key
                                local record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
                                     -H "X-Auth-Email: $global_ssl_api_email" \
                                     -H "X-Auth-Key: $global_ssl_api_token" \
                                     -H "Content-Type: application/json" | \
                                     grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//')
                            else
                                # API Token
                                local record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${website}" \
                                     -H "Authorization: Bearer $global_ssl_api_token" \
                                     -H "Content-Type: application/json" | \
                                     grep -o '"id":"[^"]*"' | head -1 | sed 's/"id":"//;s/"//')
                            fi
                            
                            if [ -n "$record_id" ]; then
                                # Cập nhật DNS record cho domain chính
                                if [ -n "$global_ssl_api_email" ]; then
                                    # Global API Key
                                    local update_response=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id" \
                                         -H "X-Auth-Email: $global_ssl_api_email" \
                                         -H "X-Auth-Key: $global_ssl_api_token" \
                                         -H "Content-Type: application/json" \
                                         -d '{"type":"A","name":"'$website'","content":"'$serverip'","ttl":1,"proxied":true}')
                                else
                                    # API Token
                                    local update_response=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id" \
                                         -H "Authorization: Bearer $global_ssl_api_token" \
                                         -H "Content-Type: application/json" \
                                         -d '{"type":"A","name":"'$website'","content":"'$serverip'","ttl":1,"proxied":true}')
                                fi
                                
                                if echo "$update_response" | grep -q '"success":true'; then
                                    echo "==> Đã cập nhật domain $website thành công";sleep 1
                                    echo "-------------------------------------------------------------------------"
                                    echo "==> Đã trỏ về IP VPS: $serverip";sleep 1
                                    echo "-------------------------------------------------------------------------"
                                    echo "==> Đã bật Cloudflare Proxy (orange cloud)";sleep 1
                                    echo "-------------------------------------------------------------------------"
                                    
                                    # Cập nhật DNS record cho domain còn lại của domain cấp 1
                                    if [ -f "/etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global" ]; then
                                        source /etc/dsnvps/menu/dsnvps-ssl-cloudflare-check-api-global
                                        if should_create_www_subdomain "$website" "$global_ssl_api_email" "$global_ssl_api_token"; then
                                            # Xác định domain cần cập nhật thêm
                                            if [[ "$website" == www.* ]]; then
                                                # Nếu domain là www.example.com → cập nhật example.com
                                                non_www_domain="${website#www.}"
                                                echo "==> Đang cập nhật non-www domain: $non_www_domain";sleep 1
                                                
                                                # Lấy record ID cho non-www domain
                                                if [ -n "$global_ssl_api_email" ]; then
                                                    # Global API Key
                                                    non_www_record_id=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?name=${non_www_domain}" \
                                                         -H "X-Auth-Email: $global_ssl_api_email" \
