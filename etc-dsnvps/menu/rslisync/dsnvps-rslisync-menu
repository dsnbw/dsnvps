echo "                          Trạng Thái: Đã Cài Đặt                     "
else
echo "                          Trạng Thái: Chưa Cài Đặt                    "
fi
  
if [ -f /etc/systemd/system/resilio-sync.service ]; then
    rslsyncstt=$(pgrep -f "/etc/dsnvps/rslsync/rslsync --nodaemon --config /etc/rslsync-dsnvps/sync.conf")
    if [ -n "$rslsyncstt" ]; then
        status="Đang BẬT"
    else
