# Update 6.1.6 ######################
if ! command -v vnstat &>/dev/null; then
    apt-get install -y -qq vnstat
    systemctl enable vnstat --now -q
    interfaces=$(ip -o link show | awk -F': ' '/state UP/ {print $2}')
    # Tạo cơ sở dữ liệu vnStat cho các interface
    for iface in $interfaces; do
        # Kiểm tra nếu interface chưa có trong vnStat thì mới thêm
        if ! vnstat -i "$iface" &>/dev/null; then
            vnstat --create -i "$iface"
            systemctl restart vnstat
        fi
    done
   
