#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ -f /etc/dsnvps/backup.telegram.conf ]; then
    if [ ! -f /etc/cron.d/dsnvps.telegram.backup.cron ]; then
        rm -rf /etc/dsnvps/backup.telegram.conf
    fi 
fi
if [ -f /etc/cron.d/dsnvps.telegram.backup.cron ]; then
    if [ ! -f /etc/dsnvps/backup.telegram.conf ]; then
        rm -rf /etc/cron.d/dsnvps.telegram.backup.cron
    fi 
fi
if [ ! -d /home/$mainsite/private_html/backup ]; then
    mkdir -p /home/$mainsite/private_html/backup
fi

if [ -f /etc/dsnvps/backup.gdriver.conf ]; then
    if grep -q "move" /etc/dsnvps/backup.gdriver.conf; then
        autoxoa="BẬT (Nên TẮT)"
    else
        autoxoa=TẮT
    fi
fi


# Tính dung lượng thư mục backup
if find /home/$mainsite/private_html/backup -type f | read; then
    dungluong=$(du -sb /home/$mainsite/private_html/backup | awk '{size=$1/1024; unit="KB"; if (size>=1024) {size/=1024; unit="MB"} if (size>=1024) {size/=1024; unit="GB"} printf "%.2f %s", size, unit}')
else
    dungluong="0 KB"
fi

# Kiểm tra cấu hình và trạng thái auto backup
if [ -f /etc/dsnvps/backup.telegram.conf ]; then
    if grep -q "move" /etc/dsnvps/backup.telegram.conf; then
        autoxoa="BẬT (Nên TẮT)"
        hientongdungluong=0
    else
        autoxoa=TẮT
        hientongdungluong=1
    fi
fi

if [ -f /etc/cron.d/dsnvps.telegram.backup.cron ] && [ -f /etc/dsnvps/backup.telegram.conf ]; then
    trangthai=BẬT
    # Đọc cron line
    cron_line=$(cat /etc/cron.d/dsnvps.telegram.backup.cron | awk 'NR==2')
    abc=$(echo "$cron_line" | awk '{print $2}')  # Giờ
    phut=$(echo "$cron_line" | awk '{print $1}')  # Phút  
    ngay=$(echo "$cron_line" | awk '{print $3}')  # Ngày trong tháng
    thang=$(echo "$cron_line" | awk '{print $4}') # Tháng
    thu=$(echo "$cron_line" | awk '{print $5}')   # Thứ trong tuần
    
    # Xác định tần suất
    if [ "$ngay" = "*" ] && [ "$thang" = "*" ] && [ "$thu" = "*" ]; then
        tan_suat_hien_thi="Hàng Ngày"
    elif [[ "$ngay" =~ ^\*/([0-9]+)$ ]]; then
        frequency_num=$(echo "$ngay" | sed 's/^\*\///')
        tan_suat_hien_thi="$frequency_num ngày 1 lần"
    elif [[ "$thu" =~ ^\*/([0-9]+)$ ]]; then
        frequency_num=$(echo "$thu" | sed 's/^\*\///')
        case $frequency_num in
            1) tan_suat_hien_thi="Hàng Ngày" ;;
            2) tan_suat_hien_thi="2 ngày 1 lần" ;;
            3) tan_suat_hien_thi="3 ngày 1 lần" ;;
            4) tan_suat_hien_thi="4 ngày 1 lần" ;;
            5) tan_suat_hien_thi="5 ngày 1 lần" ;;
            6) tan_suat_hien_thi="6 ngày 1 lần" ;;
            7) tan_suat_hien_thi="Hàng Tuần" ;;
            *) tan_suat_hien_thi="$frequency_num ngày 1 lần" ;;
        esac
    else
        tan_suat_hien_thi="Không xác định"
    fi
    thoigianbackup="| Vào: ${abc}:00 $tan_suat_hien_thi"
else
    trangthai=TẮT
    thoigianbackup=""
fi

# Hiển thị số bản backup
if [ -f /etc/dsnvps/backup.telegram.conf ]; then
    tuoifile="| Backup lưu: $(grep '^sobanbackup=' /etc/dsnvps/backup.telegram.conf | cut -d'=' -f2) Bản"
else
    tuoifile=""
fi

show_phan_tren_menu()
{
/etc/dsnvps/menu/dsnvps-menu-all-function 
echo "========================================================================="
echo "                     Sao Lưu Backup Tới Telegram                        "
echo "========================================================================="
echo "Thư mục sao lưu: /home/$mainsite/private_html/backup"
echo "========================================================================="
if [ "$hientongdungluong" == "1" ]; then
echo "Tổng dung lượng các file backup: $dungluong"
echo "========================================================================="
fi
echo "Sao lưu: $trangthai $thoigianbackup $tuoifile"
echo "========================================================================="
if [ -f /etc/cron.d/dsnvps.telegram.backup.cron ]; then
echo "Xóa backup file trên server sau khi tải lên Telegram: $autoxoa"
echo "========================================================================="
fi
echo "Hướng dẫn sử dụng: http://go.dsnvps/2856"
echo "========================================================================="
echo "========================================================================="
echo ""
}

while true; do
clear
show_phan_tren_menu
printf "%-42s %s\n" "1) Kết Nối VPS Tới Telegram      " "| 4) Tải Lên Telegram Ngay Bây Giờ |"
printf "%-45s %s\n" "2) Cấu Hình Tự Động Sao Lưu     " "| 5) Tải Backup Về VPS             |"
printf "%-45s %s\n" "-------------------------------------|----------------------------------|" ""
printf "%-41s %s\n" "3) Kiểm Tra Trạng Thái Telegram  " "| 6) Xóa Tất Cả Cấu Hình           |"
echo "========================================================================="
    read -p "Lựa chọn của bạn [0 -Thoát]: " choice

    case $choice in 
    1) /etc/dsnvps/menu/dsnvps-ket-noi-telegram-vps;;
    2) /etc/dsnvps/menu/dsnvps-tao-script-auto-upload-telegram;;
    3) /etc/dsnvps/menu/dsnvps-kiem-tra-telegram-status;;
    4) /etc/dsnvps/menu/dsnvps-upload-telegram-now;;
    5) /etc/dsnvps/menu/dsnvps-download-backup-tu-telegram-xuong-vps;;
    6) /etc/dsnvps/menu/dsnvps-clear-all-config-telegram;;
0) clear; exit 0;;  
        *)
        echo "========================================================================="
        echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!"; sleep 3
        tput cuu 10; for ((i=0; i<10; i++)); do tput el; tput cud1; done; tput cuu 10;; 
    esac
done
