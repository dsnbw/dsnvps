printf "%-40s  %s\n" "2) Sao Lưu Tất Cả Website Code    |"  "7) Phục Hồi Full Web & Database"
printf "%-35s  %s\n" "3) Sao Lưu Full Web & Database    |""--------------------------------------"
printf "%-35s  %s\n" "----------------------------------|" "8) Lấy Link File Sao Lưu"
printf "%-41s  %s\n" "4) Tự Động Sao Lưu 1 Website Code |" "9) Đưa Link File Backup Tới Website"
printf "%-32s  %s\n" "5) Tự Động Sao Lưu Tất Cả Website |" "10) Xóa Tất Cả Dữ Liệu Sao Lưu"
printf "%-32s %s\n" "----------------------------------""|--------------------------------------"
printf "%-28s %s\n" "11) TẮT/BẬT Thông Báo Telegram => |"" => Thông Báo Telegram: $thongbao"
echo "========================================================================="

    # Lua chon cua nguoi dung
    read -p "Lựa chọn của bạn [0 -Thoát]: " choice

    case $choice in
    1 ) /etc/dsnvps/menu/dsnvps-sao-luu-code;;
    2 ) /etc/dsnvps/menu/dsnvps-lan-luot-sao-luu-het-tat-ca-website;;  
    3 ) /etc/dsnvps/menu/dsnvps-sao-luu-full-website-database-code;;   
    4 ) /etc/dsnvps/menu/dsnvps-befor-chon-tat-bat-tu-dong-sao-luu-code;;
    5 ) /etc/dsnvps/menu/dsnvps-tao-cron-auto-sao-luu-tat-ca-website;;
    11 ) /etc/dsnvps/menu/dsnvps-on-off-send-thong-bao-sao-luu-thanh-cong-website;;
    6 ) /etc/dsnvps/menu/dsnvps-phuc-hoi-website;;
    7 ) /etc/dsnvps/menu/dsnvps-phuc-hoi-full-website-database-code;;
    8 ) /etc/dsnvps/menu/dsnvps-link-tai-sao-luu-1-site;;
    9 ) /etc/dsnvps/menu/dsnvps-copy-backup-code-to-root-folder;; 
    10 ) /etc/dsnvps/menu/dsnvps-xoa-toan-bo-backup-website;;
0) clear; exit 0;;
    
        *)
           # clear
            echo "========================================================================="
            echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!"; sleep 2.8
            #echo "You typed wrong, Please type in the ordinal number on the list."; sleep 2.3 
            #show_phan_tren_menu
 ####### ########## XOA 4 DONG PHIA TREN ################
 sleep 2
 tput cuu 12   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<12; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 12   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
continue
##############################################################

    esac

done

