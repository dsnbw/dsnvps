#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -f /usr/local/bin/htpasswd.py ]; then
cp -r /etc/dsnvps/menu/dsnvps-tao-mat-khau-bao-ve-folder.py /usr/local/bin/htpasswd.py
chmod 755 /usr/local/bin/htpasswd.py
fi
if [ ! -f /etc/dsnvps/pwprotect.default ]; then
echo "" > /etc/dsnvps/pwprotect.default
fi
if [ ! -f /etc/cron.d/dsnvps.code.cron ]; then
touch /etc/cron.d/dsnvps.code.cron
fi
if [ ! -d /home/$mainsite/private_html/backup ]; then
mkdir -p /home/$mainsite/private_html/backup
fi

if [ -f /etc/dsnvps/auto.backup.all.websites.telegram.conf ]; then
thongbao="BẬT    "
else
thongbao="TẮT    "
fi
#######################
#Tong dung luong wwebsite
# Đường dẫn thư mục cần kiểm tra
HOME_DIR="/home"
NGINX_CONF_DIR="/etc/nginx/conf.d"

# Biến để lưu tổng dung lượng (tính bằng KB)
TOTAL_SIZE_KB=0

# Duyệt qua tất cả các thư mục trong /home
for dir in "$HOME_DIR"/*; do
    if [ -d "$dir" ]; then
        folder_name=$(basename "$dir")
        
        # Loại trừ thư mục dsnvps.demo
        if [ "$folder_name" = "dsnvps.demo" ]; then
            continue
        fi
        
        # Kiểm tra file vhost trong /etc/nginx/conf.d
        vhost_file="$NGINX_CONF_DIR/$folder_name.conf"
        if [ -f "$vhost_file" ]; then
            size=$(du -s "$dir" | cut -f1)
            TOTAL_SIZE_KB=$((TOTAL_SIZE_KB + size))
        fi
    fi
done

# Tính toán và trả về giá trị với đơn vị
if [ "$TOTAL_SIZE_KB" -eq 0 ]; then
    result="0 KB"
elif [ "$TOTAL_SIZE_KB" -lt 1024 ]; then
    result="${TOTAL_SIZE_KB} KB"
else
    result=$(echo "scale=0; $TOTAL_SIZE_KB / 1024" | bc)
    result="${result} MB"
fi

####################################################
find /home/$mainsite/private_html/backup/ -name "*.zip*" > /etc/dsnvps/.tmp/dsnvps_check_backup_code_size
numberfiles=$(cat /etc/dsnvps/.tmp/dsnvps_check_backup_code_size | wc -l)
if [ "$numberfiles" -ne 0 ]; then
    TOTAL_SIZE_KB=$(du -c --block-size=1K $(cat /etc/dsnvps/.tmp/dsnvps_check_backup_code_size) | tail -1 | cut -f 1)
    if [ "$TOTAL_SIZE_KB" -eq 0 ]; then
        backupcodesize="0 KB"
    elif [ "$TOTAL_SIZE_KB" -lt 1024 ]; then
        backupcodesize="$TOTAL_SIZE_KB KB"
    else
        backupcodesize=$(echo "scale=0; $TOTAL_SIZE_KB / 1024" | bc)
        backupcodesize="$backupcodesize MB"
    fi
else
    backupcodesize="0 KB"
fi
#####################################
if [ -f /etc/cron.d/auto.backup.all.websites.cron ] && [ -f /etc/dsnvps/auto.backup.all.websites.conf ]; then
autobackupwebsite=BẬT

thoigianmode=`cat /etc/cron.d/auto.backup.all.websites.cron | awk 'NR==2 {print $3}'`
if [ "$thoigianmode" == "*" ]; then
khoangcachngay=1
thoigianbackup="Sao Lưu Hàng Ngày"
else
khoangcachngay=`echo $thoigianmode | cut -d'/' -f2`
thoigianbackup="Sao Lưu $khoangcachngay Ngày 1 Lần"
fi

rm -rf /etc/dsnvps/.tmp/zasxcetbvcx
cat > "/etc/dsnvps/.tmp/zasxcetbvcx" <<END
#!/bin/bash
. /etc/dsnvps/auto.backup.all.websites.conf
echo "\$sobansaoluu" > /etc/dsnvps/.tmp/zadertycvb
rm -rf /etc/dsnvps/.tmp/zasxcetbvcx
END
sh /etc/dsnvps/.tmp/zasxcetbvcx
sobansaoluu=`cat /etc/dsnvps/.tmp/zadertycvb`
ngaytuxoa=`echo "| Lưu Trữ File Backup: ${sobansaoluu} Bản"`
else
autobackupwebsite=`echo "TẮT (Không An Toàn - Khuyến Nghị: BẬT)"`
thoigianbackup=""
ngaytuxoa=""
fi

show_phan_tren_menu()
{

rm -rf /etc/dsnvps/.tmp/*dsnvps*
/etc/dsnvps/menu/dsnvps-menu-all-function  
printf "=========================================================================\n"
printf "                     Sao Lưu & Phục Hồi Code Website\n"
printf "=========================================================================\n"

message="Tổng Dung Lượng Website: $result | Tổng Dung Lượng Backup: $backupcodesize"; printf "%$(( (73 - ${#message}) / 2 ))s%s\n" "" "$message"
#printf "%$(( (73 - ${#backupcodesize} - 30) / 2))s%s\n" "" "Tổng Dung Lượng File Sao Lưu: $backupcodesize"
echo "-------------------------------------------------------------------------"
echo "Thư Mục Lưu Trữ: /home/$mainsite/private_html/backup"           
