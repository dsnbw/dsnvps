#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/*hostingaz*
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist 
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checksite-list
sowebsitetrenserver=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist | wc -l)
listwebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/checksite-list
for checksite in $listwebsite 
do
rm -rf /etc/dsnvps/.tmp/dsnvps_check_site
if [ -d /home/$checksite/public_html ]; then
find /home/$checksite/public_html -name "*.*" > /etc/dsnvps/.tmp/dsnvps_check_site
sodong=`cat /etc/dsnvps/.tmp/dsnvps_check_site | wc -l`
if [ "$sodong" -gt 0 ]; then
echo "$checksite" >> /etc/dsnvps/.tmp/checksite-list
fi
fi
done
if [ ! -f /etc/dsnvps/.tmp/checksite-list ]; then
rm -rf /etc/dsnvps/.tmp/*dsnvps*
rm -rf /etc/dsnvps/.tmp/*hostingaz*
clear
echo "========================================================================="
echo "Không tìm thấy website có dữ liệu trên server."; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi
if [ ! -f /etc/pure-ftpd/pure-ftpd.conf ]; then
clear
echo "========================================================================= "
echo "FTP Server chưa được cài đặt "
echo "-------------------------------------------------------------------------"
echo "Bạn phải cài đặt chức năng Setup FTP server trước."; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/check*
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
listwebsite=$(cat /etc/dsnvps/.tmp/checkallwebsites)
rm -rf /etc/dsnvps/.tmp/checkwebsite-list
for checkweb in $listwebsite 
do

#### Check And Remove Error in Saved File
if [ "$(pure-pw list | grep home/$checkweb)" == "" ] && [ "$(grep home/$checkweb /etc/dsnvps/FTP-Account.info)" != "" ]; then
rm -rf /etc/dsnvps/.tmp/removeerrorftp
cat > "/etc/dsnvps/.tmp/removeerrorftp" <<END
sed -i '/home\/$checkweb/d' /etc/dsnvps/FTP-Account.info
END
sh /etc/dsnvps/.tmp/removeerrorftp
rm -rf /etc/dsnvps/.tmp/removeerrorftp
fi
####

if [ "$(pure-pw list | grep "/home/$checkweb/")" != "" ]; then
echo "$checkweb" >> /etc/dsnvps/.tmp/checkwebsite-list
fi
 done
if [ ! -f /etc/dsnvps/.tmp/checkwebsite-list ]; then
rm -rf /etc/dsnvps/.tmp/check*
clear
echo "========================================================================="
echo "DSNVPS không tìm thấy website đã tạo FTP account !"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi
echo "========================================================================="
echo "Sử dụng chức năng này để xem thông tin tài khoản FTP của website."
mapfile -t website_list < /etc/dsnvps/.tmp/checkwebsite-list
echo "========================================================================="
echo "Danh sách website đã tạo tài khoản FTP:"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#website_list[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${website_list[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${website_list[right_index-1]}"      
        printf "%-4s %-30s %-4s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-4s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
     echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-ftpserver-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#website_list[@]} )); then
        website=${website_list[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
     echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
    fi
done
#### Check And Remove Error in Saved File
if [ "$(pure-pw list | grep home/$website)" == "" ] && [ "$(grep home/$website /etc/dsnvps/FTP-Account.info)" != "" ]; then
rm -rf /etc/dsnvps/.tmp/removeerrorftp
cat > "/etc/dsnvps/.tmp/removeerrorftp" <<END
sed -i '/home\/$website/d' /etc/dsnvps/FTP-Account.info
END
sh /etc/dsnvps/.tmp/removeerrorftp
rm -rf /etc/dsnvps/.tmp/removeerrorftp
fi
####

if [ "$(pure-pw list | grep "/home/$website/")" == "" ]; then
clear
echo "========================================================================="
echo "$website chưa tạo tài khoản FTP !"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi

echo "========================================================================="
echo "Tìm thấy $website trên hệ thống"
echo "-------------------------------------------------------------------------"
echo "$website đã được tạo tài khoản FTP"
echo "-------------------------------------------------------------------------"
echo "DSNVPS đang lấy thông tin"
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ..."
sleep 5
rm -rf /etc/dsnvps/.tmp/showftpaccount
pure-pw show $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}') > /etc/dsnvps/.tmp/showftpaccount
sofileupload=`cat /etc/dsnvps/.tmp/showftpaccount | grep "Max files" | sed 's/[^0-9]*//g'`
hdd=`cat /etc/dsnvps/.tmp/showftpaccount | grep "Max size" | sed 's/[^0-9]*//g'`
if [ "$sofileupload" == "0" ]; then
sofileupload=Unlimited
fi
if [ "$hdd" == "0" ]; then
hdd=Unlimited
fi

clear
echo "========================================================================="
echo "Thông tin FTP của $website:"
echo "-------------------------------------------------------------------------"
echo "Host: $serverip | Port: 21"
echo "-------------------------------------------------------------------------"
echo "Username: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}') | Password: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $10}')"
echo "-------------------------------------------------------------------------"
echo "Quota:"
echo "-------------------------------------------------------------------------"
echo "Max Files: $sofileupload files | Dung lượng Disc tối đa: $hdd MB"  
/etc/dsnvps/menu/dsnvps-ftpserver-menu
