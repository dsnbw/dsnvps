#!/bin/bash

# Tạo thư mục tạm nếu chưa tồn tại
mkdir -p /etc/dsnvps/.tmp

# File đầu ra
domain_list_file="/etc/dsnvps/.tmp/90asx.txt"
subdomain_list_file="/etc/dsnvps/.tmp/sub90sx.txt"
special_conf_list_file="/etc/dsnvps/.tmp/80zzah.txt"
combined_file="/etc/dsnvps/.tmp/290asx.txt"

# Xóa nội dung cũ trong các file
> "$domain_list_file"
> "$subdomain_list_file"
> "$special_conf_list_file"
> "$combined_file"

# Lấy danh sách các domain
for conf in /etc/nginx/conf.d/*.conf; do
    if [[ -f "$conf" ]]; then
        domain=$(basename "$conf" .conf)
        if [[ -d "/home/$domain/public_html" && "$domain" != "$mainsite" ]]; then
            echo "$domain" >> "$domain_list_file"
        fi
    fi
done

# Kiểm tra domain sử dụng WordPress và xử lý subdomain
while read -r domain; do
    wp_config="/home/$domain/public_html/wp-config.php"
    multisite_dir="/home/$domain/multisite.conf.d"

    if [[ -f "$wp_config" ]]; then
        # Kiểm tra multisite.conf.d
        if [[ -d "$multisite_dir" ]]; then
            for subconf in "$multisite_dir"/*.conf; do
                if [[ -f "$subconf" ]]; then
                    subdomain=$(basename "$subconf" .conf)
                    echo "$subdomain" >> "$subdomain_list_file"
                fi
            done
        fi
    fi
done < "$domain_list_file"

# Kiểm tra và xử lý các file đặc biệt trong conf.d
while read -r domain; do
    special_conf_dir="/home/$domain/conf.d"

    if [[ -d "$special_conf_dir" ]]; then
        for special_conf in "$special_conf_dir"/*.conf; do
            if [[ -f "$special_conf" ]]; then
                special_name=$(basename "$special_conf" .conf)
                echo "$special_name" >> "$special_conf_list_file"
            fi
        done
    fi
done < "$domain_list_file"

# Gộp 3 file thành file cuối cùng
cat "$domain_list_file" "$subdomain_list_file" "$special_conf_list_file" > "$combined_file"


# Kiểm tra nếu file output không có domain nào
if [[ ! -s "$combined_file" ]]; then
rm -rf /etc/dsnvps/.tmp/90asx.txt
rm -rf /etc/dsnvps/.tmp/sub90sx.txt
rm -rf /etc/dsnvps/.tmp/290asx.txt
rm -rf /etc/dsnvps/.tmp/80zzah.txt
    clear
    echo "========================================================================="
    echo "Hiện tại bạn chưa thêm Website Vào Server!"; sleep 2
    /etc/dsnvps/menu/dsnvps-them-website-menu
    exit
fi


