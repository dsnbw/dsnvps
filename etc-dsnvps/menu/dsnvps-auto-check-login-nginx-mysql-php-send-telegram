#!/bin/bash

LOG_FILE="/etc/dsnvps/log-auto-start-nginx-mysql-php.txt"

# Kiểm tra nếu file không tồn tại hoặc không có nội dung
if [ ! -s "$LOG_FILE" ]; then
    printf "=========================================================================\n"
echo "Chưa có log trong file $LOG_FILE"
    dsnvps
    exit 1
fi

# Lấy chiều cao của cửa sổ terminal
terminal_height=$(tput lines)

# Tính toán số dòng cần hiển thị (ví dụ: 80% chiều cao của cửa sổ)
LINES_PER_PAGE=$(( terminal_height * 80 / 100 ))

# Tổng số dòng trong file (sử dụng tac để đảo ngược nội dung)
TOTAL_LINES=$(wc -l < "$LOG_FILE")
CURRENT_LINE=1  # Bắt đầu từ dòng đầu tiên

# Hiển thị toàn bộ log từ dưới lên trên
while [ $CURRENT_LINE -le $TOTAL_LINES ]; do
clear
    printf "=========================================================================\n"
    printf "                        Service Stop Log \n"
    printf "=========================================================================\n"
    # Tính toán vị trí của dòng đầu tiên và dòng cuối cùng để hiển thị
    END_LINE=$((CURRENT_LINE + LINES_PER_PAGE - 1))
    if [ "$END_LINE" -gt "$TOTAL_LINES" ]; then
        END_LINE="$TOTAL_LINES"
    fi

    # Hiển thị các dòng từ CURRENT_LINE đến END_LINE từ dưới lên trên
    tac "$LOG_FILE" | sed -n "${CURRENT_LINE},${END_LINE}p" | tac

    # Cập nhật dòng tiếp theo để hiển thị
    CURRENT_LINE=$((END_LINE + 1))

    # Nếu đã xem hết log
    if [ "$CURRENT_LINE" -gt "$TOTAL_LINES" ]; then
        echo "========================================================================="
 echo "Hết LOG. Nhấn [ Enter ] để quay trở lại DSNVPS Main Menu"
        read -r
        clear
        dsnvps
        exit
    fi

    # Hiển thị thông báo chờ người dùng nhấn Enter
    echo "========================================================================="
echo "Nhấn Enter để xem trang tiếp theo HOẶC nhấn '0' để thoát."
    echo "========================================================================="
    read -n 1 -s -r input

    if [ "$input" = "0" ]; then
        echo "========================================================================="
echo "Thoát xem Service Stop Log."; sleep 0.2
clear
echo "========================================================================="
echo "Thoát xem Service Stop Log."; sleep 2
        dsnvps
        exit
    fi
done
