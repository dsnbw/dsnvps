#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -f /usr/local/maldetect/conf.maldet ]; then
clear
echo "========================================================================= "
echo "LMD with ClamAV chưa được cài đặt trên server"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng cài đặt LMD trước khi chạy chức năng này !"
/etc/dsnvps/menu/dsnvps-maldet-menu
exit
fi
maldet --report list > /etc/dsnvps/.tmp/maldet.txt
if [ ! -f /usr/local/maldetect/sess/session.last ]; then
clear
echo "========================================================================= "
echo "Bạn chưa scan server bằng LMD !"

/etc/dsnvps/menu/dsnvps-maldet-menu
else
#name123=$(maldet --report list | awk 'END {print $NF}')
name123=$(cat /usr/local/maldetect/sess/session.last)
rm -rf /etc/dsnvps/.tmp/maldet.txt
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ..."
sleep 2
rm -rf /etc/dsnvps/.tmp/maldet123.txt
cp /usr/local/maldetect/sess/session.$name123 /etc/dsnvps/.tmp/maldet123.txt
name123=$(cat /usr/local/maldetect/sess/session.last)
rm -rf /etc/dsnvps/.tmp/maldet.txt
cp /usr/local/maldetect/sess/session.$name123 /etc/dsnvps/.tmp/maldet123.txt
sed -i '$d' /etc/dsnvps/.tmp/maldet123.txt && sed -i '$d' /etc/dsnvps/.tmp/maldet123.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet123.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet123.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet123.txt
clear
echo "========================================================================="
echo "Báo cáo cho lần quét gần nhất vào: $(maldet --report list | grep SCAN | awk 'NR==1 {print $1,$2,$3}')"
echo "-------------------------------------------------------------------------"
cat /etc/dsnvps/.tmp/maldet123.txt | grep '\S'
/etc/dsnvps/menu/dsnvps-maldet-menu
exit
fi

