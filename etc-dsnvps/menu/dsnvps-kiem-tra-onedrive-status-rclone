#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
re='^[0-9]+$'
if [ ! -f /bin/rclone ]; then
    clear
    echo "========================================================================="
    echo "Bạn hãy cài đặt Rclone trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
    exit
fi
if [ -f /etc/dsnvps/backup.onedrive.conf ]; then
    if [ ! -f /etc/cron.d/dsnvps.rclone.backup.onedrive.cron ]; then
        rm -rf /etc/dsnvps/backup.onedrive.conf
    fi 
fi
if [ -f /etc/cron.d/dsnvps.rclone.backup.onedrive.cron ]; then
    if [ ! -f /etc/dsnvps/backup.onedrive.conf ]; then
        rm -rf /etc/cron.d/dsnvps.rclone.backup.onedrive.cron
    fi 
fi
if [ ! -f /root/.config/rclone/rclone.conf ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Chức năng sao lưu Cloud (G-Drive, OneDrive) chưa được cấu hình."
    /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
    exit
fi

rm -rf /etc/dsnvps/.tmp/checkrcloneonedrive
awk '/^\[onedrive\]/ {print}' /root/.config/rclone/rclone.conf > /etc/dsnvps/.tmp/checkrcloneonedrive
 
checka=`cat /etc/dsnvps/.tmp/checkrcloneonedrive`
 
wc -l < /etc/dsnvps/.tmp/checkrcloneonedrive > /etc/dsnvps/.tmp/checkrcloneonedriveline
checkb=`cat /etc/dsnvps/.tmp/checkrcloneonedriveline`

if [ "$checkb" -lt "1" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Bạn hãy kết nối VPS với OneDrive trước khi chạy chức năng này."
    /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
    exit
fi

if [ "$checkb" -gt "1" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Đang kiểm tra kết nối ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Phát hiện lỗi !"; sleep 3
    clear
    echo "========================================================================="
    echo "Hiện tại DSNVPS chỉ hỗ trợ backup VPS với 1 config OneDrive"
    echo "-------------------------------------------------------------------------"
    echo "Hãy chạy chức năng [ Xóa Tất Cả Cấu Hình ], và thực hiện config lại."
    /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
    exit
fi

rm -rf /etc/dsnvps/.tmp/chckshxn0
grep -B 1 "type = onedrive" /root/.config/rclone/rclone.conf | awk 'NR==1' | sed 's/\[//' | sed 's/\]//' > /etc/dsnvps/.tmp/chckshxn0
uservue=`cat /etc/dsnvps/.tmp/chckshxn0`
if [ -z "$uservue" ]; then
    clear
    echo "========================================================================="
    echo "DSNVPS không thể thực hiện chức năng này."
    echo "-------------------------------------------------------------------------"
    echo "Bạn vui lòng kiểm tra lại."
    /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
    exit
fi

echo "-------------------------------------------------------------------------"
echo "Kiểm tra kết nối tới OneDrive"; sleep 2
rm -rf /etc/dsnvps/.tmp/checkrcloneonedrive
cat > "/etc/dsnvps/.tmp/checkrcloneonedrive.sh" <<END
#!/bin/bash
. /etc/dsnvps/backup.onedrive.conf 
rclone about \${nameaction}: 2> /etc/dsnvps/.tmp/checkrcloneonedrive
END
sh /etc/dsnvps/.tmp/checkrcloneonedrive.sh
if [ -f /etc/dsnvps/.tmp/checkrcloneonedrive ]; then
    grep "Failed" /etc/dsnvps/.tmp/checkrcloneonedrive > /etc/dsnvps/.tmp/checkrcloneonedrivezhzna
    wc -c < /etc/dsnvps/.tmp/checkrcloneonedrivezhzna > /etc/dsnvps/.tmp/checkrcloneonedrive34
    abcd=`cat /etc/dsnvps/.tmp/checkrcloneonedrive34`
    if [ "$abcd" -gt 10 ]; then
        rm -rf /etc/dsnvps/.tmp/checkrcloneonedrive*
        clear
        echo "========================================================================="
        echo "DSNVPS không thể kết nối tới OneDrive"
        echo "-------------------------------------------------------------------------"
        echo "Bạn vui lòng kiểm tra lại."
        /etc/dsnvps/menu/dsnvps-rclone-onedrive-menu
        exit
    fi
fi
rm -rf /etc/dsnvps/.tmp/checkrcloneonedrive*

clear
echo "========================================================================="
echo "Trạng thái hiện tại OneDrive:"
echo "-------------------------------------------------------------------------"
cat > "/etc/dsnvps/.tmp/checkrcloneonedrive.sh" <<END
#!/bin/bash
. /etc/dsnvps/backup.onedrive.conf 
rclone about \${nameaction}: | awk '
{
    gsub("GiB", "GB");
    gsub("MiB", "MB");
    if (\$1 == "Total:")      printf "Tổng dung lượng:    %s %s\n", \$2, \$3;
    if (\$1 == "Used:")       printf "Đã sử dụng:         %s %s\n", \$2, \$3;
    if (\$1 == "Free:")       printf "Dung lượng còn lại: %s %s\n", \$2, \$3;
}'
END

chmod +x /etc/dsnvps/.tmp/checkrcloneonedrive.sh
sh /etc/dsnvps/.tmp/checkrcloneonedrive.sh

rm -rf /etc/dsnvps/.tmp/checkrcloneonedrive.sh
/etc/dsnvps/menu/dsnvps-rclone-onedrive-menu