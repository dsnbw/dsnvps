if [ -f ~/.ssh/known_hosts ]; then
    grep -q "$ipvpsmoicopy" ~/.ssh/known_hosts && sed -i "/$ipvpsmoicopy/d" ~/.ssh/known_hosts
fi
if [ ! -f ~/.ssh/id_rsa.pub ]; then
    echo "-------------------------------------------------------------------------"
    echo "Chưa có SSH key, DSNVPS sẽ tạo SSH key ..."; sleep 2
    ssh-keygen -t rsa -b 4096 -N "" -f ~/.ssh/id_rsa <<< y #>/dev/null 2>&1
    echo "SSH key đã được tạo thành công!"
fi
echo "-------------------------------------------------------------------------"
echo "Kết nối tới $ipvpsmoicopy..."; sleep 3
####################################################################
##Check Ban Pro
####################################################################
if [ ! -f /usr/bin/gxred ]; then
touch /etc/dsnvps/.tmp/ckla
/etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
clear
/etc/dsnvps/menu/dsnvps-move-du-lieu-vps-sang-vps-moi-menu
fi
###################################################################
###################################################################


sshpass -p "$passrootbackupvps" scp -P $sshport -o StrictHostKeyChecking=no ~/.ssh/id_rsa.pub root@$ipvpsmoicopy:/root/temp_key
#sshpass -p "$passrootbackupvps" scp -P $sshport ~/.ssh/id_rsa.pub root@$ipvpsmoicopy:/root/temp_key
sshpass -p "$passrootbackupvps" ssh -p $sshport root@$ipvpsmoicopy "
    mkdir -p ~/.ssh &&
    touch ~/.ssh/authorized_keys &&
    cat /root/temp_key >> ~/.ssh/authorized_keys &&
    chmod 700 ~/.ssh &&
    chmod 600 ~/.ssh/authorized_keys &&
    rm -f /root/temp_key"
#sshpass -p '$passrootbackupvps' ssh-copy-id -p $sshport -i ~/.ssh/id_rsa.pub root@$ipvpsmoicopy #>/dev/null 2>&1
#echo "buoc 2"
checkconnect=$(ssh -p $sshport -o BatchMode=yes -o ConnectTimeout=9 root@$ipvpsmoicopy echo connected 2>&1)
if [[ "${checkconnect//[$'\t\r\n ']}" != "connected" ]]; then
    clear
    echo "========================================================================="
echo "Kết nối thất bại"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng kiểm tra lại thông tin server mới"
    /etc/dsnvps/menu/dsnvps-move-du-lieu-vps-sang-vps-moi-menu
    exit
fi

cat > "/etc/dsnvps/cauhinh_move_vps.info" <<END
ipaddress = $ipvpsmoicopy
sshport = $sshport
ketnoistatus = thanhcong
END
echo "========================================================================="
echo "Kết nối thành công"; sleep 2
echo "-------------------------------------------------------------------------"
ssh root@$ipvpsmoicopy dnf -y install rsync wget tar
clear
echo "========================================================================="
echo "Kết nối tới server Mới $ipvpsmoicopy thành công ! "
echo "-------------------------------------------------------------------------"
echo "Bây giờ bạn có thể chạy chức năng [Chuyển Dữ Liệu Sang Server Mới Ngay]."
echo "-------------------------------------------------------------------------"
echo "Nếu gặp lỗi, hãy chạy chức năng [Xóa Toàn Bộ Cấu Hình] và thực hiện lại."
/etc/dsnvps/menu/dsnvps-move-du-lieu-vps-sang-vps-moi-menu
exit
