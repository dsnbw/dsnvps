#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/check*
rm -rf /etc/dsnvps/.tmp/*hostingaz*
mkdir -p /etc/dsnvps/.tmp/saoluuwebsitethanhconghostingaz
mkdir -p /etc/dsnvps/.tmp/saoluuwebsitethatbaihostingaz
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist 
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checksite-list
sowebsitetrenserver=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist | wc -l)
listwebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/checksite-list
for checksite in $listwebsite 
do
rm -rf /etc/dsnvps/.tmp/dsnvps_check_site
if [ -d /home/$checksite/public_html ]; then
find /home/$checksite/public_html -name "*.*" > /etc/dsnvps/.tmp/dsnvps_check_site
sodong=`cat /etc/dsnvps/.tmp/dsnvps_check_site | wc -l`
if [ "$sodong" -gt 5 ]; then
echo "$checksite" >> /etc/dsnvps/.tmp/checksite-list
fi
fi
done

if [ ! -f /etc/dsnvps/.tmp/checksite-list ]; then
rm -rf /etc/dsnvps/.tmp/*dsnvps*
rm -rf /etc/dsnvps/.tmp/*hostingaz*
clear
echo "========================================================================="
echo "Không tìm thấy website có dữ liệu trên server"
/etc/dsnvps/menu/dsnvps-sao-luu
fi
######################################################################################
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist 
rm -rf /etc/dsnvps/.tmp/checkautobackupdsnvps
mkdir -p /etc/dsnvps/.tmp/checkautobackupdsnvps
checkautobackup=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/chitietbackupauto
randomcode=`date |md5sum |cut -c '1-12'`
for websitecheck in $checkautobackup 
do
if [ -f /bin/auto-backupcode-$websitecheck ]; then
 if [ -f /etc/cron.d/dsnvps.code.cron ]; then
     if [ ! "$(grep auto-backupcode-$websitecheck /etc/cron.d/dsnvps.code.cron)" == "" ]; then
     touch /etc/dsnvps/.tmp/checkautobackupdsnvps/$websitecheck
     fi
 fi
fi  
done
rm -rf /etc/dsnvps/.tmp/kland
SOURCE_DIR="/etc/dsnvps/.tmp/checkautobackupdsnvps/"
OUTPUT_FILE="/etc/dsnvps/.tmp/kland"
> "$OUTPUT_FILE"
for file in "$SOURCE_DIR"/*; do
    # Check if it is a file
    if [ -f "$file" ]; then
        # Extract the file name and append it to the output file
        echo "$(basename "$file")" >> "$OUTPUT_FILE"
    fi
done
###################################################################################
##################################################################
#Thêm (V)
if [ -s "/etc/dsnvps/.tmp/kland" ]; then
ALL_WEBSITES_FILE="/etc/dsnvps/.tmp/checksite-list"
KLAND_FILE="/etc/dsnvps/.tmp/kland"
OUTPUT_FILE="/etc/dsnvps/.tmp/checksite-list_with_status"
> "$OUTPUT_FILE"
while read -r domain; do
    if grep -q "^$domain$" "$KLAND_FILE"; then
        echo "$domain**" >> "$OUTPUT_FILE"
    else
        echo "$domain" >> "$OUTPUT_FILE"
    fi
done < "$ALL_WEBSITES_FILE"
else
mv /etc/dsnvps/.tmp/checksite-list /etc/dsnvps/.tmp/checksite-list_with_status
fi
#####################################################################

printf "=========================================================================\n"
echo "Dùng chức năng này để BẬT hoặc TẮT chế độ tự động sao lưu cho website"
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checksite-list_with_status
echo "========================================================================="
echo "Danh sách các Website có dữ liệu trên server: | ** : đang BẬT Config."
echo "-------------------------------------------------------------------------"
################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${danh_sach_website[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${danh_sach_website[right_index-1]}"      # Tên database bên phải
        printf "%-4s %-30s %-4s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-4s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-sao-luu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=$(echo "${danh_sach_website[lua_chon-1]}" | sed 's/**$//')
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

# Cac doan ma xac nhan phia duoi se tiep tuc chay
rm -rf /etc/dsnvps/.tmp/websiteautobackup
echo "$website" > /etc/dsnvps/.tmp/websiteautobackup
if [ -f /bin/auto-backupcode-$website ]; then
 if [ -f /etc/cron.d/dsnvps.code.cron ]; then
     if [ ! "$(grep auto-backupcode-$website /etc/cron.d/dsnvps.code.cron)" == "" ]; then
echo "========================================================================="
echo "$website đang BẬT Chế độ sao lưu tự động."
echo "-------------------------------------------------------------------------"
prompt="Nhập Lựa chọn của bạn [0 -Thoát]: "
options=( "Cấu hình lại sao lưu tự động" "TẮT sao lưu tự động." )
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) luachon="reconfig"; break;;
    2) luachon="tat"; break;;
    0) luachon="thoat"; break;;    
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    esac  
done
if [ "$luachon" = "tat" ]; then
 echo "========================================================================="
echo "OK, Vui lòng chờ ..."; sleep 3
     /etc/dsnvps/menu/dsnvps-TAT-tu-dong-sao-luu-code
elif [ "$luachon" = "reconfig" ]; then
echo "========================================================================="
echo "OK, Vui lòng chờ ..."; sleep 3
echo "cxc" > /etc/dsnvps/.tmp/xafdf0askfhcv9
else
 clear
 echo "========================================================================="
 echo "Hủy bỏ!"
/etc/dsnvps/menu/dsnvps-sao-luu
fi
     fi
 fi
fi 
 /etc/dsnvps/menu/dsnvps-BAT-tu-dong-sao-luu-code

