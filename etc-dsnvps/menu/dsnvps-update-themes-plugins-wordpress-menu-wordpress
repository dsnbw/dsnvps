#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

echo "========================================================================="
echo "Sử dụng chức năng này để cập nhật Themes và Plugins cho wordpress website"
echo "========================================================================="
echo "========================================================================="
#prompt="Nhap lua chon cua ban: "
prompt="Lựa chọn của bạn [0 -Thoát]: "
options=( "Cập Nhật 1 Website" "Cập Nhật Tất Cả Websites")
printf "LỰA CHỌN CẬP NHẬT 1 WEBSITE HOẶC TẤT CẢ WORDPRESS WEBSITE TRÊN SERVER\n"
printf "=========================================================================\n"
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) luachonupdate="update1site"; break;;
    2) luachonupdate="updateall"; break;;
    0) luachonupdate="cancle"; break;;
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    #*) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    esac  
done
###################################
#Update 1 website
###################################
if [ "$luachonupdate" = "update1site" ]; then
/etc/dsnvps/menu/dsnvps-nang-cap-plugins-themes-wordpress
###################################
#Update tat ca cac website
###################################
elif [ "$luachonupdate" = "updateall" ]; then
/etc/dsnvps/menu/dsnvps-nang-cap-plugins-themes-tat-ca-website-wordpress
###################################
#Huy bo update
###################################
else
clear
exit 0
fi
