#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi
# Check strace
# Anti-debug removed
# Check DSNVPS Pro license
rm -rf /etc/dsnvps/.tmp/sllokie
mkdir -p /etc/dsnvps/.tmp && touch /etc/dsnvps/.tmp/sllokie && touch /etc/dsnvps/.tmp/ckla
if [ ! -f /etc/dsnvps/.tmp/sllokie ]; then
    clear
    echo "========================================================================="
    echo "Vui lòng nâng cấp DSNVPS lên phiên bản Pro để sử dụng tính năng này!"
    /etc/dsnvps/menu/dsnvps-them-website-menu
fi
rm -rf /etc/dsnvps/.tmp/sllokie
# Check Nginx configuration
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
    awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word
    if [ "$(cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word)" != "oksuccessful" ]; then
        rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
        echo "-------------------------------------------------------------------------"
        echo "Phát hiện lỗi ..."; sleep 3
        clear
        echo "========================================================================="
        echo "Nginx có lỗi. DSNVPS không thể thực hiện tính năng này!"
        echo "-------------------------------------------------------------------------"
        echo "Tình trạng Nginx: "
        echo "-------------------------------------------------------------------------"
        nginx -t
        /etc/dsnvps/menu/dsnvps-them-website-menu
    fi
fi
echo "========================================================================="
echo "Sử dụng tính năng để sao chép một website WordPress - Tạo website mới"
echo "-------------------------------------------------------------------------"
echo "với nội dung giống hệt một website WordPress hiện có trên server."
echo "-------------------------------------------------------------------------"
echo "VPS phải có ít nhất 500MB dung lượng DISC trống sau khi nhân bản."
echo "-------------------------------------------------------------------------"
echo "Nếu không, DSNVPS sẽ không thực hiện chức năng này."
echo "========================================================================="
# Prompt for new domain
kiemtradomain3="^(([a-zA-Z0-9]|xn--[a-zA-Z0-9-]+)([-a-zA-Z0-9]{0,61}[a-zA-Z0-9])?\.)+([a-zA-Z]{2,}|xn--[a-zA-Z0-9-]+)$"
while true; do
    echo -n "Nhập tên miền mới [0 - Thoát]: "
    read new_website
    if [ -z "$new_website" ]; then
        echo "========================================================================="
        echo "Bạn không nhập giá trị, vui lòng nhập lại!"
        sleep 4
        tput cuu 3
        tput ed
        continue
    fi
    new_website=$(echo "$new_website" | tr '[A-Z]' '[a-z]')
    if [ -d /home/www.$new_website/public_html ] && [ -f /etc/nginx/conf.d/www.$new_website.conf ]; then
        new_website=www.$new_website
    fi
    if [ $(echo "$new_website" | cut -c 1-4) == "www." ]; then
        website_redirect=$(echo "$new_website" | sed 's/....//')
    else
        website_redirect=www.$new_website
    fi
    if [ "$new_website" = "0" ]; then
        clear
        /etc/dsnvps/menu/dsnvps-them-website-menu
        exit
    elif [[ ! "$new_website" =~ $kiemtradomain3 ]] || [[ ! "$website_redirect" =~ $kiemtradomain3 ]]; then
        echo "========================================================================="
        echo "Giá trị không hợp lệ, vui lòng nhập lại!"
        sleep 4
        tput cuu 3
        tput ed
    elif [ -f /etc/nginx/conf.d/$new_website.conf ] || [ -f /etc/nginx/conf.d/$website_redirect.conf ]; then
        echo "========================================================================="
        echo "$new_website đã tồn tại trên hệ thống!"
        sleep 4
        tput cuu 3
        tput ed
    else
        break
    fi
done
# Check Park and Redirect Domain
echo "$new_website" > /etc/dsnvps/.tmp/websitenhap.test
/etc/dsnvps/menu/dsnvps-kiem-tra-domain-truoc-khi-them-vao-server
# List WordPress websites
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/wordpresslist
cd /etc/nginx/conf.d
ls > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
cd
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
file1="/etc/dsnvps/.tmp/dsnvps-websitelist"
while read -r wpsite; do
    if [ -f /home/$wpsite/public_html/wp-config.php ]; then
        echo "$wpsite" >> /etc/dsnvps/.tmp/wordpresslist
    fi
done < "$file1"
if [ ! -f /etc/dsnvps/.tmp/wordpresslist ]; then
    clear
    echo "========================================================================="
    echo "DSNVPS không tìm thấy website WordPress nào trên server."
    /etc/dsnvps/menu/dsnvps-them-website-menu
    exit
fi
# Select old website
echo "========================================================================="
echo "Danh sách các website WordPress trên server:"
echo "-------------------------------------------------------------------------"
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/wordpresslist
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))
    right_index=$((half + i + 1))
    left_db="${danh_sach_website[i]:- }"
    if (( right_index <= total )); then
        right_db="${danh_sach_website[right_index-1]}"
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website muốn sao chép [0 - Thoát]: "
    read lua_chon
    if [[ -z "$lua_chon" ]]; then
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
        /etc/dsnvps/menu/dsnvps-them-website-menu
        exit
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        old_website="${danh_sach_website[lua_chon-1]}"
        break
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done
# Confirm database cloning
echo "========================================================================="
echo "Bạn có muốn sao chép cả Database cho website mới không?"
echo "-------------------------------------------------------------------------"
echo "Nhập [y] để sao chép cả code và database, [n] để chỉ sao chép code."
echo "-------------------------------------------------------------------------"
read -r -p "Lựa chọn của bạn [y/N]: " clone_db_response
if [[ ! "$clone_db_response" =~ ^([yY][eE][sS]|[yY]|[nN])$ ]]; then
    clone_db_response="n"
fi
# Check disk space
echo "========================================================================="
echo "Đang kiểm tra dung lượng DISC trên server..."; sleep 5
file_size=$(du -sb /home/$old_website/public_html | awk '{print $1}')
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    old_dbname=$(grep "DB_NAME" /home/$old_website/public_html/wp-config.php | cut -d "'" -f 4)
    db_size=$(mysql -u root -p$mariadbpass -e "SELECT SUM(data_length + index_length) FROM information_schema.tables WHERE table_schema='$old_dbname';" | tail -1)
    backup_size=$((db_size / 2))
    total_needed=$((file_size + db_size + backup_size + 10*1024*1024))
else
    total_needed=$((file_size + 10*1024*1024))
fi
free_space=$(df -B1 /home | tail -1 | awk '{print $4}')
if [ $free_space -lt $((total_needed + 500*1024*1024)) ]; then
    clear
    echo "========================================================================="
    echo "Dung lượng DISC không đủ để sao chép!"
    echo "Dung lượng cần thiết: $((total_needed / 1024 / 1024)) MB"
    echo "Dung lượng còn lại: $((free_space / 1024 / 1024)) MB"
    /etc/dsnvps/menu/dsnvps-them-website-menu
    exit
fi
echo "-------------------------------------------------------------------------"
echo "=> Dung lượng DISC đủ, đang tiến hành sao chép..."
# Select cache plugin
prompt="Nhập lựa chọn của bạn [0 - Thoát]: "
options=("WP Super Cache" "W3 Total Cache" "WP-Rocket" "WP Optimize" "WP Fastest Cache" "Loại Khác")
echo "========================================================================="
echo "CHỌN PLUGIN CACHE BẠN SỬ DỤNG"
echo "========================================================================="
PS3="$prompt"
select opt in "${options[@]}"; do
    case "$REPLY" in
        1) vhostconfig="supercache"; plugin_name="WP Super Cache"; plugin_slug="wp-super-cache"; break;;
        2) vhostconfig="wptotalcache"; plugin_name="W3 Total Cache"; plugin_slug="w3-total-cache"; break;;
        3) vhostconfig="wprocket"; plugin_name="WP-Rocket"; plugin_slug="wp-rocket"; break;;
        4) vhostconfig="wpoptimize"; plugin_name="WP Optimize"; plugin_slug="wp-optimize"; break;;
        5) vhostconfig="fastestcache"; plugin_name="WP Fastest Cache"; plugin_slug="wp-fastest-cache"; break;;
        6) vhostconfig="normal"; plugin_name="Loại Khác"; plugin_slug=""; break;;
        0) vhostconfig="thoat"; break;;
        *) echo "Giá trị không hợp lệ! Vui lòng chọn một số từ danh sách."; continue;;
    esac
done
if [ "$vhostconfig" = "thoat" ]; then
    clear
    exit
fi
echo "========================================================================="
echo "Plugin Cache đã chọn: $plugin_name"
echo "========================================================================="
# Confirm cloning
echo "==> Xác nhận sao chép website:"
echo "-------------------------------------------------------------------------"
echo "Website mới sẽ thêm: $new_website"
echo "Sẽ được sao chép từ: $old_website"
echo "-------------------------------------------------------------------------"
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "Sao chép: Cả Code và Database"
else
    echo "Sao chép: Chỉ Code"
fi
echo "-------------------------------------------------------------------------"
echo "Vhost được cấu hình cho Plugin Cache: $plugin_name"
echo "========================================================================="
read -r -p "Bạn có muốn tiếp tục sao chép không? [y/N] " response
if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    clear
    /etc/dsnvps/menu/dsnvps-them-website-menu
    exit
fi
# Create new database if cloning database
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "$new_website" > /etc/dsnvps/.tmp/databasename.txt
    sed -i 's/\./_/g' /etc/dsnvps/.tmp/databasename.txt
    sed -i 's/\-/_/g' /etc/dsnvps/.tmp/databasename.txt
    random=$(date | md5sum | cut -c '1-4')
    dataname=$(cat /etc/dsnvps/.tmp/databasename.txt | cut -c1-11)_$random
    username=$(cat /etc/dsnvps/.tmp/databasename.txt | sed "s/\_//g" | cut -c1-10)$random
    password=$(date | md5sum | cut -c '1-29')
    rm -rf /etc/dsnvps/.tmp/databasename.txt
    cat > "/etc/dsnvps/.tmp/config.temp" <<END
CREATE DATABASE $dataname CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci;
CREATE USER '$username'@'localhost' IDENTIFIED BY '$password';
GRANT ALL PRIVILEGES ON $dataname.* TO '$username'@'localhost';
FLUSH PRIVILEGES;
END
    mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
    rm -f /etc/dsnvps/.tmp/config.temp
    echo "=========================================================================" >> /root/DBinfo.txt
    echo "Database: $dataname - Được tạo vào: $(date +%d/%m/%Y) khi nhân bản $new_website từ $old_website" >> /root/DBinfo.txt
    echo "=========================================================================" >> /root/DBinfo.txt
    echo "Data name: $dataname" >> /root/DBinfo.txt
    echo "Username: $username" >> /root/DBinfo.txt
    echo "Password: $password" >> /root/DBinfo.txt
    echo "" >> /root/DBinfo.txt
fi
# Copy files
echo "========================================================================="
echo "Đang nhân bản Files..."
mkdir -p /home/$new_website/public_html
cp -r /home/$old_website/public_html/* /home/$new_website/public_html/
mkdir -p /home/$new_website/logs
mkdir -p /home/$new_website/errorpage_html
cp -r /etc/dsnvps/menu/inc/errorpage_html/*.html /home/$new_website/errorpage_html
\cp -uf /etc/dsnvps/menu/robots.txt /home/$new_website/public_html/
# Dump and import database if cloning database
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "========================================================================="
    echo "Đang nhân bản Database..."
    rm -f /home/$old_website_db_backup.sql.gz
    mysqldump -u root -p$mariadbpass $old_dbname | gzip > /home/$old_website_db_backup.sql.gz
    gunzip < /home/$old_website_db_backup.sql.gz | mysql -u root -p$mariadbpass $dataname
    rm -f /home/$old_website_db_backup.sql.gz
    # Get table prefix from old website
    table_prefix=$(grep "table_prefix" /home/$old_website/public_html/wp-config.php | cut -d "'" -f 2)
    # Update URLs in database
    cat > "/etc/dsnvps/.tmp/update_urls.sql" <<END
UPDATE ${table_prefix}options SET option_value = REPLACE(option_value, 'https://$old_website', 'http://$new_website') WHERE option_name IN ('siteurl', 'home');
UPDATE ${table_prefix}options SET option_value = REPLACE(option_value, 'http://$old_website', 'http://$new_website') WHERE option_name IN ('siteurl', 'home');
UPDATE ${table_prefix}posts SET guid = REPLACE(guid, 'https://$old_website', 'http://$new_website');
UPDATE ${table_prefix}posts SET guid = REPLACE(guid, 'http://$old_website', 'http://$new_website');
UPDATE ${table_prefix}posts SET post_content = REPLACE(post_content, 'https://$old_website', 'http://$new_website');
UPDATE ${table_prefix}posts SET post_content = REPLACE(post_content, 'http://$old_website', 'http://$new_website');
END
    mysql -u root -p$mariadbpass $dataname < /etc/dsnvps/.tmp/update_urls.sql
    rm -f /etc/dsnvps/.tmp/update_urls.sql
    # Update wp-config.php
    sed -i "s/define( *'DB_NAME', *'[^']*'/define('DB_NAME', '$dataname'/" /home/$new_website/public_html/wp-config.php
    sed -i "s/define( *'DB_USER', *'[^']*'/define('DB_USER', '$username'/" /home/$new_website/public_html/wp-config.php
    sed -i "s/define( *'DB_PASSWORD', *'[^']*'/define('DB_PASSWORD', '$password'/" /home/$new_website/public_html/wp-config.php
    sed -i "s/define( *'WP_HOME', *'[^']*'/define('WP_HOME', 'http:\/\/$new_website'/" /home/$new_website/public_html/wp-config.php
    sed -i "s/define( *'WP_SITEURL', *'[^']*'/define('WP_SITEURL', 'http:\/\/$new_website'/" /home/$new_website/public_html/wp-config.php
fi
# Create vhost
rm -rf /etc/nginx/conf.d/$new_website.conf
cp -r /etc/dsnvps/menu/inc/vhost-sample/domain.normal.wordpress.conf /etc/nginx/conf.d/$new_website.conf
sed -i "s/main_domain/${new_website}/g" /etc/nginx/conf.d/$new_website.conf
sed -i "s/redirect_domain/${website_redirect}/g" /etc/nginx/conf.d/$new_website.conf
case $vhostconfig in
    "wpoptimize") sed -i 's/.*wp-optimize-cache.conf.*/include \/etc\/nginx\/conf\/wp-optimize-cache.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
    "supercache") sed -i 's/.*supercache.conf.*/include \/etc\/nginx\/conf\/supercache.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
    "wptotalcache") sed -i 's/.*w3total.conf.*/include \/etc\/nginx\/conf\/w3total.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
    "wprocket") sed -i 's/.*wprocket.conf.*/include \/etc\/nginx\/conf\/wprocket.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
    "fastestcache") sed -i 's/.*wp-fastest-cache.conf.*/include \/etc\/nginx\/conf\/wp-fastest-cache.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
    *) sed -i 's/.*all.conf.*/include \/etc\/nginx\/conf\/all.conf;/g' /etc/nginx/conf.d/$new_website.conf ;;
esac
# Create symlink for vhost
mkdir -p /home/$new_website/0-Vhost
cd /home/$new_website/0-Vhost
echo "$new_website.conf là một liên kết (symlink) đến Vhost của $new_website (/etc/nginx/conf/$new_website.conf)
Việc chỉnh sửa tệp này cũng sẽ chỉnh sửa tệp Vhost của $new_website.
+ Tệp /home/$new_website/0-Vhost/$new_website.conf chỉ có thể chỉnh sửa qua SSH. Để chỉnh sửa bằng trình soạn thảo văn bản, bạn
phải tải tệp này về máy tính, chỉnh sửa và sau đó tải lên server.
(Tải lên /etc/nginx/conf/ hoặc /home/$new_website/0-Vhost/ đều được)
+ Tệp Vhost gốc (/etc/nginx/conf/$new_website.conf) có thể chỉnh sửa qua SSH hoặc trực tiếp bằng phần mềm chỉnh sửa văn bản
sử dụng các công cụ tải lên sFTP.
" > readme.txt
ln -s /etc/nginx/conf.d/$new_website.conf /home/$new_website/0-Vhost/$new_website.conf
cd
# Set permissions
chown -R nginx:nginx /home/$new_website/public_html/
chown -R nginx:nginx /home/$new_website/logs/
find /home/$new_website/public_html/ -type d -exec chmod g+s {} \;
# Activate cache plugin
if [ -n "$plugin_slug" ]; then
    cd /home/$new_website/public_html
    wp plugin activate $plugin_slug --allow-root
    cd
fi
# Restart services
/etc/dsnvps/menu/inc/re-start-nginx-service
/etc/dsnvps/menu/inc/re-start-php-fpm-service
# Save and display result
echo "=========================================================================" > /home/$new_website/$new_website.txt
echo "Đã nhân bản $new_website từ $old_website thành công" >> /home/$new_website/$new_website.txt
echo "-------------------------------------------------------------------------" >> /home/$new_website/$new_website.txt
echo "Home Folder: /home/$new_website/public_html" >> /home/$new_website/$new_website.txt
echo "-------------------------------------------------------------------------" >> /home/$new_website/$new_website.txt
echo "Vhost: /etc/nginx/conf.d/$new_website.conf" >> /home/$new_website/$new_website.txt
echo " --------------------------------------------------------------" >> /home/$new_website/$new_website.txt
echo "Liên kết: /home/$new_website/0-Vhost/$new_website.conf" >> /home/$new_website/$new_website.txt
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "-------------------------------------------------------------------------" >> /home/$new_website/$new_website.txt
    echo "Thông tin cơ sở dữ liệu:" >> /home/$new_website/$new_website.txt
    echo "-------------------------------------------------------------------------" >> /home/$new_website/$new_website.txt
    echo "Tên Database: $dataname" >> /home/$new_website/$new_website.txt
    echo "Username: $username" >> /home/$new_website/$new_website.txt
    echo "Mật khẩu: $password" >> /home/$new_website/$new_website.txt
fi
echo "-------------------------------------------------------------------------" >> /home/$new_website/$new_website.txt
echo "Plugin Cache: $plugin_name" >> /home/$new_website/$new_website.txt
######
### Them website vào Zend Opcache"
BLACKLIST_FILE="/etc/dsnvps/opcache.blacklist"
if [ -f "$BLACKLIST_FILE" ]; then
echo "/home/$new_website/" >> "$BLACKLIST_FILE"
####### Restart PHP-FPM
/etc/dsnvps/menu/inc/re-start-php-fpm-service
fi
#########
clear
echo "========================================================================="
echo "Đã nhân bản $new_website từ $old_website thành công"
echo "-------------------------------------------------------------------------"
echo "Home folder: /home/$new_website/public_html"
if [[ "$clone_db_response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "-------------------------------------------------------------------------"
    echo "Thông tin Database:"
    echo "-------------------------------------------------------------------------"
    echo "Tên Database: $dataname"
    echo "User name: $username"
    echo "Mật khẩu: $password"
fi
echo "-------------------------------------------------------------------------"
echo "Cấu hình Vhost cho plugin cache: $plugin_name"
/etc/dsnvps/menu/dsnvps-them-website-menu