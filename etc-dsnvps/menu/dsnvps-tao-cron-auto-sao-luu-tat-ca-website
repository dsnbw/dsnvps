#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
re='^[0-9]+$'
if [ -f /etc/dsnvps/auto.backup.all.websites.conf ]; then
if [ ! -f /etc/cron.d/auto.backup.all.websites.cron ]; then
rm -rf /etc/dsnvps/auto.backup.all.websites.conf
fi
fi

if [ -f /etc/cron.d/auto.backup.all.websites.cron ]; then
if [ ! -f /etc/dsnvps/auto.backup.all.websites.conf ]; then
rm -rf /etc/cron.d/auto.backup.all.websites.cron
fi
fi

if [ -f /etc/cron.d/auto.backup.all.websites.cron ]; then
if [ -f /etc/dsnvps/auto.backup.all.websites.conf ]; then
thoigianmode=`cat /etc/cron.d/auto.backup.all.websites.cron | awk 'NR==2 {print $3}'`
if [ "$thoigianmode" == "*" ]; then
khoangcachngay=1
backupmode="Sao lưu hàng ngày"
else
khoangcachngay=`echo $thoigianmode | cut -d'/' -f2`
backupmode="Sao lưu $khoangcachngay ngày 1 lần"
fi
rm -rf /etc/dsnvps/.tmp/zasxcetbvc
cat > "/etc/dsnvps/.tmp/zasxcetbvc" <<END
#!/bin/bash
. /etc/dsnvps/auto.backup.all.websites.conf
echo "\$sobansaoluu" > /etc/dsnvps/.tmp/zadertycv
rm -rf /etc/dsnvps/.tmp/zasxcetbvc
END
sh /etc/dsnvps/.tmp/zasxcetbvc
sobansaoluu=`cat /etc/dsnvps/.tmp/zadertycv`
echo "========================================================================="
echo "Sử dụng chức năng này để BẬT/TẮT tự động sao lưu lần lượt tất cả website "
echo "-------------------------------------------------------------------------"
echo "trên server. Hiện tại chức năng này đang được BẬT. " 
echo "========================================================================="
echo "Cấu hình hiện tại:"
echo "-------------------------------------------------------------------------"
echo "Tự động sao lưu: $backupmode"
echo "-------------------------------------------------------------------------"
echo "Số bản sao lưu tối đa: $sobansaoluu bản."
echo "========================================================================="
echo "========================================================================="

prompt="Nhập Lựa chọn của bạn [0 -Thoát]: "
options=( "Cấu hình lại tự động sao lưu" "Tắt tự động sao lưu tất cả Website")
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) luachon="reconfig"; break;;
    2) luachon="tat"; break;;
    0) luachon="thoat"; break;;    
    *) echo "Bạn nhập sai! Vui lòng chọn số trong danh sách.";continue;;
    esac  
done
if [ "$luachon" = "tat" ]; then
 echo "========================================================================="
echo "OK, Vui lòng chờ ..."; sleep 3
rm -rf /etc/cron.d/auto.backup.all.websites.cron
rm -rf /etc/dsnvps/auto.backup.all.websites.conf
systemctl restart crond >/dev/null 2>&1
 clear
 echo "========================================================================="
echo "Chức năng tự động sao lưu tất cả website đã được TẮT."

 /etc/dsnvps/menu/dsnvps-sao-luu
elif [ "$luachon" = "reconfig" ]; then
echo "========================================================================="
echo "OK, Vui lòng chờ ..."; sleep 3
echo "cxc" > /etc/dsnvps/.tmp/xafdf0askfh
else
 clear
 echo "========================================================================="
 echo "Hủy bỏ!"
/etc/dsnvps/menu/dsnvps-sao-luu
fi
fi
fi

if [ ! -f /etc/dsnvps/.tmp/xafdf0askfh ]; then
echo "========================================================================="
echo "Sử dụng chức năng này để BẬT/TẮT auto sao lưu tất cả website trên VPS."
echo "-------------------------------------------------------------------------"
echo "Khi chức năng này chạy, DSNVPS sẽ tự động sao lưu lần lượt tất cả website"
echo "-------------------------------------------------------------------------"
echo "trên VPS, mỗi website vào một file riêng. Các file backup được lưu tại"
echo "-------------------------------------------------------------------------"
echo "/home/$mainsite/private_html/backup"
echo "-------------------------------------------------------------------------"
echo "Hiện tại chức năng này đang được TẮT." 
echo "========================================================================="
echo "========================================================================="
read -r -p "Bạn muốn BẬT chức năng này? [y/N] " response

if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
echo "-------------------------------------------------------------------------"
echo "OK, Vui lòng chờ ..."; sleep 3
else
 clear
 echo "========================================================================="
 echo "Hủy bỏ."
 /etc/dsnvps/menu/dsnvps-sao-luu
 exit
fi
fi
rm -rf /etc/dsnvps/.tmp/xafdf0askfh

chon_so_ban_luu_tru () {
echo "========================================================================="
echo "Lựa Chọn Số Bản Sao Lưu Tối Đa Được Lưu Trữ Trên Server."
echo "-------------------------------------------------------------------------"
echo "DSNVPS Sẽ Tự Động Xóa Các Bản Sao Lưu Cũ Nhất Nếu Vượt Quá Số Này."
echo "========================================================================="
options=( "2 Bản" "3 Bản" "4 Bản" "5 Bản" "7 Bản" "10 Bản" "14 Bản" "21 Bản" "28 Bản")
while true; do
    printf "%-34s %-20s\n" "1) ${options[0]}" "6) ${options[5]}"
    printf "%-34s %-20s\n" "2) ${options[1]}" "7) ${options[6]}"
    printf "%-34s %-20s\n" "3) ${options[2]}" "8) ${options[7]}"
    printf "%-34s %-20s\n" "4) ${options[3]}" "9) ${options[8]}"
    printf "%-34s %-20s\n" "5) ${options[4]}" "0) Thoát"
    echo -n "Nhập lựa chọn của bạn [0-9]: "
    read choice
    case "$choice" in
        1) sobansaoluu=2; break;;
        2) sobansaoluu=3; break;;
        3) sobansaoluu=4; break;;
        4) sobansaoluu=5; break;;
        5) sobansaoluu=7; break;;
        6) sobansaoluu=10; break;;
        7) sobansaoluu=14; break;;
        8) sobansaoluu=21; break;;
        9) sobansaoluu=28; break;;
        0) sobansaoluu=0; break;;
        *) echo "Bạn nhập sai! Vui lòng chọn số từ 0-9."; continue;;
    esac
done
if [ "$sobansaoluu" = "0" ]; then
    clear
    exit
fi
echo "========================================================================="
echo "Số bản sao lưu tối đa: $sobansaoluu bản"
}

chongio()
{
    echo "========================================================================="
    echo -n "Bạn muốn DSNVPS thực hiện tự động sao lưu lúc mấy giờ ?[0-23]: " 
    read gio
    if [ "$gio" = "" ]; then
        echo "========================================================================="
        echo "Bạn chưa nhập thời gian backup"
        echo "-------------------------------------------------------------------------"
        echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
        echo "-------------------------------------------------------------------------"
        chongio
    fi
    if ! [[ $gio =~ $re ]] ; then
        echo "========================================================================="
        echo "$gio không đúng!"
        echo "-------------------------------------------------------------------------"
        echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
        echo "-------------------------------------------------------------------------"
        chongio
    fi
    if ! [[ $gio -ge 0 && $gio -le 23 ]] ; then 
        echo "========================================================================="
        echo "$gio không đúng!"
        echo "-------------------------------------------------------------------------"
        echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
        echo "-------------------------------------------------------------------------"
        chongio
    fi 
}

echo "========================================================================="
echo "LỰA CHỌN TẦN SUẤT SAO LƯU"
echo "========================================================================="
options=( "Hàng ngày" "2 ngày 1 lần" "3 ngày 1 lần" "4 ngày 1 lần" "5 ngày 1 lần" "6 ngày 1 lần" "7 ngày 1 lần")
while true; do
    printf "%-33s %-20s\n" "1) ${options[0]}" "5) ${options[4]}"
    printf "%-34s %-20s\n" "2) ${options[1]}" "6) ${options[5]}"
    printf "%-34s %-20s\n" "3) ${options[2]}" "7) ${options[6]}"
    printf "%-34s %-20s\n" "4) ${options[3]}" "0) Thoát"
    echo -n "Nhập lựa chọn của bạn [0-7]: "
    read choice
    case "$choice" in
        1) khoangcachngay=1; break;;
        2) khoangcachngay=2; break;;
        3) khoangcachngay=3; break;;
        4) khoangcachngay=4; break;;
        5) khoangcachngay=5; break;;
        6) khoangcachngay=6; break;;
        7) khoangcachngay=7; break;;
        0) khoangcachngay=0; break;;
        *) echo "Bạn nhập sai! Vui lòng chọn số từ 0-7."; continue;;
    esac
done

if [ "$khoangcachngay" = "0" ]; then
    clear
    echo "========================================================================="
    echo "Hủy bỏ."
    exit
fi

chongio
chon_so_ban_luu_tru
if [ "$khoangcachngay" = "1" ]; then
    tan_suat_hien_thi="Sao lưu hàng ngày"
else
    tan_suat_hien_thi="Sao lưu $khoangcachngay ngày 1 lần"
fi
echo "========================================================================="
echo "Cấu hình tự động sao lưu: $tan_suat_hien_thi, vào lúc ${gio}h"
echo "-------------------------------------------------------------------------"
echo "Số bản sao lưu tối đa: $sobansaoluu bản"
echo "========================================================================="
read -r -p "Bạn đồng ý với cấu hình này ? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "OK, Vui lòng chờ ..."; sleep 3
    ####################################################################
    ##Check Ban Pro
    ####################################################################

    ###################################################################
    ###################################################################
    rm -rf /etc/dsnvps/auto.backup.all.websites.conf
    cat > "/etc/dsnvps/auto.backup.all.websites.conf" <<END
sobansaoluu="$sobansaoluu"
khoangcachngay="$khoangcachngay"
END
    echo "SHELL=/bin/sh" > /etc/cron.d/auto.backup.all.websites.cron
    echo "0 $gio */$khoangcachngay * * root /etc/dsnvps/menu/cron-lan-luot-sao-luu-het-tat-ca-website-run >/dev/null 2>&1" >> /etc/cron.d/auto.backup.all.websites.cron
    systemctl restart crond >/dev/null 2>&1
    clear
    echo "========================================================================="
    echo "Hoàn thành cấu hình tự động sao lưu tất cả Website trên server."
    echo "-------------------------------------------------------------------------"
    echo "Tần suất sao lưu: $tan_suat_hien_thi, vào lúc ${gio}h"
    echo "-------------------------------------------------------------------------"
    echo "Số bản sao lưu tối đa: $sobansaoluu bản."
    /etc/dsnvps/menu/dsnvps-sao-luu
else
    clear
    echo "========================================================================="
    echo "Hủy bỏ."
    /etc/dsnvps/menu/dsnvps-sao-luu
    exit
fi
