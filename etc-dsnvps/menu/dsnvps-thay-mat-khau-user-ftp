#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -l)" -lt "1" ]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website mới vào server !"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/checkallwebsites
nhapwebsite ()
{
echo -n "Nhập tên website [ENTER]: " 
read website
}

vhost_dir="/etc/nginx/conf.d"
home_dir="/home"
output_file="/etc/dsnvps/.tmp/checkallwebsites"

> "$output_file"

for vhost_file in "$vhost_dir"/*.conf; do
    domainc=$(basename "$vhost_file" .conf)

    # Bỏ qua domain dsnvps.demo
    if [[ "$domainc" == "dsnvps.demo" ]]; then
        continue
    fi

    # Kiểm tra nếu thư mục /home/domain tồn tại
    if [[ -d "$home_dir/$domainc" ]]; then
        echo "$domainc" >> "$output_file"
    fi
done

# Kiểm tra nếu file output không có domain nào
if [[ ! -s "$output_file" ]]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website Vào Server !"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
exit
fi
if [ ! -f /etc/pure-ftpd/pure-ftpd.conf ]; then
clear
echo "========================================================================= "
echo "FTP Server chưa được cài đặt "
echo "-------------------------------------------------------------------------"
echo "Bạn phải cài đặt chức năng Setup FTP server trước"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/check*
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
listwebsite=$(cat /etc/dsnvps/.tmp/checkallwebsites)
rm -rf /etc/dsnvps/.tmp/checkwebsite-list
for checkweb in $listwebsite 
do

#### Check And Remove Error in Saved File
if [ "$(pure-pw list | grep home/$checkweb)" == "" ] && [ "$(grep home/$checkweb /etc/dsnvps/FTP-Account.info)" != "" ]; then
rm -rf /etc/dsnvps/.tmp/removeerrorftp
cat > "/etc/dsnvps/.tmp/removeerrorftp" <<END
sed -i '/home\/$checkweb/d' /etc/dsnvps/FTP-Account.info
END
sh /etc/dsnvps/.tmp/removeerrorftp
rm -rf /etc/dsnvps/.tmp/removeerrorftp
fi
####

if [ "$(pure-pw list | grep "/home/$checkweb/")" != "" ]; then
echo "$checkweb" >> /etc/dsnvps/.tmp/checkwebsite-list
fi
 done
if [ ! -f /etc/dsnvps/.tmp/checkwebsite-list ]; then
rm -rf /etc/dsnvps/.tmp/check*
clear
echo "========================================================================="
echo "DSNVPS không tìm thấy website đã tạo FTP account !"
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi
echo "========================================================================="
echo "Sử dụng chức năng này để thay mật khẩu tài khoản FTP cho website."
mapfile -t website_list < /etc/dsnvps/.tmp/checkwebsite-list
echo "========================================================================="
echo "Danh sách website đã tạo tài khoản FTP:"
echo "-------------------------------------------------------------------------"
###############################################################
total=${#website_list[@]}
half=$(( (total + 1) / 2 ))  
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         
    right_index=$((half + i + 1))                

    left_db="${website_list[i]:- }"                    

    if (( right_index <= total )); then           
        right_db="${website_list[right_index-1]}"      
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
     echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-ftpserver-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#website_list[@]} )); then
        website=${website_list[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
     echo "-------------------------------------------------------------------------"
        echo "Vui lòng nhập một số hợp lệ."
        sleep 4
tput cuu 4   # Di chuyển con trỏ lên 6 dòng
for ((i=0; i<4; i++)); do
    tput el  # Xóa dòng hiện tại
    tput cud1 # Di chuyển con trỏ xuống 1 dòng
done
tput cuu 4   # Quay lại vị trí ban đầu (đầu tiên của 6 dòng)
    fi
done
#### Check And Remove Error in Saved File
if [ "$(pure-pw list | grep home/$website)" == "" ] && [ "$(grep home/$website /etc/dsnvps/FTP-Account.info)" != "" ]; then
rm -rf /etc/dsnvps/.tmp/removeerrorftp
cat > "/etc/dsnvps/.tmp/removeerrorftp" <<END
sed -i '/home\/$website/d' /etc/dsnvps/FTP-Account.info
END
sh /etc/dsnvps/.tmp/removeerrorftp
rm -rf /etc/dsnvps/.tmp/removeerrorftp
fi
####
if [ "$(pure-pw list | grep "/home/$website/")" == "" ]; then
clear
echo "========================================================================="
echo "$website chưa tạo tài khoản FTP!"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu
fi

echo "========================================================================="
echo "Phát hiện tài khoản FTP cho $website" ; sleep 1
echo "-------------------------------------------------------------------------"
echo "Thông tin tài khoản FTP hiện tại:"; sleep 1
echo "-------------------------------------------------------------------------"
echo "Username: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}')  |  Password: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $10}')"; sleep 2
echo "-------------------------------------------------------------------------"
echo "Bây giờ DSNVPS sẽ thay mật khẩu mới cho: $(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}')"; sleep 2
echo "========================================================================="
echo "Vui lòng chờ ...."
sleep 7
username=$(grep "/home/$website/" /etc/dsnvps/FTP-Account.info | awk 'NR==1 {print $7}')
mkmoi=`date |md5sum |cut -c '3-32'`
#echo "$mkmoi" | passwd --stdin $ftpuser
( echo ${mkmoi} ; echo ${mkmoi} ) | pure-pw passwd $username
pure-pw mkdb
cat > "/etc/dsnvps/.tmp/xoaftpuser" <<END	
sed -i '/\/home\/$website/d' /etc/dsnvps/FTP-Account.info
END
chmod +x /etc/dsnvps/.tmp/xoaftpuser
/etc/dsnvps/.tmp/xoaftpuser
rm -rf /etc/dsnvps/.tmp/xoaftpuser
#Khoi Dong lai Csf Firewall
if [ -f /etc/csf/csf.conf ]; then
/etc/dsnvps/menu/CSF-Fiwall/dsnvps-re-start-khoi-dong-lai-csf-lfd
fi
######
echo "FTP Account for $website | Username: $username | Password: $mkmoi | dd /home/$website/ " >> /etc/dsnvps/FTP-Account.info
clear
echo "========================================================================= "
echo "Thay mật khẩu tài khoản FTP của $website thành công"
echo "-------------------------------------------------------------------------"
echo "Thông tin login mới:"
echo "-------------------------------------------------------------------------"
echo "Host: $serverip | Port: 21"
echo "-------------------------------------------------------------------------"
echo "User: $username | Password: $mkmoi"; sleep 2
/etc/dsnvps/menu/dsnvps-ftpserver-menu





