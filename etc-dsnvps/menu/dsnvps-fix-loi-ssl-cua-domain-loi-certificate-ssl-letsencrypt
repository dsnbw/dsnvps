#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed

# Rate limit on registrations per IP is currently 10 per 3 hours
# Rate limit on certificates per Domain is currently 5 per 7 days

if [ ! -d /etc/dsnvps/Backup.Vhost.SSL ]; then
mkdir -p /etc/dsnvps/Backup.Vhost.SSL
fi

if [ ! -d /etc/dsnvps/.tmp ]; then
mkdir -p /etc/dsnvps/.tmp
fi

if [ ! -f /root/.acme.sh/acme.sh ]; then
clear
echo "========================================================================="
echo "Cai dat tien ich Acme.Sh "
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ..."; sleep 3
wget -O -  https://get.acme.sh | sh
sleep 3
clear
echo "========================================================================="
echo "Cai dat acme.sh hoan thanh"
echo "-------------------------------------------------------------------------"
echo "Bay gio ban co the su dung chuc nang cai dat SSL cho website cua minh."
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/checksite-list
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checksite-list
sowebsitetrenserver=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist| wc -l)
listwebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/checksite-list
rm -rf /etc/dsnvps/.tmp/checksite-listSSL
for checksite in $listwebsite 
do
if [ -f /etc/nginx/auth-acme/$checksite/$checksite.crt ]; then
if [ "`grep "/etc/nginx/auth-acme/$checksite/$checksite.crt" /etc/nginx/conf.d/$checksite.conf`" != "" ]; then
echo "$checksite" >> /etc/dsnvps/.tmp/checksite-list
fi
fi
done

if [ ! -f /etc/dsnvps/.tmp/checksite-list ]; then
rm -rf /etc/dsnvps/.tmp/*dsnvps*
rm -rf /etc/dsnvps/.tmp/*hostingaz*
clear
echo "========================================================================="
echo "There's no website using SSL Let's Encrypt on system"
echo "--------------------------------------------------------------------------"
echo "You can not need using this function !"
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi

echo "========================================================================="
echo "Su dung chuc nang nay de fix loi SSL cua domain."
echo "-------------------------------------------------------------------------"
echo "Trong qua trinh su dung, neu chung chi SSL cua domain bi loi, dich vu"
echo "-------------------------------------------------------------------------"
echo "Nginx se khong the khoi dong duoc va bi TAT. Su dung chuc nang nay de tao"
echo "-------------------------------------------------------------------------"
echo "chung chi SSL moi cho domain. Neu chung chi SSL cua domain hoat dong binh "
echo "-------------------------------------------------------------------------"
echo "thuong, ban khong nen dung chuc nang nay."
echo "========================================================================="
mapfile -t file_list < /etc/dsnvps/.tmp/checksite-list 
for ((i = 0; i < ${#file_list[@]}; i+=2)); do
    if ((i+1 < ${#file_list[@]})); then
        printf "%-4s %-20s %-4s %-20s\n" "$((i+1))." "${file_list[i]}" "$((i+2))." "${file_list[i+1]}"
    else
        printf "%-4s %-20s\n" "$((i+1))." "${file_list[i]}"
    fi
done
while true; do
    echo "========================================================================="
    echo -n "Nhap so tuong ung website (0-Thoat):  "
    read -r choice
    if [[ $choice == "0" ]]; then
        clear
    /etc/dsnvps/menu/dsnvps-letsencrypt-menu
        exit 0 
    fi

    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#file_list[@]} )); then
        website=${file_list[choice-1]} 
        break
    else
        echo "Bạn nhập sai, vui lòng nhập lại."
    fi
done

rm -rf /etc/dsnvps/.tmp/checksite-list 

##############
#######################################################
#Check Cai Dat SSL roi hay chua

if [ ! -f /etc/nginx/auth-acme/$website/$website.crt ]; then
clear
echo "========================================================================="
echo "$website is not using SSL Let's Encrypt."
echo "-------------------------------------------------------------------------"
echo "DSNVPS can not run this function."
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi

if [ -f /etc/nginx/auth-acme/$website/$website.crt ]; then
if [ "`grep "/etc/nginx/auth-acme/$website/$website.crt" /etc/nginx/conf.d/$website.conf`" == "" ]; then
clear
echo "========================================================================="
echo "$website is not using SSL Let's Encrypt."
echo "-------------------------------------------------------------------------"
echo "DSNVPS can not run this function."
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi
fi
######################################################
######Check Nginx Service II
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
nginx -t 2>&1 | grep -v 'ModSecurity-nginx' > /etc/dsnvps/.tmp/dsnvps.nginx.check
if [ -f /etc/dsnvps/.tmp/dsnvps.nginx.check ]; then
awk '{print $NF}' /etc/dsnvps/.tmp/dsnvps.nginx.check | tr -d '\n' > /etc/dsnvps/.tmp/dsnvps.nginx.check.word
if [ `cat /etc/dsnvps/.tmp/dsnvps.nginx.check.word` == "oksuccessful" ]; then
rm -rf /etc/dsnvps/.tmp/dsnvps.nginx.check*
echo "-------------------------------------------------------------------------"
echo "Phát hiện lỗi ..."; sleep 3
clear
clear
echo "========================================================================="
echo "Chuc nang nay su dung khi dich vu nginx bi loi. Hien tai Nginx dang OK !"
echo "-------------------------------------------------------------------------"
echo "DSNVPS khong the chay chuc nang nay. "
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi
fi

echo "========================================================================="
echo "Tìm thấy $website trên hệ thống."
echo "-------------------------------------------------------------------------"
echo "$website dang config su dung SSL Let's Encrypt."
echo "========================================================================="
read -r -p "Ban muon tao lai chung chi SSL khac cho website ? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
echo "-------------------------------------------------------------------------"; sleep 2
echo "Vui lòng chờ ..."; sleep 2
####################################################################
###################################################################
###################################################################
rm -rf /etc/nginx/auth-acme/$website/*
mkdir -p /etc/nginx/auth-acme/$website
/root/.acme.sh/acme.sh --issue -d $website -w /home/$website/public_html
sleep 6
/root/.acme.sh/acme.sh --installcert -d $website --keypath  /etc/nginx/auth-acme/$website/$website.key --capath  /etc/nginx/auth-acme/$website/$website.ca --fullchainpath  /etc/nginx/auth-acme/$website/$website.crt --reloadcmd "service nginx reload"
sleep 6
if [ ! -s /etc/nginx/auth-acme/$website/$website.crt ]; then
rm -rf /etc/nginx/auth-acme/$website
clear
echo "========================================================================="
echo "Qua trinh cai dat SSL cho $website gap loi."
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể tạo lại chứng chỉ Free SSL cho domain này."
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng kiểm tra lại hoặc thử lại sau"
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
exit
fi
#########  Restart Nginx ###############
/etc/dsnvps/menu/inc/re-start-nginx-service
#################################
clear
echo "========================================================================="
echo "Tao lai chung chi SSL cho $website thanh cong."
echo "-------------------------------------------------------------------------"
echo "Trang thai hien tai Nginx:"
echo "-------------------------------------------------------------------------"
nginx -t
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
else
clear 
echo "========================================================================= "
echo "Hủy bỏ!"
/etc/dsnvps/menu/dsnvps-letsencrypt-menu
fi
