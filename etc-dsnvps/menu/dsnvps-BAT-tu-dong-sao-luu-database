#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
re='^[0-9]+$'
dataname=$(cat /etc/dsnvps/.tmp/databaseautobackup)
randomcode=`date |md5sum |cut -c '1-2'` 

chon_so_ban_luu_tru () {
echo "========================================================================="
echo "Lựa Chọn Số Bản Sao Lưu Tối Đa Được Lưu Trữ Trên VPS."
echo "-------------------------------------------------------------------------"
echo "DSNVPS Sẽ Tự Động Xóa Các Bản Sao Lưu Cũ Nhất Nếu Vượt Quá Số Này."
echo "========================================================================="
options=( "2 Bản" "3 Bản" "4 Bản" "5 Bản" "7 Bản" "10 Bản" "14 Bản" "21 Bản" "28 Bản")
while true; do
    printf "%-34s %-20s\n" "1) ${options[0]}" "6) ${options[5]}"
    printf "%-34s %-20s\n" "2) ${options[1]}" "7) ${options[6]}"
    printf "%-34s %-20s\n" "3) ${options[2]}" "8) ${options[7]}"
    printf "%-34s %-20s\n" "4) ${options[3]}" "9) ${options[8]}"
    printf "%-34s %-20s\n" "5) ${options[4]}" 
    echo -n "Nhập lựa chọn của bạn [0 -Thoát]: "
    read choice
    case "$choice" in
        1) sobansaoluu=2; break;;
        2) sobansaoluu=3; break;;
        3) sobansaoluu=4; break;;
        4) sobansaoluu=5; break;;
        5) sobansaoluu=7; break;;
        6) sobansaoluu=10; break;;
        7) sobansaoluu=14; break;;
        8) sobansaoluu=21; break;;
        9) sobansaoluu=28; break;;
        0) sobansaoluu=0; break;;
        *) echo "Bạn nhập sai! Vui lòng chọn số từ 0-9."; continue;;
    esac
done
if [ "$sobansaoluu" = "0" ]; then
    clear
    exit
fi
echo "========================================================================="
echo "Số bản sao lưu tối đa: $sobansaoluu bản"
}

chongio()
{
echo "========================================================================="
echo -n "Bạn muốn DSNVPS backup database này lúc mấy giờ ? [0-23]: " 
read gio
if [ "$gio" = "" ]; then
echo "========================================================================="
echo "Bạn chưa nhập thời gian"
echo "-------------------------------------------------------------------------"
echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
echo "-------------------------------------------------------------------------"
chongio
fi
if ! [[ $gio =~ $re ]] ; then
echo "========================================================================="
echo "$gio không chính xác!"
echo "-------------------------------------------------------------------------"
echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
echo "-------------------------------------------------------------------------"
chongio
fi
if ! [[ $gio -ge 0 && $gio -le 23 ]] ; then 
echo "========================================================================="
echo "$gio không chính xác!"
echo "-------------------------------------------------------------------------"
echo "Giờ backup phải là số tự nhiên nằm trong khoảng (0 - 23)."
echo "-------------------------------------------------------------------------"
chongio
fi 
}

if [ ! -f /etc/dsnvps/.tmp/xafdf0askfhcv9z ]; then
echo "-------------------------------------------------------------------------"
echo "=> $dataname chưa BẬT tự động sao lưu "
fi
rm -rf /etc/dsnvps/.tmp/xafdf0askfhcv9z

echo "========================================================================="
echo "LỰA CHỌN TẦN SUẤT SAO LƯU"
echo "========================================================================="
options=( "Hàng ngày" "Hai ngày 1 lần" "Ba ngày 1 lần" "Bốn ngày 1 lần" "Năm ngày 1 lần" "Sáu ngày 1 lần" "Bảy ngày 1 lần")
while true; do
    printf "%-39s %-20s\n" "1) ${options[0]}" "5) ${options[4]}"
    printf "%-40s %-20s\n" "2) ${options[1]}" "6) ${options[5]}"
    printf "%-40s %-20s\n" "3) ${options[2]}" "7) ${options[6]}"
    printf "%-42s %-20s\n" "4) ${options[3]}" 
    echo -n "Nhập lựa chọn của bạn [0 -Thoát]: "
    read choice
    case "$choice" in
        1) khoangcachngay=1; tan_suat_hien_thi="Hàng ngày"; break;;
        2) khoangcachngay=2; tan_suat_hien_thi="Hai ngày 1 lần"; break;;
        3) khoangcachngay=3; tan_suat_hien_thi="Ba ngày 1 lần"; break;;
        4) khoangcachngay=4; tan_suat_hien_thi="Bốn ngày 1 lần"; break;;
        5) khoangcachngay=5; tan_suat_hien_thi="Năm ngày 1 lần"; break;;
        6) khoangcachngay=6; tan_suat_hien_thi="Sáu ngày 1 lần"; break;;
        7) khoangcachngay=7; tan_suat_hien_thi="Bảy ngày 1 lần"; break;;
        0) khoangcachngay=0; break;;
        *) echo "Bạn nhập sai! Vui lòng chọn số từ 0-7."; continue;;
    esac
done

if [ "$khoangcachngay" = "0" ]; then
    clear
    echo "========================================================================="
    echo "Hủy bỏ."
    exit
fi

chongio
chon_so_ban_luu_tru
echo "========================================================================="
echo "Cấu hình tự động sao lưu: $tan_suat_hien_thi, vào lúc ${gio}h"
echo "-------------------------------------------------------------------------"
echo "Số bản sao lưu tối đa: $sobansaoluu bản"
echo "========================================================================="
read -r -p "Bạn đồng ý với cấu hình này ? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."
    sleep 3
    ####################################################################
    ##Check Ban Pro
    ####################################################################
    if [ ! -f /usr/bin/gxred ]; then
        touch /etc/dsnvps/.tmp/ckla
        /etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
        clear
        /etc/dsnvps/menu/dsnvps-them-xoa-database
    fi
    ###################################################################
    cat > "/bin/auto-backupdb-$dataname" <<END
#!/bin/bash
. /root/dsnvps.conf
# Anti-debug removed
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
if [ ! -d /home/$mainsite/private_html/backup/$dataname ]; then
mkdir -p /home/$mainsite/private_html/backup/$dataname
fi
file_count=\$(ls -1 /home/$mainsite/private_html/backup/$dataname/*.sql.gz* | wc -l)
if [ \$file_count -gt $sobansaoluu ]; then
    ls -1t /home/$mainsite/private_html/backup/$dataname/*.sql.gz* | tail -n +\$(( $sobansaoluu + 1 )) | xargs rm -f
fi
cd /home/$mainsite/private_html/backup/$dataname
for file in *.sql.gz; do
time=\$(date -r /home/$mainsite/private_html/backup/$dataname/\$file +%Hh%Mm-%d-%m-%y)
    mv "\$file" "\`basename \$file .sql.gz\`.sql.gz.\$time"
done
cd
cd /home/$mainsite/private_html/backup/$dataname
enginecheck=\`grep "default_storage_engine =" /etc/my.cnf | grep MyISAM\`
if [ -z "\$enginecheck" ]; then
mysqldump -u root -p\$mariadbpass $dataname --single-transaction | gzip -6 > $dataname-$randomcode.sql.gz
else
mysqldump -u root -p\$mariadbpass $dataname --lock-tables=false | gzip -6 > $dataname-$randomcode.sql.gz
fi
cd
END
chmod +x /bin/auto-backupdb-$dataname
if [ ! -f /etc/cron.d/dsnvps.db.cron ]; then
echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.db.cron
echo "0 $gio */$khoangcachngay * * root /bin/auto-backupdb-$dataname >/dev/null 2>&1" >> /etc/cron.d/dsnvps.db.cron
else
  if [ "$(grep "SHELL=/bin/sh" /etc/cron.d/dsnvps.db.cron)" == "" ]; then
echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.db.cron 
  fi
echo "0 $gio */$khoangcachngay * * root /bin/auto-backupdb-$dataname >/dev/null 2>&1" >> /etc/cron.d/dsnvps.db.cron
fi
systemctl restart crond
clear
echo "========================================================================="
echo "Cấu hình tự động sao lưu $dataname thành công."
echo "-------------------------------------------------------------------------"
echo "Database sẽ được sao lưu: $tan_suat_hien_thi, vào lúc ${gio}h"
echo "-------------------------------------------------------------------------"
echo "Số bản sao lưu tối đa: $sobansaoluu bản."
echo "-------------------------------------------------------------------------"
echo "Link file backup:"
echo "-------------------------------------------------------------------------"
echo "http://$serverip_priport/backup/$dataname/$dataname-$randomcode.sql.gz"
/etc/dsnvps/menu/dsnvps-them-xoa-database
else
    clear
    echo "========================================================================="
    echo "Hủy bỏ."
    /etc/dsnvps/menu/dsnvps-them-xoa-database
    exit
fi
