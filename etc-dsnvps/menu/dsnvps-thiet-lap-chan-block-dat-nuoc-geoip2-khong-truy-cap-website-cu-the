  conf_redirect="/home/$source_domain/geoip2.conf.d/redirect.conf.d/geoip2_redirect_${code}.conf"
  conf_allow="/home/$source_domain/geoip2.conf.d/allowlist.conf.d/geoip2_allow_${code}.conf"
  conf_allow_merged="/home/$source_domain/geoip2.conf.d/allowlist.conf.d/geoip2_allowlist.conf"
  # Kiểm tra xung đột với allowlist hợp nhất
  allowlist_conflict=0
  if [[ -f "$conf_allow_merged" ]]; then
    # Parse regex từ file hợp nhất: lấy phần trong ngoặc (US|SG|VN)
    merged_regex=$(grep -E 'if \(\$geoip2_data_country_code !~ ' "$conf_allow_merged" | sed -E 's/.*\^\(([^)]*)\)\$\"\) \{.*/\1/')
    if [[ -n "$merged_regex" ]]; then
      # Kiểm tra nếu mã quốc gia có trong danh sách cho phép bằng cách tách chuỗi
      IFS='|' read -ra countries <<< "$merged_regex"
      for country in "${countries[@]}"; do
        if [[ "$country" == "$code" ]]; then
          allowlist_conflict=1
          break
        fi
      done
    fi
  fi
  if [[ -f "$conf_redirect" || -f "$conf_allow" || "$allowlist_conflict" == "1" ]]; then
    conflict_codes+=("$code")
    [[ -f "$conf_redirect" ]] && conflict_files+=("$conf_redirect")
    [[ -f "$conf_allow" ]] && conflict_files+=("$conf_allow")
    [[ "$allowlist_conflict" == "1" ]] && conflict_files+=("$conf_allow_merged")
  else
    allowed_codes+=("$code")
  fi
done

if (( ${#conflict_codes[@]} > 0 )); then
  echo "========================================================================="
  echo "=> Phát hiện xung đột cấu hình với các quốc gia: ${conflict_codes[*]}"
  echo "-------------------------------------------------------------------------"
  # Hiển thị chi tiết từng xung đột (DOMAIN THƯỜNG)
  for code in "${conflict_codes[@]}"; do
    f_redirect="/home/$source_domain/geoip2.conf.d/redirect.conf.d/geoip2_redirect_${code}.conf"
    f_allow="/home/$source_domain/geoip2.conf.d/allowlist.conf.d/geoip2_allow_${code}.conf"
    f_allow_merged="/home/$source_domain/geoip2.conf.d/allowlist.conf.d/geoip2_allowlist.conf"
    if [[ -f "$f_redirect" ]]; then
      target_domain=$(sed -n 's/.*return 301 http:\/\/\([^$;]*\).*/\1/p' "$f_redirect")
      echo "Truy cập $source_domain tại $code => Redirect sang: ${target_domain:-<không xác định>}"
    fi
    if [[ -f "$f_allow" ]]; then
      echo "Truy cập $source_domain tại $code => Được phép truy cập (Allow-only)"
    fi
    if [[ -f "$f_allow_merged" ]]; then
      # Kiểm tra xem có trong allowlist hợp nhất không
      merged_regex=$(grep -E 'if \(\$geoip2_data_country_code !~ ' "$f_allow_merged" | sed -E 's/.*\^\(([^)]*)\)\$\"\) \{.*/\1/')
      if [[ -n "$merged_regex" ]]; then
        IFS='|' read -ra countries <<< "$merged_regex"
        for country in "${countries[@]}"; do
          if [[ "$country" == "$code" ]]; then
            echo "Truy cập $source_domain tại $code => Được phép truy cập (Chức năng 3)"
            break
          fi
        done
      fi
    fi
  done
  echo "========================================================================="
  echo "1) Xóa cấu hình cũ và cài đặt cấu hình mới"
  echo "2) Cài đặt cấu hình mới, bỏ qua các quốc gia đang xung đột"
  echo "0) Thoát"
  echo "========================================================================="
  read -p "Vui lòng chọn [0-2]: " conflict_choice_all
  case $conflict_choice_all in
    1)
      for f in "${conflict_files[@]}"; do rm -f "$f"; done
      codes_to_process=("${codes[@]}")
      ;;
    2)
      codes_to_process=("${allowed_codes[@]}")
      # Kiểm tra xem có quốc gia nào để cấu hình không
      if (( ${#codes_to_process[@]} == 0 )); then
        echo "========================================================================="
        if (( ${#codes[@]} == 1 )); then
          echo "Quốc gia ${codes[0]} đang xung đột với cấu hình hiện tại!"
          echo "Bạn chỉ nhập 1 quốc gia và quốc gia đó đã được cấu hình cho phép truy cập."
        else
          echo "Không có quốc gia nào khác để cấu hình!"
          echo "Tất cả quốc gia đều đang xung đột với cấu hình hiện tại."
        fi
        echo "-------------------------------------------------------------------------"
        echo "Bạn có thể:"
        echo "1) Chọn option 1 để xóa cấu hình cũ và cài đặt mới"
        echo "2) Thoát và kiểm tra lại cấu hình"
        echo "========================================================================="
        read -p "Nhấn Enter để thoát: "; clear; exit 0
      fi
      ;;
    0) clear; exit 0;;
    *)
      echo "Lựa chọn không hợp lệ. Chỉ cài cho quốc gia không xung đột."; codes_to_process=("${allowed_codes[@]}")
      # Kiểm tra xem có quốc gia nào để cấu hình không
      if (( ${#codes_to_process[@]} == 0 )); then
        echo "========================================================================="
        if (( ${#codes[@]} == 1 )); then
          echo "Quốc gia ${codes[0]} đang xung đột với cấu hình hiện tại!"
          echo "Bạn chỉ nhập 1 quốc gia và quốc gia đó đã được cấu hình cho phép truy cập."
        else
          echo "Không có quốc gia nào khác để cấu hình!"
          echo "Tất cả quốc gia đều đang xung đột với cấu hình hiện tại."
        fi
        echo "-------------------------------------------------------------------------"
        echo "Bạn có thể:"
        echo "1) Chọn option 1 để xóa cấu hình cũ và cài đặt mới"
        echo "2) Thoát và kiểm tra lại cấu hình"
        echo "========================================================================="
        read -p "Nhấn Enter để thoát: "; clear;  /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu; exit
      fi
      ;;
  esac
else
  codes_to_process=("${codes[@]}")
fi

for code in "${codes_to_process[@]}"; do
echo "========================================================================="
echo "Cấu hình chặn truy cập từ: $code"; sleep 2
  config_file_source_domain="/home/$source_domain/geoip2.conf.d/countryblock.conf.d/geoip2_block_${code}.conf"

new_config_content=$(cat <<EOL
    if (\$geoip2_data_country_code = "$code") {
        return 403;
    }
EOL
)


  if [[ -f "$config_file_source_domain" ]]; then
    echo "========================================================================="
echo "==>> Phát hiện cấu hình chặn truy cập cho [ $code ] đã tồn tại ! "; sleep 4
echo "-------------------------------------------------------------------------"
echo "=> Giữ nguyên config"; sleep 4
  fi

  # Kiểm tra xung đột với Redirect/Allow trước khi ghi file (DOMAIN THƯỜNG)
  skip_current=0
  conf_redirect="/home/$source_domain/geoip2.conf.d/redirect.conf.d/geoip2_redirect_${code}.conf"
  conf_allow="/home/$source_domain/geoip2.conf.d/allowlist.conf.d/geoip2_allow_${code}.conf"
  if [[ -f "$conf_redirect" || -f "$conf_allow" ]]; then
    echo "========================================================================="
    echo "Phát hiện xung đột cấu hình cho quốc gia: $code"
    echo "-------------------------------------------------------------------------"
    [[ -f "$conf_redirect" ]] && echo "Đang tồn tại: CHUYỂN HƯỚNG (Redirect) => $conf_redirect"
    [[ -f "$conf_allow" ]] && echo "Đang tồn tại: CHO PHÉP (Allow-only) => $conf_allow"
    echo "========================================================================="
    echo "1) Xóa cấu hình cũ và cài đặt cấu hình mới"
    echo "2) Cài đặt cấu hình mới, bỏ qua quốc gia đang xung đột"
    echo "0) Thoát"
    echo "========================================================================="
    read -p "Vui lòng chọn [0-2]: " conflict_choice
    case $conflict_choice in
      1)
        [[ -f "$conf_redirect" ]] && rm -f "$conf_redirect"
        [[ -f "$conf_allow" ]] && rm -f "$conf_allow"
        ;;
      2)
        skip_current=1
        ;;
      0) clear; exit 0;;
      *)
        echo "Lựa chọn không hợp lệ. Bỏ qua quốc gia $code."; skip_current=1 ;;
    esac
  fi
  [[ "$skip_current" = "1" ]] && continue

  # Ghi đè cấu hình mới vào file
 echo "-------------------------------------------------------------------------"
  echo "$new_config_content" > "$config_file_source_domain"
  echo "Config [ $code ] ==> Done !"; sleep 2
done

if ! grep -q "countryblock.conf.d" "$config_file"; then
  sed -i "$(grep -n '}' "$config_file" | tail -n 1 | cut -d: -f1)i\\
include /home/${source_domain}/geoip2.conf.d/countryblock.conf.d/*.conf;" "$config_file"
fi

if nginx -t > /dev/null 2>&1; then
    rm -rf "$backup_file"
    systemctl reload nginx
    
    # Lấy danh sách tất cả quốc gia hiện tại sau khi reload
    country_codes_dang_cau_hinhx=$(ls $config_dir/geoip2_block_*.conf | sed -E 's/.*geoip2_block_([A-Za-z]{2})\.conf/\1/' | tr '\n' ',')
    country_codesxxxx=${country_codes_dang_cau_hinhx%,} # Loại bỏ dấu phẩy cuối cùng nếu có
    country_codes_dang_cau_hinhx=$country_codesxxxx
    
    echo "========================================================================="
    echo "Cấu hình chặn truy cập thành công."
  echo "-------------------------------------------------------------------------"
######################################################################################################################
text="Các nước bị chặn truy cập: $country_codes_dang_cau_hinhx"
max_length=72
line=""
while IFS= read -n1 char; do
    if [ ${#line} -ge $((max_length - 1)) ]; then
        echo "$line"
  echo "-------------------------------------------------------------------------"
        line="$char"
    else
        line="${line}$char"
    fi
done <<< "$text"
echo "$line"
sleep 2
########################################################################################################################
  clear
  echo "========================================================================="
echo "Hoàn tất cấu hình chặn truy cập cho $source_domain"; sleep 3
echo "-------------------------------------------------------------------------"
######################################################################################################################
text="Các nước bị chặn truy cập: $country_codes_dang_cau_hinhx"

max_length=72
line=""
while IFS= read -n1 char; do
    if [ ${#line} -ge $((max_length - 1)) ]; then
        echo "$line"
  echo "-------------------------------------------------------------------------"
        line="$char"
    else
        line="${line}$char"
    fi
done <<< "$text"
echo "$line"
########################################################################################################################
   /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
  exit
else
nginx -t > /etc/dsnvps/.tmp/a0paMLZa 2>&1
echo "========================================================================="
  echo "Cấu hình thất bại. Phục hồi cấu hình cũ"
  cp "$backup_file" "$config_file"
  rm -rf "$backup_file"
  systemctl reload nginx
  clear
 echo "========================================================================="
echo "Cấu hình chặn truy cập thất bại !"

 echo "-------------------------------------------------------------------------"
 cat /etc/dsnvps/.tmp/a0paMLZa
 rm -f /etc/dsnvps/.tmp/a0paMLZa
 /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu
fi
