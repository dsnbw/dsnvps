check_country_codes() {
  local input_codes="$1"
  IFS=',' read -ra codes <<< "$input_codes"
  for code in "${codes[@]}"; do
    code="${code// /}"  # Loại bỏ khoảng trắng
    if [[ ! "$code" =~ ^[A-Z]{2}$ ]] || ! grep -q "|$code|" "$country_code_file"; then
      return 1
    fi
  done
  return 0
}

# Hàm kiểm tra mã quốc gia có bị trùng lặp hay không
check_duplicate_codes() {
  local input_codes="$1"
  IFS=',' read -ra codes <<< "$input_codes"
  seen=()
  for code in "${codes[@]}"; do
    code="${code// /}"  # Loại bỏ khoảng trắng
    if [[ " ${seen[*]} " =~ ${code} ]]; then
      return 1  # Nếu mã quốc gia đã xuất hiện, trả về lỗi
    fi
    seen+=("$code")
  done
  return 0  # Không có trùng lặp
}
