#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
rm -rf /etc/dsnvps/.tmp/juaks
# Anti-debug removed
                
                if [ -z "$apitoken" ]; then
                    echo "========================================================================="
                    echo "Bạn nhập sai, vui lòng nhập lại!"
                    sleep 4
                    tput cuu 3 && tput ed
                else
                    echo "========================================================================="
                    echo "DSNVPS đang kiểm tra API Token ..."
                    sleep 4
                    
                    curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
                         -H "Authorization: Bearer $apitoken" \
                         -H "Content-Type:application/json" > /etc/dsnvps/.tmp/apitkchek 
                    
                    if grep -q "Invalid" /etc/dsnvps/.tmp/apitkchek; then
                        echo "========================================================================="
                        echo "Bạn nhập sai API Token của $domaincheck"
                        echo "-------------------------------------------------------------------------"
                        echo "Bạn hãy nhập lại."
                        sleep 4
                        tput cuu 7 && tput ed
                    else
                        # Kiểm tra API Token có hoạt động với domain này không
                        response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones?name=${domaincheck}" \
                             -H "Authorization: Bearer ${apitoken}" \
                             -H "Content-Type: application/json")
                        zone_id=$(echo "$response" | grep -oP '"id":"\K[^"]+' | head -n 1)
                        
                        if [ -n "$zone_id" ]; then
                            echo "========================================================================="
                            echo "API Token chính xác cho $domaincheck."
                            break 2  # Thoát cả 2 vòng lặp
                        else
                            echo "========================================================================="
                            echo "API Token hợp lệ nhưng không có quyền truy cập $domaincheck"
                            echo "-------------------------------------------------------------------------"
                            echo "Vui lòng nhập API Token của tài khoản chứa domain này."
                            sleep 4
                            tput cuu 7 && tput ed
                        fi
                    fi
                fi
            done
            break
            ;;
        2)
            clear
            /etc/dsnvps/menu/dsnvps-ddns-cloudflare-menu
            exit 0
            ;;
        *)
            echo "-------------------------------------------------------------------------"
            echo "Lựa chọn không hợp lệ. Vui lòng chọn 1 hoặc 2."
            sleep 3
            tput cuu 8 && tput ed
            ;;
    esac
done
fi

# Function để tạo subdomain trong Cloudflare
create_subdomain_in_cloudflare() {
    local subdomain="$1"
    local zone_id="$2"
    local api_token="$3"
    local server_ip="$4"
    
    echo "========================================================================="
    echo "Đang tạo subdomain $subdomain trong Cloudflare..."
    echo "-------------------------------------------------------------------------"
    echo "IP sẽ được trỏ tới: $server_ip"
    sleep 2
    
    # Tạo DNS record A cho subdomain
    local create_response
    create_response=$(curl -s -X POST "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records" \
        -H "Authorization: Bearer $api_token" \
        -H "Content-Type: application/json" \
        --data "{\"type\":\"A\",\"name\":\"$subdomain\",\"content\":\"$server_ip\",\"ttl\":120,\"proxied\":false}")
    
    if echo "$create_response" | grep -q '"success":true'; then
        echo "========================================================================="
        echo "Tạo subdomain $subdomain thành công!"
        echo "-------------------------------------------------------------------------"
        echo "Subdomain đã được trỏ tới IP: $server_ip"
        sleep 3
        return 0
    else
        echo "========================================================================="
        echo "Lỗi khi tạo subdomain $subdomain"
        echo "-------------------------------------------------------------------------"
        echo "Chi tiết lỗi:"
        echo "$create_response" | grep -oP '"message":"\K[^"]+' | head -3
        sleep 5
        return 1
    fi
}

