#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ "$(grep VN /etc/dsnvps/menu/dsnvps-check-language)" == "VN" ]; then
clear
echo "========================================================================= "
echo "You are using Vietnamese Version"
echo "-------------------------------------------------------------------------"
echo "( Bạn đang sử dụng DSNVPS ngôn ngữ Tiếng Việt )"
dsnvps
exit
fi

echo "========================================================================= "
echo "(Use this function to change language for DSNVPS to VietNamese)"
echo "-------------------------------------------------------------------------"
echo "Sử dụng chức năng này để thay đổi ngôn ngữ DSNVPS sang tiếng Việt"
echo "-------------------------------------------------------------------------"
echo "DSNVPS hỗ trợ Tiếng Anh & Tiếng Việt"
echo "========================================================================= "
read -r -p "Bạn muốn thay đổi ngôn ngữ DSNVPS sang Tiếng Việt ? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
    echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ... "
sleep 2
echo "-------------------------------------------------------------------------"
motdxxx=$(rpm -qf --queryformat="%{VERSION}" /etc/redhat-release)


cd /etc/dsnvps/
rm -rf /etc/dsnvps/menu.zip
if [ "$(arch)" = "aarch64" ]; then
    wget --progress=dot https://dsnvps/script/dsnvps/menuARM.zip 2>&1 | grep --line-buffered "%"
    mv menuARM.zip menu.zip
else
    wget --progress=dot https://dsnvps/script/dsnvps/menu.zip 2>&1 | grep --line-buffered "%"
fi

#Check menu.zip files

rm -rf /etc/dsnvps/.tmp/menu
unzip -q -o menu.zip -d /etc/dsnvps/.tmp
if [ ! -f /etc/dsnvps/.tmp/menu/dsnvps-tien-ich ]; then
rm -rf /etc/dsnvps/.tmp/menu
clear
echo "========================================================================="
echo "There's an error in changing language process"
echo "-------------------------------------------------------------------------"
echo "Vui lòng thử lại !"
dsnvps
exit
fi
## Finish check menu.zip
#wget -q https://dsnvps/script/dsnvps/motd$motdxxx -O /etc/motd
rm -rf /etc/dsnvps/.tmp/menu
unzip -q -o menu.zip
rm -rf /etc/dsnvps/menu.zip
cd
rm -rf /bin/dsnvps
cp /etc/dsnvps/menu/inc/mainmenu/dsnvps /bin/dsnvps
chmod +x /bin/dsnvps
find /etc/dsnvps/menu/inc -type f -exec chmod 755 {} \;
find /etc/dsnvps/menu/inc/setup -type f -exec chmod 755 {} \;
/etc/dsnvps/menu/inc/setup/set-permison-dsnvps-menu
clear 
echo "========================================================================= "
echo "Change Language of DSNVPS to Vietnamese Finished"
echo "-------------------------------------------------------------------------"
echo "( Thay đổi ngôn ngữ DSNVPS sang tiếng Việt thành công )"
dsnvps
       ;;
    *)
        echo ""
        ;;
esac
clear
clear
echo "========================================================================="
echo "Cancel !"
echo "-------------------------------------------------------------------------"
echo "Huỷ bỏ !"
dsnvps
exit
