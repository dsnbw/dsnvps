#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-websitelist
rm -rf /etc/dsnvps/.tmp/wordpresslist
cd /etc/nginx/conf.d
ls > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
cd
cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/wordpresslist
file1="/etc/dsnvps/.tmp/dsnvps-websitelist"
while read -r wpsite
    do
if [ -f /home/$wpsite/public_html/wp-config.php ]; then
echo "$wpsite" >> /etc/dsnvps/.tmp/wordpresslist
fi
 done < "$file1"
 if [ ! -f /etc/dsnvps/.tmp/wordpresslist ]; then
clear
echo "========================================================================="
 echo "DSNVPS không tìm thấy website chạy Wordpress Code trên Server."
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
 exit
 fi

echo "========================================================================="
echo "Sử dụng chức năng này để sao lưu database theo định dạng .sql.gz"

echo "========================================================================="
mapfile -t danh_sach_website < /etc/dsnvps/.tmp/wordpresslist
echo "========================================================================="
echo "Danh sách các website trên server:"
echo "-------------------------------------------------------------------------"
################################
total=${#danh_sach_website[@]}
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${danh_sach_website[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${danh_sach_website[right_index-1]}"      # Tên database bên phải
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
###############################################################

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r lua_chon
    
    # Kiem tra neu khong nhap gi hoac nhap khong hop le
    if [[ -z "$lua_chon" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$lua_chon" == "0" ]]; then
        clear
 /etc/dsnvps/menu/dsnvps-wordpress-tools-menu
        break
    elif [[ "$lua_chon" =~ ^[0-9]+$ ]] && (( lua_chon >= 1 && lua_chon <= ${#danh_sach_website[@]} )); then
        website=${danh_sach_website[lua_chon-1]}
        break  # Thoat vong lap neu lua chon hop le
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done

# Cac doan ma xac nhan phia duoi se tiep tuc chay

tendatabase=`cat /home/$website/public_html/wp-config.php | grep DB_NAME | cut -d \' -f 4`

if [ ! -f /var/lib/mysql/$tendatabase/db.opt ]; then
clear
echo "========================================================================="
echo "Không tìm thấy database: $tendatabase"
echo "-------------------------------------------------------------------------"
echo "trên VPS. DSNVPS không thể thực hiện chức năng này."
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
fi

if [ -f /home/$website/wp-config.php ] && grep -q "DB_NAME" /home/$website/wp-config.php; then
tendatabase=`cat /home/$website/wp-config.php | grep DB_NAME | cut -d \' -f 4`
else
tendatabase=`cat /home/$website/public_html/wp-config.php | grep DB_NAME | cut -d \' -f 4`
fi

echo "-------------------------------------------------------------------------"
echo "Tìm thấy $website trên hệ thống"; sleep 2
echo "-------------------------------------------------------------------------"
echo "$website sử dụng wordpress code"; sleep 2
echo "-------------------------------------------------------------------------"
echo "Database $website sử dụng: $tendatabase"; sleep 2
echo "-------------------------------------------------------------------------"
echo "Chuẩn bị sao lưu .... "; sleep 2

echo "-------------------------------------------------------------------------"
sleep 2

###################################################################
###################################################################
randomwp=`date |md5sum |cut -c '1-25'`
echo "`date '+%d%m%H'`" > /etc/dsnvps/.tmp/datetime
if [ ! -d /home/$website/public_html/0-DSNVPS ]; then
mkdir -p /home/$website/public_html/0-DSNVPS
fi
enginecheck=`grep "default_storage_engine =" /etc/my.cnf | grep MyISAM`
if [ -z "$enginecheck" ]; then
mysqldump -u root -p$mariadbpass $tendatabase --single-transaction | gzip -6 > $tendatabase-$randomwp-$(cat /etc/dsnvps/.tmp/datetime).sql.gz
else
mysqldump -u root -p$mariadbpass $tendatabase --lock-tables=false | gzip -6 > $tendatabase-$randomwp-$(cat /etc/dsnvps/.tmp/datetime).sql.gz
fi
mv $tendatabase-$randomwp-$(cat /etc/dsnvps/.tmp/datetime).sql.gz  /home/$website/public_html/0-DSNVPS 
cd
clear
if [ -f /home/$website/public_html/0-DSNVPS/$tendatabase-$randomwp-$(cat /etc/dsnvps/.tmp/datetime).sql.gz ]; then
rm -rf /etc/dsnvps/.tmp/test.ok
if [ ! -f /home/$website/public_html/0-DSNVPS/index.php ]; then
echo "" > /home/$website/public_html/0-DSNVPS/index.php 
fi
echo "========================================================================="
echo "Sao lưu $tendatabase thành công !"
echo "-------------------------------------------------------------------------"
echo "Link download backup:"
echo "-------------------------------------------------------------------------"
echo "http://$website/0-DSNVPS/$tendatabase-$randomwp-$(cat /etc/dsnvps/.tmp/datetime).sql.gz"
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
else
rm -rf /etc/dsnvps/.tmp/test.ok
echo "=========================================================================" 
echo "Sao lưu database thất bại"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy kiểm tra lại cấu hình database website"
echo "-------------------------------------------------------------------------"
echo "Bạn hãy dùng: [Sao Lưu 1 Database] trong [Sao Lưu & Phục Hồi Database] "
/etc/dsnvps/menu/dsnvps-wordpress-tools-menu
fi
