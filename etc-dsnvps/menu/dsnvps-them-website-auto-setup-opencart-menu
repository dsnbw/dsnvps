#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
####################################################
########## Check File check ban quyen. Khong hop le thi out
rm -rf /etc/dsnvps/.tmp/sllokie
mkdir -p /etc/dsnvps/.tmp && touch /etc/dsnvps/.tmp/sllokie && touch /etc/dsnvps/.tmp/ckla
if [ ! -f /etc/dsnvps/.tmp/sllokie ]; then
clear
echo "========================================================================="
echo "Vui lòng cập nhật DSNVPS lên phiên bản Pro để sử dụng chức năng này !"
dsnvps
fi
rm -rf /etc/dsnvps/.tmp/sllokie
############################################
################################################
php_version1=$(php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;")
if [ "$php_version1" == "7.0" ]; then
clear
echo "========================================================================="
echo "Ban dang su dung PHP 7.0"
echo "-------------------------------------------------------------------------"
echo "Hien tai Opencart chua ho tro PHP 7.0"
/etc/dsnvps/menu/dsnvps-them-website-menu
exit
fi
if [ "$php_version1" == "7.1" ]; then
clear
echo "========================================================================="
echo "Ban dang su dung PHP 7.1"
echo "-------------------------------------------------------------------------"
echo "Hien tai Opencart chua ho tro PHP 7.1"
/etc/dsnvps/menu/dsnvps-them-website-menu
exit
fi

prompt="Lựa chọn của bạn [0 -Thoát]: "
options=( "Opencart 2.2.0.0" "Opencart 2.1.0.2" "Opencart 2.1.0.1" "Opencart 2.0.3.1" "Opencart 2.0.2.0" "Opencart 2.0.0.0" "Opencart 1.5.6.4")
printf "=========================================================================\n"
printf "LUA CHON PHIEN BAN OPENCART BAN MUON CAI DAT\n"
printf "=========================================================================\n"
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) chooseversionopencart="2200"; break;;
    2) chooseversionopencart="2102"; break;;
    3) chooseversionopencart="2101"; break;;
	4) chooseversionopencart="2031"; break;;
	5) chooseversionopencart="2020"; break;;
	6) chooseversionopencart="2000"; break;;
	7) chooseversionopencart="1564"; break;;
    0) chooseversionopencart="cancle"; break;;
    *) echo "You typed wrong, Please type in the ordinal number on the list";continue;;
    esac  
done
###################################
#2200
###################################
if [ "$chooseversionopencart" = "2200" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2200
###################################
#2102
###################################
elif [ "$chooseversionopencart" = "2102" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2102
###################################
#2101
###################################
elif [ "$chooseversionopencart" = "2101" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2101
###################################
#2031
###################################
elif [ "$chooseversionopencart" = "2031" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2031
###################################
#2020
###################################
elif [ "$chooseversionopencart" = "2020" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2020
###################################
#2000
###################################
elif [ "$chooseversionopencart" = "2000" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-2000
###################################
#1654
###################################
elif [ "$chooseversionopencart" = "1564" ]; then
/etc/dsnvps/menu/dsnvps-them-website-va-opencart-1564
else
clear
exit 0
fi
