#!/bin/bash
. /etc/dsnvps/menu/inc/dsnvps-common.sh

ensure_zone_included() {
    if ! grep -q "fastcgi-cache-zone.conf" /etc/nginx/nginx.conf; then
        cp -a /etc/nginx/nginx.conf /etc/nginx/nginx.conf.bak.fcgi
        sed -i 's|include /etc/nginx/conf.d/\*.conf;|include /etc/nginx/conf/fastcgi-cache-zone.conf;\n    include /etc/nginx/conf.d/*.conf;|' /etc/nginx/nginx.conf
        if ! nginx -t >/dev/null 2>&1; then
            mv -f /etc/nginx/nginx.conf.bak.fcgi /etc/nginx/nginx.conf
            echo -e "${C_RED}[ERR] Không thể thêm fastcgi-cache-zone.conf vào nginx.conf!${C_RESET}"
            return 1
        fi
        rm -f /etc/nginx/nginx.conf.bak.fcgi
    fi
}

enable_fcgi_site() {
    local dom; dom="$(dsnvps_pick_domain all)" || return 0
    local vf="/etc/nginx/conf.d/${dom}.conf"
    ensure_zone_included || return 1
    if grep -q "fastcgi_cache DSNVPS_CACHE" "$vf"; then
        echo -e "${C_YELLOW}${dom} đã bật FastCGI Page Cache từ trước.${C_RESET}"
        return 0
    fi
    cp -a "$vf" "${vf}.bak.fcgi"
    # Inject skip_cache rules after server_name and fastcgi_cache directives inside php location
    sed -i "s|server_name .*;|& \n\tinclude /etc/nginx/conf/fastcgi-cache-rules.conf;|" "$vf"
    sed -i "s|fastcgi_pass 127.0.0.1:9000;|fastcgi_pass 127.0.0.1:9000;\n\t\tfastcgi_cache DSNVPS_CACHE;\n\t\tfastcgi_cache_valid 200 301 302 60m;\n\t\tfastcgi_cache_bypass \$skip_cache;\n\t\tfastcgi_no_cache \$skip_cache;\n\t\tadd_header X-FastCGI-Cache \$upstream_cache_status;|" "$vf"
    if nginx -t >/dev/null 2>&1; then
        systemctl reload nginx
        rm -f "${vf}.bak.fcgi"
        echo -e "${C_GREEN}[OK] Đã BẬT Nginx FastCGI Page Cache cho ${dom}.${C_RESET}"
    else
        mv -f "${vf}.bak.fcgi" "$vf"
        echo -e "${C_RED}[ERR] Lỗi cú pháp Nginx cho ${dom}, đã rollback an toàn!${C_RESET}"
    fi
}

disable_fcgi_site() {
    local dom; dom="$(dsnvps_pick_domain all)" || return 0
    local vf="/etc/nginx/conf.d/${dom}.conf"
    sed -i '/fastcgi-cache-rules\.conf/d; /fastcgi_cache DSNVPS_CACHE/d; /fastcgi_cache_valid/d; /fastcgi_cache_bypass/d; /fastcgi_no_cache/d; /X-FastCGI-Cache/d' "$vf"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    echo -e "${C_YELLOW}[OK] Đã TẮT Nginx FastCGI Page Cache cho ${dom}.${C_RESET}"
}

while true; do
    clear
    cache_size=$(du -sh /var/cache/nginx-fastcgi 2>/dev/null | awk '{print $1}')
    echo -e "${C_CYAN}=========================================================================${C_RESET}"
    echo -e "${C_YELLOW}       NGINX FASTCGI PAGE CACHE & PRELOAD CRAWLER (Cache: ${cache_size:-0})${C_RESET}"
    echo -e "${C_CYAN}=========================================================================${C_RESET}"
    echo " 1) BẬT Nginx FastCGI Page Cache cho Website"
    echo " 2) TẮT Nginx FastCGI Page Cache cho Website"
    echo " 3) Xóa toàn bộ FastCGI Page Cache (Purge All)"
    echo " 4) Preload Cache Website (Sitemap Warm-up Crawler)"
    echo " 0) Quay lại Menu chính"
    echo "========================================================================="
    read -r -p "Lựa chọn của bạn [0-4]: " ch
    case "$ch" in
        1) enable_fcgi_site; read -r -p "Nhấn [Enter]..." ;;
        2) disable_fcgi_site; read -r -p "Nhấn [Enter]..." ;;
        3)
            rm -rf /var/cache/nginx-fastcgi/*
            systemctl reload nginx
            echo -e "${C_GREEN}[OK] Đã xóa sạch Nginx FastCGI Page Cache!${C_RESET}"
            read -r -p "Nhấn [Enter]..."
            ;;
        4) /etc/dsnvps/menu/optimize/dsnvps-preload-cache; read -r -p "Nhấn [Enter]..." ;;
        0) clear; exit 0 ;;
        *) echo "Sai lựa chọn!"; sleep 1 ;;
    esac
done
