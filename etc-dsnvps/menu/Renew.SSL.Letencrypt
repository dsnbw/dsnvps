#!/bin/bash
. /root/dsnvps.conf
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/List_auto_renew_SSL
/root/.acme.sh/acme.sh --list | awk '{print $1}' FPAT='"[^"]+"'  | sed 's/Main_Domain//' > /etc/dsnvps/.tmp/List_auto_renew_SSL
if [ ! -f /etc/dsnvps/.tmp/List_auto_renew_SSL ]; then
exit
fi
domainlist=$(cat /etc/dsnvps/.tmp/List_auto_renew_SSL)
curTime=$(date +%s)
for domain in $domainlist; do
if [ -f /root/.acme.sh/$domain/$domain.conf ] && [ -f /etc/nginx/auth-acme/$domain/$domain.crt ]; then
thoigiangiahangiay=`cat /root/.acme.sh/$domain/$domain.conf | grep Le_NextRenewTime= | sed 's/[^0-9]*//g'`
hieuthoigianconlai=$(calc $thoigiangiahangiay-$curTime)
thoigiannengiahan=$(calc $hieuthoigianconlai/60/60/24)
thoigianconlai=$(calc $thoigiannengiahan+30)

if [ "$thoigianconlai" -lt 30 ]; then
/root/.acme.sh/acme.sh --renew -d $domain --force
fi
fi
done;


