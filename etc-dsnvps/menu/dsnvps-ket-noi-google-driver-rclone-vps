}

# Thực thi quy trình
validate_credentials
configure_rclone

# Dọn dẹp file tạm
rm -f "$TEMP_CONFIG_FILE" "$TEMP_AUTH_FILE"
/etc/dsnvps/menu/dsnvps-rclone-menu
