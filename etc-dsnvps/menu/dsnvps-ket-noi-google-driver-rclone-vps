#!/bin/bash
. /root/dsnvps.conf
# Anti-debug removed
if [ ! -f /bin/rclone ]; then
    clear
    echo "========================================================================="
    echo "Ban hay cai dat Rclone truoc khi chay chuc nang nay."
    /etc/dsnvps/menu/dsnvps-rclone-menu
    exit 1
fi


if [ -f /root/.config/rclone/rclone.conf ]; then
    rm -rf /etc/dsnvps/.tmp/checkrcclonedrvier
awk '/^\[gdrive\]/ {print}' /root/.config/rclone/rclone.conf > /etc/dsnvps/.tmp/checkrcclonedrvier
    checka=`cat /etc/dsnvps/.tmp/checkrcclonedrvier`
    wc -l < /etc/dsnvps/.tmp/checkrcclonedrvier > /etc/dsnvps/.tmp/checkrcclonedrvierline
    checkb=`cat /etc/dsnvps/.tmp/checkrcclonedrvierline`
    if [ "$checkb" -gt "0" ]; then
        clear
        echo "========================================================================="
        echo "Server đã kết nối với G-Drive. Hãy chạy [Cấu Hình Tự Động Sao Lưu] để "
        echo "-------------------------------------------------------------------------"
        echo "hoàn tất config. Hoặc [Xóa Tất Cả Cấu Hình] để kết nối lại !"
        /etc/dsnvps/menu/dsnvps-rclone-menu
        exit 0
    fi
fi

echo "========================================================================="
echo "========================================================================="
read -r -p "Bạn đã đọc xong hướng dẫn sử dụng chức năng này ? [y/N] " response
if [[ ! $response =~ ^(y|Y|yes|Yes)$ ]]; then
    clear
    echo "========================================================================="
    echo "Bạn chưa xác nhận. Thoát!"
    /etc/dsnvps/menu/dsnvps-rclone-menu
    exit 1
fi
echo "-------------------------------------------------------------------------"; sleep 0.1
echo "Bắt đầu cấu hình ..."; sleep 0.9
echo "-------------------------------------------------------------------------"; sleep 0.1
tput cuu 4 && tput ed

# Đường dẫn file cấu hình cho root
CONFIG_FILE="/root/.config/rclone/rclone.conf"
PORT=53682
TEMP_AUTH_FILE="/tmp/rclone_auth_$$.txt"
TEMP_CONFIG_FILE="/tmp/rclone_config_$$.txt"

# Kiểm tra và giải phóng port nếu bị chiếm dụng
if lsof -i :$PORT &>/dev/null; then
      #  echo "-------------------------------------------------------------------------"
    echo "Port $PORT đang được sử dụng. VPSIM đang giành lại Port :D ..."
    echo "-------------------------------------------------------------------------"
    fuser -k $PORT/tcp || { echo "Lỗi: Không thể giải phóng port $PORT."; exit 1; }
    sleep 3 && tput cuu 3 && tput ed
    sleep 1
fi
# Hàm kiểm tra cú pháp cơ bản
check_input() {
    local input="$1"
    local name="$2"
    if [[ -z "$input" ]]; then
        echo "-------------------------------------------------------------------------"
        echo "Lỗi: $name không được để trống!"
        sleep 3 && tput cuu 2 && tput ed
        return 1
    fi
    if [[ "$input" == "0" ]]; then
    
        echo "-------------------------------------------------------------------------"
        echo "Thoát ..."; sleep 2
        clear
        /etc/dsnvps/menu/dsnvps-rclone-menu
    fi
    # Chỉ cho phép a-z, A-Z, 0-9, dấu chấm và gạch ngang
    if ! echo "$input" | grep -qE '^[a-zA-Z0-9.-]+$'; then
        echo "-------------------------------------------------------------------------"
        echo "Lỗi: $name không đúng!"
        sleep 3 && tput cuu 2 && tput ed
        return 1
    fi
    if [[ "$name" == "client_id" ]]; then
        if [[ ! "$input" =~ ^[0-9]+-[a-zA-Z0-9.-]+\.apps\.googleusercontent\.com$ ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Lỗi: $name không đúng định dạng!"
            sleep 3 && tput cuu 2 && tput ed
            return 1
        fi
    fi
    if [[ "$name" == "client_secret" ]]; then
        if [[ ${#input} -lt 20 || ! "$input" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Lỗi: $name không đúng !"
            sleep 3 && tput cuu 2 && tput ed
            return 1
        fi
    fi
    return 0
}

# Nhập và kiểm tra client_id, client_secret
validate_credentials() {
    while true; do
        # Nhập client_id
        while true; do
            read -rp "Nhập client_id [0 -Thoát]: " CLIENT_ID
            CLIENT_ID="${CLIENT_ID//[[:space:]]/}"
            if check_input "$CLIENT_ID" "client_id"; then
                break
            fi
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng nhập lại client_id hợp lệ!"
            sleep 3 && tput cuu 3 && tput ed
        done
        echo "-------------------------------------------------------------------------"
        # Nhập client_secret
        while true; do
            read -rp "Nhập client_secret [0 -Thoát]: " CLIENT_SECRET
            CLIENT_SECRET=${CLIENT_SECRET// /}  # Loại bỏ hoàn toàn dấu cách
            if check_input "$CLIENT_SECRET" "client_secret"; then
                break
            fi
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng nhập lại client_secret hợp lệ!"
            sleep 3 && tput cuu 3 && tput ed
        done

        echo "-------------------------------------------------------------------------"
        echo "Đang kiểm tra khả năng sử dụng client_id và client_secret..."

        # Tạo remote tạm
        rclone config create gdrive_tmp drive client_id "$CLIENT_ID" client_secret "$CLIENT_SECRET" scope "drive" --non-interactive --config "$TEMP_CONFIG_FILE" > "$TEMP_AUTH_FILE" 2>&1

        # Thử chạy authorize để lấy URL
        timeout 10 rclone authorize "drive" --config "$TEMP_CONFIG_FILE" >> "$TEMP_AUTH_FILE" 2>&1 &
        sleep 3 && tput cuu 2 && tput ed

        # Trích xuất URL
        URL=$(grep -o 'http://127.0.0.1:[0-9]*/auth?state=[^ ]*' "$TEMP_AUTH_FILE")

        if [[ -n "$URL" ]]; then
                echo "-------------------------------------------------------------------------"
            echo "Client ID và Client Secret có thể sử dụng!"
            sleep 3 && tput cuu 2 && tput ed
            rclone config delete gdrive_tmp --config "$TEMP_CONFIG_FILE" &>/dev/null
            pkill -f "rclone authorize" &>/dev/null
            rm -f "$TEMP_CONFIG_FILE" "$TEMP_AUTH_FILE"
            break
        else
            clear
            echo "========================================================================="
            echo "Lỗi: Không thể khởi tạo xác thực với client_id và client_secret!"
           echo "-------------------------------------------------------------------------"
            echo "Vui lòng nhập lại!"
            rm -f "$TEMP_CONFIG_FILE" "$TEMP_AUTH_FILE"
        fi
    done
}
if [ -f /etc/ssh/sshd_config ]; then
if grep -q "#Port 22" /etc/ssh/sshd_config; then
portcu=$(cat /etc/ssh/sshd_config | grep Port | awk 'END {print $2}')
if [[ ! ${portcu} =~ ^[0-9]+$ ]] ;then
portsshvps=22
else
portsshvps=$portcu
fi
fi
fi
ip_local=$(ip route get 1.1.1.1 | awk '{print $7}' | head -n1)
if [[ "$ip_local" == "$serverip" ]]; then
    localcheck=0
else
    localcheck=1
fi

