/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
;;
esac
clear
echo "========================================================================="
echo "Ban da cancle thay doi mat khau user root!"
/etc/dsnvps/menu/dsnvps-bao-mat-server-website-menu
