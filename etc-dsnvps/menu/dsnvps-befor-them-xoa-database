#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -d /home/$mainsite/private_html/backup/AllDB ]; then
mkdir -p /home/$mainsite/private_html/backup/AllDB
fi
if [ ! -f /root/DBinfo.txt ]; then
echo "========================================================================="  > /root/DBinfo.txt
echo "Thông tin database TREN VPS"  >> /root/DBinfo.txt
echo "========================================================================="  >> /root/DBinfo.txt
echo "" >> /root/DBinfo.txt
echo "" >> /root/DBinfo.txt
fi

chown -R nginx:nginx /var/lib/php/session/
if [ -f /home/$mainsite/logs/mysql.log ]; then
chown -R mysql:mysql /home/$mainsite/logs/mysql.log
else
touch /home/$mainsite/logs/mysql.log
chown -R mysql:mysql /home/$mainsite/logs/mysql.log
fi
if [ -f /home/$mainsite/logs/mysql-slow.log ]; then
chown -R mysql:mysql /home/$mainsite/logs/mysql-slow.log
else
touch /home/$mainsite/logs/mysql-slow.log
chown -R mysql:mysql /home/$mainsite/logs/mysql-slow.log
fi
if [ -f /var/log/mysqld.log ]; then
chown -R mysql:mysql /var/log/mysqld.log
else
touch /var/log/mysqld.log
chown -R mysql:mysql /var/log/mysqld.log
fi

if [ -f /var/lib/mysql/dsnvpsCheckDB/db.opt ]; then
rm -rf /var/lib/mysql/dsnvpsCheckDB
fi
 cat > "/etc/dsnvps/.tmp/config.temp" <<END
CREATE DATABASE dsnvpsCheckDB COLLATE utf8mb4_unicode_ci;
END
mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
rm -f /etc/dsnvps/.tmp/config.temp

if [ ! -f /var/lib/mysql/dsnvpsCheckDB/db.opt ]; then
clear
echo "========================================================================"
echo "Dịch vụ MySQL đang dừng"
echo "------------------------------------------------------------------------"
echo "DSNVPS đang cố gắng khởi động nó"
echo "------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 5
#rm -rf /var/lib/mysql/ib_logfile*
/etc/dsnvps/menu/inc/start-mysql-fix-error
clear
echo "========================================================================"
echo "Kiểm tra lại dịch vụ MySQL!"
echo "------------------------------------------------------------------------"
echo "Vui lòng chờ ..."
sleep 5
cat > "/etc/dsnvps/.tmp/config.temp" <<END
CREATE DATABASE dsnvpsCheckDB COLLATE utf8mb4_unicode_ci;
END
mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
rm -f /etc/dsnvps/.tmp/config.temp
	if [ ! -f /var/lib/mysql/dsnvpsCheckDB/db.opt ]; then
	clear
	echo "========================================================================="
	echo "Xin lỗi, dịch vụ MySQL đang dừng. DSNVPS không thể bật MySQL lên được!"
	dsnvps
	else
	rm -rf /var/lib/mysql/dsnvpsCheckDB
	clear
	/etc/dsnvps/menu/dsnvps-them-xoa-database
	fi
else
rm -rf /var/lib/mysql/dsnvpsCheckDB
clear
/etc/dsnvps/menu/dsnvps-them-xoa-database
fi
