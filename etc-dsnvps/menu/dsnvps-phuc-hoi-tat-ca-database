echo "-------------------------------------------------------------------------"
echo "File Backup hop le."; sleep 4
echo "-------------------------------------------------------------------------"
echo "Chuẩn bị phục hồi Database tu file Backup ..."; sleep 2
####################################################################
##Check Ban Pro
####################################################################
if [ ! -f /usr/bin/gxred ]; then
touch /etc/dsnvps/.tmp/ckla
/etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
clear
/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
fi
###################################################################
###################################################################
cd /etc/dsnvps/.tmp/alldbdsnvps
gunzip < AllDB2.sql.gz  | mysql -u root -p$mariadbpass
cd
mv /home/AllDB.sql.gz /home/AllDB.sql.gz.Done.gz
echo "-------------------------------------------------------------------------"
echo "Phục hồi xong. DSNVPS sẽ kiểm tra kết quả phục hồi ..."; sleep 3

databaseold=$(cat /etc/dsnvps/.tmp/alldbdsnvps/listdata.txt )
for data in $databaseold 
do
if [ ! -f /var/lib/mysql/$data/db.opt ]; then
clear
echo "========================================================================="
echo "Phục hồi Full Database thất bại."
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể phục hồi database từ file backup được."
/etc/dsnvps/menu/dsnvps-sao-lưu-phục-hồi-tất-cả-database-menu
else
echo "-------------------------------------------------------------------------"
echo "Kiểm tra database: $data => Done !"; sleep 2

fi
 done
rm -rf /etc/dsnvps/.tmp/alldbdsnvps
rm -rf /etc/dsnvps/.tmp/listdatasauphuchoi.txt
ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/listdatasauphuchoi.txt

if [ "$vpsmoi" == "1" ]; then
echo "========================================================================="
echo "Bắt đầu tạo user và password cho các database:"; sleep 5

danhsachdatabasetaouser=$(cat /etc/dsnvps/.tmp/listdatasauphuchoi.txt )
for dataaz in $danhsachdatabasetaouser 
do
if [ ! -f /var/lib/mysql/dataaz/db.opt ]; then
if [ -f /root/DBinfo.txt ]; then
rm -rf /etc/dsnvps/.tmp/creckdb.txt
rm -rf /etc/dsnvps/.tmp/datanamecheckx
grep "Data name: ${dataaz}" /root/DBinfo.txt > /etc/dsnvps/.tmp/creckdb.txt
if [ -f /etc/dsnvps/.tmp/creckdb.txt ]; then
checknumber=$(cat /etc/dsnvps/.tmp/creckdb.txt | wc -l)
if [ "$checknumber" == "2" ]; then
 cat > "/etc/dsnvps/.tmp/datanamecheckx" <<END
sed -i '0,/Data name:\ ${dataaz}/{/Data name:\ ${dataaz}/d}' /root/DBinfo.txt
END
sh /etc/dsnvps/.tmp/datanamecheckx
fi

if [ "$checknumber" == "3" ]; then
 cat > "/etc/dsnvps/.tmp/datanamecheckx" <<END
sed -i '0,/Data name:\ ${dataaz}/{/Data name:\ ${dataaz}/d}' /root/DBinfo.txt
END
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
fi
if [ "$checknumber" == "4" ]; then
 cat > "/etc/dsnvps/.tmp/datanamecheckx" <<END
sed -i '0,/Data name:\ ${dataaz}/{/Data name:\ ${dataaz}/d}' /root/DBinfo.txt
END
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
fi
if [ "$checknumber" == "5" ]; then
 cat > "/etc/dsnvps/.tmp/datanamecheckx" <<END
sed -i '0,/Data name:\ ${dataaz}/{/Data name:\ ${dataaz}/d}' /root/DBinfo.txt
END
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
fi
if [ "$checknumber" == "6" ]; then
 cat > "/etc/dsnvps/.tmp/datanamecheckx" <<END
sed -i '0,/Data name:\ ${dataaz}/{/Data name:\ ${dataaz}/d}' /root/DBinfo.txt
END
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
sh /etc/dsnvps/.tmp/datanamecheckx
fi
fi
fi

password=`date +%s|md5sum |cut -c '1-16'`
hauuser=`date +%s|md5sum |cut -c '1-3'`
tienuser=`echo $dataaz | tr '[A-Z]' '[a-z]' | sed "s/\_//" | sed "s/\_//" | sed "s/\_//" | sed "s/\_//" | cut -c1-11`
username=$tienuser$hauuser
echo "========================================================================="
echo "Tạo User cho database $dataaz:"; sleep 5

echo "-------------------------------------------------------------------------"
rm -rf /etc/dsnvps/.tmp/config.temp
cat > "/etc/dsnvps/.tmp/config.temp" <<END
CREATE USER '$username'@'localhost' IDENTIFIED BY '$password';
END
	mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
	rm -rf /etc/dsnvps/.tmp/config.temp
    cat > "/etc/dsnvps/.tmp/config.temp" <<END
GRANT ALL PRIVILEGES ON $dataaz . * TO '$username'@'localhost';
END
	mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
	rm -rf /etc/dsnvps/.tmp/config.temp
    cat > "/etc/dsnvps/.tmp/config.temp" <<END
FLUSH PRIVILEGES;
END
	mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
	rm -rf /etc/dsnvps/.tmp/config.temp
	
echo "User: $username"; sleep 2
echo "-------------------------------------------------------------------------"
echo "Password: $password" ; sleep 2
echo "=========================================================================" >> /root/DBinfo.txt
echo "Database: $dataaz - Duoc tao vao: $(date +%d/%m/%Y)" >> /root/DBinfo.txt
echo "=========================================================================" >> /root/DBinfo.txt
echo "Tên database: $dataaz" >> /root/DBinfo.txt
echo "Username: $username" >> /root/DBinfo.txt
echo "password: $password" >> /root/DBinfo.txt
echo "" >> /root/DBinfo.txt
fi
 done
fi
clear
echo "========================================================================="
echo "Phục hồi Full database đã hoàn thành !"
echo "-------------------------------------------------------------------------"
echo "Danh sách database đã phục hồi:"
echo "-------------------------------------------------------------------------"
cat /etc/dsnvps/.tmp/listdatasauphuchoi.txt | pr -2 -t
rm -rf /etc/dsnvps/.tmp/listdatasauphuchoi.txt 
if [ "$vpsmoi" == "1" ]; then
echo "========================================================================="
echo "Xem thông tin user và password các database: "
echo "-------------------------------------------------------------------------"
echo "DSNVPS Menu => Quản Lý & Kiểm Tra Database => Xem User & Password Của Database"
fi
/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
       ;;
    *)
    clear
    echo "========================================================================="
echo "Hủy bỏ  !"
/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
        ;;
esac

