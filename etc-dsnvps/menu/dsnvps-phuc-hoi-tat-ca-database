echo "Tìm thấy AllDB.sql.gz"
echo "========================================================================="
read -r -p "Bạn chắc chắn phục hồi tất cả database từ file backup này? [y/N] " response

case $response in
    [yY][eE][sS]|[yY]) 
echo "-------------------------------------------------------------------------"
echo -n "Nhập [ OK ] để xác nhận: " 
read xacnhan
if [ "$xacnhan" != "OK" ]; then
clear
echo "========================================================================="
echo "Bạn nhập không chính xác!"
echo "-------------------------------------------------------------------------"
echo "Hãy chạy lại chức năng này."

/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/listdatacheck.txt
ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|sys|dsnvpsCheckDB|dsnvpscheckauto)" > /etc/dsnvps/.tmp/listdatacheck.txt
if [ -f /etc/dsnvps/.tmp/listdatacheck.txt ]; then
linecheck=`cat /etc/dsnvps/.tmp/listdatacheck.txt | wc -l`
if [ "$linecheck" == "0" ]; then
vpsmoi=1
fi
fi
echo "-------------------------------------------------------------------------"
echo "DSNVPS sẽ kiểm tra file backup này."; sleep 2
echo "-------------------------------------------------------------------------"
echo "Nếu hợp lệ, quá trình phục hồi sẽ bắt đầu."; sleep 2
echo "-------------------------------------------------------------------------"
echo "Bắt đầu kiểm tra ..."; sleep 3
echo "-------------------------------------------------------------------------"

echo "Vui lòng chờ ..."; sleep 2
rm -rf /etc/dsnvps/.tmp/alldbdsnvps
mv /home/AllDB.sql.gz /home/AllDB.sql.gz.zip
unzip -q /home/AllDB.sql.gz.zip -d /etc/dsnvps/.tmp
mv /home/AllDB.sql.gz.zip /home/AllDB.sql.gz
if [ ! -f /etc/dsnvps/.tmp/alldbdsnvps/readme.txt ]; then 
rm -rf /etc/dsnvps/.tmp/alldbdsnvps
mv /home/AllDB.sql.gz /home/AllDB.sql.gz.WRONG
clear
echo "-------------------------------------------------------------------------"
echo "File AllDB.sql.gz có vấn đề ..."; sleep 3
clear
echo "========================================================================="
echo "Đây không phải là file AllDB.sql.gz nguyên gốc do DSNVPS tạo ra."
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể chạy chức năng này."

/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
fi

if [ ! -f /etc/dsnvps/.tmp/alldbdsnvps/AllDB2.sql.gz ]; then 
rm -rf /etc/dsnvps/.tmp/alldbdsnvps
mv /home/AllDB.sql.gz /home/AllDB.sql.gz.WRONG
clear
echo "-------------------------------------------------------------------------"
echo "File AllDB.sql.gz có vấn đề ..."; sleep 3
clear
echo "========================================================================="
echo "Đây không phải là file AllDB.sql.gz nguyên gốc do DSNVPS tạo ra."
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể chạy chức năng này."

/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
fi
if [ ! -f /etc/dsnvps/.tmp/alldbdsnvps/listdata.txt ]; then 
rm -rf /etc/dsnvps/.tmp/alldbdsnvps
mv /home/AllDB.sql.gz /home/AllDB.sql.gz.WRONG.gz
clear
echo "-------------------------------------------------------------------------"
echo "File AllDB.sql.gz có vấn đề ..."; sleep 3
clear
echo "========================================================================="
echo "Đây không phải là file AllDB.sql.gz nguyên gốc do DSNVPS tạo ra."
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể chạy chức năng này."

/etc/dsnvps/menu/dsnvps-sao-luu-phuc-hoi-tat-ca-database-menu
fi

