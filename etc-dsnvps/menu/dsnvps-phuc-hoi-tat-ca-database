echo "-------------------------------------------------------------------------"
read -p "Hãy upload [ AllDB.sql.gz ] vào /home rồi nhấn [ Enter ] để phục hồi."

fi

if [ ! -f /home/AllDB.sql.gz ]; then 
echo "-------------------------------------------------------------------------"
echo "Không tìm thấy file AllDB.sql.gz ..."; sleep 3
clear
