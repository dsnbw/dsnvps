PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) chooseaction="backuptatca"; break;;
    2) chooseaction="backupmoifilebackup"; break;;
    0) chooseaction="cancle"; break;;
*) echo "Bạn nhập sai! Bạn vui lòng chọn số trong danh sách"; continue;;
    esac  
done
###################################
#backuptatca
###################################
if [ "$chooseaction" = "backuptatca" ]; then
