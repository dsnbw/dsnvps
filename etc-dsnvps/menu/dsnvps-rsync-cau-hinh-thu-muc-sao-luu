    #*) echo "You typed wrong, Please type in the ordinal number on the list";continue;;
    esac  
done

###################################
#1 tieng 1 lan
###################################
if [ "$timersync" = "aaaa" ]; then
timesync=`echo "1 tieng 1 lan"`
###################################
#1 ngay 1 lan
###################################
elif [ "$timersync" = "bbbb" ]; then
timesync=`echo "1 Ngày 1 Lần"`
###################################
#1 tuan 1 lan
###################################
elif [ "$timersync" = "cccc" ]; then
timesync=`echo "2 Ngày 1 Lần"`
###################################
#2 tuan 1 lan
###################################
elif [ "$timersync" = "dddd" ]; then
timesync=`echo "3 Ngày 1 Lần"`
else
clear
/etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
###################################
fi

echo "-------------------------------------------------------------------------"
read -r -p "Bạn muốn DSNVPS Backup Data tới VPS Backup $timesync? [y/N] " response
#read -r -p "You want DSNVPS sync data to vps backup every $phut minutes  ? [y/N] " response
case $response in
    [yY][eE][sS]|[yY]) 
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."
    sleep 2
if [ "$thietlapsaoluu" == "0" ]; then
make_script_backup
else
make_script_backup_backup_folder_only
fi

if [ "$timersync" = "aaa" ]; then
    echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.rsync.cron
    echo "0 * * * * root /etc/dsnvps/Auto_backup_VPS_by_rsync >/dev/null 2>&1" >> /etc/cron.d/dsnvps.rsync.cron
elif [ "$timersync" = "bbbb" ]; then
    echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.rsync.cron
    echo "0 3 * * * root /etc/dsnvps/Auto_backup_VPS_by_rsync >/dev/null 2>&1" >> /etc/cron.d/dsnvps.rsync.cron
elif [ "$timersync" = "cccc" ]; then
    echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.rsync.cron
    echo "0 3 */2 * * root /etc/dsnvps/Auto_backup_VPS_by_rsync >/dev/null 2>&1" >> /etc/cron.d/dsnvps.rsync.cron
else
    echo "SHELL=/bin/sh" > /etc/cron.d/dsnvps.rsync.cron
    echo "0 3 */3 * * root /etc/dsnvps/Auto_backup_VPS_by_rsync >/dev/null 2>&1" >> /etc/cron.d/dsnvps.rsync.cron
