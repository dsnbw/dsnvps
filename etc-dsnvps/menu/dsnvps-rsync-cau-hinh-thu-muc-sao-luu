#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -f /etc/dsnvps/vps_backup_rsync.info ]; then
clear
echo "========================================================================="
echo "Server hiện tại chưa được kết nối với VPS backup"
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng kết nối với VPS backup trước khi thực hiện thao tác này."
/etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
exit
fi
if [ -f /etc/dsnvps/Auto_backup_VPS_by_rsync ]; then
	if [ ! -f /etc/cron.d/dsnvps.rsync.cron ]; then
	rm -rf /etc/dsnvps/Auto_backup_VPS_by_rsync
	fi
fi
if [ -f /etc/cron.d/dsnvps.rsync.cron ]; then
	if [ ! -f /etc/dsnvps/Auto_backup_VPS_by_rsync ]; then
	rm -rf /etc/cron.d/dsnvps.rsync.cron
	fi
fi
rm -rf /etc/dsnvps/.tmp/loa
if [ -f /etc/dsnvps/Auto_backup_VPS_by_rsync ]; then
echo "========================================================================="
echo "VPS đã được cấu [Cấu Hình Thời Gian Đồng Bộ]"
echo "-------------------------------------------------------------------------"
read -r -p "Bạn muốn cấu hình lại thời gian auto backup? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
echo "-------------------------------------------------------------------------"
echo "Ok ! Vui lòng chờ ..."; sleep 2
echo "" > /etc/dsnvps/.tmp/loa
else
clear
echo "========================================================================="
echo "Hủy bỏ."
/etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
fi
fi
ipvpsbackup=$(grep "ipaddress" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')
sshport=$(grep "sshport" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')

echo "-------------------------------------------------------------------------"
echo "Kiểm tra kết nối tới VPS Backup ... "
checkconnect=$(ssh -p $sshport -o BatchMode=yes -o ConnectTimeout=9 root@$ipvpsbackup echo connected 2>&1)
if [[ ! $checkconnect == connected ]] ; then
clear
echo "========================================================================="
echo "Kết nối tới VPS Backup thất bại"
echo "-------------------------------------------------------------------------"
echo "DSNVPS không thể thực hiện chức năng này"
/etc/dsnvps/menu/dsnvps-rsync-backup-vps-menu
exit
fi
echo "-------------------------------------------------------------------------"
echo "Kết nối => OK."
if [ -f /etc/dsnvps/.tmp/loa ]; then
        sleep 4  
        tput cuu 10 
        tput ed
else
        sleep 4  
        tput cuu 4 
        tput ed
fi

make_script_backup() {
    rm -rf /etc/dsnvps/Auto_backup_VPS_by_rsync
    ipvpsbackup=$(grep "ipaddress" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')
    sshport=$(grep "sshport" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')

    cat > "/etc/dsnvps/Auto_backup_VPS_by_rsync" <<EOF
#!/bin/bash
ssh -p $sshport root@$ipvpsbackup mkdir -p /home/VPS-$serverip 
ssh -p $sshport root@$ipvpsbackup mkdir -p /home/VPS-$serverip/etc

if [ "\$(grep "Createfolder" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}')" == "" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Cai dat rsync and wget cho VPS Backup "
    echo "-------------------------------------------------------------------------"
    ssh -p $sshport root@$ipvpsbackup apt-get -y -q install rsync wget tar zip unzip
    ssh -p $sshport root@$ipvpsbackup yum -y -q install rsync wget tar zip unzip
    echo "Createfolder = thanhcong" >> /etc/dsnvps/vps_backup_rsync.info
fi

echo "Thoi gian thuc hien backup gan nhat: \$(date +%T/%d/%m/%Y)" > /home/00-Time-Backup.txt

# Backup toan bo /home, loai tru cac thu muc khong can thiet, va xoa file da xoa tren VPS chinh
rsync -avz -e "ssh -p $sshport" --delete --exclude={cache,.cache,dsnvps.conf} /home/ root@$ipvpsbackup:/home/VPS-$serverip/home/

# Backup cac file cau hinh va xoa file da xoa tren VPS chinh
rsync -avz -e "ssh -p $sshport" --delete /etc/nginx/ root@$ipvpsbackup:/home/VPS-$serverip/etc/nginx/
rsync -avz -e "ssh -p $sshport" --delete /etc/my.cnf root@$ipvpsbackup:/home/VPS-$serverip/etc/my.cnf
rsync -avz -e "ssh -p $sshport" --delete /etc/php-fpm.d/ root@$ipvpsbackup:/home/VPS-$serverip/etc/php-fpm.d/

EOF

    chmod +x /etc/dsnvps/Auto_backup_VPS_by_rsync
}


make_script_backup_backup_folder_only() {
    rm -rf /etc/dsnvps/Auto_backup_VPS_by_rsync
    ipvpsbackup=$(grep "ipaddress" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')
    sshport=$(grep "sshport" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}' | tr -d ' ')
    cat > "/etc/dsnvps/Auto_backup_VPS_by_rsync" <<EOF
#!/bin/bash
. /root/dsnvps.conf
ssh -p $sshport root@$ipvpsbackup mkdir -p /home/VPS-$serverip 
ssh -p $sshport root@$ipvpsbackup mkdir -p /home/VPS-$serverip/etc

if [ "\$(grep "Createfolder" /etc/dsnvps/vps_backup_rsync.info | awk '{print $3}')" == "" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Cai dat rsync and wget cho VPS Backup "
    echo "-------------------------------------------------------------------------"
    ssh -p $sshport root@$ipvpsbackup apt-get -y -q install rsync wget tar zip unzip
    ssh -p $sshport root@$ipvpsbackup yum -y -q install rsync wget tar zip unzip
    echo "Createfolder = thanhcong" >> /etc/dsnvps/vps_backup_rsync.info
fi

echo "Thoi gian thuc hien backup gan nhat: \$(date +%T/%d/%m/%Y)" > /home/dsnvps.demo/private_html/backup/00-Time-Backup.txt

rsync -avz -e "ssh -p $sshport" /home/$mainsite/private_html/backup/ root@$ipvpsbackup:/home/VPS-$serverip/Backup-Files/
rsync -avz -e "ssh -p $sshport" /etc/nginx/ root@$ipvpsbackup:/home/VPS-$serverip/etc/nginx/
rsync -avz -e "ssh -p $sshport" /etc/my.cnf root@$ipvpsbackup:/home/VPS-$serverip/etc/my.cnf
rsync -avz -e "ssh -p $sshport" /etc/php-fpm.d/ root@$ipvpsbackup:/home/VPS-$serverip/etc/php-fpm.d/

# Xoa file backup cu hon $backup_days ngay trong thu muc Backup-Files
ssh -p $sshport root@$ipvpsbackup 'find /home/VPS-$serverip/Backup-Files/ -type f -mtime +'"$backup_days"' -exec rm -f {} \;'
EOF

    chmod +x /etc/dsnvps/Auto_backup_VPS_by_rsync
}



########################## Lua Chon Backup ALl Hoac File backup Only
###############################################################################
