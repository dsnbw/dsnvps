<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DSNVPS's Server Manage Page</title>
    <style>
        #top-frame {
            height: 100px;
            display: flex;
            justify-content: space-around;
            align-items: center;
            background-color: #f3f3f3;
            border-bottom: 1px solid #ddd;
        }

        button {
            padding: 10px 20px;
            font-size: 14px;
            color: white;
            background-color: #cc0000; /* mặc định đỏ */
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #b30000;
        }

        /* Custom button colors */
        .btn-blue {
            background-color: #007bff;
        }
        .btn-blue:hover {
            background-color: #0056b3;
        }

        .btn-green {
            background-color: #28a745;
        }
        .btn-green:hover {
            background-color: #1e7e34;
        }

        .btn-purple {
            background-color: #6f42c1;
        }
        .btn-purple:hover {
            background-color: #5936a2;
        }

        .btn-orange {
            background-color: #fd7e14;
        }
        .btn-orange:hover {
            background-color: #e36c0a;
        }

        .btn-gray {
            background-color: #6c757d;
        }
        .btn-gray:hover {
            background-color: #5a6268;
        }

        .btn-black {
            background-color: #000000;
        }
        .btn-black:hover {
            background-color: #333333;
        }

        #bottom-frame {
            width: 100%;
            height: calc(100vh - 100px);
            border: none;
        }
    </style>
</head>
<body>
    <div id="top-frame">
        <button class="btn-blue" onclick="loadInFrame('/vsupload')">File Manager</button>
        <button onclick="openInNewTab('/phpmyadmin/index.php')">phpMyAdmin</button>
        <button onclick="openInNewTab('/status/adminer.php')">Adminer (MySQL)</button>
        <button onclick="loadInFrame('/myoosdumper/index.php')">Myoosdumper (MySQL)</button>
        <button class="btn-green" onclick="loadInFrame('/status/ocp.php')">Quản Lý Zend Opcache</button>
        <button class="btn-purple" onclick="loadInFrame('/phpsysinfo')">phpSysInfo</button>
        <button class="btn-orange" onclick="loadInFrame('/status/status.php')">Server Status</button>
        <button class="btn-gray" onclick="loadInFrame('/status/php_info.php')">PHP Info</button>
        <button class="btn-black" onclick="openInNewTab('https://dsnvps')">DSNVPS Tiếng Việt</button>
        <button class="btn-black" onclick="openInNewTab('https://dsnvps')">DSNVPS English</button>
    </div>

    <iframe id="bottom-frame" src="/phpsysinfo"></iframe>

    <script>
        function openInNewTab(url) {
            window.open(url, '_blank');
        }

        function loadInFrame(url) {
            document.getElementById('bottom-frame').src = url;
        }
    </script>
</body>
</html>
