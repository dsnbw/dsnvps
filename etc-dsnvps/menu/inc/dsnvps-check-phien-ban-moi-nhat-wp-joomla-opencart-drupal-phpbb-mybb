###### Cập nhật list check tên miền cấp 1
# Cập nhật public_suffix_list.dat (chỉ chạy 1 lần/tuần)
update_public_suffix() {
    local TARGET_FILE="/etc/dsnvps/public_suffix_list.dat"
    local TEMP_FILE="/tmp/public_suffix_list.dat"
    local CHECK_FILE="/tmp/public_suffix_last_update"
    local DOWNLOAD_URL="https://publicsuffix.org/list/public_suffix_list.dat"
    
    # Kiểm tra thời gian cập nhật cuối (1 tuần = 604800 giây)
    local current_time=$(date +%s)
    local last_update=0
    if [ -f "$CHECK_FILE" ]; then
        last_update=$(cat "$CHECK_FILE" 2>/dev/null || echo "0")
    fi
    
    # Nếu chưa đến 1 tuần thì bỏ qua
    if [ $((current_time - last_update)) -lt 604800 ]; then
        return 0
    fi
    
    # Tạo thư mục nếu chưa có
    [ ! -d "$(dirname "$TARGET_FILE")" ] && mkdir -p "$(dirname "$TARGET_FILE")" 2>/dev/null
    
    # Tải file về thư mục tạm
    if wget -q -O "$TEMP_FILE" "$DOWNLOAD_URL" 2>/dev/null; then
        local temp_size=$(stat -c%s "$TEMP_FILE" 2>/dev/null || stat -f%z "$TEMP_FILE" 2>/dev/null || echo "0")
        local target_size=$(stat -c%s "$TARGET_FILE" 2>/dev/null || stat -f%z "$TARGET_FILE" 2>/dev/null || echo "0")
        
        # Nếu file tạm hợp lệ và (file đích chưa có hoặc kích thước khác)
        if [ "$temp_size" -gt 0 ] && ([ "$target_size" -eq 0 ] || [ "$temp_size" -ne "$target_size" ]); then
            cp "$TEMP_FILE" "$TARGET_FILE" 2>/dev/null
        fi
        
        # Cập nhật thời gian check
        echo "$current_time" > "$CHECK_FILE" 2>/dev/null
        
        # Dọn dẹp file tạm
        rm -f "$TEMP_FILE" 2>/dev/null
    fi
}

# Gọi hàm
update_public_suffix
