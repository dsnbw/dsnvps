# Tối ưu Brotli
##########

#!/bin/bash

# Tối ưu Brotli
BROTLI_CONF="/etc/nginx/conf/brotli.conf"
BACKUP_CONF="/tmp/brotli.conf.bak"

# Kiểm tra file cấu hình Brotli có tồn tại không
if [ ! -f "$BROTLI_CONF" ]; then
   echo "" # echo "File cấu hình Brotli ($BROTLI_CONF) không tồn tại, thoát."
    #exit 1
fi

# Lấy thông tin RAM và CPU nếu chưa được định nghĩa
if [ -z "$TOTAL_RAM" ]; then
    TOTAL_RAM=$(free -m | awk '/^Mem:/{print $2}')  # RAM tổng trong MB
fi
if [ -z "$CPU_CORES" ]; then
    CPU_CORES=$(nproc)  # Số lõi CPU
fi

# Sao lưu cấu hình trước khi chỉnh sửa
if ! cp "$BROTLI_CONF" "$BACKUP_CONF"; then
  echo ""   echo "Không thể sao lưu $BROTLI_CONF, thoát."
    exit 1
fi

# Điều chỉnh cấp độ nén theo RAM
if [ "$TOTAL_RAM" -ge 32000 ]; then
    BROTLI_COMP_LEVEL=11
elif [ "$TOTAL_RAM" -ge 16000 ]; then
    BROTLI_COMP_LEVEL=10
elif [ "$TOTAL_RAM" -ge 8000 ]; then
    BROTLI_COMP_LEVEL=8
elif [ "$TOTAL_RAM" -ge 4000 ]; then
    BROTLI_COMP_LEVEL=6
elif [ "$TOTAL_RAM" -ge 2000 ]; then
    BROTLI_COMP_LEVEL=4
else
    BROTLI_COMP_LEVEL=3
fi

# Nếu CPU thấp hơn RAM, hạ mức nén để tránh tải cao
case "$CPU_CORES" in
    6|7) [ "$BROTLI_COMP_LEVEL" -gt 8 ] && BROTLI_COMP_LEVEL=8 ;;
    4|5) [ "$BROTLI_COMP_LEVEL" -gt 6 ] && BROTLI_COMP_LEVEL=6 ;;
    3) [ "$BROTLI_COMP_LEVEL" -gt 4 ] && BROTLI_COMP_LEVEL=4 ;;
    2) [ "$BROTLI_COMP_LEVEL" -gt 3 ] && BROTLI_COMP_LEVEL=3 ;;
    1) BROTLI_COMP_LEVEL=2 ;;
    *) : ;;  # Không thay đổi nếu CPU >= 8
esac

# Cập nhật file cấu hình Brotli (chỉ thay đổi giá trị, không dùng ">>")
sed -i "s|^\s*brotli_comp_level\s*[0-9]\+;|brotli_comp_level $BROTLI_COMP_LEVEL;|" "$BROTLI_CONF"

# Kiểm tra và reload Nginx
if nginx -t &>/dev/null; then
    if ! systemctl reload nginx 2>/dev/null && ! nginx -s reload 2>/dev/null; then
       echo ""  #echo "Không thể reload Nginx, kiểm tra dịch vụ."
        #exit 1
    else
       echo "" # echo "Cấu hình Brotli đã được cập nhật và Nginx reload thành công."
    fi
else
echo ""
    #echo "Cấu hình Nginx lỗi, khôi phục bản sao lưu."
    cp "$BACKUP_CONF" "$BROTLI_CONF"
   # exit 1
fi






