#!/bin/bash
# Kim tra phi�n bn RHEL
vercheck=$(grep -oP '^VERSION_ID="?(\d+)' /etc/os-release | grep -oP '\d+')

#######################################
if [ "$vercheck" -lt 10 ]; then
        # �p dng quy tc iptables
        iptables -I INPUT 2 -p tcp --dport 30000:50000 -j ACCEPT  # FTP passive ports hoc dch v kh�c
        iptables -I INPUT 3 -p udp --dport 30000:50000 -j ACCEPT  # FTP passive ports hoc dch v kh�c
        iptables -I INPUT 4 -p tcp --dport 21 -j ACCEPT  # FTP (TCP)
        iptables -I INPUT 5 -p udp --dport 21 -j ACCEPT  # FTP (UDP, him d�ng)
        # Lu cu h�nh
        service iptables save
else
######################
# Kiểm tra và tạo bảng/chain nếu chưa tồn tại
if ! nft list table inet filter >/dev/null 2>&1; then
    nft add table inet filter
fi
if ! nft list chain inet filter input >/dev/null 2>&1; then
    nft add chain inet filter input "{ type filter hook input priority 0; policy drop; }"
fi

# Bổ sung quy tắc vào cuối chuỗi input
nft add rule inet filter input tcp dport 30000-50000 accept
nft add rule inet filter input udp dport 30000-50000 accept
nft add rule inet filter input tcp dport 21 accept
nft add rule inet filter input udp dport 21 accept

# Lưu cấu hình
mkdir -p /etc/nftables
nft list ruleset > /etc/nftables/main.nft
chmod 600 /etc/nftables/main.nft

# Cập nhật /etc/nftables.conf để include ruleset
if [ ! -f /etc/nftables.conf ]; then
    printf '#!/usr/sbin/nft -f\nflush ruleset\n' > /etc/nftables.conf
    echo 'include "/etc/nftables/main.nft"' >> /etc/nftables.conf
elif ! grep -Fx 'include "/etc/nftables/main.nft"' /etc/nftables.conf >/dev/null; then
    echo 'include "/etc/nftables/main.nft"' >> /etc/nftables.conf
fi

# Khởi động lại nftables để áp dụng
systemctl restart nftables
####################
