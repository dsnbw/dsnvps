#!/bin/bash
apt-get install -y -qq pure-ftpd
sed -i 's/ChrootEveryone/#ChrootEveryone/g' /etc/pure-ftpd/pure-ftpd.conf
sed -i 's/VerboseLog/#VerboseLog/g' /etc/pure-ftpd/pure-ftpd.conf
sed -i 's/NoAnonymous/#NoAnonymous/g' /etc/pure-ftpd/pure-ftpd.conf
sed -i 's/MaxClientsPerIP[[:space:]]*[0-9]*/MaxClientsPerIP              321/g' /etc/pure-ftpd/pure-ftpd.conf
sed -i 's/MaxClientsNumber[[:space:]]*[0-9]*/MaxClientsNumber             123/g' /etc/pure-ftpd/pure-ftpd.conf
echo "
ChrootEveryone yes
UnixAuthentication yes
VerboseLog yes
CreateHomeDir yes
NoAnonymous yes
PureDB /etc/pure-ftpd/pureftpd.pdb
PassivePortRange          30000 50000
TLS 1
" >> /etc/pure-ftpd/pure-ftpd.conf ;
openssl req -x509 -nodes -days 7200 -newkey rsa:2048 -keyout /etc/ssl/private/pure-ftpd.pem -out /etc/ssl/private/pure-ftpd.pem -subj "/C=US/ST=DSNVPS FTP/L=DSNVPS FTP/O=DSNVPS FTP/CN=DSNVPS FTP"
if [ ! -f /etc/dsnvps/pure-ftpd.pem ]; then
yes | cp -rf /etc/ssl/private/pure-ftpd.pem /etc/dsnvps/pure-ftpd.pem
fi
if [ "$(grep /etc/ssl/private/pure-ftpd.pem /etc/pure-ftpd/pure-ftpd.conf)" != "" ]; then
sed -i 's/\/etc\/ssl\/private\/pure-ftpd.pem/\/etc\/dsnvps\/pure-ftpd.pem/g' /etc/pure-ftpd/pure-ftpd.conf
fi
if [ "$(grep CertFile\ /etc/dsnvps/pure-ftpd.pem /etc/pure-ftpd/pure-ftpd.conf)" == "" ]; then
echo "
TLSCipherSuite HIGH
CertFile /etc/dsnvps/pure-ftpd.pem
" >> /etc/pure-ftpd/pure-ftpd.conf ;
fi
sed -i "s/.*TLSCipherSuite\ HIGH.*/TLSCipherSuite\ HIGH/g" /etc/pure-ftpd/pure-ftpd.conf
sed -i "s/.*CertFile\ \/etc\/dsnvps\/pure-ftpd.pem.*/CertFile\ \/etc\/dsnvps\/pure-ftpd.pem/g" /etc/pure-ftpd/pure-ftpd.conf
systemctl enable pure-ftpd 
systemctl start pure-ftpd 
systemctl restart pure-ftpd 
