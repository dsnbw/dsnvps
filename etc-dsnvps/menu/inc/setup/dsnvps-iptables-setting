#EOF
#chmod +x /root/iptables_reset.sh 2>/dev/null
############################################
###########################################
else
###############
# Cài đặt nftables
if ! rpm -q nftables >/dev/null 2>&1; then
    dnf -y -q install nftables
    if ! rpm -q nftables >/dev/null 2>&1; then
        echo "Lỗi: Không thể cài đặt nftables. Vui lòng kiểm tra kho hoặc kết nối mạng."
        exit 1
    fi
fi

# Thêm quy tắc tạm thời để bảo vệ SSH trước khi thay đổi
nft add table inet temp_table
nft add chain inet temp_table input "{ type filter hook input priority -10; policy accept; }"
nft add rule inet temp_table input tcp dport 22 accept
nft add rule inet temp_table input ct state established,related accept

# Kiểm tra và vô hiệu hóa firewalld nếu tồn tại
if systemctl is-active firewalld >/dev/null 2>&1; then
    systemctl disable firewalld
    systemctl stop firewalld
fi

# Kích hoạt và khởi động nftables
systemctl enable nftables
systemctl start nftables

# Xóa tất cả quy tắc hiện tại
nft flush ruleset

# Tạo bảng nftables
nft add table inet filter

# Tạo chuỗi INPUT, OUTPUT, FORWARD
nft add chain inet filter input "{ type filter hook input priority 0; policy drop; }"
nft add chain inet filter output "{ type filter hook output priority 0; policy drop; }"
nft add chain inet filter forward "{ type filter hook forward priority 0; policy drop; }"

# Quy tắc INPUT
nft add rule inet filter input ct state established,related accept
nft add rule inet filter input iif lo accept # Cho phép loopback
nft add rule inet filter input tcp dport 80 accept
nft add rule inet filter input tcp dport 443 accept
nft add rule inet filter input tcp dport 22 accept # SSH và SFTP
nft add rule inet filter input tcp dport 21 accept # FTP
nft add rule inet filter input tcp dport 25 accept
nft add rule inet filter input tcp dport 465 accept
nft add rule inet filter input tcp dport 587 accept
nft add rule inet filter input tcp dport 53 accept
nft add rule inet filter input udp dport 53 accept
nft add rule inet filter input tcp dport 34618 accept # Custom service (cần xác minh ứng dụng)
nft add rule inet filter input tcp dport 11211 ip saddr 127.0.0.1 accept # Memcached, giới hạn localhost
nft add rule inet filter input tcp dport 6379 ip saddr 127.0.0.1 accept # Redis, giới hạn localhost

# Quy tắc OUTPUT
nft add rule inet filter output ct state established,related accept
nft add rule inet filter output oif lo accept # Cho phép loopback
nft add rule inet filter output tcp dport 80 accept
nft add rule inet filter output tcp dport 443 accept
nft add rule inet filter output tcp dport 22 accept
nft add rule inet filter output tcp dport 25 accept
nft add rule inet filter output tcp dport 465 accept
nft add rule inet filter output tcp dport 587 accept
nft add rule inet filter output tcp dport 53 accept
nft add rule inet filter output udp dport 53 accept
nft add rule inet filter output tcp dport 6379 accept # Cho phép kết nối đến Redis server bên ngoài

# Xóa bảng tạm thời nếu tồn tại
if nft list table inet temp_table >/dev/null 2>&1; then
    nft delete table inet temp_table
fi

# Lưu cấu hình
mkdir -p /etc/nftables
nft list ruleset > /etc/nftables/main.nft
chmod 600 /etc/nftables/main.nft

# Cập nhật /etc/nftables.conf để include ruleset
if [ ! -f /etc/nftables.conf ]; then
    echo '# nftables configuration' > /etc/nftables.conf
    echo 'include "/etc/nftables/main.nft"' >> /etc/nftables.conf
elif ! grep -Fx 'include "/etc/nftables/main.nft"' /etc/nftables.conf >/dev/null; then
    echo 'include "/etc/nftables/main.nft"' >> /etc/nftables.conf
fi

# Khởi động lại nftables để áp dụng
systemctl restart nftables  
##################     
fi

