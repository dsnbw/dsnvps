echo "Dung lượng đĩa còn trống ít hơn 30 MB. DSNVPSSC phải thoát."
echo "-------------------------------------------------------------------------"
    echo "Hãy xóa tất cả file không cần thiết để server có thêm dung lượng trống."
    echo "========================================================================="
    echo "========================================================================="
    killall -g dsnvpssc
    exit
fi

