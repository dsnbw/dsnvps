#!/bin/bash
. /root/dsnvps.conf 2>/dev/null || true
if [ "$(id -u)" != "0" ]; then
    printf "Error! Bạn phải chạy DSNVPS dưới quyền root !\n"
    exit 1
fi
vercheck=$(grep -oP '^VERSION_ID="?(\d+)' /etc/os-release | grep -oP '\d+')
if [ "${vercheck:-24}" -lt 10 ]; then
    FWtables=IP
else
    FWtables=NF
fi

while true; do
    lang_mode="VN"
    [ -f /etc/dsnvps/menu/dsnvps-check-language ] && lang_mode=$(tr -d '[:space:]' < /etc/dsnvps/menu/dsnvps-check-language)
    /etc/dsnvps/menu/menucheck/dsnvps-show-menu-version

    if [ "$lang_mode" == "EN" ]; then
        printf "%-36s %s\n" "1) Add Website & Code" "23) Migrate Old VPS to DSNVPS"
        printf "%-36s %s\n" "2) Reverse Proxy Manager" "24) Resilio Sync Manager"
        printf "%-36s %s\n" "3) Fix Permission & Chown" "25) Let's Encrypt SSL Manager"
        printf "%-36s %s\n" "4) Remove Website & Domain" "26) CloudFlare Origin SSL (15y)"
        printf "%-36s %s\n" "5) Backup & Restore Website" "27) Addons & Utilities"
        printf "%-36s %s\n" "6) Database Manager" "28) Switch PHP Version"
        printf "%-36s %s\n" "7) Backup & Restore Database" "29) Country Access Control (GeoIP2)"
        printf "%-36s %s\n" "8) WordPress / Flarum Tools" "30) CloudFlare Dynamic DNS"
        printf "%-36s %s\n" "9) WordPress Multisite" "31) VLESS VPN Setup"
        printf "%-36s %s\n" "10) phpMyAdmin & FileManager" "32) Server Timezone"
        printf "%-36s %s\n" "11) Zend OPcache Manager" "33) Server Info & Status"
        printf "%-36s %s\n" "12) Redis / Memcache Manager" "34) DSNVPS Shortcut & System Update"
        printf "%-36s %s\n" "13) FTP Account Manager" "35) Clear VPS Caches"
        printf "%-36s %s\n" "14) Swap & Log File Manager" "36) Auto-Check Services & Telegram"
        printf "%-36s %s\n" "15) Cronjob Manager" "37) Switch Language to Vietnamese"
        printf "%-36s %s\n" "16) PHP.INI Config Tuning" "38) DSNVPS Status (Offline/Standalone)"
        printf "%-36s %s\n" "17) Server & Website Security" "39) DSNVPS Pro Features (Unlocked)"
        printf "%-36s %s\n" "18) CSF Firewall Manager" "40) Server Turbo & Optimization Suite"
        printf "%-36s %s\n" "19) ${FWtables}tables Firewall Manager" "41) Realtime Monitor (WTOP)"
        printf "%-36s %s\n" "20) Anti-DDoS & ModSecurity" "42) YARA Malware Scan, 7G WAF & AI Block"
        printf "%-36s %s\n" "21) Purge CloudFlare Cache" "43) Nginx FastCGI Page Cache & Preload"
        printf "%-36s %s\n" "22) Cloud & Telegram Backup" "44) DSNVPS CLI Commands Help"
        echo "========================================================================="
        read -r -p "Your choice [0 - Exit]: " choice
    else
        printf "%-36s %s\n" "1) Thêm Website & Code" "23) Chuyển VPS Cũ Tới DSNVPS"
        printf "%-36s %s\n" "2) Quản Lý Reverse Proxy" "24) Quản Lý Resilio Sync"
        printf "%-36s %s\n" "3) Fix Lỗi Permission & Chown" "25) Cài Đặt Let's Encrypt SSL"
        printf "%-36s %s\n" "4) Xóa Web, Domain & Subsite" "26) Cài Đặt CloudFlare SSL (15 Năm)"
        printf "%-36s %s\n" "5) Sao Lưu & Phục Hồi Website" "27) Công Cụ & Cài Đặt Khác"
        printf "%-36s %s\n" "6) Quản Lý & Kiểm Tra Database" "28) Thay Đổi Phiên Bản PHP"
        printf "%-36s %s\n" "7) Sao Lưu & Phục Hồi Database" "29) Quản Lý Truy Cập Theo Quốc Gia"
        printf "%-36s %s\n" "8) Tiện Ích WordPress/Flarum" "30) Cài Đặt CloudFlare DDNS"
        printf "%-36s %s\n" "9) Quản Lý Wordpress Multisite" "31) Cài Đặt & Cấu Hình VLESS VPN"
        printf "%-36s %s\n" "10) Quản Lý phpMyAdmin, Filemanager" "32) Cài Đặt Múi Giờ Server Timezone"
        printf "%-40s %b\n" "11) Quản Lý Zend OPcache" "33) \e[33mThông Tin Quản Lý VPS\e[0m ⚙ Status"
        printf "%-36s %s\n" "12) Quản Lý Redis Cache/Memcache" "34) DSNVPS Shortcut / Cập Nhật System"
        printf "%-36s %s\n" "13) Quản Lý Tài Khoản FTP" "35) Clear VPS Caches (PHP Cache...)"
        printf "%-36s %s\n" "14) Quản Lý Swap / Log File" "36) Auto Check Login/Nginx/MySQL/PHP"
        printf "%-36s %s\n" "15) Quản Lý Cronjob" "37) Chuyển Ngôn Ngữ (VI / EN)"
        printf "%-36s %s\n" "16) Tùy Chỉnh Cấu Hình PHP" "38) Trạng Thái DSNVPS (Offline/Độc Lập)"
        printf "%-40s %b\n" "17) Bảo Mật Server & Website" "\e[32m39) DSNVPS - Đã Mở Khóa Full Tính Năng\e[0m"
        printf "%-40s %b\n" "18) Quản Lý CSF Firewall" "\e[36m40) Tối Ưu Tốc Độ Server (BBR/ZRAM/JIT)\e[0m"
        printf "%-40s %b\n" "19) Quản Lý ${FWtables}tables Firewall" "\e[36m41) Giám Sát Real-time (DSNVPS WTOP)\e[0m"
        printf "%-40s %b\n" "20) Tăng Chịu Tải Web & ModSec" "\e[36m42) Quét Mã Độc YARA, 7G WAF & Bot AI\e[0m"
        printf "%-40s %b\n" "21) Xóa Cache CloudFlare Cho Domain" "\e[36m43) Nginx FastCGI Cache & Preload Sitemap\e[0m"
        printf "%-40b %b\n" "\e[33m22) Sao Lưu VPS Tới Cloud & Tele\e[0m" "\e[36m44) Danh Sách Lệnh Nhanh CLI (dsnvps help)\e[0m"
        echo "========================================================================="
        read -r -p "Lựa chọn của bạn [0 -Thoát]: " choice
    fi

    case $choice in
        1) /etc/dsnvps/menu/childmenu/dsnvps-befor-them-website-menu;;
        2) clear && /etc/dsnvps/menu/dsnvps-reverse-proxy-menu;;
        3) /etc/dsnvps/menu/dsnvps-sua-loi-chown;;
        4) /etc/dsnvps/menu/dsnvps-befor-xoa-website;;
        5) /etc/dsnvps/menu/childmenu/dsnvps-sao-luu;;
        6) /etc/dsnvps/menu/dsnvps-befor-them-xoa-database-chi-them-xoa;;
        7) /etc/dsnvps/menu/childmenu/dsnvps-befor-them-xoa-database;;
        8) /etc/dsnvps/menu/dsnvps-cong-cu-wordpress-flarum-yourls;;
        9) /etc/dsnvps/menu/dsnvps-setup-multisite-wordpress-menu-wordpress;;
        10) /etc/dsnvps/menu/childmenu/dsnvps-phpmyadmin-menu;;
