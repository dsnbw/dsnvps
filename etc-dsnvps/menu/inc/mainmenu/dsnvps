        13) /etc/dsnvps/menu/childmenu/dsnvps-ftpserver-menu;;
        14) /etc/dsnvps/menu/dsnvps-quan-ly-swap-va-log-file-menu;;
        15) /etc/dsnvps/menu/crontab/dsnvps-cronjob-2-version-menu;;
        16) /etc/dsnvps/menu/childmenu/dsnvps-befor-dsnvps-config-php.ini-menu;;
        17) /etc/dsnvps/menu/childmenu/dsnvps-bao-mat-server-website-menu;;
        18) clear && /etc/dsnvps/menu/childmenu/dsnvps-csf-firewall-before-menu;;
        19) clear && /etc/dsnvps/menu/childmenu/dsnvps-${FWtables}tables-firewall-manager-menu;;
        20) clear && /etc/dsnvps/menu/childmenu/dsnvps-kiem-tra-ddos;;
        21) clear && /etc/dsnvps/menu/dsnvps-clear-cache-website-cloudflare;;
        22) /etc/dsnvps/menu/dsnvps-befor-rclone-menu;;
        23) /etc/dsnvps/menu/dsnvps-migration-menu.sh;;
        24) /etc/dsnvps/menu/childmenu/dsnvps-rslisync-menu;;
        25) /etc/dsnvps/menu/childmenu/dsnvps-letsencrypt-menu;;
        26) /etc/dsnvps/menu/childmenu/dsnvps-tao-paidssl-menu;;
        27) /etc/dsnvps/menu/childmenu/dsnvps-tien-ich;;
        28) /etc/dsnvps/menu/dsnvps-thay-doi-php-version;;
        29) clear && /etc/dsnvps/menu/dsnvps-nginx-geoip2-menu;;
        30) /etc/dsnvps/menu/childmenu/dsnvps-befor-ddns-cloudflare-menu;;
        31) clear && /etc/dsnvps/menu/dsnvps-cai-dat-v2ray-vpn;;
        32) clear && /etc/dsnvps/menu/dsnvps-thay-doi-thong-tin-thoi-gian;;
        33) /etc/dsnvps/menu/dsnvps-kiem-tra-server-status-va-thong-tin-server-info;;
        34) /etc/dsnvps/menu/dsnvps-shortcut-update-system-menu;;
        35) /etc/dsnvps/menu/dsnvps-quan-ly-clear-cache-auto-run-dsnvps-va-log-file-menu;;
        36) /etc/dsnvps/menu/dsnvps-auto-check-login-nginx-mysql-php-send-telegram;;
        37) /etc/dsnvps/menu/dsnvps-thay-doi-ngon-ngu-menu;;
        38) /etc/dsnvps/menu/dsnvps-nang-cap-scripts;;
        39) /etc/dsnvps/menu/dsnvps-register-business-version;;
        40) /etc/dsnvps/menu/dsnvps-optimize-suite-menu;;
        41) /etc/dsnvps/menu/dsnvps-wtop;;
        42) /etc/dsnvps/menu/dsnvps-security-pro-menu;;
        43) /etc/dsnvps/menu/dsnvps-fastcgi-cache-menu;;
        44) clear && /usr/bin/dsnvps help && read -r -p "Nhấn [Enter] để quay lại menu..." ;;
        0)  /etc/dsnvps/menu/script-thoat; exit 0;;
        *)
            echo "========================================================================="
            echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu!"
            sleep 2
        ;;
    esac
done
