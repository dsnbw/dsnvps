<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>VPS đã được cài đặt thành công bằng DSNVPS !</title>
  <link rel="icon" href="https://dsnvps/dsnvps_icon.png" type="image/png">
 <style>
    * {
      box-sizing: border-box;
    }
body {
  margin: 0;
  padding: 20px;
  font-family: Tahoma, "Times New Roman", serif;
  color: #333;
  text-align: center;
  background: linear-gradient(135deg, #ff8a8e, #f8b0c0, #f8c8e5);
  animation: softPinkDawn 20s ease-in forwards;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
}
    
    .container {
      position: relative;
      background: white;
      padding: 40px;
      border-radius: 10px;
      box-shadow: 0 10px 10px rgba(0, 0, 0, 0.2);
      max-width: 900px;
      width: 100%;
      word-break: break-word;
      z-index: 1;
    }
    h1 {
      font-size: 1rem;
      color: #ff6363;
    }
    p {
      font-size: 1rem;
      color: #555;
    }
    .emoji {
      font-size: 1.5rem;
    }
    .footer {
      margin-top: 20px;
      font-size: 0.9rem;
      color: #777;
      font-style: italic;
    }
    .footer span {
      color: #e63946;
      font-weight: bold;
    }
    

    
    /* Sun */
.sun {
  position: fixed;
  top: 20%;
  left: 5%;
  width: 130px;
  height: 130px;
  background: radial-gradient(circle, #ffd700, #ffa500);
  border-radius: 50%;
  animation: riseWithDawn 20s ease-in forwards, pulse 2s infinite alternate;
  box-shadow: 0 0 30px rgba(255, 223, 0, 0.6), 0 0 60px rgba(255, 153, 0, 0.5);
  z-index: 0;
}

@keyframes riseWithDawn {
  0% {
    top: 15%;
    width: 130px;
    height: 130px;
    opacity: 0.6;
    box-shadow: 0 0 20px rgba(255, 180, 0, 0.3), 0 0 30px rgba(255, 140, 0, 0.2);
  }
  50% {
    top: 10%;
    width: 110px;
    height: 110px;
    opacity: 0.8;
    box-shadow: 0 0 40px rgba(255, 200, 0, 0.5), 0 0 60px rgba(255, 160, 0, 0.4);
  }
  100% {
    top: 5%;
    width: 90px;
    height: 90px;
    opacity: 1;
    box-shadow: 0 0 60px rgba(255, 255, 100, 0.9), 0 0 100px rgba(255, 200, 0, 0.8);
  }
}
    @keyframes pulse {
      0% {
        transform: scale(1);
        opacity: 1;
      }
      100% {
        transform: scale(1.1);
        opacity: 0.9;
      }
    }
@keyframes softPinkDawn {
  0% {
    background: linear-gradient(135deg, #ff8a8e, #f8b0c0, #f8c8e5); 
  }
  50% {
    background: linear-gradient(135deg, #ff9a9e, #fad0c4, #fbc2eb); 
  }
  100% {
    background: linear-gradient(135deg, #ffadb2, #fde0e6, #fdeaf5); 
  }
}
    @media (min-width: 900px) {
      .container {
        padding: 50px;
        max-width: 1024px;
      }
      h1 {
        font-size: 2rem;
      }
      p {
        font-size: 1rem;
        color: #555;
      }
      p2 {
        font-size: 0.7rem;
        color: #555;
      }
      h2 {
        font-size: 1.6rem;
      }
      .emoji {
        font-size: 2rem;
      }
      .footer {
        font-size: 1rem;
      }
    }
    .popup-trigger {
      text-decoration: underline;
      color: #007bff;
      font-weight: bold;
      cursor: pointer;
    }
    .popup-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 999;
    }
    .popup {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: black;
      color: #00ff00;
      font-family: monospace;
      font-size: 14px;
      padding: 20px;
      border: 1px solid #333;
      z-index: 1000;
      max-width: 800px;
      width: 80%;
      height: auto;
      min-height: 600px;
      max-height: 100vh;
      overflow-y: auto;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }
    .popup.active, .popup-overlay.active {
      display: block;
    }
    .close-popup {
      position: absolute;
      top: 10px;
      right: 10px;
      background: red;
      color: white;
      border: none;
      cursor: pointer;
      padding: 5px 10px;
      font-size: 16px;
    }
    .terminal-content {
      text-align: left;
    }
    .menu-item {
      color: #00ff00;
      text-decoration: underline;
      cursor: pointer;
    }
    .menu-item:hover {
      color: #00ffff;
    }
    .logo-img {
  max-width: 30%;
  height: auto;
}
@media (max-width: 600px) {
  .logo-img {
    max-width: 70%;
  }
}
  </style>
</head>
