#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed


echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ....";sleep 2
systemctl start memcached.service
systemctl enable memcached.service 
echo "========================================================================= "
echo "Bật Memcached thành công."

/etc/dsnvps/menu/memcache/dsnvps-before-memcache-menu
