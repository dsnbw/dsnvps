#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
echo "=========================================================================="
read -r -p "Bạn muốn gỡ bỏ Memcached khỏi server? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then

systemctl stop memcached.service
systemctl disable memcached.service

phpver=$(php -r "echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;"); apt-get remove -y -qq memcached php${phpver}-memcached
rm -rf /etc/sysconfig/memcached
clear
echo "=========================================================================="
echo "Hoàn thành gỡ bỏ Memcached khỏi server."
dsnvps
else
clear
echo "=========================================================================="
echo "Hủy bỏ!"
/etc/dsnvps/menu/memcache/dsnvps-memcache-menu
fi

