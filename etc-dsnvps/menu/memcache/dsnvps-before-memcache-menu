#!/bin/bash
if [ ! -f /etc/php.ini ]; then
    phpsetup=$(command -v php >/dev/null 2>&1 && echo php-common)
    if [ -z "$phpsetup" ]; then
        /etc/dsnvps/menu/dsnvps-fix-loi-chua-cai-php
    else
        # Kiểm tra xem PHP-FPM có đang chạy không
        phpfpm_status=$(systemctl is-active php-fpm)
        
        if [ "$phpfpm_status" != "active" ]; then
            clear
            echo "========================================================================="
            echo "Xin lỗi, PHP không chạy. Hãy khởi động nó trước khi sử dụng chức năng này!"
            systemctl start php-fpm  # Khởi động PHP-FPM nếu nó không chạy
            dsnvps
        fi
    fi
fi

if ! command -v memcached >/dev/null 2>&1; then
echo "=========================================================================="
echo "Memcached chưa được cài đặt trên server. Memcached phải được cài đặt trước"
echo "--------------------------------------------------------------------------"
echo "khi chạy chức năng này. Để không lãng phí tài nguyên CPU & RAM Server, bạn"
echo "--------------------------------------------------------------------------"
echo "không nên cài đặt Memcached nếu không sử dụng đến nó."
echo "--------------------------------------------------------------------------"
echo "Nếu server có lượng RAM thấp (< 1GB), bạn không nên cài đặt Memcached"
echo "--------------------------------------------------------------------------"
echo "Khuyến nghị: RAM từ 2GB trở lên để mang lại trải nghiệm tốt nhất."
echo "=========================================================================="
read -r -p "Bạn muốn cài đặt Memcached cho server? [y/N] " response
if [[ $response == "y" || $response == "Y" || $response == "yes" || $response == "Yes" ]]; then
apt-get update -qq && apt-get install -y -qq memcached
apt-get install -y -qq libmemcached-tools
phpver=$(php -r "echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;"); apt-get install -y -qq php${phpver}-memcached
rm -rf /etc/sysconfig/memcached
cat > "/etc/sysconfig/memcached" <<END
PORT="11211"
USER="memcached"
MAXCONN="1024"
CACHESIZE="128"
OPTIONS="-l 127.0.0.1 -U 0" 
END

cat > /etc/memcached.conf << "MEMEOF"
-d
logfile /var/log/memcached.log
-m 128
-p 11211
-u memcache
-l 127.0.0.1
-c 1024
MEMEOF
systemctl restart memcached
systemctl enable memcached 

else
clear
echo "=========================================================================="
echo "Hủy bỏ!"
dsnvps
fi
fi
clear && /etc/dsnvps/menu/memcache/dsnvps-memcache-menu
