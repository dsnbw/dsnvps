#!/bin/bash 

. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
#mkdir -p /etc/dsnvps/.tmp && touch /etc/dsnvps/.tmp/sllokie && touch /etc/dsnvps/.tmp/ckla
rm -rf /etc/dsnvps/.tmp/checkallwebsites
echo "$(ls /etc/nginx/conf.d | sed 's/.conf//')" > /etc/dsnvps/.tmp/checkallwebsites
## Remove DSNVPS.DEMO
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/checkallwebsites
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
if [ "$(cat /etc/dsnvps/.tmp/checkallwebsites | wc -l)" -lt "1" ]; then
rm -rf /etc/dsnvps/.tmp/checkallwebsites
clear
echo "========================================================================="
echo "Hiện tại bạn chưa thêm Website mới vào server !"
/etc/dsnvps/menu/dsnvps-sao-luu
exit
fi
rm -rf /etc/dsnvps/.tmp/checkallwebsites

###
echo "========================================================================="
echo "Sử dụng chức năng này sao lưu hoặc phục hồi full code + database cho"
echo "-------------------------------------------------------------------------"
echo "website. Trong quá trình phục hồi website, DSNVPS sẽ tự động tạo database"
echo "-------------------------------------------------------------------------"
echo "cho website nếu cần thiết. Bạn không cần tạo database cho website trước"
echo "-------------------------------------------------------------------------"
echo "khi chạy chức năng này."
echo "=========================================================================" 
echo "Hướng dẫn sử dụng: http://go.dsnvps/bakrefull"
echo "========================================================================="
#prompt="Nhập lựa chọn của bạn: "
prompt="Lựa chọn của bạn [0 -Thoát]: "
options=( "Sao Lưu Full Website + Database" "Phục Hồi Full Website + Database")
printf "LỰA CHỌN SAO LƯU HAY PHỤC HỒI WEBSITE\n"
printf "=========================================================================\n"
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) luachon="saoluu"; break;;
    2) luachon="phuchoi"; break;;
    0) luachon="cancle"; break;;
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    #*) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    esac  
done
###################################
#Sao luu
###################################
if [ "$luachon" = "saoluu" ]; then
/etc/dsnvps/menu/dsnvps-sao-luu-full-website-database-code
###################################
#Phuc Hoi
###################################
elif [ "$luachon" = "phuchoi" ]; then
/etc/dsnvps/menu/dsnvps-phuc-hoi-full-website-database-code
###################################
#cancel
###################################
else
clear
exit 0
fi
