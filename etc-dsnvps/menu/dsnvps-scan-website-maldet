#!/bin/bash 
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
serverip_priport=$domainquanly
else
serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
if [ ! -f /usr/local/maldetect/conf.maldet ]; then
clear
echo "========================================================================= "
echo "LMD với ClamAV chưa được cài đặt trên VPS "
echo "-------------------------------------------------------------------------"
echo "Bạn vui lòng cài đặt LMD trước khi chạy chức năng này !"
/etc/dsnvps/menu/dsnvps-maldet-menu
exit
fi
rm -rf /etc/dsnvps/.tmp/*hostingaz*
ls /etc/nginx/conf.d > /etc/dsnvps/.tmp/dsnvps-websitelist
sed -i 's/\.conf//g' /etc/dsnvps/.tmp/dsnvps-websitelist
 cat > "/etc/dsnvps/.tmp/dsnvps-replace" <<END
sed -i '/$mainsite/d' /etc/dsnvps/.tmp/dsnvps-websitelist
END
chmod +x /etc/dsnvps/.tmp/dsnvps-replace
/etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/dsnvps-replace
rm -rf /etc/dsnvps/.tmp/checksite-list
sowebsitetrenserver=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist| wc -l)
listwebsite=$(cat /etc/dsnvps/.tmp/dsnvps-websitelist)
rm -rf /etc/dsnvps/.tmp/checksite-list
for checksite in $listwebsite 
do
rm -rf /etc/dsnvps/.tmp/dsnvps_check_site
if [ -d /home/$checksite/public_html ]; then
find /home/$checksite/public_html -name "*.*" > /etc/dsnvps/.tmp/dsnvps_check_site
sodong=`cat /etc/dsnvps/.tmp/dsnvps_check_site | wc -l`
if [ "$sodong" -gt 5 ]; then
echo "$checksite" >> /etc/dsnvps/.tmp/checksite-list
fi
fi
 done

if [ ! -f /etc/dsnvps/.tmp/checksite-list ]; then
rm -rf /etc/dsnvps/.tmp/*dsnvps*
rm -rf /etc/dsnvps/.tmp/*hostingaz*
clear
echo "========================================================================="
echo "Không có website nào có dữ liệu trên hệ thống"
echo "--------------------------------------------------------------------------"
echo "Bạn không cần sử dụng chức năng này !"
/etc/dsnvps/menu/dsnvps-maldet-menu
fi
echo "========================================================================= "
echo "Sử dụng chức năng này để quét malware cho website"
mapfile -t website_list < /etc/dsnvps/.tmp/checksite-list
echo "========================================================================="
echo "Danh sách các website có dữ liệu trên server:"
echo "-------------------------------------------------------------------------"
for ((i = 0; i < ${#website_list[@]}; i+=2)); do
    if ((i+1 < ${#website_list[@]})); then
        printf "%-4s %-20s %-4s %-20s\n" "$((i+1))." "${website_list[i]}" "$((i+2))." "${website_list[i+1]}"
    else
        printf "%-4s %-20s\n" "$((i+1))." "${website_list[i]}"
    fi
done

while true; do
    echo "========================================================================="
    echo -n "Nhập số tương ứng với website [0 -Thoát]: " 
    read -r selection
    
    # Check if nothing is entered or if the input is invalid
    if [[ -z "$selection" ]]; then
        echo "Vui lòng nhập một số hợp lệ."
        continue
    elif [[ "$selection" == "0" ]]; then
        clear
/etc/dsnvps/menu/dsnvps-maldet-menu
        break
    elif [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#website_list[@]} )); then
        website=${website_list[selection-1]}
        break  # Exit the loop if the selection is valid
    else
        echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
    fi
done
if [ ! -f /etc/nginx/conf.d/$website.conf ]; then
clear
echo "========================================================================= "
echo "Không tìm thấy domain $website"
/etc/dsnvps/menu/dsnvps-maldet-menu
fi
echo "-------------------------------------------------------------------------"
echo "Tìm thấy $website trên server "
prompt="Lựa chọn của bạn [0 -Thoát]: "
options=( "Scan Normal" "Scan In Background")
printf "=========================================================================\n"
echo "LỰA CHỌN SCAN: NORMAL HOẶC BACKGROUND"
echo "-------------------------------------------------------------------------"
printf "Nên lựa chọn [ Scan In Background ] khi scan số lượng file lớn. \n"
printf "=========================================================================\n"
PS3="$prompt"
select opt in "${options[@]}"; do 

    case "$REPLY" in
    1) cachscan="normal"; break;;
    2) cachscan="background"; break;;
    0) cachscan="cancle"; break;;
    *) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    #*) echo "Bạn nhập sai, vui lòng nhập theo số thứ tự trên menu";continue;;
    esac  
done
###################################
#scan 1 website
###################################
if [ "$cachscan" = "normal" ]; then
scanway=normal
elif [ "$cachscan" = "background" ]; then
scanway=background
else
clear
exit 0
fi
if [ "$cachscan" = "background" ]; then
echo "-------------------------------------------------------------------------"
echo "LMD sẽ scan $website theo hình thức Background"
fi
echo "-------------------------------------------------------------------------"
read -r -p "Bạn muốn scan $website ? [y/N] " response
case $response in
    [yY][eE][sS]|[yY])
    echo "-------------------------------------------------------------------------"
        echo "Vui lòng chờ ..."
    sleep 2 
if [ "$cachscan" == "background" ]; then
maldet -b -a /home/$website
clear
echo "========================================================================="
echo "Scan đang được diễn ra."
echo "-------------------------------------------------------------------------"
echo "Xem quá trình scan bằng lệnh bên dưới:"
echo "-------------------------------------------------------------------------"
echo "cat /usr/local/maldetect/logs/event_log"
echo "-------------------------------------------------------------------------"
echo "Khi scan hoàn thành. Xem kết quả bằng chức năng: View Last Scan Report"
/etc/dsnvps/menu/dsnvps-maldet-menu
else
maldet -a /home/$website
name123=$(cat /usr/local/maldetect/sess/session.last)
rm -rf /etc/dsnvps/.tmp/maldet.txt
cp /usr/local/maldetect/sess/session.$name123 /etc/dsnvps/.tmp/maldet-home.txt
sed -i '$d' /etc/dsnvps/.tmp/maldet-home.txt && sed -i '$d' /etc/dsnvps/.tmp/maldet-home.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet-home.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet-home.txt && sed -i '1d' /etc/dsnvps/.tmp/maldet-home.txt
clear
echo "========================================================================="
echo "Scan hoàn thành. Báo cáo cho lần quét vào: $(maldet --report list | grep SCAN | awk 'NR==1 {print $1,$2,$3}')"
echo "-------------------------------------------------------------------------"
cat /etc/dsnvps/.tmp/maldet-home.txt | grep '\S'
/etc/dsnvps/menu/dsnvps-maldet-menu
fi    
        ;;
    *)
clear
echo "========================================================================="
echo "Huỷ bỏ Scan $website "
/etc/dsnvps/menu/dsnvps-maldet-menu
        ;;
esac












