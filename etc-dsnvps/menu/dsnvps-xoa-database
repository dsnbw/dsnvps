#!/bin/bash
. /root/dsnvps.conf
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi
# Anti-debug removed
rm -rf /etc/dsnvps/.tmp/checkalldatabase
ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/checkalldatabase
if [ "$(cat /etc/dsnvps/.tmp/checkalldatabase | wc -l)" -lt "1" ]; then
    rm -rf /etc/dsnvps/.tmp/checkalldatabase
    clear
    echo "========================================================================="
    echo "Hiện tại bạn chưa tạo database trên server !"
    dsnvps
    exit
fi

# Path to the file containing the database list
db_file="/etc/dsnvps/.tmp/checkalldatabase"

# Check if the database file exists
if [[ ! -f "$db_file" ]]; then
    clear
    echo "========================================================================="
    echo "Database list file not found!"
    dsnvps
    exit
fi

# Read the database list into an array
mapfile -t db_list < "$db_file"

# Display the database list once at the start
echo "========================================================================="
echo "Danh sách database:"
echo "-------------------------------------------------------------------------"
total=${#db_list[@]}
half1=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
half=$(( (total + 1) / 2 ))  # Chia đôi, làm tròn lên nếu số lẻ
for ((i = 0; i < half; i++)); do
    left_index=$((i + 1))                         # Số thứ tự bên trái
    right_index=$((half + i + 1))                 # Số thứ tự bên phải

    left_db="${db_list[i]:- }"                    # Tên database bên trái

    if (( right_index <= total )); then           # Hiển thị nếu bên phải còn giá trị
        right_db="${db_list[right_index-1]}"      # Tên database bên phải
        printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
    else
        printf "%-1s %-30s\n" "$left_index." "$left_db"
    fi
done
echo "========================================================================="

# Handle deletion in a loop
while true; do
    echo -n "Nhập số tương ứng với Database mà bạn muốn xóa [0 -Thoát]: "
    read -r choice

    # Handle the user's choice
    if [[ "$choice" == "0" ]]; then
        clear
        dsnvps
        exit 0
    elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#db_list[@]} )); then
        db_to_delete="${db_list[choice - 1]}"
        # Confirm deletion
        echo "-------------------------------------------------------------------------"
        echo "Bạn lựa chọn: $db_to_delete"
        echo "-------------------------------------------------------------------------"
        read -p "Bạn chắc chắn muốn xóa database này? (Nhập OK để xác nhận): " confirm
        if [[ "$confirm" == "OK" ]]; then
            echo "-------------------------------------------------------------------------"
            echo "Vui lòng chờ ..."; 
            sleep 4 && tput cuu 4 && tput ed
            cat > "/etc/dsnvps/.tmp/config.temp" <<END
drop database $db_to_delete;
END
            mysql -u root -p$mariadbpass < /etc/dsnvps/.tmp/config.temp
            rm -f /etc/dsnvps/.tmp/config.temp

            if [ -f /bin/dsnvps-backupdb-$db_to_delete ]; then
                echo "-------------------------------------------------------------------------"
                echo "Phát hiện $db_to_delete đang cấu hình tự động sao lưu."
                echo "-------------------------------------------------------------------------"
                echo "DSNVPS sẽ TẮT cấu hình sao lưu tự động này."
                echo "-------------------------------------------------------------------------"
                echo "Vui lòng chờ ..."
                sleep 8 && tput cuu 6 && tput ed
                rm -rf /bin/dsnvps-backupdb-$db_to_delete
                cat > "/etc/dsnvps/.tmp/removebackupdb" <<END
sed --in-place '/dsnvps-backupdb-$db_to_delete/d' /etc/cron.d/dsnvps.db.cron
END
                chmod +x /etc/dsnvps/.tmp/removebackupdb
                /etc/dsnvps/.tmp/removebackupdb 
                rm -rf /etc/dsnvps/.tmp/removebackupdb
                systemctl restart crond
            fi

            ## Delete database in /root/DBinfo.txt
            if [ -f /root/DBinfo.txt ]; then
                rm -rf /etc/dsnvps/.tmp/deltata
                cat > "/etc/dsnvps/.tmp/deltata" <<END
sed -i '/Database:\ $db_to_delete/,+4d' /root/DBinfo.txt
END
                sh /etc/dsnvps/.tmp/deltata
                rm -rf /etc/dsnvps/.tmp/deltata
            fi

            # Update the database list after deletion
            rm -rf /etc/dsnvps/.tmp/checkalldatabase
            ls -l /var/lib/mysql | grep "^d" | awk -F" " '{print $9}' | grep -Ev "(Database|information_schema|mysql|performance_schema|dsnvpsCheckDB|sys|dsnvpscheckauto)" > /etc/dsnvps/.tmp/checkalldatabase
            mapfile -t db_list < "$db_file"

            if [ "$(cat /etc/dsnvps/.tmp/checkalldatabase | wc -l)" -lt "1" ]; then
                rm -rf /etc/dsnvps/.tmp/checkalldatabase
                clear
                echo "========================================================================="
                echo "Hiện tại không còn database nào trên server !"
                dsnvps
                exit
            fi
#echo "$half"
            lines_to_clear=$((half + 7))  # Số dòng danh sách cũ + 4 (tiêu đề, đường kẻ, thông báo thành công, khoảng trống)
            sleep 3 && tput cuu "$lines_to_clear" && tput ed

           # sleep 3 && tput cuu 4 && tput ed
            echo "========================================================================="
            echo "=> Xóa $db_to_delete thành công !"
            echo "========================================================================="
            echo "Danh sách database:"   
            # Display updated database list after successful deletion
            echo "-------------------------------------------------------------------------"
            total=${#db_list[@]}
            half=$(( (total + 1) / 2 ))
            for ((i = 0; i < half; i++)); do
                left_index=$((i + 1))
                right_index=$((half + i + 1))
                left_db="${db_list[i]:- }"
                if (( right_index <= total )); then
                    right_db="${db_list[right_index-1]}"
                    printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
                else
                    printf "%-1s %-30s\n" "$left_index." "$left_db"
                fi
            done
            echo "========================================================================="
        else
            sleep 1 && tput cuu 6 && tput ed
            echo "========================================================================="
            echo "Nhập không chính xác !"
            echo "-------------------------------------------------------------------------"
            echo "Bạn cần nhập 'OK' để xác nhận."
            sleep 7 && tput cuu 3 && tput ed
        fi
    else
        echo "========================================================================="
        echo "Lựa chọn không hợp lệ."
        sleep 3 && tput cuu 3 && tput ed
    fi
done
