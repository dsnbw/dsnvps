#!/bin/bash
. /root/dsnvps.conf

# Xử lý server IP và port
if [ -f /etc/dsnvps/domainquanly/domainquanly.conf ]; then
    serverip_priport=$domainquanly
else
    serverip_priport="${serverip}:${priport}"
fi

# Kiểm tra strace
# Anti-debug removed

# Xóa file tạm
rm -rf /etc/dsnvps/.tmp/*dsnvps*
rm -rf /etc/dsnvps/.tmp/*hostingaz*

# Lấy danh sách website bằng pipeline
> /etc/dsnvps/.tmp/dsnvps-websitelist
find /etc/nginx/conf.d -name "*.conf" -exec basename {} .conf \; | grep -v "$mainsite" > /etc/dsnvps/.tmp/dsnvps-websitelist
sowebsitetrenserver=$(wc -l < /etc/dsnvps/.tmp/dsnvps-websitelist)

# Tạo danh sách website có dữ liệu
> /etc/dsnvps/.tmp/checksite-list
while read -r checksite; do
    if [ -d "/home/$checksite/public_html" ] && [ "$(find /home/$checksite/public_html -maxdepth 1 -type f | wc -l)" -gt 1 ]; then
        echo "$checksite" >> /etc/dsnvps/.tmp/checksite-list
    fi
done < /etc/dsnvps/.tmp/dsnvps-websitelist

# Kiểm tra nếu không có website
if [ ! -s /etc/dsnvps/.tmp/checksite-list ]; then
    rm -rf /etc/dsnvps/.tmp/*dsnvps*
    rm -rf /etc/dsnvps/.tmp/*hostingaz*
    clear
    echo "========================================================================="
    echo "Không có website nào có dữ liệu trên hệ thống"
    echo "--------------------------------------------------------------------------"
    echo "Bạn không cần sử dụng chức năng này !"
    dsnvps
    exit
fi

# Hiển thị hướng dẫn
echo "========================================================================="
echo "Bạn PHẢI chạy chức năng này mỗi khi upload đưa code lên hoặc giải nén  "
echo "-------------------------------------------------------------------------"
echo "code trên server. Nếu không, website có thể bị lỗi khi hoạt động. Ví dụ:"
echo "-------------------------------------------------------------------------"
echo "Lỗi upload file, lỗi không update được plugins/themes, trắng trang..."
echo "========================================================================="
echo "Hướng dẫn sử dụng: http://go.dsnvps/3566"
echo "========================================================================="
prompt="Nhập Lựa chọn của bạn [0 -Thoát]: "
options=("Phân quyền 1 website" "Phân quyền tất cả website")
echo "LỰA CHỌN MỘT WEBSITE HAY TẤT CẢ WEBSITE"
echo "========================================================================="
PS3="$prompt"
select opt in "${options[@]}"; do
    if [[ -z "$REPLY" ]]; then
        echo "Bạn nhập sai, vui lòng nhập theo danh sách"
        sleep 3
        tput cuu 2
        for ((i=0; i<2; i++)); do
            tput el
            tput cud1
        done
        tput cuu 2
        continue
    fi
    case "$REPLY" in
    2) luachon="tatca"; break;;
    1) luachon="1website"; break;;
    0) luachon="cancel"; break;;
    *)
        echo "Bạn nhập sai, vui lòng nhập theo danh sách"
        sleep 3
        tput cuu 2
        for ((i=0; i<2; i++)); do
            tput el
            tput cud1
        done
        tput cuu 2
        continue;;
    esac
done

# Hàm xử lý phân quyền
set_permissions() {
    local domain=$1
    local domain_dir="/home/$domain/public_html"
    if [ -f "$domain_dir/artisan" ] && [ -d "$domain_dir/vendor/laravel" ]; then
        echo "-------------------------------------------------------------------------"
        echo "Website $domain dùng Laravel. Thiết lập phân quyền ..."; sleep 2
        chown -R nginx:nginx "$domain_dir"
        chmod -R 755 "$domain_dir"
        chmod -R 775 "$domain_dir/storage"
        chmod -R 775 "$domain_dir/bootstrap/cache"
    else
        echo "-------------------------------------------------------------------------"
        echo "Thiết lập phân quyền Website $domain..."; sleep 2
        chown -R nginx:nginx "$domain_dir"
    fi
}

if [ "$luachon" = "tatca" ]; then
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."; sleep 2
    conf_dir="/etc/nginx/conf.d"
    for conf_file in "$conf_dir"/*.conf; do
        domain=$(basename "$conf_file" .conf)
        domain_dir="/home/$domain"
        if [ -d "$domain_dir" ]; then
            echo "-------------------------------------------------------------------------"
            echo "Tìm thấy: $domain"; sleep 0.5
            set_permissions "$domain"
        fi
    done
    chown -R 777 "/home/$mainsite/logs"
    for log in mysql.log mysql-slow.log; do
        log_path="/home/$mainsite/logs/$log"
        [ -f "$log_path" ] || touch "$log_path"
        chown -R mysql:mysql "$log_path"
    done
    clear
    echo "========================================================================="
    echo "Thiết lập phân quyền cho Nginx, PHP-FPM hoàn thành."
    dsnvps

elif [ "$luachon" = "1website" ]; then
    echo "========================================================================="
    mapfile -t danh_sach_website < /etc/dsnvps/.tmp/checksite-list
    echo "Danh sách các website trên server:"
    echo "-------------------------------------------------------------------------"
    total=${#danh_sach_website[@]}
    half=$(( (total + 1) / 2 ))
    for ((i=0; i<half; i++)); do
        left_index=$((i + 1))
        right_index=$((half + i + 1))
        left_db="${danh_sach_website[i]:- }"
        if (( right_index <= total )); then
            right_db="${danh_sach_website[right_index-1]}"
            printf "%-1s %-30s %-1s %-30s\n" "$left_index." "$left_db" "$right_index." "$right_db"
        else
            printf "%-1s %-30s\n" "$left_index." "$left_db"
        fi
    done
    while true; do
        echo "========================================================================="
        echo -n "Nhập số tương ứng với website [0 -Thoát]: "
        read -r lua_chon
        if [[ -z "$lua_chon" ]] || ! [[ "$lua_chon" =~ ^[0-9]+$ ]] || (( lua_chon < 0 || lua_chon > ${#danh_sach_website[@]} )); then
            echo "Lựa chọn không hợp lệ. Vui lòng thử lại."
            sleep 3
            tput cuu 3
            for ((i=0; i<3; i++)); do
                tput el
                tput cud1
            done
            tput cuu 3
            continue
        elif [[ "$lua_chon" == "0" ]]; then
            clear
            dsnvps
            break
        else
            website=${danh_sach_website[lua_chon-1]}
            break
        fi
    done
    echo "-------------------------------------------------------------------------"
    echo "Tìm thấy $website trên server"; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "DSNVPS chuẩn bị thiết lập quyền ghi cho Nginx, PHP-FPM ..."; sleep 2
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng chờ ..."; sleep 4
    set_permissions "$website"
    clear
    echo "========================================================================="
    echo "Thiết lập phân quyền cho Nginx, PHP-FPM hoàn thành."
    dsnvps
else
    clear
    echo "========================================================================="
    echo "Hủy bỏ!"
    dsnvps
fi
