#!/bin/bash
. /root/dsnvps.conf
# Anti-debug removed

# Kiểm tra python3 và pip3
if ! command -v python3 >/dev/null 2>&1 || ! command -v pip3 >/dev/null 2>&1; then
    echo "-------------------------------------------------------------------------"
    echo "Đang cài đặt python3 và pip3..."
    apt-get install -y -qq python3 python3-pip >/dev/null 2>&1
    if [ $? -ne 0 ]; then
        clear
        echo "========================================================================="
        echo "Lỗi: Không thể cài đặt python3 và pip3. Vui lòng kiểm tra quyền hoặc kết nối mạng."
        /etc/dsnvps/menu/dsnvps-telegram-menu
        exit 1
    fi
fi


# Kiểm tra và cài đặt telethon
if ! python3 -c "import telethon" >/dev/null 2>&1; then
    echo "-------------------------------------------------------------------------"
    echo "Đang cài đặt thư viện telethon..."
    sudo pip3 install telethon >/tmp/telethon_install.log 2>&1
    if [ $? -ne 0 ]; then
        clear
        echo "========================================================================="
        echo "Lỗi: Không thể cài đặt telethon. Chi tiết lỗi:"
        cat /tmp/telethon_install.log
        echo "-------------------------------------------------------------------------"
        echo "Bạn có thể thử tiếp tục cấu hình Telegram hoặc kiểm tra quyền/mạng."
    else
        echo "-------------------------------------------------------------------------"
        echo "Cài đặt telethon thành công."
    fi
fi

# Kiểm tra file cấu hình Telegram
if [ -f /etc/dsnvps/telegram_group.conf ]; then
    # Kiểm tra xem có group_id không và validate định dạng
    if grep -q "group_id=" /etc/dsnvps/telegram_group.conf; then
        # Lấy group_id từ file config
        group_id=$(grep "group_id=" /etc/dsnvps/telegram_group.conf | cut -d'=' -f2 | tr -d ' ')
        
        # Validate group_id format (phải là số âm cho supergroup)
        if [[ "$group_id" =~ ^-[0-9]+$ ]] && [ "$group_id" -lt -1000000000000 ]; then
            clear
            echo "========================================================================="
            echo "VPS đã kết nối với Telegram (Group ID: $group_id)"
            echo "-------------------------------------------------------------------------"
            echo "Hãy chạy [Cấu Hình Tự Động Sao Lưu] để hoàn tất config."
            echo "-------------------------------------------------------------------------"
            echo "Hoặc [Xóa Tất Cả Cấu Hình] để kết nối lại!"
            /etc/dsnvps/menu/dsnvps-telegram-menu
            exit 0
        else
            echo "========================================================================="
            echo "Cảnh báo: Group ID không hợp lệ ($group_id)"
            echo "-------------------------------------------------------------------------"
            echo "Sẽ tạo lại cấu hình Telegram..."
            echo "========================================================================="
            # Xóa file config cũ để tạo lại
            rm -f /etc/dsnvps/telegram_group.conf
        fi
    fi
fi

echo "========================================================================="
echo "Dùng chức năng này để kết nối VPS với tài khoản Telegram"
echo "-------------------------------------------------------------------------"
echo "Xem hướng dẫn tại: http://go.dsnvps/2856"
echo "========================================================================="
read -r -p "Bạn đã đọc xong hướng dẫn sử dụng chức năng này? [y/N] " response
if [[ ! $response =~ ^(y|Y|yes|Yes)$ ]]; then
    clear
    echo "========================================================================="
    echo "Bạn chưa xác nhận. Thoát!"
    /etc/dsnvps/menu/dsnvps-telegram-menu
    exit 1
fi
echo "-------------------------------------------------------------------------"
echo "Bắt đầu cấu hình ..."; sleep 0.9
#echo "-------------------------------------------------------------------------"

####################################################################
##Check Ban Pro
####################################################################
if [ ! -f /usr/bin/gxred ]; then
touch /etc/dsnvps/.tmp/ckla
/etc/dsnvps/menu/dsnvps-dem-luot-su-dung-chuc-nang
clear
/etc/dsnvps/menu/dsnvps-telegram-menu
fi
###################################################################  

# Chạy script Python để tạo group và cấu hình
PYTHON_SCRIPT="/etc/dsnvps/menu/dsnvps-create-telegram-config.py"

if [ -f "$PYTHON_SCRIPT" ]; then
    python3 "$PYTHON_SCRIPT"
    python_exit_code=$?
    
    if [ $python_exit_code -eq 0 ]; then
        # Kiểm tra xem file config đã được tạo và có group_id hợp lệ không
        if [ -f /etc/dsnvps/telegram_group.conf ]; then
            group_id=$(grep "group_id=" /etc/dsnvps/telegram_group.conf | cut -d'=' -f2 | tr -d ' ')
            group_name=$(grep "group_name=" /etc/dsnvps/telegram_group.conf | cut -d'=' -f2 | tr -d ' "')
            group_type=$(grep "group_type=" /etc/dsnvps/telegram_group.conf | cut -d'=' -f2 | tr -d ' ')
            if [[ "$group_id" =~ ^-[0-9]+$ ]] && [ "$group_id" -lt -1000000000000 ]; then
                clear
                echo "========================================================================="
                echo "Kết nối VPS với Telegram thành công!"
                echo "-------------------------------------------------------------------------"
                if [ "$group_type" = "new" ]; then
                    echo "Group ID được tạo: $group_id"
                else
                    echo "Group ID Cũ: $group_id"
                fi
                echo "-------------------------------------------------------------------------"
                echo "Tên Group Telegram: $group_name"
                echo "-------------------------------------------------------------------------"
                echo "Tiếp theo bạn hãy [Cấu Hình Tự Động Sao Lưu]"
                /etc/dsnvps/menu/dsnvps-telegram-menu
            else
                clear
                echo "========================================================================="
                echo "==> Lỗi: Group ID không hợp lệ ($group_id)"
                echo "-------------------------------------------------------------------------"
                echo "Vui lòng thử lại hoặc kiểm tra cấu hình."
                /etc/dsnvps/menu/dsnvps-telegram-menu
                exit 1
            fi
        else
            # Exit code 0 nhưng không có file config = thoát bình thường (chọn 0)
            clear
            echo "========================================================================="
            echo "Thoát."
            /etc/dsnvps/menu/dsnvps-telegram-menu
            exit 0
        fi
    else
        clear
        echo "========================================================================="
        if [ $python_exit_code -eq 1 ]; then
            echo "==> Lỗi: Group ID không đúng định dạng!"
            echo "-------------------------------------------------------------------------"
            echo "Group ID phải là số âm bắt đầu bằng -100 (ví dụ: -1001234567890)"
        else
            echo "==> Lỗi: Không thể kết nối với Telegram! (Exit code: $python_exit_code)"
            echo "-------------------------------------------------------------------------"
            echo "Hãy kiểm tra lại api_id, api_hash, số điện thoại hoặc thử lại."
        fi
        /etc/dsnvps/menu/dsnvps-telegram-menu
        exit 1
    fi
else
    clear
    echo "========================================================================="
    echo "Không tìm thấy file $PYTHON_SCRIPT"
    echo "-------------------------------------------------------------------------"
    echo "Vui lòng kiểm tra lại cấu hình DSNVPS."
    /etc/dsnvps/menu/dsnvps-telegram-menu
    exit 1
fi
