#!/bin/bash
. /root/dsnvps.conf 
# Anti-debug removed
if [ -f /etc/vsftpd/vsftpd.conf ]; then
clear
echo "========================================================================= "
echo "Phat hien VSFTPD duoc cai dat tren server. "
echo "-------------------------------------------------------------------------"
echo "De su dung day du chuc nang Quản Lý FTP Account"
echo "-------------------------------------------------------------------------"
echo "DSNVPS se Remove VSFTPD tren Server truoc"
sleep 8
clear
echo "-------------------------------------------------------------------------"
echo "Vui lòng chờ ............."
sleep 3
apt-get remove -y -qq vsftpd >/dev/null 2>&1 || true
clear
fi
if [ ! -f /etc/pure-ftpd/pure-ftpd.conf ]; then
/etc/dsnvps/menu/dsnvps-ftpserver-menu-khong
else
/etc/dsnvps/menu/dsnvps-ftpserver-menu-co
fi
